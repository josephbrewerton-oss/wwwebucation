{
  "name": "st-joseph-curriculum-portal",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "prebuild": "node scripts/generate-cartridge-manifest.mjs && node scripts/generate-scenes-manifest.js",
    "manifest": "node scripts/generate-cartridge-manifest.mjs",
    "manifest:scenes": "npx tsx scripts/compile-ast-bytecode.ts && node scripts/generate-cartridge-manifest.mjs && node scripts/generate-scenes-manifest.js && npx tsx scripts/generate-cartridge-checksums.ts && python3 scripts/build-player-zip.py && npx tsx scripts/generate-manifest-digests.ts",
    "build": "node scripts/build-wasm.js && npx tsx scripts/compile-ast-bytecode.ts && node scripts/generate-cartridge-manifest.mjs && node scripts/generate-scenes-manifest.js && npx tsx scripts/generate-cartridge-checksums.ts && npx tsx scripts/generate-manifest-digests.ts && vite build && cp dist/index.html dist/404.html",
    "build:wasm": "node scripts/build-wasm.js",
    "compile:bytecode": "npx tsx scripts/compile-ast-bytecode.ts",
    "build:player-zip": "python3 scripts/build-player-zip.py",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "pretest": "node scripts/generate-scenes-manifest.js",
    "test": "npm run test:bytecode && npm run test:paths && npm run test:ast && npm run test:simulations && npm run test:swf && npm run test:ink && npm run test:invariants && npm run test:bsl && npm run test:integrity",
    "test:bytecode": "npx tsx scripts/test-ast-bytecode.ts",
    "test:paths": "npx tsx scripts/simulate-cartridge-paths.ts",
    "test:bsl": "npx tsx scripts/simulate-bsl-interpreter.ts",
    "test:integrity": "npx tsx scripts/simulate-cartridge-integrity.ts",
    "pretest:ast": "node scripts/generate-scenes-manifest.js",
    "test:ast": "npx tsx scripts/test-ast-manifests.ts",
    "test:simulations": "npx tsx scripts/simulate-questions.ts",
    "test:swf": "npx tsx scripts/simulate-swf-import.ts",
    "test:ink": "npx tsx scripts/simulate-whiteboard-ink.ts",
    "test:invariants": "npx tsx scripts/simulate-sim-engine-invariants.ts",
    "ingest:oak": "npx tsx scripts/ingest-oak.ts",
    "export:dist": "npx tsx scripts/export-distribution.ts",
    "lint": "tsc --noEmit",
    "mine:watch": "npx tsx scripts/watchSubstrates.ts"
  },
  "overrides": {
    "typescript": "^5.6.3",
    "esbuild": "^0.28.1",
    "source-map-js": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.6.3",
    "vite": "^8.3.6",
    "wabt": "^1.0.39"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.87"
  }
}
