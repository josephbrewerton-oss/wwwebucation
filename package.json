{
  "name": "st-joseph-curriculum-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build:wasm": "node scripts/build-wasm.js",
    "compile:bytecode": "npx tsx scripts/compile-ast-bytecode.ts",
    "manifest:scenes": "npx tsx scripts/compile-ast-bytecode.ts && node scripts/generate-scenes-manifest.js",
    "build": "node scripts/build-wasm.js && npx tsx scripts/compile-ast-bytecode.ts && node scripts/generate-scenes-manifest.js && python3 scripts/generate-icons.py && npx tsx scripts/generate-manifest-digests.ts && npm run ingest:oak && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "npm run test:bytecode && npm run test:ast && npm run test:simulations && npm run test:swf && npm run test:ink && npm run test:invariants && npm run test:bsl",
    "test:bytecode": "npx tsx scripts/test-ast-bytecode.ts",
    "test:bsl": "npx tsx scripts/simulate-bsl-interpreter.ts",
    "test:ast": "npx tsx scripts/test-ast-manifests.ts",
    "test:simulations": "npx tsx scripts/simulate-questions.ts",
    "test:swf": "npx tsx scripts/simulate-swf-import.ts",
    "test:ink": "npx tsx scripts/simulate-whiteboard-ink.ts",
    "test:invariants": "npx tsx scripts/simulate-sim-engine-invariants.ts",
    "ingest:oak": "npx tsx scripts/ingest-oak.ts",
    "export:dist": "npx tsx scripts/export-distribution.ts",
    "lint": "tsc --noEmit",
    "mine:watch": "npx tsx scripts/watchSubstrates.ts"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "source-map-js": "^1.2.2"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.5.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "wabt": "^1.0.39",
    "webmcp-types": "^0.1.10"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "canvas-confetti": "^1.9.4",
    "katex": "^0.18.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3"
  }
}
