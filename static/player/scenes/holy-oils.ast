(:scene :id "holy-oils" :type "Slide" :oak-id "OAK-KS2-RE-003" :oak-unit "ks2-re-catholic-holy-oils-ambry" :title "The Three Holy Oils & The Sacred Ambry (Olea Sancta)" :stage "CATHOLIC LIFE" :duration 18.0
  (:vars (
    (:var :name "ambryLight" :val 1.0 :min 0.2 :max 1.5 :step 0.1 :label "Ambry Sanctuary Lamp")
    (:var :name "oilGlow" :val 1.0 :min 0.0 :max 1.0 :step 1.0 :label "Ampulla Halo")
  ))
  (:inputs (
    (:slider :var "ambryLight" :label "Ambry Sanctuary Lamp" :min 0.2 :max 1.5 :step 0.1)
    (:slider :var "oilGlow" :label "Ampulla Halo" :min 0.0 :max 1.0 :step 1.0)
  ))
  (:gestures (
    (:draggable :target "#oil-probe" :axis "xy" :min 100 :max 700)
  ))
  (:subtitles (
    (:start 0.00 :end 0.20 :en "The Holy Ambry is the sacred niche in the sanctuary or baptistery inscribed with 'Olea Sancta', housing the three holy oils." :es "El Santo Ambón o Sagrario de los Santos Óleos guarda con reverencia los tres óleos sagrados de la Iglesia." :la "Ambriarium sacrum olea sancta in pariete sanctuarii vel baptisterii fideliter custodit.")
    (:start 0.20 :end 0.40 :en "Oleum Infirmorum (O.I.) is blessed pure olive oil used in the Sacrament of the Anointing of the Sick for healing and pardon." :es "El Óleo de los Enfermos (O.I.) se aplica en la frente y manos para aliviar los dolores y perdonar los pecados." :la "Oleum Infirmorum ad sanationem mentis et corporis atque remissionem peccatorum confertur.")
    (:start 0.40 :end 0.60 :en "Oleum Catechumenorum (O.C.) fortifies the soul against spiritual warfare before the waters of Holy Baptism." :es "El Óleo de los Catecúmenos (O.C.) fortalece contra las tentaciones antes del baño de la regeneración bautismal." :la "Oleum Catechumenorum pugiles Christi contra tentationes daemonis munit.")
    (:start 0.60 :end 0.80 :en "Sanctum Chrisma (S.C.) is pure olive oil mixed with sweet aromatic balsam, solemnly consecrated by the Bishop." :es "El Santo Crisma (S.C.) mezcla aceite y bálsamo oloroso, consagrado con el soplo del Obispo en la Misa Crismal." :la "Sanctum Chrisma cum balsamo confectum spiritualem Christi odorem et characterem indelibilem effundit.")
    (:start 0.80 :end 1.00 :en "At the annual Chrism Mass, the Bishop breathes over the Chrism; old oils are reverently burned in the Easter Fire." :es "En la Misa Crismal se renuevan los óleos, y los sobrantes se queman reverentemente en el Fuego Pascual." :la "In Missa Chrismatis episcopus insufflat; vetera olea in igne Paschali pie comburuntur.")
  ))
  (:keyframes (
    (:t 0.00 :title "1. Ambriarium Sacrum (The Holy Ambry)" :rule "Olea Sancta: Consecrated sanctuary niche keeping the three sacred oils under glass and key.")
    (:t 0.20 :title "2. Oleum Infirmorum • O.I. (Oil of the Sick)" :rule "O.I.: Pure olive oil for the Anointing of the Sick (James 5:14) on forehead and hands.")
    (:t 0.40 :title "3. Oleum Catechumenorum • O.C. (Catechumens)" :rule "O.C.: Pre-baptismal breast anointing giving strength against evil and the armor of God.")
    (:t 0.60 :title "4. Sanctum Chrisma • S.C. (Sacred Chrism)" :rule "S.C.: Balsam + olive oil for Baptism crown, Confirmation forehead, Holy Orders, and Altars.")
    (:t 0.80 :title "5. Chrism Mass, Insufflatio & Easter Fire" :rule "Missa Chrismatis: Bishop's sacred breath, priestly promises renewal, and Easter Fire burning.")
  ))
  (:interactive (
    (:checkpoint :t 0.62
      :prompt "Which of the Three Holy Oils is mixed with sweet aromatic balsam and leaves an indelible spiritual character?"
      :options ("Sacred Chrism (Sanctum Chrisma • S.C.)" "Oil of the Sick (Oleum Infirmorum • O.I.)" "Oil of Catechumens (Oleum Catechumenorum • O.C.)" "Holy Water of the Jordan")
      :answer 0
      :explanation "Sacred Chrism is compounded with sweet fragrant balsam and consecrated by the Bishop. It confers the indelible seal of the Holy Spirit in Baptism, Confirmation, and Holy Orders.")
  ))
  (:bindings (
    (:target "#ambry-lamp-glow" :attr "opacity" :expr "(0.75 + Math.sin(t * Math.PI * 10) * 0.25) * (vars.ambryLight || 1.0)")
    (:target "#oi-vessel-glow" :attr "opacity" :expr "t >= 0.20 && t < 0.40 ? 0.95 : 0.15")
    (:target "#oc-vessel-glow" :attr "opacity" :expr "t >= 0.40 && t < 0.60 ? 0.95 : 0.15")
    (:target "#sc-vessel-glow" :attr "opacity" :expr "t >= 0.60 && t < 0.80 ? 0.95 : 0.25")
    (:target "#oil-probe" :attr "cx" :expr "t < 0.20 ? 400 : (t < 0.40 ? 250 : (t < 0.60 ? 550 : (t < 0.80 ? 400 : 400)))")
    (:target "#oil-probe" :attr "cy" :expr "t < 0.20 ? 80 : (t < 0.40 ? 250 : (t < 0.60 ? 250 : (t < 0.80 ? 230 : 350)))")
    (:target "#oil-step-title" :attr "textContent" :expr "t < 0.20 ? '1. AMBRIARIUM SACRUM (THE SACRED AMBRY)' : (t < 0.40 ? '2. OLEUM INFIRMORUM [O.I.] (OIL OF THE SICK)' : (t < 0.60 ? '3. OLEUM CATECHUMENORUM [O.C.] (ARMOR OF GOD)' : (t < 0.80 ? '4. SANCTUM CHRISMA [S.C.] (BALSAMIC SEAL OF SPIRIT)' : '5. MISSA CHRISMATIS & EASTER VIGIL FIRE'))")
    (:target "#oil-step-desc" :expr "t < 0.20 ? 'Inscribed with OLEA SANCTA • Reverently housing the three sacramental oils...' : (t < 0.40 ? 'Pure olive oil • Comforting, healing of body and soul, pardon of sins (James 5:14)...' : (t < 0.40 ? 'Pre-baptismal anointing on chest • Spiritual armor against adversary and temptation...' : (t < 0.80 ? 'Fragrant balsam + olive oil • Bishop breathes Insufflatio • Indelible royal seal...' : 'Holy Week renewal • Priests renew ordination promises • Old oils burned in Easter Fire...')))" :attr "textContent")
  ))
)
