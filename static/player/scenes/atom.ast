    (:target "#atom-oe-7" :attr "display" :expr "vars.atomicNumber >= 10 ? 'inline' : 'none'")

    <!-- M-Shell Electrons (n=3, 8 positions) -->
    (:target "#atom-me-0" :type "3d-node"
      :x "Math.cos(t * Math.PI * 2 * 0.9 * (vars.orbitSpeed || 1) + 0 * Math.PI / 4) * 215"
      :y "Math.sin(t * Math.PI * 2 * 0.9 * (vars.orbitSpeed || 1) + 0 * Math.PI / 4) * 110"
      :z "Math.sin(t * Math.PI * 2 * 0.9 * (vars.orbitSpeed || 1) + 0 * Math.PI / 4) * 215"
      :base-r 6
    )
