(:scene :id "kinetic-gas" :type "Sim" :oak-id "OAK-KS3-SCI-001" :title "Kinetic Gas Theory & Boyle's Law" :stage "KS3/KS4 PHYSICS & CHEMISTRY" :duration 14.0
  (:vars (
    (:var :name "volume" :val 1.0 :min 0.35 :max 1.0 :step 0.01 :unit "m³" :label "Chamber Volume")
    (:var :name "temp" :val 300 :min 75 :max 650 :step 10 :unit "K" :label "Gas Temperature")
    (:var :name "particleCount" :val 75 :min 15 :max 150 :step 5 :label "Particle Count (N)")
    (:var :name "state" :val "gas" :label "Matter Phase State")
  ))
  (:inputs (
    (:slider :var "volume" :label "Cylinder Volume (V)" :min 0.35 :max 1.0 :step 0.01)
    (:slider :var "temp" :label "Thermal Temperature (T)" :min 90 :max 600 :step 10)
    (:slider :var "particleCount" :label "Molecules / Atoms (N)" :min 15 :max 150 :step 5)
  ))
  (:computed (
    (:name "pressure" :expr "(101.3 / (vars.volume || 1.0) * ((vars.temp || 300) / 300)).toFixed(1)")
  ))
  (:gestures (
    (:draggable :target "#piston-assembly" :axis "x" :min 200 :max 450)
  ))
  (:emitters (
    (:emitter :id "gas-molecules" :count 75 :speed 160 :radius 4.5 :fill "#38bdf8"
      :minX 46 :maxX 494 :minY 86 :maxY 374 :wrapMode "bounce"
      :obstacles (
        (:obstacle :target "#piston-assembly" :bounce 1.0)
      )
    )
  ))
  (:subtitles (
    (:start 0.00 :end 3.50 :en "Kinetic Molecular Theory explains that gas pressure arises from billions of elastic collisions against the container walls." :es "La teoría cinética explica que la presión de un gas surge de millones de colisiones elásticas contra las paredes.")
    (:start 3.50 :end 7.20 :en "Boyle's Law states that at constant temperature, halving the volume doubles collision frequency, doubling pressure." :es "La ley de Boyle establece que a temperatura constante, reducir el volumen a la mitad duplica las colisiones y la presión.")
    (:start 7.20 :end 10.20 :en "Gay-Lussac's Law demonstrates that heating gas increases particle speed (v_rms), producing harder, more frequent impacts." :es "La ley de Gay-Lussac demuestra que calentar el gas aumenta la velocidad de las partículas, produciendo impactos más fuertes.")
    (:start 10.20 :end 12.20 :en "When thermal energy drops below boiling point (220 K), gas condenses into an incompressible, flowing liquid." :es "Al bajar la energía térmica bajo el punto de ebullición (220 K), el gas se condensa en un líquido fluido.")
    (:start 12.20 :end 14.00 :en "Under cryogenic freezing (85 K), intermolecular bonds lock particles into a rigid, vibrating crystal lattice solid." :es "Bajo congelación criogénica (85 K), los enlaces intermoleculares fijan las partículas en una red cristalina sólida.")
  ))
  (:keyframes (
    (:t 0.00 :title "1. Equilibrium Gas State" :rule "V = 100%, T = 300K -> P = 101.3 kPa baseline atmospheric pressure")
    (:t 0.35 :title "2. Boyle's Isothermal Compression" :rule "Piston compresses V to 50% -> Collision frequency doubles -> P rises to 202.6 kPa")
    (:t 0.65 :title "3. Thermal Heat Wave (Gay-Lussac)" :rule "Temperature spikes to 600K -> v_rms increases by √2 -> P reaches 405.2 kPa")
    (:t 0.78 :title "4. Condensation (Gas → Liquid)" :rule "Thermal energy drops to 220K -> Molecules condense into fluid liquid state")
    (:t 0.92 :title "5. Phase Transition to Solid" :rule "Cryogenic cooling to 85K locks particles into vibrating crystal lattice sites")
  ))
  (:interactive (
    (:checkpoint :t 0.34
      :prompt "According to Boyle's Law, what happens to the gas pressure if the volume is halved at constant temperature?"
      :options ("Pressure doubles (P ∝ 1/V)" "Pressure drops to zero" "Temperature decreases" "Volume increases")
      :answer 0
      :explanation "Boyle's Law dictates P1 × V1 = P2 × V2. Halving distance halves transit time, doubling the collision rate on container walls.")
  ))
  (:bindings (
    (:target "#piston-assembly" :attr "transform" :expr "'translate(' + (vars.volume !== undefined && vars.volume !== null ? (250 + 180 * (Math.max(0.35, Math.min(1.0, vars.volume)) - 0.35) / 0.65) : (t < 0.25 ? 430 : (t < 0.51 ? (430 - 180 * Math.min(1, (t - 0.25) / 0.26)) : (t < 0.74 ? 250 : (250 + 180 * Math.min(1, (t - 0.74) / 0.13)))))) + ', 0)'")
    (:target "#gauge-needle" :attr "transform" :expr "'rotate(' + ((vars.state === 'solid' || (vars.state === undefined && (vars.temp !== undefined ? vars.temp <= 140 : t >= 0.87))) ? -45 : ((vars.state === 'liquid' || (vars.state === undefined && (vars.temp !== undefined ? (vars.temp > 140 && vars.temp <= 273) : (t >= 0.74 && t < 0.87)))) ? -25 : (vars.volume !== undefined ? (-45 + (1.0 - Math.max(0.35, Math.min(1.0, vars.volume))) * 140 * ((vars.temp || 300) / 300)) : (-45 + (t < 0.25 ? 0 : (t < 0.51 ? 70 * ((t - 0.25) / 0.26) : (t < 0.74 ? 70 + 70 * ((t - 0.51) / 0.23) : 70))))))) + ' 0 0)'")
    (:target "#gauge-value" :attr "textContent" :expr "((vars.state === 'solid' || (vars.state === undefined && (vars.temp !== undefined ? vars.temp <= 140 : t >= 0.87))) ? '0.0 kPa' : ((vars.state === 'liquid' || (vars.state === undefined && (vars.temp !== undefined ? (vars.temp > 140 && vars.temp <= 273) : (t >= 0.74 && t < 0.87)))) ? '24.5 kPa' : (computed.pressure !== undefined ? computed.pressure + ' kPa' : (vars.pressure !== undefined ? Number(vars.pressure).toFixed(1) + ' kPa' : ((101.3 / (t < 0.25 ? 1.0 : (t < 0.51 ? (1.0 - 0.5 * ((t - 0.25) / 0.26)) : 0.5))) * ((t < 0.51 ? 300 : (t < 0.74 ? 300 + 300 * ((t - 0.51) / 0.23) : 300)) / 300)).toFixed(1) + ' kPa'))))")
    (:target "#thermo-fluid" :attr "height" :expr "vars.temp !== undefined ? Math.max(20, Math.min(160, (vars.temp / 600) * 150)) : (t < 0.51 ? 116 : (t < 0.74 ? (116 + 34 * ((t - 0.51) / 0.23)) : (t < 0.87 ? (150 - 85 * ((t - 0.74) / 0.13)) : 35)))")
    (:target "#thermo-fluid" :attr "y" :expr "vars.temp !== undefined ? Math.max(20, 180 - Math.max(20, Math.min(160, (vars.temp / 600) * 150))) : (t < 0.51 ? 64 : (t < 0.74 ? (64 - 34 * ((t - 0.51) / 0.23)) : (t < 0.87 ? (30 + 85 * ((t - 0.74) / 0.13)) : 145)))")
    (:target "#thermo-value" :attr "textContent" :expr "vars.temp ? Math.round(vars.temp) + ' K' : (t < 0.51 ? '300 K' : (t < 0.74 ? Math.round(300 + 300 * ((t - 0.51) / 0.23)) + ' K' : (t < 0.87 ? Math.round(600 - 380 * ((t - 0.74) / 0.13)) + ' K' : '85 K')))")
(:target "#pv-equation" :attr "textContent" :expr "(vars.state === 'solid' || (vars.state === undefined && (vars.temp !== undefined ? vars.temp <= 140 : t >= 0.87))) ? 'Phase Change  •  Cryogenic Crystal Lattice Solid (85 K)' : ((vars.state === 'liquid' || (vars.state === undefined && (vars.temp !== undefined ? (vars.temp > 140 && vars.temp <= 273) : (t >= 0.74 && t < 0.87)))) ? 'Phase Change  •  Gas Condenses to Fluid Liquid (220 K)' : ((vars.temp !== undefined ? vars.temp <= 350 : t < 0.51) ? 'P × V = k  •  (Boyles Law P ∝ 1/V verified)' : 'P / T = k  •  (Gay-Lussac Isochoric Heating)'))")
    (:target "#ind-gas" :attr "fill" :expr "((vars.state === 'solid' || (vars.state === undefined && (vars.temp !== undefined ? vars.temp <= 140 : t >= 0.87))) ? false : ((vars.state === 'liquid' || (vars.state === undefined && (vars.temp !== undefined ? (vars.temp > 140 && vars.temp <= 273) : (t >= 0.74 && t < 0.87)))) ? false : true)) ? '#2563eb' : '#1e293b'")
    (:target "#txt-gas" :attr "fill" :expr "((vars.state === 'solid' || (vars.state === undefined && (vars.temp !== undefined ? vars.temp <= 140 : t >= 0.87))) ? false : ((vars.state === 'liquid' || (vars.state === undefined && (vars.temp !== undefined ? (vars.temp > 140 && vars.temp <= 273) : (t >= 0.74 && t < 0.87)))) ? false : true)) ? '#ffffff' : '#64748b'")
    (:target "#ind-liquid" :attr "fill" :expr "((vars.state === 'liquid' || (vars.state === undefined && (vars.temp !== undefined ? (vars.temp > 140 && vars.temp <= 273) : (t >= 0.74 && t < 0.87)))) && vars.state !== 'solid' && (vars.temp === undefined || vars.temp > 140)) ? '#06b6d4' : '#1e293b'")
    (:target "#txt-liquid" :attr "fill" :expr "((vars.state === 'liquid' || (vars.state === undefined && (vars.temp !== undefined ? (vars.temp > 140 && vars.temp <= 273) : (t >= 0.74 && t < 0.87)))) && vars.state !== 'solid' && (vars.temp === undefined || vars.temp > 140)) ? '#ffffff' : '#64748b'")
    (:target "#ind-solid" :attr "fill" :expr "(vars.state === 'solid' || (vars.state === undefined && (vars.temp !== undefined ? vars.temp <= 140 : t >= 0.87))) ? '#22c55e' : '#1e293b'")
    (:target "#txt-solid" :attr "fill" :expr "(vars.state === 'solid' || (vars.state === undefined && (vars.temp !== undefined ? vars.temp <= 140 : t >= 0.87))) ? '#ffffff' : '#64748b'")
    (:target "#collision-rate" :attr "textContent" :expr "(vars.state === 'solid' || (vars.state === undefined && (vars.temp !== undefined ? vars.temp <= 140 : t >= 0.87))) ? '0 / sec (Lattice Lock)' : ((vars.state === 'liquid' || (vars.state === undefined && (vars.temp !== undefined ? (vars.temp > 140 && vars.temp <= 273) : (t >= 0.74 && t < 0.87)))) ? '120 / sec (Fluid Shearing)' : (Math.round(480 / (vars.volume || (t < 0.25 ? 1.0 : (t < 0.51 ? (1.0 - 0.5 * ((t - 0.25) / 0.26)) : 0.5))) * ((vars.temp || (t < 0.51 ? 300 : (t < 0.74 ? (300 + 300 * ((t - 0.51) / 0.23)) : 300))) / 300)) + ' / sec'))")
    (:target "#rms-speed" :attr "textContent" :expr "(vars.state === 'solid' || (vars.state === undefined && (vars.temp !== undefined ? vars.temp <= 140 : t >= 0.87))) ? '25 m/s (Thermal Jitter)' : ((vars.state === 'liquid' || (vars.state === undefined && (vars.temp !== undefined ? (vars.temp > 140 && vars.temp <= 273) : (t >= 0.74 && t < 0.87)))) ? '180 m/s (Fluid Flow)' : (Math.round(490 * Math.sqrt((vars.temp || (t < 0.51 ? 300 : (t < 0.74 ? (300 + 300 * ((t - 0.51) / 0.23)) : 300))) / 300)) + ' m/s'))")
    (:target "#brownian-grain" :attr "cx" :expr "(vars.state === 'solid' || (vars.state === undefined && (vars.temp !== undefined ? vars.temp <= 140 : t >= 0.87))) ? 180 : (200 + Math.sin(t * 24) * 25)")
    (:target "#brownian-grain" :attr "cy" :expr "(vars.state === 'solid' || (vars.state === undefined && (vars.temp !== undefined ? vars.temp <= 140 : t >= 0.87))) ? 260 : ((vars.state === 'liquid' || (vars.state === undefined && (vars.temp !== undefined ? (vars.temp > 140 && vars.temp <= 273) : (t >= 0.74 && t < 0.87)))) ? (290 + Math.cos(t * 12) * 15) : (210 + Math.cos(t * 31) * 20))")
  ))
)
