(:scene :id "dna-helix" :type "Sim" :oak-id "OAK-KS3-SCI-005" :oak-unit "ks3-biology-genetics-dna-transcription" :title "Genetics: DNA Base Pairing & Transcription" :stage "KS3 GENETICS" :duration 12.0
  (:camera :distance 440 :pitch 18 :yaw "((vars.rotSpeed != null ? vars.rotSpeed : 1.0) * (clock != null ? clock : (t * 12.0)) * 25.0)" :fov 60)
  (:vars (
    (:var :name "rotSpeed" :val 1.0 :min 0.2 :max 3.0 :step 0.2 :label "Helix Spin Rate")
    (:var :name "unzipProgress" :val 0.0 :min 0.0 :max 1.0 :step 0.05 :label "Helicase Unzip Progress")
  ))
  (:inputs (
    (:slider :var "rotSpeed" :label "Rotation Velocity" :min 0.2 :max 3.0 :step 0.2)
    (:slider :var "unzipProgress" :label "Transcription Unzip" :min 0.0 :max 1.0 :step 0.05)
  ))
  (:computed (
    (:name "hydrogenBonds" :expr "Math.round((1.0 - vars.unzipProgress) * 45)")
  ))
  (:gestures (
    (:draggable :target "#dna-line-0" :axis "xy" :min -50 :max 50)
  ))
  (:subtitles (
    (:start 0.00 :end 0.35 :en "DNA contains hereditary code structured as an anti-parallel double helix spiraling in 3D." :es "El ADN contiene el código genético estructurado como una doble hélice en 3D.")
    (:start 0.35 :end 0.70 :en "Complementary base rule: Adenine (Red) pairs with Thymine (Green); Cytosine (Blue) with Guanine (Gold)." :es "Regla complementaria: Adenina se une a Timina; Citosina se une a Guanina.")
    (:start 0.70 :end 1.00 :en "Hydrogen bonds hold the rungs together. Drag anywhere on stage to orbit this DNA helix in 3D!" :es "Los puentes de hidrógeno unen las bases. ¡Arrastra para rotar la hélice en 3D!")
  ))
  (:keyframes (
    (:t 0.00 :title "Double Helix Geometry" :rule "Anti-parallel sugar-phosphate backbones spiraling in 3D.")
    (:t 0.35 :title "Watson-Crick Base Pairs" :rule "Adenine (A) always pairs with Thymine (T) via 2 hydrogen bonds.")
    (:t 0.70 :title "Cytosine-Guanine Pairs" :rule "Cytosine (C) pairs with Guanine (G) via 3 hydrogen bonds.")
    (:t 1.00 :title "Replication Fork Unzip" :rule "Helicase enzyme unzips hydrogen bonds for semi-conservative replication.")
  ))
  (:interactive (
    (:checkpoint :t 0.50
      :prompt "According to Watson-Crick base-pairing rules, which nitrogenous base pairs with Adenine (A) in DNA?"
      :options ("Thymine (T) via 2 hydrogen bonds" "Cytosine (C)" "Guanine (G)" "Uracil (only in RNA)")
      :answer 0
      :explanation "In double-stranded DNA, Adenine (A) always pairs specifically with Thymine (T) via 2 hydrogen bonds, while Guanine (G) pairs with Cytosine (C) via 3 hydrogen bonds.")
  ))
  (:bindings (
    (:target "#dna-status-text" :attr "textContent" :expr "vars.unzipProgress > 0 ? ('Replication Fork: Helicase Active! ' + computed.hydrogenBonds + ' / 45 H-Bonds Intact (' + Math.round((1 - vars.unzipProgress) * 100) + '%)') : 'Strand A 5\\'→3\\' • Strand B 3\\'→5\\' • 45 Hydrogen Bonds (100% Intact)'")
    (:target "#dna-line-0" :type "3d-line"
      :x1 "-110 * Math.cos((0/18)*Math.PI*3)" :y1 "(0/18)*360 - 180" :z1 "-110 * Math.sin((0/18)*Math.PI*3)"
      :x2 "110 * Math.cos((0/18)*Math.PI*3)" :y2 "(0/18)*360 - 180" :z2 "110 * Math.sin((0/18)*Math.PI*3)"
      :cap1 "#dna-ca-0" :cap2 "#dna-cb-0" :base-r 8)
    (:target "#dna-line-1" :type "3d-line"
      :x1 "-110 * Math.cos((1/18)*Math.PI*3)" :y1 "(1/18)*360 - 180" :z1 "-110 * Math.sin((1/18)*Math.PI*3)"
      :x2 "110 * Math.cos((1/18)*Math.PI*3)" :y2 "(1/18)*360 - 180" :z2 "110 * Math.sin((1/18)*Math.PI*3)"
      :cap1 "#dna-ca-1" :cap2 "#dna-cb-1" :base-r 8)
    (:target "#dna-line-2" :type "3d-line"
      :x1 "-110 * Math.cos((2/18)*Math.PI*3)" :y1 "(2/18)*360 - 180" :z1 "-110 * Math.sin((2/18)*Math.PI*3)"
      :x2 "110 * Math.cos((2/18)*Math.PI*3)" :y2 "(2/18)*360 - 180" :z2 "110 * Math.sin((2/18)*Math.PI*3)"
      :cap1 "#dna-ca-2" :cap2 "#dna-cb-2" :base-r 8)
    (:target "#dna-line-3" :type "3d-line"
      :x1 "-110 * Math.cos((3/18)*Math.PI*3)" :y1 "(3/18)*360 - 180" :z1 "-110 * Math.sin((3/18)*Math.PI*3)"
      :x2 "110 * Math.cos((3/18)*Math.PI*3)" :y2 "(3/18)*360 - 180" :z2 "110 * Math.sin((3/18)*Math.PI*3)"
      :cap1 "#dna-ca-3" :cap2 "#dna-cb-3" :base-r 8)
    (:target "#dna-line-4" :type "3d-line"
