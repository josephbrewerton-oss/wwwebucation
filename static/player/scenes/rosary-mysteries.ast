(:scene :id "rosary-mysteries" :type "Sim" :title "The Holy Rosary: 3D Beads & 20 Scriptural Mysteries" :stage "CATHOLIC LIFE & RE" :duration 20.0
  (:camera :distance 460 :pitch 22 :yaw "t * 36" :fov 60)
  (:vars (
    (:var :name "decade" :val 1 :min 1 :max 5 :step 1 :label "Decade (1 to 5)")
    (:var :name "beadProgress" :val 0.0 :min 0.0 :max 1.0 :step 0.05 :label "Mystery Orbit")
  ))
  (:inputs (
    (:slider :var "decade" :label "Rosary Decade (1 to 5)" :min 1 :max 5 :step 1)
  ))
  (:gestures (
    (:draggable :target "#crucifix-node" :axis "xy" :min -80 :max 80)
  ))
  (:subtitles (
    (:start 0.00 :end 0.25 :en "The Holy Rosary is a scriptural, contemplative prayer meditating on the Life, Passion, and Glory of Jesus Christ across 20 Mysteries." :es "El Santo Rosario es una oración contemplativa y bíblica que medita en la Vida, Pasión y Gloria de Jesucristo en 20 Misterios.")
    (:start 0.25 :end 0.50 :en "Each decade begins with the Lord's Prayer (Pater Noster), followed by 10 Hail Marys (Ave Maria) reflecting on the scriptural mystery, and the Glory Be." :es "Cada misterio comienza con el Padre Nuestro, seguido de 10 Avemarías y el Gloria.")
    (:start 0.50 :end 0.75 :en "The 4 Cycles of Mysteries: Joyful (Incarnation), Luminous (Public Ministry), Sorrowful (Passion), and Glorious (Resurrection & Eternal Life)." :es "Los 4 ciclos de misterios: Gozosos (Encarnación), Luminosos (Ministerio), Dolorosos (Pasión) y Gloriosos (Resurrección).")
    (:start 0.75 :end 1.00 :en "The Rosary beads act as a physical tactile contemplative anchor: holding the beads frees the mind to meditate on the Gospel." :es "Las cuentas del rosario sirven de ancla táctil contemplativa: sostenerlas libera la mente para meditar en el Evangelio.")
  ))
  (:keyframes (
    (:t 0.00 :title "1. The Apostles' Creed & Crucifix" :rule "Begins at the Crucifix: Credo in Deum Patrem omnipotentem.")
    (:t 0.25 :title "2. The Our Father (Pater Noster)" :rule "Pater noster, qui es in caelis, sanctificetur nomen tuum.")
    (:t 0.50 :title "3. The 10 Hail Marys (Ave Maria)" :rule "Ave Maria, gratia plena, Dominus tecum. Benedicta tu in mulieribus.")
    (:t 0.75 :title "4. The Glory Be & Fatima Prayer" :rule "Gloria Patri, et Filio, et Spiritui Sancto. Sicut erat in principio.")
  ))
  (:interactive (
    (:checkpoint :t 0.35
      :prompt "Which Pope introduced the Luminous Mysteries (Mysteries of Light) focusing on Christ's public ministry?"
      :options ("Pope Saint John Paul II in 2002 (Rosarium Virginis Mariae)" "Pope Francis in 2015" "Pope Saint John XXIII in 1962" "Pope Leo XIII in 1883")
      :answer 0
      :explanation "In October 2002, Pope St John Paul II published the apostolic letter Rosarium Virginis Mariae, adding the 5 Luminous Mysteries (Baptism in the Jordan, Wedding at Cana, Proclamation of the Kingdom, Transfiguration, Institution of the Eucharist).")
    (:checkpoint :t 0.70
      :prompt "What is the primary spiritual purpose of holding the physical beads while reciting the vocal prayers?"
      :options ("To provide a tactile rhythm that quiets the senses so the heart can meditate on the Gospel mysteries" "To count exactly how many minutes have passed" "Because silent prayer without beads is invalid" "To measure finger dexterity")
      :answer 0
      :explanation "The repetition of vocal prayers combined with the tactile beads provides a calming contemplative rhythm, freeing the intellect and heart to meditate deeply on Christ's life.")
  ))
  (:bindings (
    <!-- 3D Bead Circle (Chaplet Decades) -->
    (:target "#rosary-ring" :type "3d-ring" :r "130" :tilt-x "25" :depth-fog true)
    
    <!-- 3D Pendent Strand & Crucifix -->
    (:target "#crucifix-node" :type "3d-node" :x "0" :y "110" :z "0" :base-r 16 :depth-fog true)
    (:target "#our-father-pendent" :type "3d-node" :x "0" :y "70" :z "5" :base-r 12 :depth-fog true)
    (:target "#centerpiece-medal" :type "3d-node" :x "0" :y "35" :z "10" :base-r 14 :depth-fog true)
    (:target "#pendent-line" :type "3d-line" :x1 "0" :y1 "35" :z1 "10" :x2 "0" :y2 "110" :z2 "0" :depth-fog true)

    <!-- Dynamic Prayer Title & Active Bead Highlight -->
    (:target "#rosary-prayer-status" :attr "textContent" :expr "t < 0.25 ? 'CRUCIFIX: Credo in Deum (Apostles\' Creed)' : (t < 0.5 ? 'LARGE BEAD: Pater Noster (The Lord\'s Prayer)' : (t < 0.75 ? '10 SMALL BEADS: Ave Maria (Contemplating the Mystery)' : 'GLORIA PATRI: Glory be to the Father'))")
    (:target "#active-bead-halo" :attr "cx" :expr "String(Math.cos(t * Math.PI * 4) * 130)")
    (:target "#active-bead-halo" :attr "cy" :expr "String(-20 + Math.sin(t * Math.PI * 4) * 55)")
  ))
)
