(:scene :id "solar-system" :type "Sim" :oak-id "OAK-KS3-SCI-006" :oak-unit "ks3-physics-space-solar-system-gravity" :title "Solar System: Heliocentric Planetary Motion" :stage "KS3 SCIENCE" :duration 14.0
  (:camera :distance 580 :pitch 24 :yaw "((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 2.8) % 360" :fov 60)
  (:vars (
    (:var :name "warpSpeed" :val 1.0 :min 0.2 :max 10.0 :step 0.2 :label "Time Dilation Warp")
    (:var :name "showOrbits" :val true :label "Display Orbital Rings")
    (:var :name "selectedPlanet" :val "none" :label "Selected Celestial Body")
  ))
  (:inputs (
    (:slider :var "warpSpeed" :label "Orbital Speed Multiplier" :min 0.2 :max 10.0 :step 0.2)
    (:switch :var "showOrbits" :label "Orbital Paths")
  ))
  (:computed (
    (:name "earthDays" :expr "Math.round((vars.warpSpeed || 1) * 365)")
    (:name "solarClk" :expr "vars._solarClock !== undefined ? vars._solarClock : t * 14")
    (:name "planetIdx" :expr "['sun','mercury','venus','earth','moon','mars','jupiter','saturn','uranus','neptune'].indexOf(vars.selectedPlanet || 'none')")
    (:name "cardIdx" :expr "Math.max(0, vars.planetIdx)")
    (:name "cardTitle" :expr "['☀️ THE SUN','☿ MERCURY','♀ VENUS','🌍 EARTH','🌕 THE MOON (LUNA)','♂ MARS','♃ JUPITER','🪐 SATURN','♅ URANUS','♆ NEPTUNE'][vars.cardIdx]")
    (:name "cardType" :expr "['YELLOW DWARF STAR (G2V)','ROCKY TERRESTRIAL WORLD','GREENHOUSE HELLSCAPE','OCEANIC LIVING OASIS','NATURAL ROCKY SATELLITE','RUST RED DESERT WORLD','KING OF GAS GIANTS','GOLDEN RINGED GAS GIANT','SIDEWAYS ICE GIANT','SUPERSONIC ICE GIANT'][vars.cardIdx]")
    (:name "cardColor" :expr "['#f59e0b','#cbd5e1','#fde047','#38bdf8','#f1f5f9','#ef4444','#fb923c','#eab308','#06b6d4','#3b82f6'][vars.cardIdx]")
    (:name "valDiameter" :expr "['1,392,700 km (109×)','4,879 km (0.38×)','12,104 km (0.95×)','12,742 km (1.0× Baseline)','3,474 km (0.27×)','6,779 km (0.53×)','139,820 km (11.0×)','120,536 km (9.5×)','50,724 km (4.0×)','49,244 km (3.9×)'][vars.cardIdx]")
    (:name "barDiameter" :expr "[246,35,70,75,25,45,235,200,130,125][vars.cardIdx]")
    (:name "valMass" :expr "['333,000 Earths','0.055 Earths','0.815 Earths','1.00 Earth (5.97×10²⁴ kg)','0.012 Earths','0.107 Earths','317.8 Earths (Monster)','95.2 Earths','14.5 Earths','17.1 Earths'][vars.cardIdx]")
    (:name "barMass" :expr "[246,20,65,75,15,30,246,180,110,125][vars.cardIdx]")
    (:name "valDistance" :expr "['0.00 AU (Center)','0.39 AU (57.9M km)','0.72 AU (108.2M km)','1.00 AU (149.6M km)','384,400 km from Earth','1.52 AU (227.9M km)','5.20 AU (778.5M km)','9.54 AU (1.43B km)','19.2 AU (2.87B km)','30.1 AU (4.50B km)'][vars.cardIdx]")
    (:name "barDistance" :expr "[10,30,55,75,15,95,140,175,215,246][vars.cardIdx]")
    (:name "valDay" :expr "['27 Days (Differential)','59 Earth Days','243 Days (Retrograde)','23h 56m 04s','27.3 Days (Locked)','24h 37m (Earth-like)','9h 55m (Fastest Spin!)','10h 33m (Super Fast)','17h 14m (Retrograde)','16h 06m'][vars.cardIdx]")
    (:name "barDay" :expr "[70,130,240,45,80,48,30,35,55,50][vars.cardIdx]")
    (:name "valYear" :expr "['230 Million Yrs (Orbit)','88 Days (Fastest!)','225 Earth Days','365.25 Earth Days','27.3 Days around Earth','687 Earth Days (1.88 yrs)','11.86 Earth Years','29.45 Earth Years','84.0 Earth Years','164.8 Earth Years'][vars.cardIdx]")
    (:name "barYear" :expr "[246,35,60,80,20,110,160,195,220,246][vars.cardIdx]")
    (:name "valMoons" :expr "['8 Planets + 5 Dwarfs','0 Moons','0 Moons','1 Moon (Luna)','0 (Orbits Earth)','2 Moons (Phobos, Deimos)','95 Moons (Europa, Io)','146 Moons (Record!)','28 Moons','16 Moons (Triton)'][vars.cardIdx]")
    (:name "barMoons" :expr "[246,10,10,25,10,35,210,246,85,65][vars.cardIdx]")
    (:name "fact1" :expr "['Contains 99.86% of all mass in the Solar System!','Closest world to Sun with extreme temperature swings:','Hottest planet in the Solar System (+465°C)!','The only known haven for living biology in the cosmos!','Tidally locked: identical face always points to Earth!','Host to Olympus Mons: 22 km volcano (nearly 3× Everest)!','Great Red Spot is an anticyclone storm raging >350 yrs!','Density is less than water: Saturn would float in a bathtub!','Tilted 98° on its side: rolls like a cosmic bowling ball!','Supersonic storm winds roar over 2,100 km/h (Mach 1.7)!'][vars.cardIdx]")
    (:name "fact2" :expr "['Nuclear fusion burns 600M tons of H every second.','+430°C by day, plunging to -180°C in nighttime shadow!','Runaway greenhouse atmosphere crushes with 92 atm.','Oceans cover 71% of surface; nitrogen-oxygen shield.','Lunar gravitational pull stabilizes Earth axial tilt.','Iron oxide (rust) dust blankets entire planetary crust.','Possesses strongest planetary magnetic field in system.','Majestic rings span 282,000 km wide but are only ~10m thin.','Coldest planetary atmosphere recorded at -224°C.','Took 165 Earth years to complete its first orbit since discovery.'][vars.cardIdx]")
    (:name "fact3" :expr "['Surface temp: 5,500°C • Core temp: 15,000,000°C.','Giant iron core makes up 85% of its planetary radius.','Spins backwards: Sun rises in West and sets in East!','Geodynamo molten iron core creates magnetosphere.','Footprints left by astronauts will last millions of years.','Features Valles Marineris canyon spanning 4,000 km.','Subsurface ocean on moon Europa has more water than Earth.','Moon Titan has thick atmosphere and liquid methane lakes.','Methane in upper atmosphere absorbs red light, glowing cyan.','Moon Triton orbits retrograde with nitrogen ice geysers.'][vars.cardIdx]")
    (:name "cardPower" :expr "['⭐ COSMIC POWER: 100 / 100','⭐ COSMIC POWER: 68 / 100','⭐ COSMIC POWER: 79 / 100','⭐ COSMIC POWER: 94 / 100','⭐ COSMIC POWER: 72 / 100','⭐ COSMIC POWER: 84 / 100','⭐ COSMIC POWER: 98 / 100','⭐ COSMIC POWER: 96 / 100','⭐ COSMIC POWER: 88 / 100','⭐ COSMIC POWER: 92 / 100'][vars.cardIdx]")
    (:name "hudBanner" :expr "vars.planetIdx >= 0 ? ('🪐 Inspecting: ' + ['THE SUN','MERCURY','VENUS','EARTH','THE MOON','MARS','JUPITER','SATURN','URANUS','NEPTUNE'][vars.cardIdx] + ' • Warp: ' + (Math.round((vars.warpSpeed || 1) * 10) / 10) + '×') : ('🪐 Tap any planet to explore its Cosmic Fact Card! • ' + (Math.round((vars.warpSpeed || 1) * 10) / 10) + '×')")
    (:name "reticleX" :expr "vars.planetIdx <= 0 ? 0 : (vars.planetIdx === 4 ? ((Math.cos(vars.solarClk * 0.1286 * Math.PI * 2) * 118) + Math.cos(vars.solarClk * 1.2857 * Math.PI * 2) * 16) : Math.cos(vars.solarClk * [0, 0.3714, 0.2000, 0.1286, 0.1286, 0.0893, 0.0643, 0.0486, 0.0371, 0.0300][vars.cardIdx] * Math.PI * 2) * [0, 50, 80, 118, 118, 155, 210, 265, 320, 370][vars.cardIdx])")
    (:name "reticleY" :expr "vars.planetIdx <= 0 ? 0 : (vars.planetIdx === 4 ? ((Math.sin(vars.solarClk * 0.1286 * Math.PI * 2 * 0.10) * 14) + Math.sin(vars.solarClk * 1.2857 * Math.PI * 2) * 5) : Math.sin(vars.solarClk * [0, 0.3714, 0.2000, 0.1286, 0.1286, 0.0893, 0.0643, 0.0486, 0.0371, 0.0300][vars.cardIdx] * Math.PI * 2 * [0, 0.12, 0.15, 0.10, 0.10, 0.18, 0.08, 0.06, 0.05, 0.04][vars.cardIdx]) * [0, 8, 12, 14, 14, 16, 18, 20, 22, 24][vars.cardIdx])")
    (:name "reticleZ" :expr "vars.planetIdx <= 0 ? 0 : (vars.planetIdx === 4 ? ((Math.sin(vars.solarClk * 0.1286 * Math.PI * 2) * 118) + Math.sin(vars.solarClk * 1.2857 * Math.PI * 2) * 16) : Math.sin(vars.solarClk * [0, 0.3714, 0.2000, 0.1286, 0.1286, 0.0893, 0.0643, 0.0486, 0.0371, 0.0300][vars.cardIdx] * Math.PI * 2) * [0, 50, 80, 118, 118, 155, 210, 265, 320, 370][vars.cardIdx])")
  ))
  (:gestures (
    (:trackball :target "#stage-svg")
    (:clickable :target "[data-planet]" :attr "data-planet" :set-var "selectedPlanet" :val-expr "vars.selectedPlanet === _attr ? 'none' : _attr" :tone-expr "([110,784,659.25,523.25,587.33,440,146.83,220,329.63,246.94][['sun','mercury','venus','earth','moon','mars','jupiter','saturn','uranus','neptune'].indexOf(vars.selectedPlanet)] || 330)")
    (:clickable :target "[data-action='tt-prev']" :set-var "selectedPlanet" :val-expr "['sun','mercury','venus','earth','moon','mars','jupiter','saturn','uranus','neptune'][(['sun','mercury','venus','earth','moon','mars','jupiter','saturn','uranus','neptune'].indexOf(vars.selectedPlanet || 'earth') + 9) % 10]" :tone-expr "([110,784,659.25,523.25,587.33,440,146.83,220,329.63,246.94][['sun','mercury','venus','earth','moon','mars','jupiter','saturn','uranus','neptune'].indexOf(vars.selectedPlanet)] || 523.25)")
    (:clickable :target "[data-action='tt-next']" :set-var "selectedPlanet" :val-expr "['sun','mercury','venus','earth','moon','mars','jupiter','saturn','uranus','neptune'][(['sun','mercury','venus','earth','moon','mars','jupiter','saturn','uranus','neptune'].indexOf(vars.selectedPlanet || 'earth') + 1) % 10]" :tone-expr "([110,784,659.25,523.25,587.33,440,146.83,220,329.63,246.94][['sun','mercury','venus','earth','moon','mars','jupiter','saturn','uranus','neptune'].indexOf(vars.selectedPlanet)] || 523.25)")
    (:clickable :target "[data-action='tt-close']" :set-var "selectedPlanet" :val "none" :tone 330)
    (:clickable :target "[data-action='solar-warp-1']" :set-var "warpSpeed" :val 1.0 :tone 440)
    (:clickable :target "[data-action='solar-warp-2']" :set-var "warpSpeed" :val 2.0 :tone 523)
    (:clickable :target "[data-action='solar-warp-5']" :set-var "warpSpeed" :val 5.0 :tone 659)
    (:clickable :target "[data-action='solar-warp-10']" :set-var "warpSpeed" :val 10.0 :tone 784)
    (:key :code "Escape" :if "vars.selectedPlanet && vars.selectedPlanet !== 'none'" :set-var "selectedPlanet" :val "none" :tone 330)
    (:key :code "ArrowUp" :step-var "warpSpeed" :delta 0.4 :min 0.2 :max 10.0)
    (:key :code "ArrowDown" :step-var "warpSpeed" :delta -0.4 :min 0.2 :max 10.0)
    (:key :code "KeyO" :toggle-var "showOrbits")
  ))
  (:subtitles (
    (:start 0.00 :end 0.30 :en "At the focal center sits our Sun. Click any planet or use the Cosmic Ribbon to reveal its Cosmic Fact Card!" :es "En el centro se encuentra el Sol. ¡Haz clic en cualquier planeta o en la barra cósmica para ver su tarjeta cósmica de datos!")
    (:start 0.30 :end 0.65 :en "Kepler's Harmonic Law: Planets closer to the Sun experience higher orbital velocities. Inner rocky worlds complete rapid orbits." :es "Ley armónica de Kepler: Los planetas cercanos al Sol experimentan mayores velocidades orbitales.")
    (:start 0.65 :end 1.00 :en "Outer gas and ice giants Jupiter, Saturn, Uranus, and Neptune sweep through vast cosmic orbits. Tap any world to inspect its cosmic superpowers!" :es "Los gigantes gaseosos y de hielo Júpiter, Saturno, Urano y Neptuno recorren amplias órbitas. ¡Toca cualquier mundo para ver sus superpoderes!")
  ))
  (:keyframes (
    (:t 0.00 :title "Heliocentric Center" :rule "The Sun contains 99.86% of the solar system's mass, generating gravitational curvature.")
    (:t 0.30 :title "Inner Terrestrial Worlds" :rule "Mercury, Venus, Earth, and Mars orbit rapidly due to intense gravitational acceleration.")
    (:t 0.65 :title "The Gas Giants" :rule "Jupiter and ringed Saturn rule the middle solar system with dozens of orbiting moons.")
    (:t 1.00 :title "Outer Ice Giants" :rule "Uranus and supersonic Neptune complete the 8-planet planetary harmony.")
  ))
  (:interactive (
    (:checkpoint :t 0.40
      :prompt "According to Kepler's Third Law (T² ∝ r³), which planet takes the least time to complete one full revolution around the Sun?"
      :options ("Mercury (closest orbital radius, 88 days)" "Earth (365 days)" "Jupiter (12 Earth years)" "Neptune (165 Earth years)")
      :answer 0
      :explanation "Planets closest to the Sun experience the strongest gravitational pull and have the smallest orbital circumference, resulting in the shortest orbital period (Mercury orbits in just 88 Earth days).")
    (:checkpoint :t 0.80
      :prompt "What keeps the eight planets moving in curved orbits around the Sun instead of flying off in a straight line into deep space?"
      :options ("Centripetal gravitational force exerted by the Sun's 99.86% system mass" "Magnetic attraction from Earth's North Pole" "Solar wind pushing planets inward" "Friction from interplanetary air")
      :answer 0
      :explanation "By Newton's Law of Universal Gravitation, the Sun's immense mass provides the inward centripetal force that continuously bends each planet's tangential inertia into a closed orbit.")
  ))
  (:bindings (
    (:target "#sun-body" :type "3d-node" :x "0" :y "0" :z "0" :base-r 26 :depth-fog false)
    (:target "#sun-corona" :type "3d-node" :x "0" :y "0" :z "0" :base-r 42 :depth-fog false)
    
    (:target "#orbit-mercury" :type "3d-ring" :r "50" :depth-fog true)
    (:target "#orbit-venus" :type "3d-ring" :r "80" :depth-fog true)
    (:target "#orbit-earth" :type "3d-ring" :r "118" :depth-fog true)
    (:target "#orbit-mars" :type "3d-ring" :r "155" :depth-fog true)
    (:target "#orbit-jupiter" :type "3d-ring" :r "210" :depth-fog true)
    (:target "#orbit-saturn" :type "3d-ring" :r "265" :depth-fog true)
    (:target "#orbit-uranus" :type "3d-ring" :r "320" :depth-fog true)
    (:target "#orbit-neptune" :type "3d-ring" :r "370" :depth-fog true)
    (:target "#orbit-mercury" :attr "opacity" :expr "vars.showOrbits === false ? 0.06 : 0.6")
    (:target "#orbit-venus" :attr "opacity" :expr "vars.showOrbits === false ? 0.06 : 0.6")
    (:target "#orbit-earth" :attr "opacity" :expr "vars.showOrbits === false ? 0.06 : 0.55")
    (:target "#orbit-mars" :attr "opacity" :expr "vars.showOrbits === false ? 0.06 : 0.6")
    (:target "#orbit-jupiter" :attr "opacity" :expr "vars.showOrbits === false ? 0.06 : 0.6")
    (:target "#orbit-saturn" :attr "opacity" :expr "vars.showOrbits === false ? 0.06 : 0.6")
    (:target "#orbit-uranus" :attr "opacity" :expr "vars.showOrbits === false ? 0.06 : 0.6")
    (:target "#orbit-neptune" :attr "opacity" :expr "vars.showOrbits === false ? 0.06 : 0.6")

    (:target "#planet-mercury" :type "3d-node"
      :x "Math.cos(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.3714) * Math.PI * 2) * 50"
      :y "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.3714) * Math.PI * 2 * 0.12) * 8"
      :z "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.3714) * Math.PI * 2) * 50"
      :base-r 4.8
      :label "#label-mercury"
    )
    (:target "#planet-venus" :type "3d-node"
      :x "Math.cos(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.2000) * Math.PI * 2) * 80"
      :y "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.2000) * Math.PI * 2 * 0.15) * 12"
      :z "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.2000) * Math.PI * 2) * 80"
      :base-r 7.2
      :label "#label-venus"
    )
    (:target "#planet-earth" :type "3d-node"
      :x "Math.cos(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.1286) * Math.PI * 2) * 118"
      :y "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.1286) * Math.PI * 2 * 0.10) * 14"
      :z "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.1286) * Math.PI * 2) * 118"
      :base-r 8.2
      :label "#label-earth"
    )
    (:target "#moon-earth" :type "3d-node"
      :x "(Math.cos(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.1286) * Math.PI * 2) * 118) + Math.cos(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 1.2857) * Math.PI * 2) * 16"
      :y "(Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.1286) * Math.PI * 2 * 0.10) * 14) + Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 1.2857) * Math.PI * 2) * 5"
      :z "(Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.1286) * Math.PI * 2) * 118) + Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 1.2857) * Math.PI * 2) * 16"
      :base-r 2.6
    )
    (:target "#planet-mars" :type "3d-node"
      :x "Math.cos(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0893) * Math.PI * 2) * 155"
      :y "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0893) * Math.PI * 2 * 0.18) * 16"
      :z "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0893) * Math.PI * 2) * 155"
      :base-r 5.8
      :label "#label-mars"
    )
    (:target "#planet-jupiter" :type "3d-node"
      :x "Math.cos(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0643) * Math.PI * 2) * 210"
      :y "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0643) * Math.PI * 2 * 0.08) * 18"
      :z "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0643) * Math.PI * 2) * 210"
      :base-r 13.5
      :label "#label-jupiter"
    )
    (:target "#planet-saturn" :type "3d-node"
      :x "Math.cos(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0486) * Math.PI * 2) * 265"
      :y "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0486) * Math.PI * 2 * 0.06) * 20"
      :z "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0486) * Math.PI * 2) * 265"
      :base-r 10.5
      :label "#label-saturn"
    )
    (:target "#saturn-ring" :type "3d-ring"
      :cx "Math.cos(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0486) * Math.PI * 2) * 265"
      :cy "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0486) * Math.PI * 2 * 0.06) * 20"
      :cz "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0486) * Math.PI * 2) * 265"
      :r "19"
      :tilt-x "25"
      :tilt-z "15"
      :depth-fog true
    )
    (:target "#planet-uranus" :type "3d-node"
      :x "Math.cos(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0371) * Math.PI * 2) * 320"
      :y "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0371) * Math.PI * 2 * 0.05) * 22"
      :z "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0371) * Math.PI * 2) * 320"
      :base-r 8.5
      :label "#label-uranus"
    )
    (:target "#uranus-ring" :type "3d-ring"
      :cx "Math.cos(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0371) * Math.PI * 2) * 320"
      :cy "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0371) * Math.PI * 2 * 0.05) * 22"
      :cz "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0371) * Math.PI * 2) * 320"
      :r "14.5"
      :tilt-x "85"
      :tilt-z "10"
      :depth-fog true
    )
    (:target "#planet-neptune" :type "3d-node"
      :x "Math.cos(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0300) * Math.PI * 2) * 370"
      :y "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0300) * Math.PI * 2 * 0.04) * 24"
      :z "Math.sin(((vars._solarClock !== undefined ? vars._solarClock : t * 14) * 0.0300) * Math.PI * 2) * 370"
      :base-r 8.0
      :label "#label-neptune"
    )

    (:target "#solar-hud-banner" :attr "textContent" :expr "computed.hudBanner")

    (:target "#planet-target-reticle" :attr "display" :expr "vars.planetIdx >= 0 ? 'inline' : 'none'")
    (:target "#planet-target-reticle" :type "3d-node" :x "vars.reticleX" :y "vars.reticleY" :z "vars.reticleZ" :base-r 22 :depth-fog false)

    (:target "#solar-top-trumps-card" :attr "display" :expr "vars.planetIdx >= 0 ? 'inline' : 'none'")
    (:target "#tt-planet-title" :attr "textContent" :expr "computed.cardTitle")
    (:target "#tt-planet-class" :attr "textContent" :expr "computed.cardType")
    (:target "#tt-class-pill" :attr "stroke" :expr "computed.cardColor")
    (:target "#tt-val-diameter" :attr "textContent" :expr "computed.valDiameter")
    (:target "#tt-bar-diameter" :attr "width" :expr "computed.barDiameter")
    (:target "#tt-bar-diameter" :attr "fill" :expr "computed.cardColor")
    (:target "#tt-val-mass" :attr "textContent" :expr "computed.valMass")
    (:target "#tt-bar-mass" :attr "width" :expr "computed.barMass")
    (:target "#tt-bar-mass" :attr "fill" :expr "computed.cardColor")
    (:target "#tt-val-distance" :attr "textContent" :expr "computed.valDistance")
    (:target "#tt-bar-distance" :attr "width" :expr "computed.barDistance")
    (:target "#tt-bar-distance" :attr "fill" :expr "computed.cardColor")
    (:target "#tt-val-day" :attr "textContent" :expr "computed.valDay")
    (:target "#tt-bar-day" :attr "width" :expr "computed.barDay")
    (:target "#tt-bar-day" :attr "fill" :expr "computed.cardColor")
    (:target "#tt-val-year" :attr "textContent" :expr "computed.valYear")
    (:target "#tt-bar-year" :attr "width" :expr "computed.barYear")
    (:target "#tt-bar-year" :attr "fill" :expr "computed.cardColor")
    (:target "#tt-val-moons" :attr "textContent" :expr "computed.valMoons")
    (:target "#tt-bar-moons" :attr "width" :expr "computed.barMoons")
    (:target "#tt-bar-moons" :attr "fill" :expr "computed.cardColor")
    (:target "#tt-fact-line1" :attr "textContent" :expr "computed.fact1")
    (:target "#tt-fact-line2" :attr "textContent" :expr "computed.fact2")
    (:target "#tt-fact-line3" :attr "textContent" :expr "computed.fact3")
