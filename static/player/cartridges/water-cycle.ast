(:scene :id "water-cycle" :type "Slide" :oak-id "OAK-KS2-GEO-001" :title "Water Cycle: Continuous Earth Cycle" :stage "KS2 GEOGRAPHY" :duration 10.0
  (:vars (
    (:var :name "oceanTemp" :val 24 :min 10 :max 40 :step 1 :unit "°C" :label "Sea Surface Temp")
    (:var :name "cloudCover" :val 70 :min 10 :max 100 :step 5 :unit "%" :label "Cloud Density")
  ))
  (:inputs (
    (:slider :var "oceanTemp" :label "Ocean Heat Index" :min 10 :max 40 :step 1)
    (:slider :var "cloudCover" :label "Cloud Condensation" :min 10 :max 100 :step 5)
  ))
  (:computed (
    (:name "rainfallRate" :expr "(vars.oceanTemp * 0.15 * (vars.cloudCover / 50)).toFixed(1)")
  ))
  (:gestures (
    (:draggable :target "#wc-vapor-0" :axis "y" :min 140 :max 350)
  ))
  (:subtitles (
    (:start 0.00 :end 0.35 :en "Solar energy heats water surfaces, causing evaporation into rising gas molecules." :es "La energía solar calienta el agua provocando la evaporación en moléculas de gas.")
    (:start 0.35 :end 0.70 :en "As vapor climbs into cold upper air, it condenses into visible fluffy clouds." :es "Al subir al aire frío, el vapor se condensa en nubes esponjosas.")
    (:start 0.70 :end 1.00 :en "When droplets become too heavy, gravity pulls them down as precipitation." :es "Cuando las gotas son pesadas, la gravedad las hace caer en precipitación.")
  ))
  (:keyframes (
    (:t 0.00 :title "Solar Heating & Evaporation" :rule "Sun warms ocean water, converting liquid into invisible water vapor.")
    (:t 0.35 :title "Atmospheric Condensation" :rule "Rising vapor cools and condenses into cloud water droplets.")
    (:t 0.70 :title "Precipitation" :rule "Heavy clouds release moisture as rain, sleet, or snow.")
    (:t 1.00 :title "Runoff & Collection" :rule "Rivers carry precipitation back to oceans, completing the closed cycle.")
  ))
  (:interactive (
    (:checkpoint :t 0.65
      :prompt "What state change occurs when rising invisible water vapor cools in the upper atmosphere to form clouds?"
      :options ("Condensation (gas to liquid droplets)" "Evaporation" "Sublimation" "Freezing directly to rock")
      :answer 0
      :explanation "Condensation occurs as warm water vapor rises, expands, and cools, changing from a gas into tiny suspended liquid droplets that form clouds.")
  ))
  (:bindings (
    (:target "#wc-vapor-0" :attr "cy" :expr "330 - ((t * 2 + 0/6) % 1) * 160")
    (:target "#wc-vapor-1" :attr "cy" :expr "330 - ((t * 2 + 1/6) % 1) * 160")
    (:target "#wc-vapor-2" :attr "cy" :expr "330 - ((t * 2 + 2/6) % 1) * 160")
    (:target "#wc-vapor-3" :attr "cy" :expr "330 - ((t * 2 + 3/6) % 1) * 160")
    (:target "#wc-vapor-4" :attr "cy" :expr "330 - ((t * 2 + 4/6) % 1) * 160")
    (:target "#wc-vapor-5" :attr "cy" :expr "330 - ((t * 2 + 5/6) % 1) * 160")
    (:target "#wc-rain-0" :attr "opacity" :expr "t > 0.45 ? 1 : 0")
    (:target "#wc-rain-0" :attr "y1" :expr "190 + ((t * 3 + 0/8) % 1) * 130")
    (:target "#wc-rain-0" :attr "y2" :expr "198 + ((t * 3 + 0/8) % 1) * 130")
    (:target "#wc-rain-1" :attr "opacity" :expr "t > 0.45 ? 1 : 0")
    (:target "#wc-rain-1" :attr "y1" :expr "190 + ((t * 3 + 1/8) % 1) * 130")
    (:target "#wc-rain-1" :attr "y2" :expr "198 + ((t * 3 + 1/8) % 1) * 130")
    (:target "#wc-rain-2" :attr "opacity" :expr "t > 0.45 ? 1 : 0")
    (:target "#wc-rain-2" :attr "y1" :expr "190 + ((t * 3 + 2/8) % 1) * 130")
    (:target "#wc-rain-2" :attr "y2" :expr "198 + ((t * 3 + 2/8) % 1) * 130")
    (:target "#wc-rain-3" :attr "opacity" :expr "t > 0.45 ? 1 : 0")
    (:target "#wc-rain-3" :attr "y1" :expr "190 + ((t * 3 + 3/8) % 1) * 130")
    (:target "#wc-rain-3" :attr "y2" :expr "198 + ((t * 3 + 3/8) % 1) * 130")
    (:target "#wc-rain-4" :attr "opacity" :expr "t > 0.45 ? 1 : 0")
    (:target "#wc-rain-4" :attr "y1" :expr "190 + ((t * 3 + 4/8) % 1) * 130")
    (:target "#wc-rain-4" :attr "y2" :expr "198 + ((t * 3 + 4/8) % 1) * 130")
    (:target "#wc-rain-5" :attr "opacity" :expr "t > 0.45 ? 1 : 0")
    (:target "#wc-rain-5" :attr "y1" :expr "190 + ((t * 3 + 5/8) % 1) * 130")
    (:target "#wc-rain-5" :attr "y2" :expr "198 + ((t * 3 + 5/8) % 1) * 130")
    (:target "#wc-rain-6" :attr "opacity" :expr "t > 0.45 ? 1 : 0")
    (:target "#wc-rain-6" :attr "y1" :expr "190 + ((t * 3 + 6/8) % 1) * 130")
    (:target "#wc-rain-6" :attr "y2" :expr "198 + ((t * 3 + 6/8) % 1) * 130")
    (:target "#wc-rain-7" :attr "opacity" :expr "t > 0.45 ? 1 : 0")
    (:target "#wc-rain-7" :attr "y1" :expr "190 + ((t * 3 + 7/8) % 1) * 130")
    (:target "#wc-rain-7" :attr "y2" :expr "198 + ((t * 3 + 7/8) % 1) * 130")
  ))
)
