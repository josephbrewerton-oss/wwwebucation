# ast-sexpr.gbnf
# GGML BNF Grammar for Constraining Local LLMs to Token-Efficient S-Expression ASTs with 3D Node Subsystem
# Produces valid Lisp-like (scene ...) structures parsed directly by AST Vector Player.

root ::= "(scene" ws ":id" ws string ws (":type" ws ("\"Sim\"" | "\"Slide\"" | "\"App\"" | "\"Film\"") ws)? (":video" ws string ws)? (":video-fit" ws ("\"contain\"" | "\"cover\"" | "\"fill\"") ws)? ":stage" ws string ws ":duration" ws number ws "(:title" ws string ")" ws (camera ws)? ("(:easing" ws easing ")" ws)? ("(:static" ws "(" ws (staticItem ws)* ")" ws ")")? ws ("(:actors" ws "(" ws (actorItem ws)* ")" ws ")")? ws ("(:vars" ws "(" ws (variable ws)* ")" ws ")")? ws ("(:inputs" ws "(" ws (input ws)* ")" ws ")")? ws ("(:computed" ws "(" ws (computed ws)* ")" ws ")")? ws ("(:state-machines" ws "(" ws (stateMachine ws)* ")" ws ")")? ws ("(:emitters" ws "(" ws (emitter ws)* ")" ws ")")? ws ("(:bind-inputs" ws "(" ws (bindInput ws)* ")" ws ")")? ws "(:keyframes" ws "(" ws (keyframe ws)* ")" ws ")" ws ("(:subtitles" ws "(" ws (subtitle ws)* ")" ws ")")? ws ("(:bindings" ws "(" ws (binding ws)* ")" ws ")")? ws ("(:interactive" ws "(" ws (checkpoint ws)* ")" ws ")")? ws ("(:gestures" ws "(" ws (gesture ws)* ")" ws ")")? ws ")"

staticItem ::= "(:element" ws ":target" ws string (ws ":layer" ws string)? (ws ":cache" ws boolean)? ")"

actorItem ::= "(:actor" ws ":target" ws string (ws ":kinematic" ws boolean)? (ws ":will-change" ws boolean)? ")"

camera ::= "(:camera" ws ":distance" ws number ws ":pitch" ws number ws ":yaw" ws (string | number) ws ":fov" ws number ")"

variable ::= "(:var" ws ":name" ws string ws ":val" ws (number | string | boolean) (ws ":min" ws number)? (ws ":max" ws number)? (ws ":step" ws number)? (ws ":unit" ws string)? (ws ":label" ws string)? ")"

input ::= "(:" ("slider" | "switch" | "button" | "number") ws ":var" ws string ws ":label" ws string (ws ":min" ws number)? (ws ":max" ws number)? (ws ":step" ws number)? ")"

bindInput ::= "(:bind-input" ws ":target" ws string ws ":var" ws string ws ":min" ws number ws ":max" ws number (ws ":axis" ws ("\"x\"" | "\"y\"" | "\"rotary\""))? (ws ":track-min" ws number)? (ws ":track-max" ws number)? ")"

computed ::= "(:name" ws string ws ":expr" ws string ")"

stateMachine ::= "(:state-machine" ws ":id" ws string ws ":initial" ws string (ws ":dwell" ws number)? ws "(:states" ws "(" ws (stateDef ws)+ ")" ws ")" ws "(:transitions" ws "(" ws (transitionDef ws)* ")" ws ")" ws ")"

stateDef ::= "(:state" ws ":name" ws string ws (stateAttr | emitterSet)* ")"

stateAttr ::= "(:attr" ws ":target" ws string ws ":attr" ws string ws ":val" ws (number | string) ")"

emitterSet ::= "(:emitter-set" ws ":target" ws string (ws ":speed" ws number)? (ws ":count" ws integer)? (ws ":gravity" ws number)? (ws ":fill" ws string)? (ws ":bounds-element" ws string)? ")"

transitionDef ::= "(:transition" ws ":from" ws string ws ":to" ws string ws ":trigger" ws string (ws ":duration" ws number)? (ws ":dwell" ws number)? (ws ":easing" ws easing)? ")"

emitter ::= "(:emitter" ws ":id" ws string (ws ":count" ws integer)? (ws ":speed" ws number)? (ws ":radius" ws number)? (ws ":fill" ws string)? (ws ":gravity" ws number)? (ws ":wrap" ws ("\"bounce\"" | "\"wrap\""))? (ws ":bounds" ws number ws number ws number ws number)? (ws ":bounds-element" ws string)? ")"

keyframe ::= "(:t" ws fraction ws ":title" ws string ws ":rule" ws string ")"

subtitle ::= "(:start" ws fraction ws ":end" ws fraction ws ":en" ws string (ws ":es" ws string)? (ws ":la" ws string)? ")"

checkpoint ::= "(:checkpoint" ws ":t" ws fraction ws ":prompt" ws string ws ":options" ws "(" ws (string ws)* ")" ws ":answer" ws integer ws ":explanation" ws string ")"

gesture ::= "(:draggable" ws ":target" ws string ws ":axis" ws ("\"x\"" | "\"y\"" | "\"xy\"" | "\"curve\"") ws ":min" ws number ws ":max" ws number ")"

binding ::= node3d | line3d | ring3d | attr2d

node3d ::= "(:target" ws string ws ":type" ws "\"3d-node\"" ws ":x" ws string ws ":y" ws string ws ":z" ws string (ws ":base-r" ws number)? (ws ":label" ws string)? (ws ":depth-fog" ws boolean)? ")"

line3d ::= "(:target" ws string ws ":type" ws "\"3d-line\"" ws ":x1" ws string ws ":y1" ws string ws ":z1" ws string ws ":x2" ws string ws ":y2" ws string ws ":z2" ws string (ws ":cap1" ws string)? (ws ":cap2" ws string)? (ws ":base-r" ws number)? ")"

ring3d ::= "(:target" ws string ws ":type" ws "\"3d-ring\"" ws ":r" ws string (ws ":cx" ws string)? (ws ":cy" ws string)? (ws ":cz" ws string)? (ws ":tilt-x" ws string)? (ws ":tilt-z" ws string)? (ws ":depth-fog" ws boolean)? ")"

attr2d ::= "(:target" ws string ws ":attr" ws string ws ":expr" ws string ")"

boolean ::= "true" | "false"
easing ::= "\"linear\"" | "\"easeInQuad\"" | "\"easeOutQuad\"" | "\"easeInOutQuad\"" | "\"cubic\""

fraction ::= "0." [0-9] [0-9]? | "1.0" | "0.0" | "1" | "0"
number ::= [0-9]+ ("." [0-9]+)?

string ::= "\"" ([^"\\] | "\\" (["\\/bfnrt] | "u" [a-fA-F0-9] [a-fA-F0-9] [a-fA-F0-9] [a-fA-F0-9]))* "\""
ws ::= [ \t\n\r]*
