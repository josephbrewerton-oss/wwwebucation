content = """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%" style="background:#090d16; font-family:system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  <!-- ============================================================= -->
  <!-- 1. EMBEDDED AST DECLARATIVE S-EXPRESSION SPECIFICATION        -->
  <!-- ============================================================= -->
  <metadata type="application/ast-sexpr">
    <![CDATA[
    (:scene
      :id "lumina-architecture-manifesto"
      :type "Slide"
      :title "Lumina: Sovereign Architectural Manifesto"
      :stage "FOUNDATIONAL SYSTEM ARCHITECTURE"
      :duration 1.0

      ;; -----------------------------------------------------------
      ;; State Registers
      ;; -----------------------------------------------------------
      (:vars (
        (:var :name "page" :val 0 :min 0 :max 3 :step 1 :label "Chapter Index")
        (:var :name "wasmByteOffset" :val 128 :min 0 :max 448 :step 1 :label "Linear Memory Ring (KB)")
      ))

      ;; -----------------------------------------------------------
      ;; Hardware Control Surfaces
      ;; -----------------------------------------------------------
      (:inputs (
        (:slider :var "page" :label "Turn Chapter" :min 0 :max 3 :step 1)
        (:slider :var "wasmByteOffset" :label "Inspect WASM Ring Buffer" :min 0 :max 448 :step 1)
      ))

      ;; -----------------------------------------------------------
      ;; Mathematical Computations
      ;; -----------------------------------------------------------
      (:computed (
        (:name "spineTranslationX" :expr "-(vars.page || 0) * 800")
        (:name "memoryPointerAngle" :expr "((vars.wasmByteOffset || 0) / 448) * 360")
        (:name "rectWidth" :expr "50 + ((vars.wasmByteOffset || 0) / 448) * 130")
      ))

      ;; -----------------------------------------------------------
      ;; Pedagogical Stage Checkpoints / Table of Contents
      ;; -----------------------------------------------------------
      (:keyframes (
        (:t 0.00 :title "I. The Anti-Enclosure Axiom" :rule "Zero Telemetry, Zero Cloud Compute, Universal Destination of Goods")
        (:t 0.33 :title "II. WASM 7-Page Linear Memory" :rule "Fixed 448 KB Virtual ISA. Zero Allocation in Hot Animation Loops")
        (:t 0.66 :title "III. The AST Tuple Pipeline" :rule "Declarative S-Expressions Compiling Directly into Pure SVG Nodes")
        (:t 1.00 :title "IV. The Sovereign Offline Covenant" :rule "Air-Gapped P2P Mesh, Static Integrity, AGPLv3 Dual Licensing")
      ))

      ;; -----------------------------------------------------------
      ;; 60 FPS Reactive Vector Bindings
      ;; -----------------------------------------------------------
      (:bindings (
        (:target "#document-spine" :attr "transform" :expr "'translate(' + computed.spineTranslationX + ', 0)'")
        (:target "#chapter-indicator" :attr "textContent" :expr "'CHAPTER ' + ((vars.page || 0) + 1) + ' OF 4'")
        (:target "#wasm-dial-pointer" :attr "transform" :expr "'rotate(' + computed.memoryPointerAngle + ' 1200 250)'")
        (:target "#wasm-addr-readout" :attr "textContent" :expr "'0x' + (Math.round((vars.wasmByteOffset || 0) * 1024)).toString(16).toUpperCase().padStart(6, '0') + ' / 0x070000'")
        (:target "#live-vector-rect" :attr "width" :expr "computed.rectWidth")
        (:target "#live-ast-token-readout" :attr "textContent" :expr "'(:target \\\"#live-rect\\\" :width ' + Math.round(computed.rectWidth) + ')'")
      ))

      ;; -----------------------------------------------------------
      ;; Gestural Interaction
      ;; -----------------------------------------------------------
      (:gestures (
        (:draggable :target "#wasm-dial-handle" :axis "x" :min 1050 :max 1350)
      ))
    )
    ]]>
  </metadata>

  <!-- ============================================================= -->
  <!-- 2. DEFINITIONS, GRADIENTS, AND PATTERNS                      -->
  <!-- ============================================================= -->
  <defs>
    <linearGradient id="pageCardGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>

    <linearGradient id="cyanAccent" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#38bdf8"/>
      <stop offset="100%" stop-color="#818cf8"/>
    </linearGradient>

    <pattern id="blueprintGrid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#1e293b" stroke-width="0.75"/>
    </pattern>
  </defs>

  <!-- Background Grid -->
  <rect width="800" height="500" fill="url(#blueprintGrid)"/>

  <!-- Static Persistent HUD Header -->
  <g id="hud-header">
    <text x="30" y="38" fill="#38bdf8" font-size="12" font-weight="700" letter-spacing="1.5">LUMINA ARCHITECTURAL DISSERTATION</text>
    <text id="chapter-indicator" x="770" y="38" text-anchor="end" fill="#94a3b8" font-size="11" font-family="monospace">CHAPTER 1 OF 4</text>
    <line x1="30" y1="48" x2="770" y2="48" stroke="#334155" stroke-width="1"/>
  </g>

  <!-- ============================================================= -->
  <!-- 3. HORIZONTAL 4-CHAPTER DOCUMENT SPINE                        -->
  <!-- ============================================================= -->
  <g id="document-spine">

    <!-- CHAPTER 1: THE ANTI-ENCLOSURE AXIOM (0px -> 800px) -->
    <g id="page-1" transform="translate(0, 0)">
      <rect x="40" y="65" width="720" height="400" rx="12" fill="url(#pageCardGrad)" stroke="#334155" stroke-width="1.5"/>

      <text x="70" y="110" fill="#f8fafc" font-size="20" font-weight="700">I. The Anti-Enclosure Axiom</text>
      <text x="70" y="136" fill="#94a3b8" font-size="12">An architectural refusal of surveillance-capitalist, subscription-locked educational technology.</text>

      <g transform="translate(70, 165)">
        <rect x="0" y="0" width="420" height="60" rx="6" fill="#090d16" stroke="#1e293b"/>
        <text x="15" y="24" fill="#38bdf8" font-size="12" font-weight="700" font-family="monospace">01. ZERO NETWORK EGRESS &amp; PRIVACY SOVEREIGNTY</text>
        <text x="15" y="44" fill="#94a3b8" font-size="11">No tracking beacons, cookies, or telemetry. Complete student safeguarding by construction.</text>
      </g>

      <g transform="translate(70, 240)">
        <rect x="0" y="0" width="420" height="60" rx="6" fill="#090d16" stroke="#1e293b"/>
        <text x="15" y="24" fill="#38bdf8" font-size="12" font-weight="700" font-family="monospace">02. MECHANICAL SYMPATHY OVER FRAMEWORK BLOAT</text>
        <text x="15" y="44" fill="#94a3b8" font-size="11">Zero Virtual DOM diffing. 60 FPS vector execution within low-power school hardware budgets.</text>
      </g>

      <g transform="translate(70, 315)">
        <rect x="0" y="0" width="420" height="60" rx="6" fill="#090d16" stroke="#1e293b"/>
        <text x="15" y="24" fill="#38bdf8" font-size="12" font-weight="700" font-family="monospace">03. HUMANITARIAN COMMONS (AGPLv3 + OGL v3.0)</text>
        <text x="15" y="44" fill="#94a3b8" font-size="11">Perpetually free for state schools, Catholic dioceses, charities, and developing nations.</text>
      </g>

      <!-- Sovereign Seal -->
      <g transform="translate(595, 230)">
        <circle cx="50" cy="50" r="50" fill="#090d16" stroke="#38bdf8" stroke-width="2" stroke-dasharray="6 3"/>
        <circle cx="50" cy="50" r="42" fill="none" stroke="#334155" stroke-width="1"/>
        <text x="50" y="46" text-anchor="middle" fill="#38bdf8" font-size="10" font-weight="700" font-family="monospace">AIR-GAPPED</text>
        <text x="50" y="60" text-anchor="middle" fill="#94a3b8" font-size="8" font-family="monospace">VERIFIED VM</text>
      </g>
    </g>

    <!-- CHAPTER 2: 7-PAGE (448 KB) WASM LINEAR MEMORY (800px -> 1600px) -->
    <g id="page-2" transform="translate(800, 0)">
      <rect x="40" y="65" width="720" height="400" rx="12" fill="url(#pageCardGrad)" stroke="#334155" stroke-width="1.5"/>

      <text x="70" y="110" fill="#f8fafc" font-size="20" font-weight="700">II. 7-Page (448 KB) WASM Memory Contract</text>
      <text x="70" y="136" fill="#94a3b8" font-size="12">Fixed linear memory virtual ISA guarantees zero dynamic heap allocations in active loops.</text>

      <text x="70" y="180" fill="#cbd5e1" font-size="13" font-weight="600">Deterministic Linear Memory Allocation:</text>
      <text x="70" y="204" fill="#94a3b8" font-size="12">Hot simulation loops bypass garbage-collected V8 memory pools.</text>
      <text x="70" y="222" fill="#94a3b8" font-size="12">All particle arrays, rigid bodies, and projected geometries live in</text>
      <text x="70" y="240" fill="#94a3b8" font-size="12">a pre-allocated Structure of Arrays (SoA) layout.</text>

      <rect x="70" y="275" width="340" height="50" rx="6" fill="#090d16" stroke="#1e293b"/>
      <text x="85" y="295" fill="#94a3b8" font-size="10" font-family="monospace">INSPECTED ADDRESS REGISTER:</text>
      <text id="wasm-addr-readout" x="85" y="315" fill="#38bdf8" font-size="13" font-weight="700" font-family="monospace">0x020000 / 0x070000</text>

      <!-- Live Memory Dial Visualization -->
      <g id="wasm-memory-viz">
        <circle cx="1200" cy="250" r="90" fill="#090d16" stroke="#334155" stroke-width="16"/>
        <circle cx="1200" cy="250" r="90" fill="none" stroke="url(#cyanAccent)" stroke-width="16" stroke-dasharray="140 425"/>
        <text x="1200" y="246" text-anchor="middle" fill="#f8fafc" font-size="14" font-weight="700" font-family="monospace">448 KB</text>
        <text x="1200" y="262" text-anchor="middle" fill="#64748b" font-size="10" font-family="monospace">TOTAL POOL</text>
        <!-- Rotating Pointer Needle -->
        <g id="wasm-dial-pointer">
          <line x1="1200" y1="250" x2="1200" y2="175" stroke="#f43f5e" stroke-width="3" stroke-linecap="round"/>
          <circle cx="1200" cy="250" r="6" fill="#f43f5e"/>
        </g>
      </g>
    </g>

    <!-- CHAPTER 3: S-EXPRESSION PIPELINE (1600px -> 2400px) -->
    <g id="page-3" transform="translate(1600, 0)">
      <rect x="40" y="65" width="720" height="400" rx="12" fill="url(#pageCardGrad)" stroke="#334155" stroke-width="1.5"/>

      <text x="70" y="110" fill="#f8fafc" font-size="20" font-weight="700">III. Declarative S-Expressions into Pure Vectors</text>
      <text x="70" y="136" fill="#94a3b8" font-size="12">Mathematical evaluation maps directly into standard W3C SVG nodes at 60 FPS.</text>

      <text x="70" y="180" fill="#cbd5e1" font-size="13" font-weight="600">Real-Time Mathematical Projection:</text>
      <text x="70" y="204" fill="#94a3b8" font-size="12">The engine evaluates concise declarative tuples directly into SVG</text>
      <text x="70" y="222" fill="#94a3b8" font-size="12">attributes without parsing DOM templates or rerendering frames.</text>

      <!-- Active Evaluated Tuple Box -->
      <text x="70" y="268" fill="#94a3b8" font-size="10" font-family="monospace">EVALUATED AST TUPLE EMISSION:</text>
      <rect x="70" y="280" width="370" height="44" rx="6" fill="#090d16" stroke="#1e293b"/>
      <text id="live-ast-token-readout" x="85" y="307" fill="#a7f3d0" font-size="12" font-family="monospace">(:target "#live-rect" :width 100)</text>

      <!-- Live Rendering Output Display -->
      <g transform="translate(2080, 180)">
        <rect x="0" y="0" width="230" height="150" rx="8" fill="#090d16" stroke="#334155"/>
        <text x="15" y="24" fill="#64748b" font-size="10" font-family="monospace">SVG TARGET VIEWPORT</text>
        <line x1="15" y1="32" x2="215" y2="32" stroke="#1e293b" stroke-width="1"/>
        <rect id="live-vector-rect" x="25" y="55" width="100" height="60" rx="4" fill="url(#cyanAccent)"/>
      </g>
    </g>

    <!-- CHAPTER 4: THE OFFLINE TRUST COVENANT (2400px -> 3200px) -->
    <g id="page-4" transform="translate(2400, 0)">
      <rect x="40" y="65" width="720" height="400" rx="12" fill="url(#pageCardGrad)" stroke="#334155" stroke-width="1.5"/>

      <text x="70" y="110" fill="#f8fafc" font-size="20" font-weight="700">IV. The Sovereign Offline Covenant</text>
      <text x="70" y="136" fill="#94a3b8" font-size="12">Engineered for 20-year durability, optical sneakernets, and zero marginal costs.</text>

      <g transform="translate(70, 165)">
        <rect x="0" y="0" width="660" height="70" rx="6" fill="#090d16" stroke="#1e293b"/>
        <text x="15" y="24" fill="#38bdf8" font-size="12" font-weight="700" font-family="monospace">OPTICAL SNEAKERNET &amp; WEBRTC BEACONS</text>
        <text x="15" y="44" fill="#94a3b8" font-size="11">Distribute complete interactive curricula across air-gapped classrooms via animated QR</text>
        <text x="15" y="58" fill="#94a3b8" font-size="11">codes and local peer-to-peer data channels with zero cellular bandwidth usage.</text>
      </g>

      <g transform="translate(70, 250)">
        <rect x="0" y="0" width="660" height="70" rx="6" fill="#090d16" stroke="#1e293b"/>
        <text x="15" y="24" fill="#38bdf8" font-size="12" font-weight="700" font-family="monospace">FLASH WEAR GUARD &amp; LONG-TERM PRESERVATION</text>
        <text x="15" y="44" fill="#94a3b8" font-size="11">Strictly 0 disk writes during active simulation runs protects cheap eMMC storage chips.</text>
        <text x="15" y="58" fill="#94a3b8" font-size="11">Standard W3C SVG vector primitives guarantee visual fidelity across decades.</text>
      </g>

      <g transform="translate(70, 335)">
        <rect x="0" y="0" width="660" height="55" rx="6" fill="#090d16" stroke="#1e293b"/>
        <text x="15" y="24" fill="#38bdf8" font-size="12" font-weight="700" font-family="monospace">CANONICAL ARTIFACT INTEGRITY</text>
        <text x="15" y="44" fill="#94a3b8" font-size="11">This single .ast.svg file is both the executable program and its complete explanatory dissertation.</text>
      </g>
    </g>

  </g>
</svg>
"""

with open("manifesto.ast.svg", "w", encoding="utf-8") as f:
    f.write(content.strip())

print(f"File created successfully: {len(content)} bytes")
