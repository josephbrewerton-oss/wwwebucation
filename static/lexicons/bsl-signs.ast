    (kf :idx 2 :label "Index Up" :rule "Dominant index finger held erect in front of chest" :tip [15 -30 25] :knuckle [38 -2 16] :wrist [70 35 0] :shape :point :palm :in :hold 180 :nmf (nmf :mouth "one" :brows "neutral" :tilt "nod"))
  )

  (sign :id "two" :word "TWO" :cat "temporal" :gloss "TWO"
    :label "Two / Pair / Double"
    :desc "Dominant index and middle fingers raised vertically in V-shape, palm facing inward." :aliases ("2" "PAIR" "DOUBLE" "BOTH")
    (kf :idx 1 :label "V Poise" :rule "Dominant V begins rising in front of lower chest" :tip [12 -10 22] :knuckle [35 15 14] :wrist [68 50 0] :shape :v :palm :in :hold 110 :nmf (nmf :mouth "two" :brows "neutral"))
    (kf :idx 2 :label "V Up" :rule "Dominant index and middle fingers held upright in front of chest" :tip [15 -30 25] :knuckle [38 -2 16] :wrist [70 35 0] :shape :v :palm :in :hold 180 :nmf (nmf :mouth "two" :brows "neutral" :tilt "nod"))
  )

  (sign :id "three" :word "THREE" :cat "temporal" :gloss "THREE"
    :label "Three / Trio / Triple"
    :desc "Dominant thumb, index, and middle fingers extended upright, palm facing inward." :aliases ("3" "TRIO" "TRIPLE")
