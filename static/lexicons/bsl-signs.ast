    (kf :idx 2 :label "Firm Grip in Space" :rule "Both hands close into solid fists holding an object in front of chest" :tip [12 0 28] :knuckle [38 25 18] :wrist [72 58 0] :shape :fist :palm :in :hold 190 :base-mode :mirror :nmf (nmf :mouth "hold" :brows "neutral" :tilt "nod"))
  )

  (sign :id "real" :word "REAL" :cat "grammar" :gloss "TRUE"
    :label "Real / True / Actual / Really"
    :desc "Dominant index finger moves straight out forward from mouth (speaking truth)." :aliases ("REALLY" "TRUE" "TRULY" "TRUTH" "ACTUAL")
    (kf :idx 1 :label "Index at Lips" :rule "Dominant index touches lips" :tip [5 -45 16] :knuckle [28 -18 10] :wrist [65 22 0] :shape :point :palm :lateral :hold 110 :nmf (nmf :mouth "true" :brows "neutral"))
    (kf :idx 2 :label "Straight Out Forward" :rule "Index finger shoots straight forward proving authentic truth" :tip [10 -35 35] :knuckle [35 -5 24] :wrist [70 35 8] :shape :point :palm :lateral :hold 190 :nmf (nmf :mouth "true" :brows "neutral" :tilt "nod"))
  )

  (sign :id "act" :word "ACT" :cat "conversation" :gloss "DO"
    :label "Act / Action / Do / Perform"
    :desc "Both C-hands or bent hands swing synchronously side-to-side (doing action)." :aliases ("ACTION" "ACTIONS" "DO" "DOING" "PERFORM")
    (kf :idx 1 :label "Action Swing Left" :rule "Both hands sweep toward left side" :tip [-20 15 28] :knuckle [10 38 18] :wrist [50 70 0] :shape :claw :palm :down :hold 130 :base-mode :mirror :nmf (nmf :mouth "action" :brows "neutral"))
    (kf :idx 2 :label "Action Swing Right" :rule "Both hands sweep across to right side completing dynamic motion" :tip [25 15 28] :knuckle [52 38 18] :wrist [85 70 0] :shape :claw :palm :down :hold 180 :base-mode :mirror :nmf (nmf :mouth "action" :brows "neutral" :tilt "nod"))
  )

  (sign :id "times" :word "TIMES" :cat "stem" :gloss "MULTIPLY"
    :label "Times / Multiply / Multiplication"
    :desc "Both index fingers cross in an X shape in front of chest (multiplication symbol)." :aliases ("MULTIPLY" "MULTIPLICATION" "PRODUCT" "BY-TIMES")
    (kf :idx 1 :label "Fingers Poised to Cross" :rule "Both index fingers held in front of chest angled toward each other" :tip [12 -5 25] :knuckle [38 18 16] :wrist [70 52 0] :shape :point :hold 110 :base-mode :mirror :nmf (nmf :mouth "times" :brows "neutral"))
    (kf :idx 2 :label "Cross Fingers X" :rule "Both index fingers meet and cross diagonally forming multiplication cross" :tip [0 -10 28] :knuckle [26 15 18] :wrist [65 50 0] :shape :point :hold 200 :base-mode :mirror :nmf (nmf :mouth "times" :brows "neutral" :tilt "nod"))
  )

  (sign :id "square" :word "SQUARE" :cat "stem" :gloss "SQUARE"
    :label "Square / Quadratic / Box"
    :desc "Both index fingers draw the top, sides, and bottom of a four-sided equilateral square." :aliases ("SQUARES" "SQUARED" "BOX" "QUADRILATERAL")
    (kf :idx 1 :label "Top Horizontal Edge" :rule "Both index fingers meet at top center and pull apart horizontally" :tip [25 -30 26] :knuckle [50 -5 16] :wrist [82 32 0] :shape :point :hold 120 :base-mode :mirror :nmf (nmf :mouth "square" :brows "neutral"))
    (kf :idx 2 :label "Drop Vertical Sides" :rule "Both fingers trace straight down the two vertical edges" :tip [25 15 26] :knuckle [50 38 16] :wrist [82 70 0] :shape :point :hold 130 :base-mode :mirror :nmf (nmf :mouth "square" :brows "neutral"))
    (kf :idx 3 :label "Close Bottom Base" :rule "Fingers draw inward meeting together at bottom center" :tip [0 15 26] :knuckle [26 38 16] :wrist [65 70 0] :shape :point :hold 190 :base-mode :mirror :nmf (nmf :mouth "square" :brows "neutral" :tilt "nod"))
  )

  (sign :id "bishop" :word "BISHOP" :cat "faith" :gloss "BISHOP"
    :label "Bishop / Mitre / Episcopus"
    :desc "Both hands outline the tall peaked mitre on top of head, then kiss episcopal ring." :aliases ("BISHOPS" "EPISCOPAL" "ARCHBISHOP" "MITRE")
    (kf :idx 1 :label "Mitre Peak on Head" :rule "Both flat hands meet above head forming the pointed triangular episcopal mitre" :tip [0 -95 22] :knuckle [28 -65 14] :wrist [68 -25 5] :shape :flat :hold 140 :base-mode :mirror :nmf (nmf :mouth "bishop" :brows "raised"))
    (kf :idx 2 :label "Episcopal Ring Kiss" :rule "Dominant ring finger touched to lips in reverent greeting of bishop" :tip [8 -45 16] :knuckle [32 -18 10] :wrist [68 22 0] :shape :point :palm :in :hold 200 :nmf (nmf :mouth "bishop" :brows "neutral" :tilt "nod"))
  )

  (sign :id "commandment" :word "COMMANDMENT" :cat "faith" :gloss "LAW"
    :label "Commandment / Law / Rule of God"
    :desc "Dominant L-hand or flat hand strikes against non-dominant vertical palm (tablets of the law)." :aliases ("COMMANDMENTS" "LAW" "RULES" "DECALOGUE")
    (kf :idx 1 :label "Tablet High Law" :rule "Dominant flat hand strikes upper part of non-dominant vertical tablet palm" :tip [-30 -15 24] :knuckle [0 12 14] :wrist [50 48 0] :shape :flat :palm :out :hold 120 :base-mode :vowel-board :nmf (nmf :mouth "law" :brows "furrowed"))
    (kf :idx 2 :label "Tablet Lower Law" :rule "Dominant hand strikes lower part of tablet palm confirming Divine Law" :tip [-30 15 24] :knuckle [0 38 14] :wrist [50 70 0] :shape :flat :palm :out :hold 200 :base-mode :vowel-board :nmf (nmf :mouth "law" :brows "neutral" :tilt "nod"))
  )

  (sign :id "baptism" :word "BAPTISM" :cat "faith" :gloss "BAPTISM"
    :label "Baptism / Christening / Holy Water"
    :desc "Cupped hand pours sacred water three times over head or baby font." :aliases ("BAPTISMAL" "BAPTISED" "BAPTIZED" "BAPTISE" "CHRISTENING")
    (kf :idx 1 :label "Cup Water Font" :rule "Dominant cupped hand scoops holy water from baptismal font" :tip [10 15 28] :knuckle [35 38 18] :wrist [70 70 0] :shape :c-shape :palm :up :hold 120 :nmf (nmf :mouth "baptism" :brows "neutral"))
    (kf :idx 2 :label "Pour Holy Water" :rule "Hand tips over gently pouring sanctifying waters of rebirth" :tip [12 -15 32] :knuckle [38 15 22] :wrist [72 52 5] :shape :c-shape :palm :down :hold 200 :nmf (nmf :mouth "water" :brows "raised" :tilt "nod"))
  )

  (sign :id "adoration" :word "ADORATION" :cat "faith" :gloss "ADORATION"
    :label "Adoration / Blessed Sacrament / Monstrance"
    :desc "Both hands elevate gazing up with deep reverence toward the consecrated Host." :aliases ("ADORE" "EXPOSITION" "MONSTRANCE")
    (kf :idx 1 :label "Hands of Awe" :rule "Both hands lifted palms forward gazing up in sacred awe before Monstrance" :tip [15 -45 32] :knuckle [42 -15 22] :wrist [75 25 5] :shape :flat :palm :out :hold 150 :base-mode :mirror :nmf (nmf :mouth "adore" :brows "raised"))
    (kf :idx 2 :label "Reverent Genuflection Bow" :rule "Hands draw toward heart and head bows deeply before the Real Presence" :tip [0 -10 25] :knuckle [26 18 15] :wrist [65 55 0] :shape :flat :palm :in :hold 220 :base-mode :mirror :nmf (nmf :mouth "Amen" :brows "neutral" :tilt "nod"))
  )

  (sign :id "anointing" :word "ANOINTING" :cat "faith" :gloss "ANOINT"
    :label "Anointing / Holy Chrism / Healing of Sick"
    :desc "Dominant thumb traces Sign of Cross with holy chrism on forehead." :aliases ("ANOINT" "ANOINTED" "CHRISM" "OIL-HOLY")
    (kf :idx 1 :label "Chrism on Forehead" :rule "Dominant thumb touches center of forehead" :tip [0 -65 18] :knuckle [25 -35 12] :wrist [65 5 0] :shape :point :palm :in :hold 130 :nmf (nmf :mouth "anoint" :brows "raised"))
    (kf :idx 2 :label "Cross Anointing Stroke" :rule "Thumb traces cross in holy oil dispensing the healing seal" :tip [0 -50 18] :knuckle [25 -20 12] :wrist [65 20 0] :shape :point :palm :in :hold 200 :nmf (nmf :mouth "anoint" :brows "neutral" :tilt "nod"))
  )

  (sign :id "slide" :word "SLIDE" :cat "school" :gloss "SLIDE"
    :label "Slide / Glide / Smooth Motion"
    :desc "Dominant flat hand glides smoothly across non-dominant horizontal palm." :aliases ("GLIDE" "SLIDING" "SLIDES")
    (kf :idx 1 :label "Poised to Slide" :rule "Dominant flat hand rests on heel of non-dominant palm" :tip [-45 15 18] :knuckle [-10 35 10] :wrist [40 68 -5] :shape :flat :palm :down :hold 110 :base-mode :vowel-board :nmf (nmf :mouth "slide" :brows "neutral"))
    (kf :idx 2 :label "Smooth Forward Glide" :rule "Dominant hand glides effortlessly forward across fingertips and into air" :tip [-15 10 38] :knuckle [18 32 25] :wrist [62 65 8] :shape :flat :palm :down :hold 190 :nmf (nmf :mouth "mm" :brows "neutral" :tilt "nod"))
  )

  (sign :id "drag" :word "DRAG" :cat "school" :gloss "DRAG"
    :label "Drag / Pull / Move"
    :desc "Both hands pull firmly backward as if dragging an interactive object across screen." :aliases ("DRAGGING" "PULL" "PULLING")
    (kf :idx 1 :label "Grasp Object" :rule "Both hands grasp object forward in interactive canvas space" :tip [15 5 42] :knuckle [42 28 30] :wrist [75 60 10] :shape :fist :hold 120 :base-mode :mirror :nmf (nmf :mouth "drag" :brows "furrowed"))
    (kf :idx 2 :label "Heave Back" :rule "Both hands haul firmly back toward torso" :tip [10 15 20] :knuckle [35 38 12] :wrist [70 70 0] :shape :fist :hold 190 :base-mode :mirror :nmf (nmf :mouth "puffed-cheeks" :brows "furrowed" :tilt "nod"))
  )

  (sign :id "golden" :word "GOLDEN" :cat "faith" :gloss "GOLD"
    :label "Gold / Golden / Chalice Metal"
    :desc "Dominant index touches earlobe (gold earring) then shakes open hand in shimmering yellow radiance." :aliases ("GOLD" "GILT" "YELLOW-SHIMMER")
    (kf :idx 1 :label "Touch Ear Gold" :rule "Dominant index touches earlobe" :tip [35 -55 15] :knuckle [58 -25 10] :wrist [85 15 0] :shape :point :palm :in :hold 120 :nmf (nmf :mouth "gold" :brows "raised"))
    (kf :idx 2 :label "Radiant Gold Shimmer" :rule "Hand moves down and forward fluttering fingers with golden radiance" :tip [20 -15 32] :knuckle [48 15 20] :wrist [80 48 5] :shape :spread :palm :up :hold 200 :nmf (nmf :mouth "gold" :brows "raised" :tilt "nod"))
  )

  (sign :id "faith" :word "FAITH" :cat "faith" :gloss "FAITH"
    :label "Faith / Trust / Belief in God"
    :desc "Dominant index touches forehead (mind belief) then clasps non-dominant fist firmly (heart trust)." :aliases ("BELIEF" "BELIEVE" "TRUST" "FIDELITY")
    (kf :idx 1 :label "Mind Belief" :rule "Dominant index touches temple/forehead" :tip [20 -65 18] :knuckle [45 -35 12] :wrist [75 5 0] :shape :point :palm :in :hold 120 :nmf (nmf :mouth "faith" :brows "raised"))
    (kf :idx 2 :label "Firm Fist Clasp" :rule "Dominant hand descends and locks firmly over non-dominant fist in steadfast trust" :tip [-30 10 22] :knuckle [0 32 14] :wrist [50 65 0] :shape :fist :hold 200 :base-mode :vowel-board :nmf (nmf :mouth "trust" :brows "neutral" :tilt "nod"))
  )

  (sign :id "white" :word "WHITE" :cat "school" :gloss "WHITE"
    :label "White / Pure White"
    :desc "Dominant fingertips stroke up chest from heart in pure white radiance." :aliases ("ALB" "SNOW-WHITE")
    (kf :idx 1 :label "Chest Poise" :rule "Dominant open flat hand rests lightly at heart" :tip [0 -20 20] :knuckle [28 10 12] :wrist [65 50 0] :shape :flat :palm :in :hold 110 :nmf (nmf :mouth "white" :brows "neutral"))
    (kf :idx 2 :label "Chest Stroke" :rule "Dominant open flat hand brushes upward from upper chest towards neck" :tip [0 -40 20] :knuckle [28 -10 12] :wrist [65 30 0] :shape :flat :palm :in :hold 180 :nmf (nmf :mouth "white" :brows "raised" :tilt "nod"))
  )

  (sign :id "stone" :word "STONE" :cat "stem" :gloss "STONE"
    :label "Stone / Rock / Altar Mensa"
    :desc "Back of dominant fist taps under chin twice (hard rock/stone)." :aliases ("ROCK" "STONES" "MINERAL" "MENSA")
    (kf :idx 1 :label "Fist Poise Under Chin" :rule "Back of dominant fist poised slightly below chin" :tip [10 -25 16] :knuckle [35 0 10] :wrist [68 35 0] :shape :fist :palm :down :hold 110 :nmf (nmf :mouth "stone" :brows "neutral"))
    (kf :idx 2 :label "Knock Under Chin" :rule "Back of dominant fist taps lightly under chin twice" :tip [10 -38 16] :knuckle [35 -12 10] :wrist [68 25 0] :shape :fist :palm :down :hold 180 :nmf (nmf :mouth "stone" :brows "neutral" :tilt "nod"))
  )

  (sign :id "lamp" :word "LAMP" :cat "faith" :gloss "LIGHT"
    :label "Lamp / Sanctuary Light / Flame"
    :desc "Dominant hand blossoms open upward from pinched bulb into shining sanctuary flame." :aliases ("FLAME" "CANDLE" "LANTERN" "BURNING")
    (kf :idx 1 :label "Flame Base Bulb" :rule "Dominant pinch hand poised upright" :tip [10 -25 28] :knuckle [35 2 18] :wrist [70 38 0] :shape :pinch :palm :up :hold 120 :nmf (nmf :mouth "lamp" :brows "raised"))
    (kf :idx 2 :label "Flame Flare Open" :rule "Fingers burst open radiating warm sacred flame" :tip [12 -45 32] :knuckle [38 -15 22] :wrist [72 25 5] :shape :spread :palm :up :hold 190 :nmf (nmf :mouth "light" :brows "raised" :tilt "nod"))
  )

  (sign :id "balance" :word "BALANCE" :cat "stem" :gloss "BALANCE"
    :label "Balance / Equilibrium / Weigh"
    :desc "Both flat hands hover palms up oscillating like scales of justice." :aliases ("EQUILIBRIUM" "SCALES" "BALANCED" "WEIGH")
    (kf :idx 1 :label "Scales Left Down" :rule "Left palm dips slightly while right rises in dynamic oscillation" :tip [15 10 30] :knuckle [42 32 20] :wrist [75 65 0] :shape :flat :palm :up :hold 130 :base-mode :mirror :nmf (nmf :mouth "balance" :brows "neutral"))
    (kf :idx 2 :label "Scales Hover" :rule "Both palms settle horizontal facing up in perfect equilibrium" :tip [15 15 30] :knuckle [42 38 20] :wrist [75 70 0] :shape :flat :palm :up :hold 190 :base-mode :mirror :nmf (nmf :mouth "balance" :brows "neutral" :tilt "nod"))
  )

  (sign :id "center" :word "CENTER" :cat "stem" :gloss "CENTER"
    :label "Center / Middle / Core"
    :desc "Dominant bent-hand circles above non-dominant open palm and plunges into exact center." :aliases ("CENTRE" "MIDDLE" "CORE" "CENTRAL")
    (kf :idx 1 :label "Hover Above Center" :rule "Dominant bent hand circles above non-dominant open flat palm" :tip [-30 -5 25] :knuckle [0 18 15] :wrist [50 52 0] :shape :claw :hold 120 :base-mode :vowel-board :nmf (nmf :mouth "center" :brows "neutral"))
    (kf :idx 2 :label "Plunge to Center" :rule "Fingertips plunge decisively into the exact focal center of base palm" :tip [-35 15 18] :knuckle [-5 35 10] :wrist [45 68 -5] :shape :point :hold 190 :base-mode :vowel-board :nmf (nmf :mouth "middle" :brows "neutral" :tilt "nod"))
  )

  (sign :id "make" :word "MAKE" :cat "conversation" :gloss "MAKE"
    :label "Make / Create / Produce"
    :desc "Both fists placed one atop the other twist back and forth like shaping materials." :aliases ("MAKES" "MADE" "MAKING" "CREATE" "BUILD")
    (kf :idx 1 :label "Fists Twist 1" :rule "Dominant fist on top of non-dominant fist twists right" :tip [-30 5 25] :knuckle [0 28 15] :wrist [50 60 0] :shape :fist :hold 120 :base-mode :vowel-board :nmf (nmf :mouth "make" :brows "neutral"))
    (kf :idx 2 :label "Fists Twist 2" :rule "Fists twist counter-direction completing constructive creation" :tip [-30 5 25] :knuckle [0 28 15] :wrist [50 60 0] :shape :fist :hold 180 :base-mode :vowel-board :nmf (nmf :mouth "make" :brows "neutral" :tilt "nod"))
  )

  (sign :id "add" :word "ADD" :cat "stem" :gloss "ADD"
    :label "Add / Addition / Plus"
    :desc "Dominant hand joins together with non-dominant hand gathering quantities into a single sum." :aliases ("ADDITION" "PLUS" "ADDED" "ADDING")
    (kf :idx 1 :label "Separate Quantities" :rule "Hands held apart open ready to combine" :tip [25 5 30] :knuckle [52 28 20] :wrist [85 60 0] :shape :flat-spread :hold 110 :base-mode :mirror :nmf (nmf :mouth "add" :brows "neutral"))
    (kf :idx 2 :label "Bring Together In Sum" :rule "Both hands sweep together meeting at center closing into a single unified whole" :tip [0 10 26] :knuckle [26 32 16] :wrist [65 65 0] :shape :flat :hold 190 :base-mode :mirror :nmf (nmf :mouth "plus" :brows "neutral" :tilt "nod"))
  )

  (sign :id "out" :word "OUT" :cat "grammar" :gloss "OUT"
    :label "Out / Outside / Exterior"
    :desc "Dominant flat hand pulls cleanly out and away from non-dominant container hand." :aliases ("OUTSIDE" "EXTERIOR" "AWAY")
    (kf :idx 1 :label "Inside Base" :rule "Dominant flat fingers placed inside non-dominant cupped C hand" :tip [-30 20 20] :knuckle [0 42 10] :wrist [50 75 -5] :shape :flat :hold 110 :base-mode :vowel-board :nmf (nmf :mouth "out" :brows "neutral"))
    (kf :idx 2 :label "Pull Outward to Freedom" :rule "Dominant hand pulls straight up and out away into open space" :tip [10 -20 35] :knuckle [38 8 24] :wrist [72 42 8] :shape :flat :palm :out :hold 190 :nmf (nmf :mouth "out" :brows "raised" :tilt "nod"))
  )

  (sign :id "up" :word "UP" :cat "stem" :gloss "UP"
    :label "Up / Upward / Ascend"
    :desc "Dominant index finger points and moves straight upward." :aliases ("UPWARD" "ABOVE" "HIGHER" "ASCEND")
    (kf :idx 1 :label "Index Poise Mid" :rule "Dominant index points upward at mid chest level" :tip [15 -30 25] :knuckle [38 -2 16] :wrist [70 35 0] :shape :point :palm :in :hold 110 :nmf (nmf :mouth "up" :brows "neutral"))
    (kf :idx 2 :label "Index Shoots Upward" :rule "Dominant index points and moves straight up into high spatial locus" :tip [15 -70 25] :knuckle [40 -35 16] :wrist [72 5 0] :shape :point :palm :in :hold 180 :nmf (nmf :mouth "up" :brows "raised" :tilt "nod"))
  )

  (sign :id "base" :word "BASE" :cat "stem" :gloss "BASE"
    :label "Base / Foundation / Bottom"
    :desc "Dominant flat palm pats under non-dominant horizontal forearm supporting it." :aliases ("FOUNDATION" "BOTTOM" "SUBSTRATE")
    (kf :idx 1 :label "Hover Below Arm" :rule "Dominant flat hand hovers below non-dominant horizontal forearm" :tip [-35 40 20] :knuckle [-5 60 12] :wrist [45 92 0] :shape :flat :palm :up :hold 110 :base-mode :vowel-board :nmf (nmf :mouth "base" :brows "neutral"))
    (kf :idx 2 :label "Support Underneath" :rule "Dominant flat hand pats upward against bottom of non-dominant horizontal forearm" :tip [-35 25 20] :knuckle [-5 45 12] :wrist [45 78 0] :shape :flat :palm :up :hold 180 :base-mode :vowel-board :nmf (nmf :mouth "base" :brows "neutral" :tilt "nod"))
  )
)
