    :desc "Flat open palm pushes directly forward toward addressee/viewer." :aliases ("YOURS" "YOURSELF")
    (kf :idx 1 :label "Poised Near Body" :rule "Flat open hand held at chest facing viewer" :tip [8 -5 28] :knuckle [35 22 20] :wrist [68 55 5] :shape :flat :palm :out :hold 110 :nmf (nmf :mouth "your" :brows "neutral"))
    (kf :idx 2 :label "Flat Palm Toward Viewer" :rule "Flat open palm extends directly forward toward audience locus" :tip [10 -10 42] :knuckle [38 18 30] :wrist [72 52 12] :shape :flat :palm :out :hold 180 :nmf (nmf :mouth "your" :brows "neutral" :tilt "nod"))
  )

  (sign :id "hand" :word "HAND" :cat "conversation" :gloss "HAND"
    :label "Hand / Hands"
    :desc "Dominant flat hand gently clasps or strokes the non-dominant open flat hand." :aliases ("HANDS" "MANUAL")
    (kf :idx 1 :label "Poised Above Base Hand" :rule "Dominant flat hand poised over non-dominant palm" :tip [-30 0 28] :knuckle [0 22 18] :wrist [50 55 5] :shape :flat :palm :down :hold 110 :base-mode :vowel-board :nmf (nmf :mouth "hand" :brows "neutral"))
    (kf :idx 2 :label "Open Hands Meet" :rule "Dominant flat hand strokes over non-dominant flat palm" :tip [-30 10 24] :knuckle [0 32 14] :wrist [50 65 0] :shape :flat :palm :down :hold 180 :base-mode :vowel-board :nmf (nmf :mouth "hand" :brows "neutral" :tilt "nod"))
  )

  (sign :id "hold" :word "HOLD" :cat "conversation" :gloss "HOLD"
