    :desc "Flat open palm pushes gently toward 3rd-person spatial locus indicating possession." :aliases ("HER" "HERS" "THEIR" "THEIRS" "ITS")
    (kf :idx 1 :label "Poise at Locus Entry" :rule "Flat open hand positioned near torso facing 3rd-person locus" :tip [20 -5 25] :knuckle [45 20 18] :wrist [75 52 5] :shape :flat :palm :out :hold 110 :nmf (nmf :mouth "his" :brows "neutral"))
    (kf :idx 2 :label "Possessive Palm at Locus" :rule "Flat open hand pushes forward towards 3rd-person locus at right" :tip [35 -10 35] :knuckle [62 15 25] :wrist [92 48 10] :shape :flat :palm :out :hold 180 :nmf (nmf :mouth "his" :brows "neutral" :tilt "nod"))
  )

  (sign :id "my" :word "MY" :cat "conversation" :gloss "POSS-1ST"
    :label "My / Mine / Me / Possessive 1st Person"
    :desc "Flat open palm rests firmly flat against center of upper chest (heart)." :aliases ("MINE" "MYSELF")
    (kf :idx 1 :label "Approach Chest" :rule "Flat open hand hovers slightly in front of heart" :tip [0 -15 26] :knuckle [26 12 18] :wrist [65 50 5] :shape :flat :palm :in :hold 110 :nmf (nmf :mouth "my" :brows "neutral"))
    (kf :idx 2 :label "Flat Palm on Chest" :rule "Flat open palm pats gently against center of upper chest" :tip [0 -20 18] :knuckle [26 8 10] :wrist [65 45 0] :shape :flat :palm :in :hold 180 :nmf (nmf :mouth "my" :brows "neutral" :tilt "nod"))
  )

  (sign :id "your" :word "YOUR" :cat "conversation" :gloss "POSS-2ND"
