    (kf :idx 2 :label "Twist V Outward" :rule "V handshape snaps outward 90 degrees" :tip [15 -18 32] :knuckle [40 8 22] :wrist [72 42 5] :shape :v :palm :out :hold 180 :nmf (nmf :mouth "second" :brows "neutral" :tilt "nod"))
  )

  (sign :id "third" :word "THIRD" :cat "temporal" :gloss "THIRD"
