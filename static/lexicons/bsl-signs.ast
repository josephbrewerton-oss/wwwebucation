    (kf :idx 2 :label "Three Up" :rule "Dominant thumb, index, and middle held upright in front of chest" :tip [15 -30 25] :knuckle [38 -2 16] :wrist [70 35 0] :shape :spread :palm :in :hold 180 :nmf (nmf :mouth "three" :brows "neutral" :tilt "nod"))
  )

  (sign :id "his" :word "HIS" :cat "conversation" :gloss "POSS-3RD"
