;; =============================================================================
;; St Joseph's Curriculum Portal — British Sign Language (BSL) AST Lexicon
;; Canonical Procedural 3D Kinematic S-Expression Corpus (Phase 1)
;; Zero-Video Invariant: Ultra-compact mathematical representations of sign trajectories
;; =============================================================================
(bsl-lexicon :version "2.0.0-LEVEL2-3" :standard "BANZSL" :title "St Joseph's BSL Curriculum Lexicon (Level 2/3 Upgraded)" :signs-count 100
  (sign :id "jesus" :word "JESUS" :cat "faith" :gloss "JESUS"
    :label "Jesus Christ"
    :desc "Index touches center of non-dominant palm, then dominant palm (the crucifixion nails in the hands)." :aliases ("CHRIST" "LORD" "SAVIOUR" "SAVIOR")
    (kf :idx 1 :label "Nail in Left Palm" :rule "Dominant index touches center of non-dominant open palm" :tip [-50 30 12] :knuckle [5 40 5] :wrist [65 75 -10] :nmf (nmf :mouth "Jesus" :brows "neutral"))
    (kf :idx 2 :label "Nail in Right Palm" :rule "Hands cross: index touches opposite palm center" :tip [35 25 14] :knuckle [60 45 5] :wrist [100 80 -10] :base-shift [20 -10 0] :nmf (nmf :mouth "Christ" :brows "neutral"))
  )

  (sign :id "god" :word "GOD" :cat "faith" :gloss "GOD"
    :label "God the Father"
    :desc "Dominant index points reverently upward toward heaven with upward gaze." :aliases ("FATHER" "ALMIGHTY" "CREATOR")
    (kf :idx 1 :label "Raise Pointing Hand" :rule "Dominant index points upward at upper chest level" :tip [25 -50 25] :knuckle [45 -15 15] :wrist [75 35 0] :nmf (nmf :mouth "God" :brows "raised"))
    (kf :idx 2 :label "Reverent Point to Heaven" :rule "Dominant index extends higher toward the heavens" :tip [30 -85 35] :knuckle [50 -40 20] :wrist [80 10 5] :nmf (nmf :mouth "God" :brows "raised"))
  )

  (sign :id "pray" :word "PRAY" :cat "faith" :gloss "PRAY"
    :label "Pray / Prayer"
    :desc "Both flat palms join together at chest level in prayer steeple, bowing slightly." :aliases ("PRAYER" "PRAYING" "PRAYS" "AMEN")
    (kf :idx 1 :label "Palms Together at Chest" :rule "Both flat hands press palms together pointing upward in front of heart" :tip [-15 -15 25] :knuckle [20 20 12] :wrist [55 65 0] :nmf (nmf :mouth "pray" :brows "neutral"))
    (kf :idx 2 :label "Reverent Dip" :rule "Prayer steeple hands dip forward in reverent contemplation" :tip [-15 5 30] :knuckle [20 35 18] :wrist [55 75 5] :nmf (nmf :mouth "Amen" :brows "neutral" :tilt "nod"))
  )

  (sign :id "church" :word "CHURCH" :cat "faith" :gloss "CHURCH"
    :label "Church / Cathedral"
    :desc "Both hands form a peaked steeple/roof above chest, tapping together twice." :aliases ("CHAPEL" "CATHEDRAL" "SANCTUARY" "BASILICA")
    (kf :idx 1 :label "Form Steeples" :rule "Fingertips join in a triangular church roof spire" :tip [-5 -40 22] :knuckle [35 -5 12] :wrist [75 45 0] :nmf (nmf :mouth "church" :brows "neutral"))
    (kf :idx 2 :label "Steeple Tap" :rule "Roof tap confirms the consecrated sacred architecture" :tip [-5 -30 22] :knuckle [35 5 12] :wrist [75 55 0] :nmf (nmf :mouth "church" :brows "neutral"))
  )

  (sign :id "cross" :word "CROSS" :cat "faith" :gloss "CROSS"
    :label "Cross / Crucifix"
    :desc "Dominant index traces the vertical and horizontal beams of the Cross." :aliases ("CRUCIFIX" "CRUCIFIXION")
    (kf :idx 1 :label "Vertical Top" :rule "Index finger begins at top of cross near forehead" :tip [0 -60 25] :knuckle [25 -25 15] :wrist [65 25 0] :shape :point :base-mode :vowel-board :nmf (nmf :mouth "cross" :brows "neutral"))
    (kf :idx 2 :label "Vertical Base" :rule "Index finger traces downward to base at lower chest" :tip [0 35 25] :knuckle [25 65 15] :wrist [65 95 0] :shape :point :base-mode :vowel-board :nmf (nmf :mouth "cross" :brows "neutral"))
    (kf :idx 3 :label "Horizontal Beam Left" :rule "Index draws crossbeam starting from left" :tip [-45 -15 22] :knuckle [-10 15 12] :wrist [40 55 0] :shape :point :base-mode :vowel-board :nmf (nmf :mouth "cross" :brows "neutral"))
    (kf :idx 4 :label "Horizontal Beam Right" :rule "Index draws across to right shoulder" :tip [45 -15 22] :knuckle [75 15 12] :wrist [110 55 0] :shape :point :base-mode :vowel-board :nmf (nmf :mouth "cross" :brows "neutral"))
  )

  (sign :id "bible" :word "BIBLE" :cat "faith" :gloss "HOLY BOOK"
    :label "Bible / Holy Scripture"
    :desc "Hands join together and open like a book, indicating Sacred Scripture." :aliases ("SCRIPTURE" "GOSPEL" "TESTAMENT")
    (kf :idx 1 :label "Closed Book" :rule "Palms pressed together vertically" :tip [-10 15 20] :knuckle [25 45 10] :wrist [65 80 0] :nmf (nmf :mouth "holy" :brows "neutral"))
    (kf :idx 2 :label "Open Scripture Book" :rule "Palms open upward side by side like pages of the Bible" :tip [25 20 15] :knuckle [55 50 10] :wrist [95 85 0] :base-shift [-30 0 0] :nmf (nmf :mouth "book" :brows "neutral"))
  )

  (sign :id "holy" :word "HOLY" :cat "faith" :gloss "HOLY"
    :label "Holy / Sacred"
    :desc "Flat open hand brushes upward from heart in a pure elevating gesture." :aliases ("SACRED" "BLESSED" "SANCTUS")
    (kf :idx 1 :label "At Heart" :rule "Open flat hand rests near heart" :tip [-10 0 20] :knuckle [30 35 10] :wrist [75 70 0] :nmf (nmf :mouth "holy" :brows "raised"))
    (kf :idx 2 :label "Elevate Upward" :rule "Hand sweeps upward in divine radiance" :tip [15 -45 30] :knuckle [50 -10 15] :wrist [90 35 0] :nmf (nmf :mouth "holy" :brows "raised"))
  )

  (sign :id "love" :word "LOVE" :cat "faith" :gloss "LOVE"
    :label "Love / Charity"
    :desc "Fists crossed over heart in a warm embracing cross." :aliases ("CHARITY" "LOVING" "LOVES")
    (kf :idx 1 :label "Fists at Shoulders" :rule "Both hands loosely closed in front of chest" :tip [10 10 15] :knuckle [45 40 8] :wrist [85 75 0] :nmf (nmf :mouth "love" :brows "neutral"))
    (kf :idx 2 :label "Crossed Over Heart" :rule "Fists cross snugly over chest" :tip [-25 -5 22] :knuckle [15 25 12] :wrist [60 65 0] :nmf (nmf :mouth "love" :brows "neutral" :tilt "nod"))
  )

  (sign :id "peace" :word "PEACE" :cat "faith" :gloss "PEACE"
    :label "Peace / Pax"
    :desc "Both palms touch center then glide smoothly outward and downward." :aliases ("PAX" "CALM" "SERENITY")
    (kf :idx 1 :label "Joined Center" :rule "Open hands touch palms together in center" :tip [-10 5 20] :knuckle [25 35 10] :wrist [65 70 0] :nmf (nmf :mouth "peace" :brows "neutral"))
    (kf :idx 2 :label "Glide Outward" :rule "Hands smooth outward into serene open space" :tip [55 30 20] :knuckle [85 55 10] :wrist [120 85 0] :base-shift [-40 20 0] :nmf (nmf :mouth "peace" :brows "neutral"))
  )

  (sign :id "school" :word "SCHOOL" :cat "school" :gloss "SCHOOL"
    :label "School"
    :desc "Dominant flat palm claps twice across non-dominant palm." :aliases ("CLASSROOM" "COLLEGE" "ACADEMY")
    (kf :idx 1 :label "First Palm Clap" :rule "Dominant flat hand claps down onto non-dominant palm" :tip [-45 20 12] :knuckle [5 35 5] :wrist [65 70 -10] :nmf (nmf :mouth "school" :brows "neutral"))
    (kf :idx 2 :label "Lift" :rule "Hand rebounds upward slightly" :tip [-35 -10 25] :knuckle [15 15 15] :wrist [75 50 0] :nmf (nmf :mouth "school" :brows "neutral"))
    (kf :idx 3 :label "Second Palm Clap" :rule "Second rhythmic clap confirming school activity" :tip [-45 20 12] :knuckle [5 35 5] :wrist [65 70 -10] :nmf (nmf :mouth "school" :brows "neutral"))
  )

  (sign :id "teacher" :word "TEACHER" :cat "school" :gloss "TEACH PERSON"
    :label "Teacher / Educator"
    :desc "Pinched fingers move forward from temples (teaching) then hands move down (person)." :aliases ("TEACH" "TEACHING" "EDUCATOR" "INSTRUCTOR")
    (kf :idx 1 :label "From Mind" :rule "Pinched hands positioned near temples" :tip [50 -65 28] :knuckle [70 -35 15] :wrist [95 10 0] :shape :claw :base-mode :mirror :nmf (nmf :mouth "teach" :brows "neutral"))
    (kf :idx 2 :label "Extend Knowledge Out" :rule "Hands extend forward sharing knowledge with pupils" :tip [30 -20 65] :knuckle [55 10 45] :wrist [85 50 20] :shape :spread :base-mode :mirror :nmf (nmf :mouth "teacher" :brows "neutral"))
  )

  (sign :id "learn" :word "LEARN" :cat "school" :gloss "LEARN"
    :label "Learn / Student"
    :desc "Hand gathers knowledge from open palm book and places it into the mind/forehead." :aliases ("LEARNING" "STUDENT" "PUPIL" "STUDY")
    (kf :idx 1 :label "Gather from Book" :rule "Fingertips take knowledge from flat non-dominant palm" :tip [-45 25 14] :knuckle [0 35 5] :wrist [60 70 -10] :nmf (nmf :mouth "learn" :brows "neutral"))
    (kf :idx 2 :label "Place into Forehead" :rule "Hand moves up and touches forehead with knowledge" :tip [15 -65 30] :knuckle [45 -30 15] :wrist [80 15 0] :nmf (nmf :mouth "learn" :brows "raised" :tilt "nod"))
  )

  (sign :id "book" :word "BOOK" :cat "school" :gloss "BOOK"
    :label "Book / Text"
    :desc "Palms pressed together vertically then opened like a book." :aliases ("TEXTBOOK" "READER" "PAGES")
    (kf :idx 1 :label "Closed Book" :rule "Palms pressed together" :tip [-10 15 20] :knuckle [25 45 10] :wrist [65 80 0] :nmf (nmf :mouth "book" :brows "neutral"))
    (kf :idx 2 :label "Open Pages" :rule "Palms swing open upward" :tip [25 20 15] :knuckle [55 50 10] :wrist [95 85 0] :base-shift [-30 0 0] :nmf (nmf :mouth "book" :brows "neutral"))
  )

  (sign :id "read" :word "READ" :cat "school" :gloss "READ"
    :label "Read / Reading"
    :desc "V-fingers (eyes) scan down the non-dominant flat palm page." :aliases ("READING" "READS")
    (kf :idx 1 :label "Scan Top of Page" :rule "V-fingers point to top of non-dominant palm page" :tip [-60 -25 20] :knuckle [-10 -5 10] :wrist [50 40 -10] :nmf (nmf :mouth "read" :brows "neutral"))
    (kf :idx 2 :label "Scan Down Page" :rule "V-fingers scan down to bottom of palm page" :tip [-50 35 18] :knuckle [0 50 8] :wrist [60 85 -10] :nmf (nmf :mouth "read" :brows "neutral"))
  )

  (sign :id "write" :word "WRITE" :cat "school" :gloss "WRITE"
    :label "Write / Writing"
    :desc "Dominant pinched fingers pretend to write a pen stroke across non-dominant palm." :aliases ("WRITING" "PEN" "PENCIL")
    (kf :idx 1 :label "Pen Start" :rule "Pinched writing fingers touch left side of palm" :tip [-70 20 14] :knuckle [-20 30 8] :wrist [45 65 -10] :nmf (nmf :mouth "write" :brows "neutral"))
    (kf :idx 2 :label "Pen Stroke Across" :rule "Fingers scribble across to right side of palm" :tip [-30 25 14] :knuckle [15 35 8] :wrist [75 70 -10] :nmf (nmf :mouth "write" :brows "neutral"))
  )

  (sign :id "question" :word "QUESTION" :cat "school" :gloss "QUESTION"
    :label "Question / Ask"
    :desc "Dominant index traces a question mark hook in the air and dots it." :aliases ("ASK" "QUERY" "QUIZ")
    (kf :idx 1 :label "Hook Top" :rule "Index finger curves upper hook in air" :tip [25 -35 30] :knuckle [45 -5 18] :wrist [80 40 0] :nmf (nmf :mouth "question" :brows "furrowed"))
    (kf :idx 2 :label "Stem" :rule "Index curves down straight" :tip [25 -5 30] :knuckle [45 25 18] :wrist [80 65 0] :nmf (nmf :mouth "question" :brows "furrowed"))
    (kf :idx 3 :label "Question Dot" :rule "Index jabs dot cleanly underneath" :tip [25 25 30] :knuckle [45 55 18] :wrist [80 90 0] :nmf (nmf :mouth "question" :brows "raised"))
  )

  (sign :id "listen" :word "LISTEN" :cat "school" :gloss "LISTEN"
    :label "Listen / Hear"
    :desc "Dominant cupped hand placed near ear, tilting head to listen attentively." :aliases ("HEAR" "HEARING" "LISTENING")
    (kf :idx 1 :label "Cup Ear" :rule "Cupped hand brought alongside right ear" :tip [75 -55 25] :knuckle [95 -20 15] :wrist [120 25 0] :nmf (nmf :mouth "listen" :brows "raised" :tilt "tilt-right"))
    (kf :idx 2 :label "Attentive Ear" :rule "Hand cups closer focusing sound" :tip [65 -55 22] :knuckle [85 -20 12] :wrist [110 25 0] :nmf (nmf :mouth "listen" :brows "raised" :tilt "tilt-right"))
  )

  (sign :id "look" :word "LOOK" :cat "grammar" :gloss "LOOK"
    :label "Look / See / Watch"
    :desc "Two fingers (V-shape) point outward from eyes toward the target locus." :aliases ("SEE" "WATCH" "VIEW" "OBSERVE" "LOOKS" "LOOKED" "LOOKING") :directional true :default-loci (:from "ME" :to "YOU")
    (kf :idx 1 :label "From Eyes" :rule "V-fingers start pointing near eyes" :tip [35 -45 25] :knuckle [60 -15 15] :wrist [90 25 0] :shape :v :nmf (nmf :mouth "look" :brows "raised"))
    (kf :idx 2 :label "Direct Outward" :rule "V-fingers thrust forward directing gaze to target locus" :tip [25 -25 65] :knuckle [50 5 45] :wrist [80 45 20] :shape :v :nmf (nmf :mouth "look" :brows "raised"))
  )

  (sign :id "help" :word "HELP" :cat "school" :gloss "HELP"
    :label "Help / Support"
    :desc "Dominant closed fist with thumb up rests on open non-dominant palm, lifting forward." :aliases ("ASSIST" "SUPPORT")
    (kf :idx 1 :label "Rest on Palm" :rule "Dominant thumbs-up fist rests on flat non-dominant palm" :tip [-40 30 14] :knuckle [-5 40 5] :wrist [55 75 -10] :nmf (nmf :mouth "help" :brows "raised"))
    (kf :idx 2 :label "Lift Forward Together" :rule "Both hands move forward together offering supportive help" :tip [-25 5 45] :knuckle [10 15 35] :wrist [70 50 15] :base-shift [15 -20 30] :nmf (nmf :mouth "help" :brows "raised" :tilt "nod"))
  )

  (sign :id "science" :word "SCIENCE" :cat "stem" :gloss "SCIENCE"
    :label "Science / Lab"
    :desc "Alternating pouring gestures of two imaginary beaker test tubes." :aliases ("SCIENTIFIC" "CHEMISTRY" "BIOLOGY" "PHYSICS")
    (kf :idx 1 :label "Pour Right Beaker" :rule "Dominant hand tilts down pouring test tube" :tip [30 -10 25] :knuckle [60 15 15] :wrist [95 50 0] :nmf (nmf :mouth "science" :brows "neutral"))
    (kf :idx 2 :label "Pour Left Beaker" :rule "Hands alternate pouring into opposite vessel" :tip [-30 0 25] :knuckle [10 25 15] :wrist [60 60 0] :base-shift [20 -15 10] :nmf (nmf :mouth "science" :brows "neutral"))
  )

  (sign :id "maths" :word "MATHS" :cat "stem" :gloss "MATHS"
    :label "Maths / Arithmetic"
    :desc "M-letter fingers tapping rhythmically across palm." :aliases ("MATH" "MATHEMATICS" "ARITHMETIC")
    (kf :idx 1 :label "Tap M Fingers" :rule "Three fingers of dominant hand tap non-dominant palm" :tip [-50 25 12] :knuckle [0 35 5] :wrist [60 70 -10] :nmf (nmf :mouth "maths" :brows "neutral"))
    (kf :idx 2 :label "Tap Second Stroke" :rule "Second tap calculation rhythm" :tip [-40 20 12] :knuckle [10 30 5] :wrist [70 65 -10] :nmf (nmf :mouth "maths" :brows "neutral"))
  )

  (sign :id "number" :word "NUMBER" :cat "stem" :gloss "NUMBER"
    :label "Number / Count"
    :desc "Fingertips tap together counting rhythmically." :aliases ("NUMBERS" "COUNT" "COUNTING")
    (kf :idx 1 :label "Fingertip Pinch" :rule "Dominant thumb and index pinch tapping non-dominant index" :tip [-65 -10 18] :knuckle [-10 15 8] :wrist [50 60 -10] :nmf (nmf :mouth "number" :brows "neutral"))
    (kf :idx 2 :label "Count Step" :rule "Rebound count tap" :tip [-55 10 18] :knuckle [0 25 8] :wrist [60 65 -10] :nmf (nmf :mouth "count" :brows "neutral"))
  )

  (sign :id "equal" :word "EQUAL" :cat "stem" :gloss "EQUAL"
    :label "Equals / Same"
    :desc "Both index fingers held parallel horizontally like an equals sign (=)." :aliases ("EQUALS" "SAME" "EQUIVALENT")
    (kf :idx 1 :label "Parallel Index Bars" :rule "Dominant index placed parallel just above non-dominant index" :tip [-35 0 20] :knuckle [15 10 10] :wrist [75 45 0] :nmf (nmf :mouth "equal" :brows "neutral"))
    (kf :idx 2 :label "Press Equality" :rule "Both horizontal fingers tap together confirming equality" :tip [-35 15 20] :knuckle [15 25 10] :wrist [75 55 0] :nmf (nmf :mouth "equal" :brows "neutral"))
  )

  (sign :id "water" :word "WATER" :cat "stem" :gloss "WATER"
    :label "Water / Liquid"
    :desc "Index finger taps side of chin twice (BSL water sign)." :aliases ("LIQUID" "DRINK")
    (kf :idx 1 :label "Tap Chin 1" :rule "Index finger touches right side of chin" :tip [25 -45 22] :knuckle [55 -15 12] :wrist [90 25 0] :nmf (nmf :mouth "water" :brows "neutral"))
    (kf :idx 2 :label "Tap Chin 2" :rule "Index finger taps chin second time" :tip [25 -45 22] :knuckle [55 -15 12] :wrist [90 25 0] :nmf (nmf :mouth "water" :brows "neutral"))
  )

  (sign :id "light" :word "LIGHT" :cat "stem" :gloss "LIGHT"
    :label "Light / Shine"
    :desc "Pinched hand near temple opens outward into bright radiating fingers." :aliases ("SUNLIGHT" "SHINE" "BRIGHT")
    (kf :idx 1 :label "Spark Point" :rule "Fingers pinched near temple" :tip [50 -55 25] :knuckle [75 -25 15] :wrist [105 15 0] :nmf (nmf :mouth "light" :brows "raised"))
    (kf :idx 2 :label "Radiate Light Rays" :rule "Fingers splay open wide projecting light downward and outward" :tip [30 -10 55] :knuckle [55 20 35] :wrist [85 60 15] :nmf (nmf :mouth "light" :brows "raised"))
  )

  (sign :id "hello" :word "HELLO" :cat "conversation" :gloss "HELLO"
    :label "Hello / Welcome"
    :desc "Dominant open flat hand waves warmly from temple forward." :aliases ("HI" "WELCOME" "GREETINGS")
    (kf :idx 1 :label "Temple Salute" :rule "Open flat hand near right temple" :tip [60 -55 28] :knuckle [85 -25 15] :wrist [110 15 0] :nmf (nmf :mouth "hello" :brows "raised"))
    (kf :idx 2 :label "Wave Forward" :rule "Hand sweeps warmly forward with open welcome" :tip [85 -40 50] :knuckle [110 -10 30] :wrist [135 30 10] :nmf (nmf :mouth "hello" :brows "raised" :tilt "nod"))
  )

  (sign :id "thank-you" :word "THANK YOU" :cat "conversation" :gloss "THANK-YOU"
    :label "Thank You / Thanks"
    :desc "Flat hand fingertips touch chin and move forward toward conversational partner." :aliases ("THANKS" "THANK" "GRATITUDE")
    (kf :idx 1 :label "Touch Chin" :rule "Fingertips of flat dominant hand touch chin/lips" :tip [0 -45 24] :knuckle [35 -10 12] :wrist [80 35 0] :nmf (nmf :mouth "thank you" :brows "raised"))
    (kf :idx 2 :label "Extend Gratitude Forward" :rule "Hand moves smoothly forward toward receiver" :tip [0 5 65] :knuckle [25 35 45] :wrist [70 70 20] :nmf (nmf :mouth "thank you" :brows "raised" :tilt "nod"))
  )

  (sign :id "please" :word "PLEASE" :cat "conversation" :gloss "PLEASE"
    :label "Please"
    :desc "Flat hand fingertips touch chin and move forward (identical root to thank you with please mouthing)." :aliases ("PRAY-THEE")
    (kf :idx 1 :label "Touch Lips/Chin" :rule "Flat fingertips rest at lips/chin" :tip [0 -45 24] :knuckle [35 -10 12] :wrist [80 35 0] :nmf (nmf :mouth "please" :brows "raised"))
    (kf :idx 2 :label "Extend Forward" :rule "Hand moves forward gracefully" :tip [0 15 60] :knuckle [25 45 40] :wrist [70 80 15] :nmf (nmf :mouth "please" :brows "raised" :tilt "nod"))
  )

  (sign :id "yes" :word "YES" :cat "conversation" :gloss "YES"
    :label "Yes / Agree"
    :desc "Dominant fist nods up and down like an agreeing head." :aliases ("AGREE" "CORRECT" "TRUE")
    (kf :idx 1 :label "Fist Up" :rule "Closed fist tilts back ready to nod" :tip [35 -10 25] :knuckle [60 15 15] :wrist [95 55 0] :nmf (nmf :mouth "yes" :brows "raised"))
    (kf :idx 2 :label "Fist Nod Down" :rule "Fist nods down decisively like a head nod" :tip [35 30 25] :knuckle [60 55 15] :wrist [95 85 0] :nmf (nmf :mouth "yes" :brows "raised" :tilt "nod"))
  )

  (sign :id "no" :word "NO" :cat "conversation" :gloss "NO"
    :label "No / Disagree"
    :desc "Index and middle fingers snap shut against thumb twice." :aliases ("DISAGREE" "INCORRECT" "FALSE")
    (kf :idx 1 :label "Beak Open" :rule "Index and middle fingers extend open from thumb" :tip [35 -25 25] :knuckle [60 5 15] :wrist [95 45 0] :nmf (nmf :mouth "no" :brows "furrowed"))
    (kf :idx 2 :label "Snap Shut" :rule "Fingers snap closed against thumb" :tip [35 0 25] :knuckle [60 25 15] :wrist [95 65 0] :nmf (nmf :mouth "no" :brows "furrowed"))
  )

  (sign :id "good" :word "GOOD" :cat "conversation" :gloss "GOOD"
    :label "Good / Well"
    :desc "Dominant thumbs up rests on flat non-dominant palm with affirmation." :aliases ("WELL" "EXCELLENT" "FINE")
    (kf :idx 1 :label "Thumb Up at Chest" :rule "Thumbs up gesture held in front of heart" :tip [25 0 25] :knuckle [50 25 15] :wrist [85 65 0] :nmf (nmf :mouth "good" :brows "raised"))
    (kf :idx 2 :label "Affirmative Thrust" :rule "Thumbs up moves forward with bright affirmation" :tip [20 10 50] :knuckle [45 35 35] :wrist [80 70 15] :nmf (nmf :mouth "good" :brows "raised" :tilt "nod"))
  )

  (sign :id "friend" :word "FRIEND" :cat "conversation" :gloss "FRIEND"
    :label "Friend / Companionship"
    :desc "Dominant index hooks into non-dominant index in an affectionate interlocking clasp." :aliases ("FRIENDS" "COMPANION" "PARTNER")
    (kf :idx 1 :label "Approach Hook" :rule "Dominant hooked index approaches non-dominant hooked index" :tip [-45 -10 20] :knuckle [5 15 10] :wrist [65 55 -10] :nmf (nmf :mouth "friend" :brows "raised"))
    (kf :idx 2 :label "Interlock Clasp" :rule "Both index fingers lock together warmly" :tip [-55 5 16] :knuckle [-10 20 8] :wrist [50 65 -10] :nmf (nmf :mouth "friend" :brows "raised" :tilt "nod"))
  )

  (sign :id "sun" :word "SUN" :cat "stem" :gloss "SUN"
    :label "Sun / Solar"
    :desc "Dominant index traces a circle above head, then opens into a radiating open palm." :aliases ("SOLAR" "SUNLIGHT" "SUNSHINE")
    (kf :idx 1 :label "Trace Sun Circle" :rule "Index finger circles clockwise overhead" :tip [20 -70 30] :knuckle [45 -35 20] :wrist [75 10 0] :shape :point :nmf (nmf :mouth "sun" :brows "raised"))
    (kf :idx 2 :label "Radiate Solar Rays" :rule "Hand opens wide into spread claw shining down on solar system" :tip [35 -40 50] :knuckle [60 -10 35] :wrist [90 35 15] :shape :spread :nmf (nmf :mouth "sun" :brows "raised" :tilt "tilt-right"))
  )

  (sign :id "planet" :word "PLANET" :cat "stem" :gloss "PLANET"
    :label "Planet / World"
    :desc "Curved dominant hand traces an orbital arc around a spherical non-dominant base." :aliases ("PLANETS" "WORLD" "GLOBE")
    (kf :idx 1 :label "Orbital Approach" :rule "Curved claw hand positions above spherical base fist" :tip [-25 0 25] :knuckle [10 20 15] :wrist [60 65 0] :shape :claw :base-shift [-10 10 0] :nmf (nmf :mouth "planet" :brows "neutral"))
    (kf :idx 2 :label "Orbital Sweep" :rule "Dominant hand sweeps in a semi-circular orbital path around base" :tip [35 10 30] :knuckle [65 30 18] :wrist [105 70 5] :shape :claw :base-shift [-10 10 0] :nmf (nmf :mouth "planet" :brows "neutral"))
  )

  (sign :id "orbit" :word "ORBIT" :cat "stem" :gloss "ORBIT"
    :label "Orbit / Revolution"
    :desc "Dominant index revolves continuously around non-dominant vertical index core." :aliases ("REVOLVE" "REVOLUTION" "ORBITAL")
    (kf :idx 1 :label "Start Behind Axis" :rule "Dominant index arcs behind non-dominant anchor axis" :tip [-40 10 15] :knuckle [-5 25 10] :wrist [55 65 -5] :shape :point :base-shift [-15 20 0] :nmf (nmf :mouth "orbit" :brows "neutral"))
    (kf :idx 2 :label "Sweep Across Front" :rule "Dominant index sweeps forward in a broad horizontal elliptic curve" :tip [25 15 45] :knuckle [55 35 30] :wrist [90 70 15] :shape :point :base-shift [-15 20 0] :nmf (nmf :mouth "orbit" :brows "neutral"))
    (kf :idx 3 :label "Complete Loop" :rule "Returns to start point confirming continuous closed Keplerian orbit" :tip [-35 10 20] :knuckle [0 25 12] :wrist [60 65 -5] :shape :point :base-shift [-15 20 0] :nmf (nmf :mouth "orbit" :brows "neutral"))
  )

  (sign :id "earth" :word "EARTH" :cat "stem" :gloss "EARTH"
    :label "Earth / Terra"
    :desc "Both curved open hands form a sphere, tilting slightly on its axial plane." :aliases ("GLOBE" "TERRA" "WORLD")
    (kf :idx 1 :label "Form Top Hemispheres" :rule "Both curved hands frame the northern sphere" :tip [-10 5 30] :knuckle [25 25 18] :wrist [70 60 5] :shape :claw :base-shift [-30 0 0] :nmf (nmf :mouth "earth" :brows "neutral"))
    (kf :idx 2 :label "Rotate Axis" :rule "Hands tilt diagonally denoting axial tilt" :tip [15 15 32] :knuckle [45 35 20] :wrist [85 70 5] :shape :claw :base-shift [-30 -10 0] :nmf (nmf :mouth "earth" :brows "neutral" :tilt "tilt-left"))
  )

  (sign :id "moon" :word "MOON" :cat "stem" :gloss "MOON"
    :label "Moon / Lunar"
    :desc "C-hand (crescent shape) positioned near eye/temple, moving slightly upward." :aliases ("LUNAR" "CRESCENT")
    (kf :idx 1 :label "Crescent at Eye" :rule "Thumb and index form C-shape near dominant eye" :tip [55 -50 28] :knuckle [80 -20 18] :wrist [110 20 0] :shape :claw :nmf (nmf :mouth "moon" :brows "raised"))
    (kf :idx 2 :label "Ascend Lunar Arc" :rule "Crescent moves gently outward and upward into the night sky" :tip [70 -70 35] :knuckle [95 -40 22] :wrist [125 0 5] :shape :claw :nmf (nmf :mouth "moon" :brows "raised" :tilt "tilt-right"))
  )

  (sign :id "gravity" :word "GRAVITY" :cat "stem" :gloss "GRAVITY"
    :label "Gravity / Attraction"
    :desc "Open flat hand drops abruptly downward into flat base palm with authoritative weight." :aliases ("GRAVITATIONAL" "WEIGHT" "PULL")
    (kf :idx 1 :label "Suspended High" :rule "Dominant open hand suspended flat above base" :tip [-20 -20 30] :knuckle [15 0 20] :wrist [65 40 10] :shape :flat :base-shift [-10 25 0] :nmf (nmf :mouth "gravity" :brows "furrowed"))
    (kf :idx 2 :label "Sudden Downward Drop" :rule "Hand plunges straight down striking the base with gravitational mass" :tip [-40 30 15] :knuckle [-5 40 5] :wrist [55 75 -5] :shape :flat :base-shift [-10 25 0] :nmf (nmf :mouth "down" :brows "furrowed" :tilt "nod"))
  )

  (sign :id "fast" :word "FAST" :cat "stem" :gloss "FAST"
    :label "Fast / Rapid / Quick"
    :desc "Dominant index flicks rapidly across non-dominant index in a high-velocity spark." :aliases ("QUICK" "RAPID" "SPEED" "FASTEST")
    (kf :idx 1 :label "Cock Finger" :rule "Dominant hooked index poised right behind base index" :tip [-45 0 20] :knuckle [0 15 12] :wrist [60 55 0] :shape :point :base-shift [-15 10 0] :nmf (nmf :mouth "fast" :brows "raised"))
    (kf :idx 2 :label "High-Velocity Flick" :rule "Dominant index snaps rapidly forward in an instant strike" :tip [10 -10 50] :knuckle [40 10 35] :wrist [85 45 15] :shape :point :base-shift [-15 10 0] :nmf (nmf :mouth "fast" :brows "raised" :tilt "nod"))
  )

  (sign :id "time" :word "TIME" :cat "stem" :gloss "TIME"
    :label "Time / Period"
    :desc "Dominant index finger taps the wrist watch face twice on non-dominant carpal." :aliases ("CLOCK" "PERIOD" "DURATION" "HOUR")
    (kf :idx 1 :label "Tap Wrist 1" :rule "Dominant index taps outer wrist face of base hand" :tip [-55 35 10] :knuckle [-10 40 5] :wrist [45 70 -10] :shape :point :base-shift [-20 20 0] :nmf (nmf :mouth "time" :brows "neutral"))
    (kf :idx 2 :label "Lift" :rule "Slight rebound lift" :tip [-50 15 20] :knuckle [-5 25 12] :wrist [50 60 -5] :shape :point :base-shift [-20 20 0] :nmf (nmf :mouth "time" :brows "neutral"))
    (kf :idx 3 :label "Tap Wrist 2" :rule "Second tap confirming temporal measurement" :tip [-55 35 10] :knuckle [-10 40 5] :wrist [45 70 -10] :shape :point :base-shift [-20 20 0] :nmf (nmf :mouth "time" :brows "neutral"))
  )

  (sign :id "energy" :word "ENERGY" :cat "stem" :gloss "ENERGY"
    :label "Energy / Power"
    :desc "E-finger shape brushes firmly down the inner dominant forearm twice." :aliases ("POWER" "FORCE-FIELD")
    (kf :idx 1 :label "High Arm Start" :rule "Clawed fingertips touch upper forearm" :tip [40 -15 20] :knuckle [65 10 12] :wrist [100 50 0] :shape :claw :nmf (nmf :mouth "energy" :brows "neutral"))
    (kf :idx 2 :label "Power Stroke Down" :rule "Hand pulls down flexing wrist with kinetic vigor" :tip [25 25 25] :knuckle [50 45 15] :wrist [85 80 0] :shape :claw :nmf (nmf :mouth "energy" :brows "raised" :tilt "nod"))
  )

  (sign :id "force" :word "FORCE" :cat "stem" :gloss "FORCE"
    :label "Force / Push"
    :desc "Both flat open palms face forward at shoulder height and push outward with muscular effort." :aliases ("PUSH" "PRESSURE")
    (kf :idx 1 :label "Poised at Chest" :rule "Both flat hands held vertical in front of shoulders" :tip [0 -10 20] :knuckle [30 15 10] :wrist [75 55 0] :shape :flat :base-shift [-30 0 0] :nmf (nmf :mouth "force" :brows "furrowed"))
    (kf :idx 2 :label "Muscular Push Out" :rule "Both palms thrust forward driving against resistance" :tip [0 -5 65] :knuckle [25 20 50] :wrist [70 60 25] :shape :flat :base-shift [-30 0 0] :nmf (nmf :mouth "force" :brows "furrowed" :tilt "nod"))
  )

  (sign :id "what" :word "WHAT" :cat "conversation" :gloss "WHAT"
    :label "What / Query"
    :desc "Both open hands held forward palms up, swinging gently side to side with inquisitive furrowed brows." :aliases ("WHATS" "QUERY")
    (kf :idx 1 :label "Palms Up Chest Level" :rule "Both open flat hands held forward palms up at chest" :tip [15 10 30] :knuckle [45 30 20] :wrist [80 65 5] :shape :flat :base-mode :mirror :nmf (nmf :mouth "what" :brows "furrowed"))
    (kf :idx 2 :label "Inquisitive Side Swing" :rule "Both open palms swing outward slightly in inquiry" :tip [45 15 35] :knuckle [75 35 25] :wrist [110 70 10] :shape :flat :base-mode :mirror :nmf (nmf :mouth "what" :brows "furrowed" :tilt "nod"))
  )

  (sign :id "where" :word "WHERE" :cat "conversation" :gloss "WHERE"
    :label "Where / Location"
    :desc "Both flat palms facing upward held at chest level move in small horizontal circles with furrowed brows." :aliases ("WHERES")
    (kf :idx 1 :label "Palms Up Center" :rule "Open palms face upward held at mid chest" :tip [20 15 25] :knuckle [50 35 15] :wrist [85 70 0] :shape :flat :base-mode :mirror :nmf (nmf :mouth "where" :brows "furrowed"))
    (kf :idx 2 :label "Horizontal Search Circles" :rule "Hands circle slightly outward searching for location" :tip [40 15 35] :knuckle [70 35 25] :wrist [105 70 10] :shape :flat :base-mode :mirror :nmf (nmf :mouth "where" :brows "furrowed" :tilt "tilt-left"))
  )

  (sign :id "who" :word "WHO" :cat "conversation" :gloss "WHO"
    :label "Who / Person"
    :desc "Dominant index finger circles in small clockwise circles beside chin with furrowed inquisitive brows." :aliases ("WHOM" "WHOSE")
    (kf :idx 1 :label "Index Near Chin" :rule "Dominant index points upward beside right side of chin" :tip [30 -45 24] :knuckle [55 -15 14] :wrist [90 25 0] :shape :point :nmf (nmf :mouth "who" :brows "furrowed"))
    (kf :idx 2 :label "Inquisitive Circle" :rule "Dominant index circles gently beside mouth" :tip [25 -40 26] :knuckle [50 -10 16] :wrist [85 30 0] :shape :point :nmf (nmf :mouth "who" :brows "furrowed" :tilt "nod"))
  )

  (sign :id "why" :word "WHY" :cat "conversation" :gloss "WHY"
    :label "Why / Reason"
    :desc "Dominant index finger points and touches non-dominant chest/shoulder with furrowed inquiring brows." :aliases ("REASON")
    (kf :idx 1 :label "Touch Chest" :rule "Dominant index finger taps left upper chest" :tip [-20 -10 20] :knuckle [15 15 12] :wrist [65 55 0] :shape :point :nmf (nmf :mouth "why" :brows "furrowed"))
    (kf :idx 2 :label "Inquiring Rebound" :rule "Dominant index rebounds slightly outward with quizzical expression" :tip [-5 -20 35] :knuckle [30 5 25] :wrist [80 45 10] :shape :point :nmf (nmf :mouth "why" :brows "furrowed" :tilt "tilt-right"))
  )

  (sign :id "when" :word "WHEN" :cat "conversation" :gloss "WHEN"
    :label "When / Time Point"
    :desc "Dominant fingers flutter lightly forward across cheek from right to left like passing time." :aliases ("WHENEVER")
    (kf :idx 1 :label "Cheek Flutter Start" :rule "Fingertips poised near right cheekbone" :tip [45 -50 25] :knuckle [70 -20 15] :wrist [100 20 0] :shape :spread :nmf (nmf :mouth "when" :brows "furrowed"))
    (kf :idx 2 :label "Temporal Flutter Forward" :rule "Fingers flutter forward with furrowed questioning brows" :tip [55 -35 45] :knuckle [80 -5 30] :wrist [110 35 15] :shape :spread :nmf (nmf :mouth "when" :brows "furrowed" :tilt "nod"))
  )

  (sign :id "how" :word "HOW" :cat "conversation" :gloss "HOW"
    :label "How / Manner"
    :desc "Both curved hands with knuckles touching twist inward and outward from wrists, questioning brows." :aliases ("MANNER")
    (kf :idx 1 :label "Knuckles Touching" :rule "Both curved hands held knuckles together at chest" :tip [-10 10 25] :knuckle [25 30 15] :wrist [70 65 0] :shape :claw :base-mode :mirror :nmf (nmf :mouth "how" :brows "furrowed"))
    (kf :idx 2 :label "Twist Outward" :rule "Wrists rotate turning palms upward in inquiry" :tip [25 20 35] :knuckle [55 40 25] :wrist [95 75 10] :shape :flat :base-mode :mirror :nmf (nmf :mouth "how" :brows "furrowed" :tilt "tilt-left"))
  )

  (sign :id "goodbye" :word "GOODBYE" :cat "conversation" :gloss "GOODBYE"
    :label "Goodbye / Farewell"
    :desc "Dominant open flat hand waves warmly side-to-side at shoulder height." :aliases ("BYE" "FAREWELL" "SEE-YOU")
    (kf :idx 1 :label "Wave Left" :rule "Open flat hand tilts toward left at upper shoulder level" :tip [45 -50 30] :knuckle [70 -20 20] :wrist [100 20 5] :shape :flat :nmf (nmf :mouth "bye" :brows "raised"))
    (kf :idx 2 :label "Wave Right" :rule "Open flat hand tilts smoothly toward right with warm farewell smile" :tip [75 -45 35] :knuckle [95 -15 25] :wrist [120 25 10] :shape :flat :nmf (nmf :mouth "goodbye" :brows "raised" :tilt "tilt-right"))
  )

  (sign :id "name" :word "NAME" :cat "conversation" :gloss "NAME"
    :label "Name / Called"
    :desc "Dominant index and middle finger (H/V shape) brush across the forehead from left to right." :aliases ("NAMES" "CALLED" "NAMED")
    (kf :idx 1 :label "Forehead Left" :rule "Two fingers touch left side of forehead" :tip [-15 -65 25] :knuckle [20 -35 15] :wrist [65 5 0] :shape :v :nmf (nmf :mouth "name" :brows "neutral"))
    (kf :idx 2 :label "Forehead Sweep Across" :rule "Two fingers sweep across to right side of forehead" :tip [45 -65 25] :knuckle [70 -35 15] :wrist [100 5 0] :shape :v :nmf (nmf :mouth "name" :brows "neutral" :tilt "nod"))
  )

  (sign :id "sorry" :word "SORRY" :cat "conversation" :gloss "SORRY"
    :label "Sorry / Apology"
    :desc "Dominant closed fist makes gentle circular rubbing motion over heart with apologetic expression." :aliases ("APOLOGY" "APOLOGISE" "APOLOGIZE" "FORGIVE")
    (kf :idx 1 :label "Fist at Heart" :rule "Closed fist placed against left chest over heart" :tip [-15 0 20] :knuckle [15 25 10] :wrist [60 60 0] :shape :fist :nmf (nmf :mouth "sorry" :brows "furrowed"))
    (kf :idx 2 :label "Circular Rub Over Heart" :rule "Fist rubs circularly over heart with sincere head bow" :tip [-20 10 22] :knuckle [10 35 12] :wrist [55 70 0] :shape :fist :nmf (nmf :mouth "sorry" :brows "furrowed" :tilt "nod"))
  )

  (sign :id "welcome" :word "WELCOME" :cat "conversation" :gloss "WELCOME"
    :label "Welcome / Receive"
    :desc "Both open hands with palms facing inward sweep from outside inward toward heart in a welcoming embrace." :aliases ("HOSPITALITY" "WELCOME-ALL")
    (kf :idx 1 :label "Open Arms Wide" :rule "Both open hands spread outward welcoming visitor" :tip [65 0 30] :knuckle [90 25 20] :wrist [120 60 5] :shape :flat :base-mode :mirror :nmf (nmf :mouth "welcome" :brows "raised"))
    (kf :idx 2 :label "Gather to Heart" :rule "Hands sweep inward toward chest warmly receiving guest" :tip [15 5 25] :knuckle [45 30 15] :wrist [80 65 0] :shape :flat :base-mode :mirror :nmf (nmf :mouth "welcome" :brows "raised" :tilt "nod"))
  )

  (sign :id "start" :word "START" :cat "school" :gloss "START"
    :label "Start / Begin"
    :desc "Dominant index finger twists clockwise between non-dominant index and middle fingers like turning a key." :aliases ("BEGIN" "COMMENCE" "STARTS")
    (kf :idx 1 :label "Key in Ignition" :rule "Dominant index inserted between non-dominant index and middle" :tip [-45 15 16] :knuckle [5 25 8] :wrist [60 65 -10] :shape :point :base-mode :vowel-board :nmf (nmf :mouth "start" :brows "raised"))
    (kf :idx 2 :label "Twist Ignition Key" :rule "Dominant wrist rotates sharply turning key forward to initiate" :tip [-35 10 25] :knuckle [15 20 15] :wrist [70 55 0] :shape :point :base-mode :vowel-board :nmf (nmf :mouth "begin" :brows "raised" :tilt "nod"))
  )

  (sign :id "stop" :word "STOP" :cat "school" :gloss "STOP"
    :label "Stop / Halt"
    :desc "Dominant flat open hand chops down vertically onto flat horizontal palm of non-dominant hand." :aliases ("HALT" "CEASE" "STOPS" "FREEZE")
    (kf :idx 1 :label "Raise Chopping Hand" :rule "Dominant flat hand poised vertically above horizontal base palm" :tip [-40 -10 25] :knuckle [0 10 15] :wrist [55 50 0] :shape :flat :base-mode :vowel-board :nmf (nmf :mouth "stop" :brows "furrowed"))
    (kf :idx 2 :label "Decisive Palm Chop" :rule "Dominant hand chops firmly down striking base palm into complete halt" :tip [-45 25 12] :knuckle [5 35 5] :wrist [65 70 -10] :shape :flat :base-mode :vowel-board :nmf (nmf :mouth "stop" :brows "furrowed" :tilt "nod"))
  )

  (sign :id "sit" :word "SIT" :cat "school" :gloss "SIT"
    :label "Sit / Be Seated"
    :desc "Dominant hooked two fingers press downward onto non-dominant horizontal fingers like legs sitting down." :aliases ("SIT-DOWN" "SEAT" "SEATED")
    (kf :idx 1 :label "Legs Poised Above Seat" :rule "Hooked two fingers hover above base fingers" :tip [-45 0 22] :knuckle [0 15 12] :wrist [55 55 0] :shape :claw :base-mode :vowel-board :nmf (nmf :mouth "sit" :brows "neutral"))
    (kf :idx 2 :label "Press Down to Sit" :rule "Fingers press firmly down onto base denoting sitting down" :tip [-45 25 14] :knuckle [5 35 5] :wrist [65 70 -10] :shape :claw :base-mode :vowel-board :nmf (nmf :mouth "sit" :brows "neutral" :tilt "nod"))
  )

  (sign :id "stand" :word "STAND" :cat "school" :gloss "STAND"
    :label "Stand / Stand Up"
    :desc "Dominant inverted V-fingers stand upright on non-dominant flat palm, then elevate upward." :aliases ("STAND-UP" "UPRIGHT")
    (kf :idx 1 :label "Standing on Palm" :rule "Inverted V-fingers stand upright on non-dominant palm" :tip [-45 20 14] :knuckle [0 0 20] :wrist [55 -20 25] :shape :v :base-mode :vowel-board :nmf (nmf :mouth "stand" :brows "raised"))
    (kf :idx 2 :label "Rise Tall" :rule "Hand lifts upward asserting tall upright posture" :tip [-35 -25 30] :knuckle [10 -45 35] :wrist [65 -65 40] :shape :v :base-mode :vowel-board :nmf (nmf :mouth "up" :brows "raised" :tilt "nod"))
  )

  (sign :id "wait" :word "WAIT" :cat "school" :gloss "WAIT"
    :label "Wait / Hold On"
    :desc "Both flat open hands held out palm forward at mid-chest in reassuring calm posture." :aliases ("HOLD-ON" "PAUSE" "PATIENCE")
    (kf :idx 1 :label "Palm Forward Halt" :rule "Both flat hands pushed forward facing listener at mid-chest" :tip [25 -10 45] :knuckle [55 15 30] :wrist [90 55 10] :shape :flat :base-mode :mirror :nmf (nmf :mouth "wait" :brows "neutral"))
    (kf :idx 2 :label "Calm Reassurance" :rule "Hands pulse gently forward reminding student to hold on" :tip [25 -5 55] :knuckle [55 20 40] :wrist [90 60 20] :shape :flat :base-mode :mirror :nmf (nmf :mouth "wait" :brows "neutral" :tilt "nod"))
  )

  (sign :id "finish" :word "FINISH" :cat "school" :gloss "FINISH"
    :label "Finish / Completed"
    :desc "Both flat open hands held out in front flick outward from wrists decisively confirming completion." :aliases ("DONE" "COMPLETED" "FINISHED" "END")
    (kf :idx 1 :label "Hands Poised Inward" :rule "Both open flat hands held facing inward at chest level" :tip [-10 5 25] :knuckle [25 25 15] :wrist [70 60 0] :shape :flat :base-mode :mirror :nmf (nmf :mouth "finish" :brows "raised"))
    (kf :idx 2 :label "Flick Outward Done" :rule "Both hands flick outward shaking off tasks in finality" :tip [45 20 35] :knuckle [75 40 25] :wrist [110 75 10] :shape :spread :base-mode :mirror :nmf (nmf :mouth "done" :brows "raised" :tilt "nod"))
  )

  (sign :id "correct" :word "CORRECT" :cat "school" :gloss "CORRECT"
    :label "Correct / Right"
    :desc "Dominant extended index finger taps firmly onto non-dominant index finger twice in clear affirmation." :aliases ("RIGHT" "ACCURATE" "EXACT")
    (kf :idx 1 :label "Align Index Fingers" :rule "Dominant index taps down onto non-dominant index" :tip [-45 15 18] :knuckle [5 25 8] :wrist [65 60 -10] :shape :point :base-mode :vowel-board :nmf (nmf :mouth "correct" :brows "raised"))
    (kf :idx 2 :label "Affirmative Second Tap" :rule "Rebounds and strikes index firmly confirming correct answer" :tip [-45 15 18] :knuckle [5 25 8] :wrist [65 60 -10] :shape :point :base-mode :vowel-board :nmf (nmf :mouth "right" :brows "raised" :tilt "nod"))
  )

  (sign :id "wrong" :word "WRONG" :cat "school" :gloss "WRONG"
    :label "Wrong / Incorrect"
    :desc "Dominant crooked finger taps against chin/cheek, shaking head with furrowed brows." :aliases ("INCORRECT" "MISTAKE" "ERROR" "FALSE")
    (kf :idx 1 :label "Tap Chin" :rule "Dominant hooked index finger touches side of chin" :tip [25 -45 24] :knuckle [55 -15 14] :wrist [90 25 0] :shape :claw :nmf (nmf :mouth "wrong" :brows "furrowed" :tilt "tilt-left"))
    (kf :idx 2 :label "Correction Tap" :rule "Hooked finger taps second time with head shake" :tip [25 -45 24] :knuckle [55 -15 14] :wrist [90 25 0] :shape :claw :nmf (nmf :mouth "no" :brows "furrowed" :tilt "tilt-right"))
  )

  (sign :id "happy" :word "HAPPY" :cat "conversation" :gloss "HAPPY"
    :label "Happy / Joyful"
    :desc "Dominant flat open hand brushes upward twice across the chest in cheerful light strokes with broad smile." :aliases ("GLAD" "JOY" "JOYFUL" "DELIGHT")
    (kf :idx 1 :label "Brush Up Chest 1" :rule "Flat open hand brushes up across chest" :tip [-10 10 20] :knuckle [25 35 10] :wrist [70 70 0] :shape :flat :base-mode :vowel-board :nmf (nmf :mouth "happy" :brows "raised"))
    (kf :idx 2 :label "Brush Up Chest 2" :rule "Second light buoyant upward stroke beaming with joyful enthusiasm" :tip [10 -25 30] :knuckle [45 0 18] :wrist [85 40 5] :shape :flat :base-mode :vowel-board :nmf (nmf :mouth "happy" :brows "raised" :tilt "nod"))
  )

  (sign :id "sad" :word "SAD" :cat "conversation" :gloss "SAD"
    :label "Sad / Unhappy"
    :desc "Dominant open hand fingertips stroke slowly downward past cheek and chest with downcast expression." :aliases ("UNHAPPY" "SORROW" "GLUM" "DOWN")
    (kf :idx 1 :label "Touch High Cheek" :rule "Fingertips gently touch upper cheek near eye" :tip [40 -50 25] :knuckle [65 -20 15] :wrist [95 20 0] :shape :flat :nmf (nmf :mouth "sad" :brows "furrowed"))
    (kf :idx 2 :label "Slow Downward Draw" :rule "Hand draws slowly down toward lower chest reflecting downcast emotion" :tip [20 25 20] :knuckle [45 50 10] :wrist [80 85 0] :shape :flat :nmf (nmf :mouth "sad" :brows "furrowed" :tilt "nod"))
  )

  (sign :id "more" :word "MORE" :cat "conversation" :gloss "MORE"
    :label "More / Additional"
    :desc "Dominant flat hand rests on non-dominant flat hand then scoops forward adding more." :aliases ("ADDITIONAL" "EXTRA" "PLUS")
    (kf :idx 1 :label "Rest on Base Hand" :rule "Dominant flat hand rests on horizontal base palm" :tip [-45 20 14] :knuckle [5 35 5] :wrist [65 70 -10] :shape :flat :base-mode :vowel-board :nmf (nmf :mouth "more" :brows "raised"))
    (kf :idx 2 :label "Scoop Forward Adding More" :rule "Hand sweeps forward and upward gathering additional quantity" :tip [-20 0 45] :knuckle [15 15 35] :wrist [75 50 15] :shape :flat :base-mode :vowel-board :nmf (nmf :mouth "more" :brows "raised" :tilt "nod"))
  )

  (sign :id "again" :word "AGAIN" :cat "conversation" :gloss "AGAIN"
    :label "Again / Repeat"
    :desc "Dominant two fingers (V-shape) arc over and tap non-dominant palm in repetition." :aliases ("REPEAT" "ONCE-MORE" "ENCORE")
    (kf :idx 1 :label "Arc Above Palm" :rule "Two fingers arc above non-dominant open palm" :tip [-45 -10 25] :knuckle [0 10 15] :wrist [55 50 0] :shape :v :base-mode :vowel-board :nmf (nmf :mouth "again" :brows "raised"))
    (kf :idx 2 :label "Tap Palm Again" :rule "Two fingers tap down decisively onto base palm confirming repetition" :tip [-45 25 14] :knuckle [5 35 5] :wrist [65 70 -10] :shape :v :base-mode :vowel-board :nmf (nmf :mouth "again" :brows "raised" :tilt "nod"))
  )

  (sign :id "slow" :word "SLOW" :cat "stem" :gloss "SLOW"
    :label "Slow / Deliberate"
    :desc "Dominant flat hand glides slowly and smoothly up the back of non-dominant forearm." :aliases ("SLOWLY" "DELAY" "GENTLE")
    (kf :idx 1 :label "Glide Start at Wrist" :rule "Dominant fingertips touch back of non-dominant wrist" :tip [-65 35 10] :knuckle [-20 40 5] :wrist [35 70 -10] :shape :flat :base-mode :vowel-board :nmf (nmf :mouth "slow" :brows "neutral"))
    (kf :idx 2 :label "Smooth Upward Stroke" :rule "Hand glides slowly up forearm toward elbow" :tip [-30 15 16] :knuckle [15 25 8] :wrist [70 55 0] :shape :flat :base-mode :vowel-board :nmf (nmf :mouth "slow" :brows "neutral" :tilt "nod"))
  )

  (sign :id "big" :word "BIG" :cat "stem" :gloss "BIG"
    :label "Big / Large"
    :desc "Both curved claw hands start together in center and spread widely apart indicating vast scale." :aliases ("LARGE" "HUGE" "GREAT" "GIANT")
    (kf :idx 1 :label "Center Bounds" :rule "Curved hands held together framing moderate boundary" :tip [-10 0 25] :knuckle [20 20 15] :wrist [65 55 0] :shape :claw :base-mode :mirror :nmf (nmf :mouth "big" :brows "raised"))
    (kf :idx 2 :label "Expand Wide Apart" :rule "Hands push widely outward with puffed cheeks indicating immense size" :tip [75 -15 40] :knuckle [105 10 28] :wrist [140 45 12] :shape :claw :base-mode :mirror :nmf (nmf :mouth "huge" :brows "raised" :tilt "nod"))
  )

  (sign :id "small" :word "SMALL" :cat "stem" :gloss "SMALL"
    :label "Small / Little"
    :desc "Dominant thumb and index finger pinch close together showing a tiny gap with squinted eyes." :aliases ("LITTLE" "TINY" "MINIATURE")
    (kf :idx 1 :label "Measure Tiny Gap" :rule "Thumb and index pinched closely apart in front of eye" :tip [35 -35 30] :knuckle [60 -10 18] :wrist [95 35 0] :shape :claw :nmf (nmf :mouth "small" :brows "furrowed"))
    (kf :idx 2 :label "Pinch Narrower" :rule "Fingers narrow gap closer showing minuscule dimension" :tip [30 -30 35] :knuckle [55 -5 22] :wrist [90 40 5] :shape :claw :nmf (nmf :mouth "tiny" :brows "furrowed" :tilt "nod"))
  )

  (sign :id "all" :word "ALL" :cat "conversation" :gloss "ALL"
    :label "All / Everyone"
    :desc "Both open hands sweep from outward inward in a broad inclusive embrace gathering everything." :aliases ("EVERYONE" "EVERYBODY" "WHOLE")
    (kf :idx 1 :label "Broad Perimeter" :rule "Both open hands reach out wide encompassing entire perimeter" :tip [60 -10 30] :knuckle [85 15 20] :wrist [115 50 5] :shape :flat :base-mode :mirror :nmf (nmf :mouth "all" :brows "raised"))
    (kf :idx 2 :label "Inclusive Circle Inward" :rule "Hands sweep inward completing circle to join at center" :tip [-10 10 25] :knuckle [25 30 15] :wrist [70 65 0] :shape :flat :base-mode :mirror :nmf (nmf :mouth "all" :brows "raised" :tilt "nod"))
  )

  (sign :id "give" :word "GIVE" :cat "grammar" :gloss "GIVE"
    :label "Give / Provide"
    :desc "Flat cupped hand sweeps forward from sender locus to recipient locus with slight wrist flick." :aliases ("PROVIDE" "GIVES" "GAVE" "GIVING") :directional true :default-loci (:from "ME" :to "YOU")
    (kf :idx 1 :label "Source Origin" :rule "Hand holds open palm up near body at origin locus" :tip [20 25 20] :knuckle [45 45 12] :wrist [80 75 0] :shape :flat :nmf (nmf :mouth "give" :brows "neutral"))
    (kf :idx 2 :label "Deliver to Destination" :rule "Hand sweeps outward and presents palm to destination locus" :tip [10 -15 60] :knuckle [35 10 45] :wrist [75 45 30] :shape :flat :nmf (nmf :mouth "give" :brows "neutral" :tilt "nod"))
  )

  (sign :id "tell" :word "TELL" :cat "grammar" :gloss "TELL"
    :label "Tell / Inform"
    :desc "Dominant index fingertip touches side of chin/lips and projects forward towards recipient." :aliases ("INFORM" "TELLS" "TOLD" "TELLING") :directional true :default-loci (:from "ME" :to "YOU")
    (kf :idx 1 :label "Touch Lips" :rule "Index finger touches side of chin below bottom lip" :tip [12 -52 24] :knuckle [38 -25 15] :wrist [75 25 0] :shape :point :nmf (nmf :mouth "tell" :brows "neutral"))
    (kf :idx 2 :label "Project Forward to Addressee" :rule "Index finger flicks forward from lips straight toward recipient locus" :tip [8 -25 58] :knuckle [32 0 40] :wrist [70 35 25] :shape :point :nmf (nmf :mouth "tell" :brows "neutral"))
  )

  (sign :id "ask" :word "ASK" :cat "grammar" :gloss "ASK"
    :label "Ask / Inquire"
    :desc "Hooked index finger points towards recipient locus with inquisitive slight forward head tilt." :aliases ("INQUIRE" "QUESTION" "ASKS" "ASKED" "ASKING") :directional true :default-loci (:from "ME" :to "YOU")
    (kf :idx 1 :label "Inquisitive Origin" :rule "Hooked index points forward from chest" :tip [15 10 30] :knuckle [42 32 20] :wrist [80 65 5] :shape :point :nmf (nmf :mouth "ask" :brows "furrowed"))
    (kf :idx 2 :label "Direct Query to Locus" :rule "Index extends forward reaching toward destination locus" :tip [5 -15 62] :knuckle [30 8 45] :wrist [72 40 28] :shape :point :nmf (nmf :mouth "ask" :brows "furrowed" :tilt "nod"))
  )

  (sign :id "show" :word "SHOW" :cat "grammar" :gloss "SHOW"
    :label "Show / Demonstrate"
    :desc "Non-dominant flat palm faces forward, dominant index presses palm pushing forward towards recipient." :aliases ("DEMONSTRATE" "DISPLAY" "SHOWS" "SHOWED" "SHOWING") :directional true :default-loci (:from "ME" :to "YOU")
    (kf :idx 1 :label "Index to Base Palm" :rule "Dominant index presses into center of open non-dominant palm facing target" :tip [-35 5 25] :knuckle [5 20 15] :wrist [55 60 0] :shape :point :base-mode :vowel-board :nmf (nmf :mouth "show" :brows "neutral"))
    (kf :idx 2 :label "Push Outward Together" :rule "Both hands push forward in unison presenting the evidence to destination locus" :tip [-20 -20 55] :knuckle [15 -2 42] :wrist [60 30 25] :shape :point :base-mode :vowel-board :base-shift [15 -20 30] :nmf (nmf :mouth "show" :brows "raised" :tilt "nod"))
  )

  (sign :id "explain" :word "EXPLAIN" :cat "grammar" :gloss "EXPLAIN"
    :label "Explain / Clarify"
    :desc "Both hands open and close alternating fingers pushing forward towards recipient." :aliases ("CLARIFY" "DESCRIBE" "EXPLAINS" "EXPLAINED" "EXPLAINING") :directional true
    (kf :idx 1 :label "Alternating Right Forward" :rule "Right hand pushes forward with fingers fluttering open" :tip [25 -10 45] :knuckle [50 15 30] :wrist [85 50 15] :shape :spread :base-mode :mirror :nmf (nmf :mouth "explain" :brows "neutral"))
    (kf :idx 2 :label "Alternating Left Forward" :rule "Left hand pushes forward while right recedes" :tip [10 5 30] :knuckle [40 25 20] :wrist [75 60 5] :shape :claw :base-mode :mirror :base-shift [25 -15 20] :nmf (nmf :mouth "explain" :brows "neutral"))
  )

  (sign :id "yesterday" :word "YESTERDAY" :cat "temporal" :gloss "YESTERDAY"
    :label "Yesterday / Past Day"
    :desc "Thumb of dominant fist points backwards over shoulder into the past timeline." :aliases ("PAST-DAY")
    (kf :idx 1 :label "Thumb at Cheek" :rule "Fist with extended thumb begins beside cheek" :tip [45 -45 22] :knuckle [65 -20 12] :wrist [95 20 -5] :shape :fist :nmf (nmf :mouth "yesterday" :brows "neutral"))
    (kf :idx 2 :label "Thumb Points Over Shoulder" :rule "Thumb flicks backward past shoulder into past timeline" :tip [60 -60 -10] :knuckle [80 -30 -15] :wrist [105 10 -25] :shape :fist :nmf (nmf :mouth "yesterday" :brows "neutral" :tilt "tilt-right"))
  )

  (sign :id "today" :word "TODAY" :cat "temporal" :gloss "TODAY"
    :label "Today / Present Day"
    :desc "Both open hands palm up drop firmly twice in front of waist indicating this day." :aliases ("THIS-DAY" "CURRENT-DAY")
    (kf :idx 1 :label "Hands Raised" :rule "Both open flat hands palm up held at waist level" :tip [35 15 25] :knuckle [60 35 15] :wrist [95 65 0] :shape :flat :base-mode :mirror :nmf (nmf :mouth "today" :brows "neutral"))
    (kf :idx 2 :label "Firm Downward Pulse" :rule "Both hands drop firmly downward asserting the present moment" :tip [35 40 25] :knuckle [60 55 15] :wrist [95 85 0] :shape :flat :base-mode :mirror :nmf (nmf :mouth "today" :brows "neutral" :tilt "nod"))
  )

  (sign :id "tomorrow" :word "TOMORROW" :cat "temporal" :gloss "TOMORROW"
    :label "Tomorrow / Next Day"
    :desc "Thumb of dominant fist flicks forward from cheek into the future timeline." :aliases ("NEXT-DAY")
    (kf :idx 1 :label "Thumb at Jawline" :rule "Thumb tip touches side of jaw near ear" :tip [42 -40 18] :knuckle [65 -18 10] :wrist [95 25 -5] :shape :fist :nmf (nmf :mouth "tomorrow" :brows "neutral"))
    (kf :idx 2 :label "Forward Arc into Future" :rule "Thumb arches forward away from jawline into upcoming future space" :tip [30 -30 52] :knuckle [55 -5 35] :wrist [90 30 18] :shape :fist :nmf (nmf :mouth "tomorrow" :brows "neutral"))
  )

  (sign :id "now" :word "NOW" :cat "temporal" :gloss "NOW"
    :label "Now / Immediately"
    :desc "Both hands bend downward firmly in front of body at present waist level." :aliases ("CURRENTLY" "PRESENT" "IMMEDIATELY")
    (kf :idx 1 :label "Wrists Poised" :rule "Both flat hands point slightly upward at lower chest" :tip [30 10 25] :knuckle [55 30 15] :wrist [90 60 0] :shape :flat :base-mode :mirror :nmf (nmf :mouth "now" :brows "raised"))
    (kf :idx 2 :label "Crisp Downward Drop" :rule "Both hands drop crisply downward snapping into present plane" :tip [30 35 25] :knuckle [55 50 15] :wrist [90 80 0] :shape :flat :base-mode :mirror :nmf (nmf :mouth "now" :brows "raised" :tilt "nod"))
  )

  (sign :id "future" :word "FUTURE" :cat "temporal" :gloss "FUTURE"
    :label "Future / Ahead"
    :desc "Flat open hand sweeps forward from side of temple into distant space." :aliases ("AHEAD" "LATER" "UPCOMING" "SOON")
    (kf :idx 1 :label "Temple Origin" :rule "Flat open hand held vertical beside eye/temple" :tip [35 -55 22] :knuckle [58 -25 12] :wrist [90 15 0] :shape :flat :nmf (nmf :mouth "future" :brows "raised"))
    (kf :idx 2 :label "Long Forward Sweep" :rule "Flat hand sweeps far forward slicing through upcoming future timeline" :tip [20 -35 70] :knuckle [45 -5 50] :wrist [80 25 30] :shape :flat :nmf (nmf :mouth "future" :brows "raised"))
  )

  (sign :id "past" :word "PAST" :cat "temporal" :gloss "PAST"
    :label "Past / Ago"
    :desc "Flat hand waves backward over dominant shoulder into history." :aliases ("AGO" "BEFORE" "PREVIOUSLY" "HISTORY")
    (kf :idx 1 :label "At Shoulder" :rule "Flat hand vertical in front of dominant shoulder" :tip [40 -30 20] :knuckle [62 -5 10] :wrist [90 35 0] :shape :flat :nmf (nmf :mouth "past" :brows "neutral"))
    (kf :idx 2 :label "Wave Backward Over Shoulder" :rule "Hand sweeps backward past shoulder into past timeline" :tip [55 -50 -15] :knuckle [75 -20 -20] :wrist [100 15 -30] :shape :flat :nmf (nmf :mouth "past" :brows "neutral" :tilt "tilt-right"))
  )

  (sign :id "morning" :word "MORNING" :cat "temporal" :gloss "MORNING"
    :label "Morning / Dawn"
    :desc "Dominant hand rises like the dawn sun rising above horizontal non-dominant arm." :aliases ("DAWN" "AM")
    (kf :idx 1 :label "Below Horizon" :rule "Cupped hand rests beneath non-dominant forearm" :tip [-10 35 20] :knuckle [20 55 12] :wrist [60 85 0] :shape :flat :base-mode :vowel-board :nmf (nmf :mouth "morning" :brows "neutral"))
    (kf :idx 2 :label "Sun Rises Above Horizon" :rule "Hand rises upward above forearm spreading light" :tip [0 -20 32] :knuckle [25 10 20] :wrist [65 50 5] :shape :spread :base-mode :vowel-board :nmf (nmf :mouth "morning" :brows "raised" :tilt "nod"))
  )

  (sign :id "afternoon" :word "AFTERNOON" :cat "temporal" :gloss "AFTERNOON"
    :label "Afternoon / PM"
    :desc "Dominant flat hand rests on non-dominant arm and tilts gently downward." :aliases ("PM" "MIDDAY")
    (kf :idx 1 :label "Arm Rest High" :rule "Dominant elbow rests on non-dominant fingertips pointing slightly up" :tip [15 -30 30] :knuckle [40 0 20] :wrist [75 40 5] :shape :flat :base-mode :vowel-board :nmf (nmf :mouth "afternoon" :brows "neutral"))
    (kf :idx 2 :label "Tilt Downward" :rule "Hand tilts gently downward as afternoon progresses" :tip [25 5 30] :knuckle [45 25 18] :wrist [75 55 5] :shape :flat :base-mode :vowel-board :nmf (nmf :mouth "afternoon" :brows "neutral"))
  )

  (sign :id "understand" :word "UNDERSTAND" :cat "grammar" :gloss "UNDERSTAND"
    :label "Understand / Comprehend"
    :desc "Index finger flicks upward next to temple like an enlightened spark of comprehension." :aliases ("COMPREHEND" "GET-IT" "UNDERSTOOD")
    (kf :idx 1 :label "Fist at Temple" :rule "Fist held beside temple with index curled" :tip [32 -48 18] :knuckle [55 -25 10] :wrist [85 18 0] :shape :fist :nmf (nmf :mouth "understand" :brows "raised"))
    (kf :idx 2 :label "Index Sparks Upward" :rule "Index finger springs upright in comprehension" :tip [32 -72 25] :knuckle [55 -40 15] :wrist [85 5 0] :shape :point :nmf (nmf :mouth "understand" :brows "raised" :tilt "nod"))
  )

  (sign :id "agree" :word "AGREE" :cat "grammar" :gloss "AGREE"
    :label "Agree / Concur"
    :desc "Index points to head, then dominant flat hand drops firmly onto non-dominant palm." :aliases ("CONCUR" "CONSENT" "AGREES" "AGREED")
    (kf :idx 1 :label "Point to Head" :rule "Dominant index touches temple (same thought)" :tip [30 -52 20] :knuckle [55 -25 10] :wrist [85 18 0] :shape :point :nmf (nmf :mouth "agree" :brows "raised"))
    (kf :idx 2 :label "Hands Unite in Agreement" :rule "Dominant flat hand drops firmly into non-dominant open palm" :tip [-30 15 22] :knuckle [5 32 12] :wrist [55 68 0] :shape :flat :base-mode :vowel-board :nmf (nmf :mouth "agree" :brows "raised" :tilt "nod"))
  )

  (sign :id "disagree" :word "DISAGREE" :cat "grammar" :gloss "DISAGREE"
    :label "Disagree / Differ"
    :desc "Index points to head then index fingers cross with a firm head shake." :aliases ("DIFFER" "DISAGREES" "DISAGREED")
    (kf :idx 1 :label "Point to Head" :rule "Index points to temple" :tip [30 -52 20] :knuckle [55 -25 10] :wrist [85 18 0] :shape :point :nmf (nmf :mouth "differ" :brows "furrowed"))
    (kf :idx 2 :label "Cross Fingers No" :rule "Both index fingers cross in negation with head shake" :tip [0 5 28] :knuckle [30 25 18] :wrist [70 60 5] :shape :point :base-mode :mirror :nmf (nmf :mouth "no" :brows "furrowed" :tilt "shake"))
  )

  (sign :id "remember" :word "REMEMBER" :cat "grammar" :gloss "REMEMBER"
    :label "Remember / Recall"
    :desc "Dominant thumb touches forehead then drops to join non-dominant thumb in memory locked." :aliases ("RECALL" "MEMORIZE" "REMEMBERS")
    (kf :idx 1 :label "Touch Forehead" :rule "Thumb of dominant fist touches side of forehead" :tip [25 -55 22] :knuckle [50 -28 12] :wrist [80 15 0] :shape :fist :nmf (nmf :mouth "remember" :brows "raised"))
    (kf :idx 2 :label "Lock Thumbs Together" :rule "Dominant thumb drops and locks onto non-dominant thumb" :tip [-15 10 25] :knuckle [15 30 15] :wrist [60 65 0] :shape :fist :base-mode :vowel-board :nmf (nmf :mouth "remember" :brows "neutral" :tilt "nod"))
  )

  (sign :id "forget" :word "FORGET" :cat "grammar" :gloss "FORGET"
    :label "Forget / Blank"
    :desc "Flat open hand wipes across forehead as if clearing thoughts from mind." :aliases ("FORGOT" "FORGOTTEN")
    (kf :idx 1 :label "Hand at Temple" :rule "Open flat hand rests across temple and forehead" :tip [0 -60 25] :knuckle [35 -35 15] :wrist [75 5 0] :shape :flat :nmf (nmf :mouth "forget" :brows "furrowed"))
    (kf :idx 2 :label "Wipe Across" :rule "Hand sweeps laterally across forehead into space" :tip [45 -60 25] :knuckle [75 -35 15] :wrist [105 5 0] :shape :flat :nmf (nmf :mouth "blank" :brows "furrowed" :tilt "shake"))
  )

  (sign :id "think" :word "THINK" :cat "grammar" :gloss "THINK"
    :label "Think / Ponder"
    :desc "Dominant index finger taps or gently circles temple in reflection." :aliases ("PONDER" "CONSIDER" "THINKS" "THOUGHT")
    (kf :idx 1 :label "Index at Temple" :rule "Index finger touches side of temple" :tip [28 -52 22] :knuckle [55 -25 12] :wrist [85 18 0] :shape :point :nmf (nmf :mouth "think" :brows "raised"))
    (kf :idx 2 :label "Reflective Tap" :rule "Index finger taps temple in contemplation" :tip [28 -50 20] :knuckle [55 -23 10] :wrist [85 20 0] :shape :point :nmf (nmf :mouth "think" :brows "raised"))
  )

  (sign :id "know" :word "KNOW" :cat "grammar" :gloss "KNOW"
    :label "Know / Aware"
    :desc "Fingertips of dominant flat hand touch side of forehead twice." :aliases ("AWARE" "KNOWS" "KNEW" "KNOWN")
    (kf :idx 1 :label "Touch Forehead" :rule "Fingertips of bent flat hand tap side of forehead" :tip [25 -55 22] :knuckle [52 -30 12] :wrist [82 15 0] :shape :flat :nmf (nmf :mouth "know" :brows "raised"))
    (kf :idx 2 :label "Second Tap" :rule "Fingertips confirm contact on forehead with head nod" :tip [25 -53 20] :knuckle [52 -28 10] :wrist [82 17 0] :shape :flat :nmf (nmf :mouth "know" :brows "raised" :tilt "nod"))
  )

  (sign :id "want" :word "WANT" :cat "grammar" :gloss "WANT"
    :label "Want / Desire"
    :desc "Both clawed hands palm up pull smoothly inwards toward the chest." :aliases ("DESIRE" "WANTS" "WANTED")
    (kf :idx 1 :label "Reach Outward" :rule "Both hands open clawed palms up reaching forward" :tip [25 0 45] :knuckle [50 25 30] :wrist [85 60 15] :shape :claw :base-mode :mirror :nmf (nmf :mouth "want" :brows "raised"))
    (kf :idx 2 :label "Pull Inward" :rule "Both clawed hands pull inward towards body" :tip [20 20 25] :knuckle [45 40 15] :wrist [80 70 0] :shape :claw :base-mode :mirror :nmf (nmf :mouth "want" :brows "neutral" :tilt "nod"))
  )

  (sign :id "need" :word "NEED" :cat "grammar" :gloss "NEED"
    :label "Need / Require"
    :desc "Bent index finger nods firmly downward in front of body in requirement." :aliases ("REQUIRE" "MUST-HAVE" "NEEDS" "NEEDED")
    (kf :idx 1 :label "Hook Up" :rule "Bent hooked index finger held at mid chest" :tip [20 5 30] :knuckle [45 25 20] :wrist [80 60 5] :shape :point :nmf (nmf :mouth "need" :brows "furrowed"))
    (kf :idx 2 :label "Firm Downward Bend" :rule "Hooked index nods firmly downward expressing imperative necessity" :tip [20 28 30] :knuckle [45 45 20] :wrist [80 75 5] :shape :point :nmf (nmf :mouth "need" :brows "furrowed" :tilt "nod"))
  )

  (sign :id "can" :word "CAN" :cat "grammar" :gloss "CAN"
    :label "Can / Able"
    :desc "Both fists nod downward firmly in affirmative capability." :aliases ("ABLE" "COULD" "POSSIBLE")
    (kf :idx 1 :label "Fists Poised" :rule "Both fists held in front of body at waist level" :tip [25 15 25] :knuckle [50 35 15] :wrist [85 65 0] :shape :fist :base-mode :mirror :nmf (nmf :mouth "can" :brows "raised"))
    (kf :idx 2 :label "Affirmative Nod Down" :rule "Both fists drop firmly downward confirming ability" :tip [25 38 25] :knuckle [50 55 15] :wrist [85 85 0] :shape :fist :base-mode :mirror :nmf (nmf :mouth "can" :brows "raised" :tilt "nod"))
  )

  (sign :id "cannot" :word "CANNOT" :cat "grammar" :gloss "CANNOT"
    :label "Cannot / Unable"
    :desc "Dominant index crosses and strikes down off non-dominant index with head shake." :aliases ("CAN'T" "UNABLE" "IMPOSSIBLE")
    (kf :idx 1 :label "Index Raised Above Non-Dominant" :rule "Dominant index raised above non-dominant extended index finger" :tip [-25 -5 25] :knuckle [5 15 15] :wrist [50 55 0] :shape :point :base-mode :vowel-board :nmf (nmf :mouth "cant" :brows "furrowed"))
    (kf :idx 2 :label "Strike Down and Past" :rule "Dominant index strikes past non-dominant index with emphatic head shake" :tip [-25 30 25] :knuckle [5 45 15] :wrist [50 80 0] :shape :point :base-mode :vowel-board :nmf (nmf :mouth "no" :brows "furrowed" :tilt "shake"))
  )

  (sign :id "must" :word "MUST" :cat "grammar" :gloss "MUST"
    :label "Must / Obligation"
    :desc "Index finger points down firmly with strong downward thrust." :aliases ("HAVE-TO" "OBLIGATED")
    (kf :idx 1 :label "Point Raised" :rule "Index finger points forward at chest level" :tip [20 -10 30] :knuckle [45 15 20] :wrist [80 55 5] :shape :point :nmf (nmf :mouth "must" :brows "furrowed"))
    (kf :idx 2 :label "Forceful Downward Thrust" :rule "Index thrusts firmly downward in absolute mandate" :tip [20 35 30] :knuckle [45 55 20] :wrist [80 85 5] :shape :point :nmf (nmf :mouth "must" :brows "furrowed" :tilt "nod"))
  )

  (sign :id "because" :word "BECAUSE" :cat "grammar" :gloss "BECAUSE"
    :label "Because / Reason"
    :desc "Index finger taps side of forehead then drops into open flat hand." :aliases ("REASON" "WHY-BECAUSE")
    (kf :idx 1 :label "Tap Forehead" :rule "Dominant index taps side of forehead" :tip [28 -52 22] :knuckle [55 -25 12] :wrist [85 18 0] :shape :point :nmf (nmf :mouth "because" :brows "raised"))
    (kf :idx 2 :label "Present Reason" :rule "Hand opens into flat palm up explaining the cause" :tip [25 10 35] :knuckle [50 35 25] :wrist [85 65 10] :shape :flat :nmf (nmf :mouth "reason" :brows "neutral"))
  )

  (sign :id "if" :word "IF" :cat "grammar" :gloss "IF"
    :label "If / Conditional"
    :desc "Dominant little finger taps cheek twice in classical BSL conditional marker." :aliases ("SUPPOSE" "WHETHER")
    (kf :idx 1 :label "Pinky at Cheek" :rule "Pinky finger touches upper cheekbone" :tip [30 -45 20] :knuckle [55 -20 10] :wrist [85 22 -5] :shape :point :nmf (nmf :mouth "if" :brows "raised"))
    (kf :idx 2 :label "Pinky Tap" :rule "Pinky taps cheek twice with raised eyebrows indicating conditional clause" :tip [30 -43 18] :knuckle [55 -18 8] :wrist [85 24 -5] :shape :point :nmf (nmf :mouth "if" :brows "raised"))
  )

  (sign :id "me" :word "ME" :cat "grammar" :gloss "ME"
    :label "Me / I"
    :desc "Dominant index points directly to the center of own chest." :aliases ("I" "MYSELF")
    (kf :idx 1 :label "Approach Chest" :rule "Dominant index points towards heart" :tip [10 0 15] :knuckle [40 20 10] :wrist [75 55 0] :shape :point :nmf (nmf :mouth "me" :brows "neutral"))
    (kf :idx 2 :label "Touch Center Chest" :rule "Index touches center of own chest establishing 1st person locus" :tip [0 10 8] :knuckle [30 25 5] :wrist [70 60 -5] :shape :point :nmf (nmf :mouth "me" :brows "neutral"))
  )

  (sign :id "you" :word "YOU" :cat "grammar" :gloss "YOU"
    :label "You / Addressee"
    :desc "Dominant index points directly forward to the addressee (2nd person locus)." :aliases ("YOURSELF")
    (kf :idx 1 :label "Raise Point" :rule "Dominant index points forward at upper chest level" :tip [10 -10 35] :knuckle [35 15 25] :wrist [75 50 10] :shape :point :nmf (nmf :mouth "you" :brows "neutral"))
    (kf :idx 2 :label "Direct Point to Addressee" :rule "Index finger extends forward directly toward 2nd person locus" :tip [0 -20 65] :knuckle [25 0 45] :wrist [65 35 25] :shape :point :nmf (nmf :mouth "you" :brows "neutral"))
  )

  (sign :id "they" :word "THEY" :cat "grammar" :gloss "THEY"
    :label "They / Them"
    :desc "Dominant index sweeps horizontally across 3rd person space." :aliases ("THEM" "THOSE-PEOPLE")
    (kf :idx 1 :label "Start Sweep Left" :rule "Index points towards Locus A on left" :tip [-45 -5 35] :knuckle [-15 15 25] :wrist [35 55 10] :shape :point :nmf (nmf :mouth "they" :brows "neutral"))
    (kf :idx 2 :label "Sweep to Locus B Right" :rule "Index sweeps across to Locus B on right encompassing the group" :tip [45 -5 35] :knuckle [70 15 25] :wrist [105 55 10] :shape :point :nmf (nmf :mouth "they" :brows "neutral"))
  )

  (sign :id "pupil" :word "PUPIL" :cat "school" :gloss "PUPIL"
    :label "Pupil / Student"
    :desc "Sign for LEARN (taps forehead from palm) followed by person drop." :aliases ("STUDENT" "LEARNER" "SCHOLAR")
    (kf :idx 1 :label "Gather from Palm" :rule "Dominant fingertips touch non-dominant open palm (gathering knowledge)" :tip [-40 20 15] :knuckle [0 35 10] :wrist [50 70 0] :shape :claw :base-mode :vowel-board :nmf (nmf :mouth "student" :brows "neutral"))
    (kf :idx 2 :label "Knowledge to Forehead" :rule "Hand rises and touches forehead (internalizing learning)" :tip [22 -52 22] :knuckle [48 -25 12] :wrist [80 18 0] :shape :flat :base-mode :vowel-board :nmf (nmf :mouth "pupil" :brows "raised" :tilt "nod"))
  )

  (sign :id "family" :word "FAMILY" :cat "conversation" :gloss "FAMILY"
    :label "Family / Relatives"
    :desc "Both curved hands draw an inclusive horizontal circle and join pinkies together." :aliases ("HOUSEHOLD" "RELATIVES")
    (kf :idx 1 :label "Hands Apart" :rule "Both curved hands in front of chest facing each other" :tip [30 5 30] :knuckle [55 25 20] :wrist [90 60 5] :shape :claw :base-mode :mirror :nmf (nmf :mouth "family" :brows "raised"))
    (kf :idx 2 :label "Circle Together" :rule "Both hands sweep in a circle and unite together in loving unity" :tip [0 15 25] :knuckle [30 35 15] :wrist [70 70 0] :shape :claw :base-mode :mirror :nmf (nmf :mouth "family" :brows "raised" :tilt "nod"))
  )
)
