    (kf :idx 2 :label "Twist Three Outward" :rule "Three fingers snap outward marking ordinal third" :tip [15 -18 32] :knuckle [40 8 22] :wrist [72 42 5] :shape :spread :palm :out :hold 180 :nmf (nmf :mouth "third" :brows "neutral" :tilt "nod"))
  )

  (sign :id "one" :word "ONE" :cat "temporal" :gloss "ONE"
    :label "One / Single / Unit"
    :desc "Dominant index finger raised vertically at chest, palm facing inward." :aliases ("1" "SINGLE" "SOLITARY")
