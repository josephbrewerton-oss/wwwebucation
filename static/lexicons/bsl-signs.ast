    (kf :idx 2 :label "Twist Forward Decisive" :rule "Thumb flicks forward decisively indicating ordinal primacy" :tip [15 -18 32] :knuckle [40 8 22] :wrist [72 42 5] :shape :fist :palm :out :hold 180 :nmf (nmf :mouth "first" :brows "neutral" :tilt "nod"))
  )

  (sign :id "second" :word "SECOND" :cat "temporal" :gloss "SECOND"
    :label "Second / 2nd / Following"
    :desc "Dominant V-handshape twists forward from wrist marking 2nd place." :aliases ("2ND" "SECONDO")
