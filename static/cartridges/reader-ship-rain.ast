(:scene :id "reader-ship-rain" :type "Slide" :oak-id "OAK-KS1-ENG-R03" :oak-unit "ks1-english-decodable-book-3-ship-rain" :title "Decodable Book 3: A Ship in the Rain (Level 3 · Phase 3 Digraphs)" :stage "EYFS/KS1 PHONICS" :duration 20.0
  (:use-skill "storybook-reader" :pages 5)
  (:vars (
    (:var :name "page" :val 0 :min 0 :max 4 :step 1 :label "Story Page")
    (:var :name "showButtons" :val true :label "Show Sound Buttons")
    (:var :name "activeWord" :val "Tap any word above to see & hear its sounds" :label "Selected Word Helper")
    (:var :name "activePhonemes" :val "" :label "Selected Word Phonemes")
  ))
  (:inputs (
    (:switch :var "showButtons" :label "Show DfE Sound Buttons (• / ━━ / ♥)")
  ))
  (:computed (
    (:name "activePage" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5)))")
    (:name "pageText" :expr "['We see a big ship in the rain.', 'A deep fish can zoom by the boat.', 'At night we see the moon and a bright star.', 'He can see a high light on the dark rock.', 'The rain is off! The ship is back at the dock.'][Math.max(0, Math.min(4, Math.floor((t || 0) * 5)))] || ''")
  ))
  (:subtitles (
    (:start 0.00 :end 0.20 :en "We see a big ship in the rain.")
    (:start 0.20 :end 0.40 :en "A deep fish can zoom by the boat.")
    (:start 0.40 :end 0.60 :en "At night we see the moon and a bright star.")
    (:start 0.60 :end 0.80 :en "He can see a high light on the dark rock.")
    (:start 0.80 :end 1.00 :en "The rain is off! The ship is back at the dock.")
  ))
  (:keyframes (
    (:t 0.00 :title "Page 1: A Ship in the Rain" :rule "We see a big ship in the rain.")
    (:t 0.25 :title "Page 2: A Ship in the Rain" :rule "A deep fish can zoom by the boat.")
    (:t 0.50 :title "Page 3: A Ship in the Rain" :rule "At night we see the moon and a bright star.")
    (:t 0.75 :title "Page 4: A Ship in the Rain" :rule "He can see a high light on the dark rock.")
    (:t 1.00 :title "Page 5: A Ship in the Rain" :rule "The rain is off! The ship is back at the dock.")
  ))
  (:interactive (
    (:checkpoint :t 0.50
      :prompt "What was the weather when the ship set off?"
      :options ("🌧️ Rain" "❄️ Snow" "🌬️ Hot wind")
      :answer 0
      :explanation "Great reading! In 'A Ship in the Rain', the answer is Rain.")
    (:checkpoint :t 1.00
      :prompt "What did they see in the sky at night?"
      :options ("🚌 A red bus" "🌙 The moon and a star" "🐷 A pink pig")
      :answer 1
      :explanation "Great reading! In 'A Ship in the Rain', the answer is The moon and a star.")
  ))
  (:bindings (
    (:target "#book-page-0" :attr "display" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 0 ? 'inline' : 'none'")
    (:target "#sb-page-0" :attr "opacity" :expr "vars.showButtons ? '1' : '0'")
    (:target "#page-dot-0" :attr "fill" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 0 ? '#0369a1' : '#cbd5e1'")
    (:target "#book-page-1" :attr "display" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 1 ? 'inline' : 'none'")
    (:target "#sb-page-1" :attr "opacity" :expr "vars.showButtons ? '1' : '0'")
    (:target "#page-dot-1" :attr "fill" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 1 ? '#0369a1' : '#cbd5e1'")
    (:target "#book-page-2" :attr "display" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 2 ? 'inline' : 'none'")
    (:target "#sb-page-2" :attr "opacity" :expr "vars.showButtons ? '1' : '0'")
    (:target "#page-dot-2" :attr "fill" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 2 ? '#0369a1' : '#cbd5e1'")
    (:target "#book-page-3" :attr "display" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 3 ? 'inline' : 'none'")
    (:target "#sb-page-3" :attr "opacity" :expr "vars.showButtons ? '1' : '0'")
    (:target "#page-dot-3" :attr "fill" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 3 ? '#0369a1' : '#cbd5e1'")
    (:target "#book-page-4" :attr "display" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 4 ? 'inline' : 'none'")
    (:target "#sb-page-4" :attr "opacity" :expr "vars.showButtons ? '1' : '0'")
    (:target "#page-dot-4" :attr "fill" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 4 ? '#0369a1' : '#cbd5e1'")
    (:target "#book-page-num" :attr "textContent" :expr "'Page ' + (Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) + 1) + ' of 5'")
    (:target "#decoder-hint-txt" :attr "textContent" :expr "vars.activeWord || 'Tap any word above to see & hear its sounds'")
    (:target "#btn-toggle-sb-txt" :attr "textContent" :expr "vars.showButtons ? '● Sound Buttons: ON' : '○ Sound Buttons: OFF'")
    (:target "#btn-toggle-sb-rect" :attr "fill" :expr "vars.showButtons ? '#e0f2fe' : '#f1f5f9'")
  ))
)
