(:scene :id "water-cycle" :type "Slide" :oak-id "OAK-KS2-GEO-001" :title "Water Cycle: Continuous Earth Cycle" :stage "KS2 GEOGRAPHY" :duration 10.0
  (:vars (
    (:var :name "oceanTemp" :val 24 :min 10 :max 40 :step 1 :unit "°C" :label "Sea Surface Temp")
    (:var :name "cloudCover" :val 70 :min 10 :max 100 :step 5 :unit "%" :label "Cloud Density")
  ))
  (:inputs (
    (:slider :var "oceanTemp" :label "Ocean Heat Index" :min 10 :max 40 :step 1)
    (:slider :var "cloudCover" :label "Cloud Condensation" :min 10 :max 100 :step 5)
  ))
  (:computed (
    (:name "rainfallRate" :expr "(vars.oceanTemp * 0.15 * (vars.cloudCover / 50)).toFixed(1)")
  ))
  (:gestures (
    (:draggable :target "#wc-vapor-0" :axis "y" :min 140 :max 350)
  ))
  (:subtitles (
    (:start 0.00 :end 0.35 :en "Solar energy heats water surfaces, causing evaporation into rising gas molecules." :es "La energía solar calienta el agua provocando la evaporación en moléculas de gas.")
    (:start 0.35 :end 0.70 :en "As vapor climbs into cold upper air, it condenses into visible fluffy clouds." :es "Al subir al aire frío, el vapor se condensa en nubes esponjosas.")
    (:start 0.70 :end 1.00 :en "When droplets become too heavy, gravity pulls them down as precipitation." :es "Cuando las gotas son pesadas, la gravedad las hace caer en precipitación.")
  ))
  (:keyframes (
    (:t 0.00 :title "Solar Heating & Evaporation" :rule "Sun warms ocean water, converting liquid into invisible water vapor.")
    (:t 0.35 :title "Atmospheric Condensation" :rule "Rising vapor cools and condenses into cloud water droplets.")
    (:t 0.70 :title "Precipitation" :rule "Heavy clouds release moisture as rain, sleet, or snow.")
    (:t 1.00 :title "Runoff & Collection" :rule "Rivers carry precipitation back to oceans, completing the closed cycle.")
  ))
  (:interactive (
    (:checkpoint :t 0.65
      :prompt "What state change occurs when rising invisible water vapor cools in the upper atmosphere to form clouds?"
      :options ("Condensation (gas to liquid droplets)" "Evaporation" "Sublimation" "Freezing directly to rock")
      :answer 0
      :explanation "Condensation occurs as warm water vapor rises, expands, and cools, changing from a gas into tiny suspended liquid droplets that form clouds.")
  ))
  (:bindings (
    ;; Flash-style living solar corona, rays & thermal glow driven by oceanTemp
    (:target "#wc-sun-rays" :attr "transform" :expr "'rotate(' + (t * 90).toFixed(1) + ') scale(' + (0.88 + (vars.oceanTemp - 10) * 0.008 + Math.sin(t * 12.566) * 0.03).toFixed(3) + ')'")
    (:target "#wc-sun-halo-ring" :attr "opacity" :expr "(0.45 + ((vars.oceanTemp - 10) / 30) * 0.5).toFixed(2)")

    ;; Volumetric cloud squash-stretch drift & storm darkening driven by cloudCover
    (:target "#wc-cloud-group" :attr "transform" :expr "'translate(' + (Math.sin(t * 6.283) * 14).toFixed(1) + ',' + (Math.cos(t * 6.283) * 3.5).toFixed(1) + ')'")
    (:target "#wc-cloud-storm-tint" :attr "opacity" :expr "(0.06 + (vars.cloudCover / 100) * 0.62).toFixed(2)")

    ;; Alpine river current, ocean shimmer & subterranean aquifer percolation
    (:target "#wc-river-foam" :attr "stroke-dashoffset" :expr "(-t * 220).toFixed(1)")
    (:target "#wc-ocean-sheen" :attr "transform" :expr "'translate(' + (Math.sin(t * 12.566) * 8).toFixed(1) + ',0)'")
    (:target "#wc-aquifer-flow" :attr "stroke-dashoffset" :expr "(-t * 140).toFixed(1)")

    ;; Live telemetry readout synced to sliders
    (:target "#wc-rainfall-readout" :attr "textContent" :expr "Math.round(vars.oceanTemp) + '°C · ' + Math.round(vars.cloudCover) + '% Cloud · ' + (vars.oceanTemp * 0.15 * (vars.cloudCover / 50)).toFixed(1) + ' mm/h'")

    ;; Rising evaporation vapor orbs (speed scales with oceanTemp)
    (:target "#wc-vapor-0" :attr "cy" :expr "336 - ((t * (1.4 + vars.oceanTemp * 0.04) + 0/6) % 1) * 165")
    (:target "#wc-vapor-1" :attr "cy" :expr "336 - ((t * (1.4 + vars.oceanTemp * 0.04) + 1/6) % 1) * 165")
    (:target "#wc-vapor-2" :attr "cy" :expr "336 - ((t * (1.4 + vars.oceanTemp * 0.04) + 2/6) % 1) * 165")
    (:target "#wc-vapor-3" :attr "cy" :expr "336 - ((t * (1.4 + vars.oceanTemp * 0.04) + 3/6) % 1) * 165")
    (:target "#wc-vapor-4" :attr "cy" :expr "336 - ((t * (1.4 + vars.oceanTemp * 0.04) + 4/6) % 1) * 165")
    (:target "#wc-vapor-5" :attr "cy" :expr "336 - ((t * (1.4 + vars.oceanTemp * 0.04) + 5/6) % 1) * 165")

    ;; Falling glossy precipitation teardrops (intensity scales with cloudCover)
    (:target "#wc-rain-0" :attr "opacity" :expr "t > 0.42 ? (0.35 + (vars.cloudCover / 100) * 0.65).toFixed(2) : 0")
    (:target "#wc-rain-0" :attr "transform" :expr "'translate(320,' + (182 + ((t * 3 + 0/8) % 1) * 138).toFixed(1) + ')'")
    (:target "#wc-rain-1" :attr "opacity" :expr "t > 0.42 ? (0.35 + (vars.cloudCover / 100) * 0.65).toFixed(2) : 0")
    (:target "#wc-rain-1" :attr "transform" :expr "'translate(345,' + (182 + ((t * 3 + 1/8) % 1) * 138).toFixed(1) + ')'")
    (:target "#wc-rain-2" :attr "opacity" :expr "t > 0.42 ? (0.35 + (vars.cloudCover / 100) * 0.65).toFixed(2) : 0")
    (:target "#wc-rain-2" :attr "transform" :expr "'translate(370,' + (182 + ((t * 3 + 2/8) % 1) * 138).toFixed(1) + ')'")
    (:target "#wc-rain-3" :attr "opacity" :expr "t > 0.42 ? (0.35 + (vars.cloudCover / 100) * 0.65).toFixed(2) : 0")
    (:target "#wc-rain-3" :attr "transform" :expr "'translate(395,' + (182 + ((t * 3 + 3/8) % 1) * 138).toFixed(1) + ')'")
    (:target "#wc-rain-4" :attr "opacity" :expr "t > 0.42 ? (0.35 + (vars.cloudCover / 100) * 0.65).toFixed(2) : 0")
    (:target "#wc-rain-4" :attr "transform" :expr "'translate(420,' + (182 + ((t * 3 + 4/8) % 1) * 138).toFixed(1) + ')'")
    (:target "#wc-rain-5" :attr "opacity" :expr "t > 0.42 ? (0.35 + (vars.cloudCover / 100) * 0.65).toFixed(2) : 0")
    (:target "#wc-rain-5" :attr "transform" :expr "'translate(445,' + (182 + ((t * 3 + 5/8) % 1) * 138).toFixed(1) + ')'")
    (:target "#wc-rain-6" :attr "opacity" :expr "t > 0.42 ? (0.35 + (vars.cloudCover / 100) * 0.65).toFixed(2) : 0")
    (:target "#wc-rain-6" :attr "transform" :expr "'translate(470,' + (182 + ((t * 3 + 6/8) % 1) * 138).toFixed(1) + ')'")
    (:target "#wc-rain-7" :attr "opacity" :expr "t > 0.42 ? (0.35 + (vars.cloudCover / 100) * 0.65).toFixed(2) : 0")
    (:target "#wc-rain-7" :attr "transform" :expr "'translate(495,' + (182 + ((t * 3 + 7/8) % 1) * 138).toFixed(1) + ')'")
  ))
)
