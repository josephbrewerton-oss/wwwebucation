(:scene :id "reader-pat-sat" :type "Slide" :oak-id "OAK-KS1-ENG-R01" :oak-unit "eyfs-english-decodable-book-1-pat-sat" :title "Decodable Book 1: Pat Sat (Level 1 · Set 1 & 2 (SATPIN))" :stage "EYFS/KS1 PHONICS" :duration 20.0
  (:vars (
    (:var :name "page" :val 0 :min 0 :max 4 :step 1 :label "Story Page")
    (:var :name "showButtons" :val true :label "Show Sound Buttons")
    (:var :name "activeWord" :val "Tap any word above to see & hear its sounds" :label "Selected Word Helper")
    (:var :name "activePhonemes" :val "" :label "Selected Word Phonemes")
  ))
  (:inputs (
    (:slider :var "page" :label "Turn Page (1 to 5)" :min 0 :max 4 :step 1)
    (:switch :var "showButtons" :label "Show DfE Sound Buttons (• / ━━ / ♥)")
  ))
  (:computed (
    (:name "pageText" :expr "['Pat sat on a mat.', 'Pat sat at a tap.', 'A tin pan is at the tap.', 'Tap, tap, tap! A tin pan did tip.', 'Pat is in a nap on a mat.'][vars.page || 0] || ''")
  ))
  (:gestures (
    (:key :code "ArrowLeft" :step-var "page" :delta -1 :min 0 :max 4)
    (:key :code "ArrowRight" :step-var "page" :delta 1 :min 0 :max 4)
    (:clickable :target "#btn-prev-page" :step-var "page" :delta -1 :min 0 :max 4 :tone "392")
    (:clickable :target "#btn-next-page" :step-var "page" :delta 1 :min 0 :max 4 :tone "523.25")
    (:clickable :target ".page-dot" :attr "data-page" :set-var "page" :tone "440")
    (:clickable :target "#btn-toggle-sb" :toggle-var "showButtons" :tone "493.88")
    (:clickable :target "#btn-read-page" :tone "523.25,659.25" :speak-expr "computed.pageText")
    (:clickable :target ".book-word" :set-var "activeWord" :val-expr "el.getAttribute('data-hint')" :tone "523.25" :speak-expr "el.getAttribute('data-word')")
    (:clickable :target ".book-word" :set-var "activePhonemes" :val-expr "el.getAttribute('data-phonemes')")
    (:clickable :target "#btn-sound-out" :tone "440,523.25,659.25" :speak-expr "vars.activePhonemes || computed.pageText")
  ))
  (:subtitles (
    (:start 0.00 :end 0.20 :en "Pat sat on a mat.")
    (:start 0.20 :end 0.40 :en "Pat sat at a tap.")
    (:start 0.40 :end 0.60 :en "A tin pan is at the tap.")
    (:start 0.60 :end 0.80 :en "Tap, tap, tap! A tin pan did tip.")
    (:start 0.80 :end 1.00 :en "Pat is in a nap on a mat.")
  ))
  (:keyframes (
    (:t 0.00 :title "Page 1: Pat Sat" :rule "Pat sat on a mat.")
    (:t 0.25 :title "Page 2: Pat Sat" :rule "Pat sat at a tap.")
    (:t 0.50 :title "Page 3: Pat Sat" :rule "A tin pan is at the tap.")
    (:t 0.75 :title "Page 4: Pat Sat" :rule "Tap, tap, tap! A tin pan did tip.")
    (:t 1.00 :title "Page 5: Pat Sat" :rule "Pat is in a nap on a mat.")
  ))
  (:interactive (
    (:checkpoint :t 0.50
      :prompt "Where did Pat sit at the start?"
      :options ("🧶 On a mat" "🚢 In a ship" "🐸 On a frog")
      :answer 0
      :explanation "Great reading! In 'Pat Sat', the answer is On a mat.")
    (:checkpoint :t 0.92
      :prompt "What was next to the tap?"
      :options ("🐶 A red dog" "🍳 A tin pan" "🎂 A cake")
      :answer 1
      :explanation "Great reading! In 'Pat Sat', the answer is A tin pan.")
  ))
  (:bindings (
    (:target "#book-page-0" :attr "display" :expr "(vars.page || 0) === 0 ? 'block' : 'none'")
    (:target "#sb-page-0" :attr "opacity" :expr "vars.showButtons ? '1' : '0'")
    (:target "#page-dot-0" :attr "fill" :expr "(vars.page || 0) === 0 ? '#0284c7' : '#cbd5e1'")
    (:target "#book-page-1" :attr "display" :expr "(vars.page || 0) === 1 ? 'block' : 'none'")
    (:target "#sb-page-1" :attr "opacity" :expr "vars.showButtons ? '1' : '0'")
    (:target "#page-dot-1" :attr "fill" :expr "(vars.page || 0) === 1 ? '#0284c7' : '#cbd5e1'")
    (:target "#book-page-2" :attr "display" :expr "(vars.page || 0) === 2 ? 'block' : 'none'")
    (:target "#sb-page-2" :attr "opacity" :expr "vars.showButtons ? '1' : '0'")
    (:target "#page-dot-2" :attr "fill" :expr "(vars.page || 0) === 2 ? '#0284c7' : '#cbd5e1'")
    (:target "#book-page-3" :attr "display" :expr "(vars.page || 0) === 3 ? 'block' : 'none'")
    (:target "#sb-page-3" :attr "opacity" :expr "vars.showButtons ? '1' : '0'")
    (:target "#page-dot-3" :attr "fill" :expr "(vars.page || 0) === 3 ? '#0284c7' : '#cbd5e1'")
    (:target "#book-page-4" :attr "display" :expr "(vars.page || 0) === 4 ? 'block' : 'none'")
    (:target "#sb-page-4" :attr "opacity" :expr "vars.showButtons ? '1' : '0'")
    (:target "#page-dot-4" :attr "fill" :expr "(vars.page || 0) === 4 ? '#0284c7' : '#cbd5e1'")
    (:target "#book-page-num" :attr "textContent" :expr "'Page ' + ((vars.page || 0) + 1) + ' of 5'")
    (:target "#decoder-hint-txt" :attr "textContent" :expr "vars.activeWord || 'Tap any word above to see & hear its sounds'")
    (:target "#btn-toggle-sb-txt" :attr "textContent" :expr "vars.showButtons ? '● Sound Buttons: ON' : '○ Sound Buttons: OFF'")
    (:target "#btn-toggle-sb-rect" :attr "fill" :expr "vars.showButtons ? '#e0f2fe' : '#f1f5f9'")
  ))
)
