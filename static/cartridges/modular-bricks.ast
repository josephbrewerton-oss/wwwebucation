(:scene :id "modular-bricks" :type "Sim" :oak-id "OAK-KS3-DT-001" :oak-unit "ks3-design-technology-modular-structures-spatial-geometry" :title "Modular Brick Engineering & 3D Spatial Geometry" :stage "KS2/KS3 DESIGN & TECH" :duration 16.0
  (:vars (
    (:var :name "brickType" :val "2x4" :label "Brick Geometry Form Factor")
    (:var :name "brickColor" :val "red" :label "ABS Injection Color")
    (:var :name "turntableYaw" :val 0 :min 0 :max 360 :step 1 :unit "deg" :label "Turntable Orbit Yaw")
    (:var :name "cameraPitch" :val 32 :min -65 :max 65 :step 1 :unit "deg" :label "Camera Elevation Angle")
    (:var :name "flipUnderside" :val false :label "Show Underside Clutch Cavity")
    (:var :name "autoSpin" :val true :label "Continuous 360° Orbit")
    (:var :name "explodeView" :val false :label "Exploded View Toggle")
    (:var :name "explodeOffset" :val 0 :min 0 :max 50 :step 2 :unit "mm" :label "Exploded Assembly Offset")
    (:var :name "showDimensions" :val true :label "Engineering Dimension Overlays")
    (:var :name "stackMode" :val false :label "3-Layer Staggered Wall Assembly")
    (:var :name "spinSpeed" :val 1.0 :min 0.2 :max 4.0 :step 0.2 :label "Turntable Rotation Velocity")
  ))
  (:inputs (
    (:select :var "brickType" :label "Brick Geometry Form Factor" :options ("2x4" "2x2" "1x2" "slope" "tile"))
    (:select :var "brickColor" :label "ABS Injection Color" :options ("red" "blue" "yellow" "green" "orange" "white" "black" "cyan"))
    (:switch :var "autoSpin" :label "Auto-Turntable 360° Spin")
    (:slider :var "spinSpeed" :label "Turntable Velocity (×)" :min 0.2 :max 4.0 :step 0.2)
    (:switch :var "flipUnderside" :label "Flip to Underside Cavity")
    (:slider :var "turntableYaw" :label "Manual Orbit Yaw Angle" :min 0 :max 360 :step 1)
    (:slider :var "cameraPitch" :label "Camera Pitch Angle" :min -65 :max 65 :step 1)
    (:switch :var "explodeView" :label "Explode Assembly Toggle")
    (:slider :var "explodeOffset" :label "Explode Assembly Offset (mm)" :min 0 :max 50 :step 2)
    (:switch :var "stackMode" :label "3-Layer Staggered Wall")
    (:switch :var "showDimensions" :label "Engineering Dimensions")
  ))
  (:computed (
    (:name "currentYaw" :expr "Math.round((vars.turntableYaw + (vars.autoSpin ? t * 36 * vars.spinSpeed : 0)) % 360)")
    (:name "isUnderside" :expr "Boolean(vars.flipUnderside || vars.cameraPitch < 0)")
    (:name "effectiveExplode" :expr "vars.explodeOffset > 0 ? vars.explodeOffset : (vars.explodeView ? 28 : 0)")
    (:name "volumeMm3" :expr "vars.brickType === '2x2' ? 2458 : (vars.brickType === '1x2' ? 1229 : (vars.brickType === 'slope' ? 3277 : (vars.brickType === 'tile' ? 1638 : 4915)))")
    (:name "studCount" :expr "vars.brickType === '2x2' ? 4 : (vars.brickType === '1x2' ? 2 : (vars.brickType === 'slope' ? 4 : (vars.brickType === 'tile' ? 0 : 8)))")
    (:name "absTop0" :expr "vars.brickColor === 'blue' ? '#3b82f6' : (vars.brickColor === 'yellow' ? '#fde047' : (vars.brickColor === 'green' ? '#22c55e' : (vars.brickColor === 'orange' ? '#fb923c' : (vars.brickColor === 'white' ? '#ffffff' : ((vars.brickColor === 'black' || vars.brickColor === 'dark-gray') ? '#475569' : (vars.brickColor === 'cyan' ? '#38bdf8' : '#f43f5e'))))))")
    (:name "absTop1" :expr "vars.brickColor === 'blue' ? '#2563eb' : (vars.brickColor === 'yellow' ? '#eab308' : (vars.brickColor === 'green' ? '#16a34a' : (vars.brickColor === 'orange' ? '#ea580c' : (vars.brickColor === 'white' ? '#e2e8f0' : ((vars.brickColor === 'black' || vars.brickColor === 'dark-gray') ? '#334155' : (vars.brickColor === 'cyan' ? '#0284c7' : '#e11d48'))))))")
    (:name "absLeft0" :expr "vars.brickColor === 'blue' ? '#1d4ed8' : (vars.brickColor === 'yellow' ? '#ca8a04' : (vars.brickColor === 'green' ? '#15803d' : (vars.brickColor === 'orange' ? '#c2410c' : (vars.brickColor === 'white' ? '#cbd5e1' : ((vars.brickColor === 'black' || vars.brickColor === 'dark-gray') ? '#1e293b' : (vars.brickColor === 'cyan' ? '#0369a1' : '#be123c'))))))")
    (:name "absLeft1" :expr "vars.brickColor === 'blue' ? '#1e3a8a' : (vars.brickColor === 'yellow' ? '#854d0e' : (vars.brickColor === 'green' ? '#14532d' : (vars.brickColor === 'orange' ? '#7c2d12' : (vars.brickColor === 'white' ? '#94a3b8' : ((vars.brickColor === 'black' || vars.brickColor === 'dark-gray') ? '#0f172a' : (vars.brickColor === 'cyan' ? '#0c4a6e' : '#881337'))))))")
    (:name "absRight0" :expr "vars.brickColor === 'blue' ? '#2563eb' : (vars.brickColor === 'yellow' ? '#eab308' : (vars.brickColor === 'green' ? '#16a34a' : (vars.brickColor === 'orange' ? '#ea580c' : (vars.brickColor === 'white' ? '#e2e8f0' : ((vars.brickColor === 'black' || vars.brickColor === 'dark-gray') ? '#334155' : (vars.brickColor === 'cyan' ? '#0284c7' : '#e11d48'))))))")
    (:name "absRight1" :expr "vars.brickColor === 'blue' ? '#1e40af' : (vars.brickColor === 'yellow' ? '#a16207' : (vars.brickColor === 'green' ? '#166534' : (vars.brickColor === 'orange' ? '#9a3412' : (vars.brickColor === 'white' ? '#94a3b8' : ((vars.brickColor === 'black' || vars.brickColor === 'dark-gray') ? '#1e293b' : (vars.brickColor === 'cyan' ? '#075985' : '#9f1239'))))))")
    (:name "absStudRim" :expr "vars.brickColor === 'blue' ? '#93c5fd' : (vars.brickColor === 'yellow' ? '#fef08a' : (vars.brickColor === 'green' ? '#86efac' : (vars.brickColor === 'orange' ? '#fed7aa' : (vars.brickColor === 'white' ? '#ffffff' : ((vars.brickColor === 'black' || vars.brickColor === 'dark-gray') ? '#94a3b8' : (vars.brickColor === 'cyan' ? '#bae6fd' : '#fda4af'))))))")
    (:name "absTubeStroke" :expr "vars.brickColor === 'blue' ? '#60a5fa' : (vars.brickColor === 'yellow' ? '#fde047' : (vars.brickColor === 'green' ? '#4ade80' : (vars.brickColor === 'orange' ? '#fdba74' : (vars.brickColor === 'white' ? '#ffffff' : ((vars.brickColor === 'black' || vars.brickColor === 'dark-gray') ? '#64748b' : (vars.brickColor === 'cyan' ? '#7dd3fc' : '#f43f5e'))))))")
  ))
  (:gestures (
    (:trackball :target "#stage-svg" :yaw-var "turntableYaw" :pitch-var "cameraPitch" :pitch-min -65 :pitch-max 65)
    (:trackball :target "#turntable-root" :yaw-var "turntableYaw" :pitch-var "cameraPitch" :pitch-min -65 :pitch-max 65)
    (:trackball :target "#brick-3d-stage" :yaw-var "turntableYaw" :pitch-var "cameraPitch" :pitch-min -65 :pitch-max 65)
    (:draggable :target "#brick-yaw-knob" :axis "x" :min-x 42 :max-x 166 :var "turntableYaw" :relative true)

    ;; Brick Form Factor Buttons
    (:clickable :target "#btn-type-2x4" :set "brickType" :val "2x4")
    (:clickable :target "#btn-type-2x2" :set "brickType" :val "2x2")
    (:clickable :target "#btn-type-1x2" :set "brickType" :val "1x2")
    (:clickable :target "#btn-type-slope" :set "brickType" :val "slope")
    (:clickable :target "#btn-type-tile" :set "brickType" :val "tile")

    ;; All 8 ABS Color Swatches
    (:clickable :target "#col-swatch-red" :set "brickColor" :val "red")
    (:clickable :target "#col-swatch-blue" :set "brickColor" :val "blue")
    (:clickable :target "#col-swatch-yellow" :set "brickColor" :val "yellow")
    (:clickable :target "#col-swatch-green" :set "brickColor" :val "green")
    (:clickable :target "#col-swatch-orange" :set "brickColor" :val "orange")
    (:clickable :target "#col-swatch-white" :set "brickColor" :val "white")
    (:clickable :target "#col-swatch-black" :set "brickColor" :val "black")
    (:clickable :target "#col-swatch-cyan" :set "brickColor" :val "cyan")

    ;; View Flip, Stack Mode & Bottom Action Toolbar Controls
    (:clickable :target "#btn-toggle-flip" :expr "const next = !(vars.flipUnderside || vars.cameraPitch < 0); engine.setVar('flipUnderside', next); if (!next && vars.cameraPitch < 0) engine.setVar('cameraPitch', 32);")
    (:clickable :target "#btn-action-flip" :expr "const next = !(vars.flipUnderside || vars.cameraPitch < 0); engine.setVar('flipUnderside', next); if (!next && vars.cameraPitch < 0) engine.setVar('cameraPitch', 32);")
    (:clickable :target "#btn-toggle-stack" :toggle "stackMode")
    (:clickable :target "#btn-action-spin" :toggle "autoSpin")
    (:clickable :target "#btn-action-explode" :expr "const next = !(vars.explodeView || vars.explodeOffset > 0); engine.setVar('explodeView', next); engine.setVar('explodeOffset', next ? 28 : 0);")
    (:clickable :target "#btn-action-dimensions" :toggle "showDimensions")
    (:clickable :target "#btn-action-reset" :expr "engine.resetVars(); engine.resetCamera();")
  ))
  (:subtitles (
    (:start 0.00 :end 0.28 :en "Welcome to the Modular Brick Lab! The universal 2×4 brick is engineered around an exact 8.0 mm modular stud matrix." :es "¡Bienvenidos al laboratorio de bloques modulares! El ladrillo clásico de 2×4 está diseñado con una matriz modular exacta de 8.0 mm.")
    (:start 0.28 :end 0.60 :en "Observe the 3D isometric turntable. Tap Explode or View: Underside to reveal the internal cylindrical friction clutch tubes!" :es "Observa la plataforma giratoria isométrica 3D. ¡Activa Despiece o Vista Inferior para ver los tubos de fricción!")
    (:start 0.60 :end 0.85 :en "In structural engineering, overlapping bricks across seams distributes lateral shear forces, preventing wall collapse." :es "En ingeniería estructural, solapar ladrillos distribuye las fuerzas de corte y evita el colapso.")
    (:start 0.85 :end 1.00 :en "Experiment with different block types, vibrant palettes, and spin controls to master 3D spatial geometry." :es "Experimenta con diferentes tipos de bloques, paletas de colores y controles de giro para dominar la geometría espacial 3D.")
  ))
  (:keyframes (
    (:t 0.00 :title "Modular Grid Standard" :rule "The 8.0 mm stud pitch allows endless modular combinations across any axis.")
    (:t 0.28 :title "Friction Clutch Mechanics" :rule "Internal cylindrical tubes press against top studs with ~3.2 N of holding tension.")
    (:t 0.60 :title "Shear Load Distribution" :rule "Staggered brick overlapping eliminates continuous vertical fracture lines.")
    (:t 0.85 :title "Spatial Volume & Geometry" :rule "Standard brick height is 9.6 mm—exactly three stacked 3.2 mm plates.")
    (:t 1.00 :title "Master Structural Assembly" :rule "Interlocking modular bricks combine isometric math with tactile engineering.")
  ))
  (:interactive (
    (:checkpoint :t 0.45
      :prompt "What is the mathematical ratio between a standard brick's height (9.6 mm) and a flat construction plate's height (3.2 mm)?"
      :options ("3 : 1 (3 plates stacked equal 1 standard brick)" "2 : 1 (2 plates equal 1 brick)" "4 : 1 (4 plates equal 1 brick)" "1 : 1 (they are identical)")
      :answer 0
      :explanation "Standard interlocking modular brick systems enforce an exact 3:1 height ratio: three plates stacked together (3 × 3.2 mm = 9.6 mm) equal exactly one brick height.")
    (:checkpoint :t 0.80
      :prompt "In masonry and modular brick architecture, why is staggered (overlapping) bonding far stronger than stack bonding?"
      :options ("Overlapping distributes shear tension across adjacent units, preventing vertical seam cracks." "It uses fewer plastic polymers." "It reduces overall mass." "It allows bricks to slide freely.")
      :answer 0
      :explanation "Stack bonding creates unbroken vertical lines of weakness. Staggered interlocking distributes tensile and lateral forces across adjacent bricks, eliminating fault lines.")
  ))
  (:bindings (
    ;; 1. Turntable Rotation & Explode Offsets
    (:target "#brick-3d-stage" :attr "transform" :expr "'rotate(' + vars.currentYaw + ' 0 60)'")
    (:target "#brick-top-view" :attr "opacity" :expr "vars.isUnderside ? 0 : 1")
    (:target "#brick-top-view" :attr "display" :expr "vars.isUnderside ? 'none' : 'inline'")
    (:target "#brick-top-view" :attr "transform" :expr "'translate(0, ' + (-vars.effectiveExplode) + ')'")
    (:target "#brick-underside-view" :attr "opacity" :expr "vars.isUnderside ? 1 : 0")
    (:target "#brick-underside-view" :attr "display" :expr "vars.isUnderside ? 'inline' : 'none'")
    (:target "#brick-underside-view" :attr "transform" :expr "'translate(0, ' + (-vars.effectiveExplode) + ')'")
    (:target "#brick-bottom-tubes" :attr "opacity" :expr "(vars.effectiveExplode > 6 && !vars.isUnderside) ? 1 : 0")
    (:target "#brick-bottom-tubes" :attr "transform" :expr "'translate(0, ' + (40 + vars.effectiveExplode * 0.65) + ')'")

    ;; 2. Active Brick Form Factor Switching (Top + Underside + Explode Clutch Geometry)
    (:target "#brick-geom-2x4" :attr "display" :expr "vars.brickType === '2x4' ? 'inline' : 'none'")
    (:target "#brick-geom-2x2" :attr "display" :expr "vars.brickType === '2x2' ? 'inline' : 'none'")
    (:target "#brick-geom-1x2" :attr "display" :expr "vars.brickType === '1x2' ? 'inline' : 'none'")
    (:target "#brick-geom-slope" :attr "display" :expr "vars.brickType === 'slope' ? 'inline' : 'none'")
    (:target "#brick-geom-tile" :attr "display" :expr "vars.brickType === 'tile' ? 'inline' : 'none'")

    (:target "#under-geom-2x4" :attr "display" :expr "(vars.brickType === '2x4' || vars.brickType === 'slope') ? 'inline' : 'none'")
    (:target "#under-geom-2x2" :attr "display" :expr "vars.brickType === '2x2' ? 'inline' : 'none'")
    (:target "#under-geom-1x2" :attr "display" :expr "vars.brickType === '1x2' ? 'inline' : 'none'")
    (:target "#under-geom-tile" :attr "display" :expr "vars.brickType === 'tile' ? 'inline' : 'none'")

    (:target "#explode-cavity-2x4" :attr "display" :expr "(vars.brickType === '2x4' || vars.brickType === 'slope' || vars.brickType === 'tile') ? 'inline' : 'none'")
    (:target "#explode-cavity-2x2" :attr "display" :expr "vars.brickType === '2x2' ? 'inline' : 'none'")
    (:target "#explode-cavity-1x2" :attr "display" :expr "vars.brickType === '1x2' ? 'inline' : 'none'")
    (:target "#explode-tubes-outer" :attr "display" :expr "(vars.brickType === '2x4' || vars.brickType === 'slope' || vars.brickType === 'tile') ? 'inline' : 'none'")
    (:target "#explode-tube-center" :attr "display" :expr "vars.brickType === '1x2' ? 'none' : 'inline'")
    (:target "#explode-pin-1x2" :attr "display" :expr "vars.brickType === '1x2' ? 'inline' : 'none'")
    (:target "#explode-callout-text" :attr "text" :expr "vars.brickType === '1x2' ? '▲ 1× SOLID CENTER CLUTCH PIN' : (vars.brickType === '2x2' ? '▲ 1× CENTRAL CLUTCH TUBE (8mm PITCH)' : '▲ 3× CLUTCH FRICTION TUBES (8mm PITCH)')")
    (:target "#under-callout-text" :attr "text" :expr "vars.brickType === '1x2' ? '▲ SUBTRACTIVE CSG CAVITY: 1.2mm WALLS • Ø3.2mm PIN' : (vars.brickType === '2x2' ? '▲ SUBTRACTIVE CSG CAVITY: 1.2mm WALLS • 1× Ø6.51mm TUBE' : (vars.brickType === 'tile' ? '▲ SHALLOW 3.2mm TILE CAVITY • 3× FRICTION TUBES' : '▲ SUBTRACTIVE CSG CAVITY: 1.2mm WALLS • Ø6.51mm TUBES'))")

    ;; 3. Dynamic ABS Material Color Gradients, Studs, Tubes & Header Badge
    (:target "#brick-grad-top-0" :attr "stop-color" :expr "vars.absTop0")
    (:target "#brick-grad-top-1" :attr "stop-color" :expr "vars.absTop1")
    (:target "#brick-grad-left-0" :attr "stop-color" :expr "vars.absLeft0")
    (:target "#brick-grad-left-1" :attr "stop-color" :expr "vars.absLeft1")
    (:target "#brick-grad-right-0" :attr "stop-color" :expr "vars.absRight0")
    (:target "#brick-grad-right-1" :attr "stop-color" :expr "vars.absRight1")
    (:target "#brick-logo-base" :attr "fill" :expr "vars.absTop1")

    (:target "#master-stud-wall" :attr "fill" :expr "vars.absLeft0")
    (:target "#master-stud-top" :attr "fill" :expr "vars.absTop0")
    (:target "#master-stud-top" :attr "stroke" :expr "vars.absStudRim")
    (:target "#master-anti-tube-wall" :attr "fill" :expr "vars.absRight1")
    (:target "#master-anti-tube-rim" :attr "fill" :expr "vars.absLeft0")
    (:target "#master-anti-tube-rim" :attr "stroke" :expr "vars.absTubeStroke")
    (:target "#master-pin-wall" :attr "fill" :expr "vars.absRight1")
    (:target "#master-pin-top" :attr "fill" :expr "vars.absLeft0")
    (:target "#master-pin-top" :attr "stroke" :expr "vars.absTubeStroke")
    (:target "#tube-1-wall" :attr "fill" :expr "vars.absRight1")
    (:target "#tube-1-rim" :attr "fill" :expr "vars.absLeft0")
    (:target "#tube-1-rim" :attr "stroke" :expr "vars.absTubeStroke")
    (:target "#tube-2-wall" :attr "fill" :expr "vars.absRight1")
    (:target "#tube-2-rim" :attr "fill" :expr "vars.absLeft0")
    (:target "#tube-2-rim" :attr "stroke" :expr "vars.absTubeStroke")
    (:target "#tube-3-wall" :attr "fill" :expr "vars.absRight1")
    (:target "#tube-3-rim" :attr "fill" :expr "vars.absLeft0")
    (:target "#tube-3-rim" :attr "stroke" :expr "vars.absTubeStroke")

    ;; 4. Left Deck Active Button Highlights (Brick Geometry + Swatches + Toggles)
    (:target "#btn-type-2x4-rect" :attr "fill" :expr "vars.brickType === '2x4' ? '#1e293b' : '#0f172a'")
    (:target "#btn-type-2x4-rect" :attr "stroke" :expr "vars.brickType === '2x4' ? '#38bdf8' : '#334155'")
    (:target "#btn-type-2x4-rect" :attr "stroke-width" :expr "vars.brickType === '2x4' ? '1.8' : '1'")
    (:target "#btn-type-2x4-txt" :attr "fill" :expr "vars.brickType === '2x4' ? '#ffffff' : '#94a3b8'")

    (:target "#btn-type-2x2-rect" :attr "fill" :expr "vars.brickType === '2x2' ? '#1e293b' : '#0f172a'")
    (:target "#btn-type-2x2-rect" :attr "stroke" :expr "vars.brickType === '2x2' ? '#38bdf8' : '#334155'")
    (:target "#btn-type-2x2-rect" :attr "stroke-width" :expr "vars.brickType === '2x2' ? '1.8' : '1'")
    (:target "#btn-type-2x2-txt" :attr "fill" :expr "vars.brickType === '2x2' ? '#ffffff' : '#94a3b8'")

    (:target "#btn-type-1x2-rect" :attr "fill" :expr "vars.brickType === '1x2' ? '#1e293b' : '#0f172a'")
    (:target "#btn-type-1x2-rect" :attr "stroke" :expr "vars.brickType === '1x2' ? '#38bdf8' : '#334155'")
    (:target "#btn-type-1x2-rect" :attr "stroke-width" :expr "vars.brickType === '1x2' ? '1.8' : '1'")
    (:target "#btn-type-1x2-txt" :attr "fill" :expr "vars.brickType === '1x2' ? '#ffffff' : '#94a3b8'")

    (:target "#btn-type-slope-rect" :attr "fill" :expr "vars.brickType === 'slope' ? '#1e293b' : '#0f172a'")
    (:target "#btn-type-slope-rect" :attr "stroke" :expr "vars.brickType === 'slope' ? '#38bdf8' : '#334155'")
    (:target "#btn-type-slope-rect" :attr "stroke-width" :expr "vars.brickType === 'slope' ? '1.8' : '1'")
    (:target "#btn-type-slope-txt" :attr "fill" :expr "vars.brickType === 'slope' ? '#ffffff' : '#94a3b8'")

    (:target "#btn-type-tile-rect" :attr "fill" :expr "vars.brickType === 'tile' ? '#1e293b' : '#0f172a'")
    (:target "#btn-type-tile-rect" :attr "stroke" :expr "vars.brickType === 'tile' ? '#38bdf8' : '#334155'")
    (:target "#btn-type-tile-rect" :attr "stroke-width" :expr "vars.brickType === 'tile' ? '1.8' : '1'")
    (:target "#btn-type-tile-txt" :attr "fill" :expr "vars.brickType === 'tile' ? '#ffffff' : '#94a3b8'")

    (:target "#col-swatch-red" :attr "stroke" :expr "vars.brickColor === 'red' ? '#ffffff' : '#334155'")
    (:target "#col-swatch-red" :attr "stroke-width" :expr "vars.brickColor === 'red' ? '2.5' : '1.5'")
    (:target "#col-swatch-blue" :attr "stroke" :expr "vars.brickColor === 'blue' ? '#ffffff' : '#334155'")
    (:target "#col-swatch-blue" :attr "stroke-width" :expr "vars.brickColor === 'blue' ? '2.5' : '1.5'")
    (:target "#col-swatch-yellow" :attr "stroke" :expr "vars.brickColor === 'yellow' ? '#ffffff' : '#334155'")
    (:target "#col-swatch-yellow" :attr "stroke-width" :expr "vars.brickColor === 'yellow' ? '2.5' : '1.5'")
    (:target "#col-swatch-green" :attr "stroke" :expr "vars.brickColor === 'green' ? '#ffffff' : '#334155'")
    (:target "#col-swatch-green" :attr "stroke-width" :expr "vars.brickColor === 'green' ? '2.5' : '1.5'")
    (:target "#col-swatch-orange" :attr "stroke" :expr "vars.brickColor === 'orange' ? '#ffffff' : '#334155'")
    (:target "#col-swatch-orange" :attr "stroke-width" :expr "vars.brickColor === 'orange' ? '2.5' : '1.5'")
    (:target "#col-swatch-white" :attr "stroke" :expr "vars.brickColor === 'white' ? '#38bdf8' : '#334155'")
    (:target "#col-swatch-white" :attr "stroke-width" :expr "vars.brickColor === 'white' ? '2.5' : '1.5'")
    (:target "#col-swatch-black" :attr "stroke" :expr "(vars.brickColor === 'black' || vars.brickColor === 'dark-gray') ? '#ffffff' : '#334155'")
    (:target "#col-swatch-black" :attr "stroke-width" :expr "(vars.brickColor === 'black' || vars.brickColor === 'dark-gray') ? '2.5' : '1.5'")
    (:target "#col-swatch-cyan" :attr "stroke" :expr "vars.brickColor === 'cyan' ? '#ffffff' : '#334155'")
    (:target "#col-swatch-cyan" :attr "stroke-width" :expr "vars.brickColor === 'cyan' ? '2.5' : '1.5'")

    ;; 5. Stack Mode, Dimensions, Bottom Toolbar Buttons & Scrubber Knob
    (:target "#brick-baseplate" :attr "opacity" :expr "vars.stackMode ? 1 : 0")
    (:target "#brick-bottom-layer" :attr "opacity" :expr "vars.stackMode ? 1 : 0")
    (:target "#brick-dimension-overlays" :attr "opacity" :expr "vars.showDimensions ? 1 : 0")
    (:target "#dim-pitch-group" :attr "opacity" :expr "vars.brickType === 'tile' ? 0 : 1")
    (:target "#dim-length-text" :attr "text" :expr "(vars.brickType === '2x2' || vars.brickType === '1x2') ? '16.0 mm' : '32.0 mm'")
    (:target "#dim-width-text" :attr "text" :expr "vars.brickType === '1x2' ? '8.0 mm' : '16.0 mm'")
    (:target "#dim-height-text" :attr "text" :expr "vars.brickType === 'tile' ? '3.2 mm' : '9.6 mm'")

    (:target "#btn-dimensions-rect" :attr "stroke" :expr "vars.showDimensions ? '#facc15' : '#334155'")
    (:target "#txt-dimensions-btn" :attr "fill" :expr "vars.showDimensions ? '#facc15' : '#94a3b8'")
    (:target "#txt-dimensions-btn" :attr "text" :expr "vars.showDimensions ? '📏 Dimensions: ON' : '📏 Dimensions: OFF'")

    (:target "#btn-spin-rect" :attr "stroke" :expr "vars.autoSpin ? '#38bdf8' : '#334155'")
    (:target "#txt-spin-btn" :attr "fill" :expr "vars.autoSpin ? '#38bdf8' : '#94a3b8'")
    (:target "#txt-spin-btn" :attr "text" :expr "vars.autoSpin ? '⚡ Spin 360°: ON' : '⚡ Spin 360°: OFF'")

    (:target "#btn-explode-rect" :attr "stroke" :expr "vars.effectiveExplode > 0 ? '#f43f5e' : '#334155'")
    (:target "#txt-explode-btn" :attr "fill" :expr "vars.effectiveExplode > 0 ? '#f43f5e' : '#94a3b8'")
    (:target "#txt-explode-btn" :attr "text" :expr "vars.effectiveExplode > 0 ? '💥 Explode: ON' : '💥 Explode: OFF'")

    (:target "#btn-flip-rect" :attr "stroke" :expr "vars.isUnderside ? '#f43f5e' : '#38bdf8'")
    (:target "#txt-flip-btn" :attr "fill" :expr "vars.isUnderside ? '#f43f5e' : '#38bdf8'")
    (:target "#txt-flip-btn" :attr "text" :expr "vars.isUnderside ? '🔄 View: UNDERSIDE' : '🔄 View: TOP STUDS'")

    (:target "#btn-toggle-flip-rect" :attr "stroke" :expr "vars.isUnderside ? '#f43f5e' : '#38bdf8'")
    (:target "#txt-toggle-flip" :attr "fill" :expr "vars.isUnderside ? '#f43f5e' : '#38bdf8'")
    (:target "#txt-toggle-flip" :attr "text" :expr "vars.isUnderside ? '🔄 UNDERSIDE VIEW' : '🔄 TOP STUDS VIEW'")

    (:target "#btn-toggle-stack-rect" :attr "stroke" :expr "vars.stackMode ? '#34d399' : '#334155'")
    (:target "#txt-stack-mode" :attr "fill" :expr "vars.stackMode ? '#34d399' : '#94a3b8'")
    (:target "#txt-stack-mode" :attr "text" :expr "vars.stackMode ? '🧱 WALL STACK: ACTIVE' : '🧱 WALL STACK: OFF'")

    (:target "#brick-yaw-knob" :attr "cx" :expr "42 + (vars.currentYaw / 360) * 124")

    ;; 6. Engineering Telemetry & Header Readouts
    (:target "#brick-badge-text" :attr "text" :expr "vars.brickType === '2x2' ? '16×16×9.6 mm • 2.5 cm³' : (vars.brickType === '1x2' ? '16×8×9.6 mm • 1.2 cm³' : (vars.brickType === 'slope' ? '32×16×9.6 mm • 3.3 cm³' : (vars.brickType === 'tile' ? '32×16×3.2 mm • 1.6 cm³' : '32×16×9.6 mm • 4.9 cm³')))")
    (:target "#stat-brick-type" :attr "text" :expr "vars.brickType.toUpperCase()")
    (:target "#stat-brick-height" :attr "text" :expr "vars.brickType === 'tile' ? '3.2 mm (1p)' : '9.6 mm (3p)'")
    (:target "#stat-studs" :attr "text" :expr "vars.brickType === 'slope' ? '4 ridge studs' : (vars.brickType === 'tile' ? '0 (smooth)' : (vars.studCount + ' studs'))")
    (:target "#stat-volume" :attr "text" :expr "Number(vars.volumeMm3).toLocaleString('en-US') + ' mm³'")
    (:target "#stat-clutch" :attr "text" :expr "vars.brickType === '1x2' ? '~1.4 N (1 pin)' : (vars.brickType === '2x2' ? '~2.0 N (1 tube)' : '~3.2 N (3 tubes)')")
  ))
)
