(:scene :id "altar-anatomy" :type "Slide" :title "The Catholic Altar: Sacred Anatomy, Types & Appointments" :stage "CATHOLIC LIFE" :duration 18.0
  (:vars (
    (:var :name "candleGlow" :val 1.0 :min 0.2 :max 1.5 :step 0.1 :label "Altar Candles Flame")
    (:var :name "xrayRelics" :val 0.0 :min 0.0 :max 1.0 :step 1.0 :label "Relic Stone X-Ray")
  ))
  (:inputs (
    (:slider :var "candleGlow" :label "Altar Candles Flame" :min 0.2 :max 1.5 :step 0.1)
    (:slider :var "xrayRelics" :label "Relic Stone X-Ray" :min 0.0 :max 1.0 :step 1.0)
  ))
  (:gestures (
    (:draggable :target "#altar-probe" :axis "xy" :min 100 :max 700)
  ))
  (:subtitles (
    (:start 0.00 :end 0.16 :en "The Mensa is the consecrated stone table representing Jesus Christ Himself, the living Cornerstone of the Church." :es "La Mensa es la mesa de piedra consagrada que representa a Jesucristo, la Piedra Angular de la Iglesia." :la "Mensa altaris est Christus lapis angularis: hic sacrificium eucharisticum perenne celebratur.")
    (:start 0.16 :end 0.32 :en "Inset into the mensa lies the Altar Stone, marked with five crosses for Christ's Sacred Wounds and sealing relics of the holy martyrs." :es "Incrustada en la mensa se encuentra el Ara de piedra, con cinco cruces por las Llagas de Cristo y reliquias de los mártires." :la "Petra sacra cum quinque vulneribus Christi et sanctorum martyrum reliquiis consecrata.")
    (:start 0.32 :end 0.48 :en "Pure white linens cover the mensa to recall Christ's clean burial shroud, while the front is adorned with the seasonal Antependium." :es "El mantel de lino blanco recuerda la sábana santa del sepulcro, y el frontal o antependio muestra el color litúrgico." :la "Linteum album sepulcrum Christi significat; antependium sacrum colorem temporis praefert.")
    (:start 0.48 :end 0.64 :en "The central Crucifix reminds all that the Mass is the very same sacrifice as Calvary, flanked by pure beeswax candles." :es "El crucifijo central recuerda que la Misa es el mismo sacrificio del Calvario, acompañado de cirios de cera virgen." :la "Crux altaris unum idemque sacrificium Calvariae proclamat; candelae lumen Christi effundunt.")
    (:start 0.64 :end 0.80 :en "Upon the unfolded Corporal rest the golden Chalice, Paten with host, Purificator, and protective linen Pall." :es "Sobre el Corporal desplegado reposan el Cáliz dorado, la Patena con la hostia, el Purificador y la Pala." :la "In corporali calix, patena cum hostia, purificatorium et palla ad sanctissima mysteria parantur.")
    (:start 0.80 :end 1.00 :en "On the left stands the Roman Missal; on the right, the Credence Table holds the water and wine cruets, lavabo basin, and sanctus bells." :es "A la izquierda se coloca el Misal Romano; a la derecha, la credencia con vinajeras, lavabo y campanillas." :la "Missale Romanum preces ecclesiae continet; abacus ampullas, pelvim et campanas sanctuarii sustinet.")
  ))
  (:keyframes (
    (:t 0.00 :title "1. Consecrated Mensa (Stone Table)" :rule "Mensa Altaris: Anointed with Sacred Chrism, representing Christ the Cornerstone.")
    (:t 0.16 :title "2. Altar Stone & Relics of Martyrs" :rule "Ara Sacra: Sealed sepulchrum with martyrs' relics and five engraved crosses for Christ's wounds.")
    (:t 0.32 :title "3. Altar Linens & Seasonal Antependium" :rule "Lintea & Frontale: White burial shroud linen and seasonal liturgical color frontal.")
    (:t 0.48 :title "4. Central Crucifix & Beeswax Candles" :rule "Crux & Candelae: Reminds us of Calvary; beeswax candles signify the Light of Christ.")
    (:t 0.64 :title "5. The Corporal, Chalice, Paten & Pall" :rule "Vasa Sacra: Unfolded nine-square corporal catching every sacred particle of the Eucharist.")
    (:t 0.80 :title "6. Roman Missal & Credence Appointments" :rule "Missale & Abacus: Order of Mass book, water and wine cruets, lavabo dish and sanctus bells.")
  ))
  (:interactive (
    (:checkpoint :t 0.20
      :prompt "Why does a consecrated Catholic Altar Stone contain five engraved crosses and sealed relics of martyrs?"
      :options ("To represent the Five Wounds of Christ on the Cross, echoing Revelation 6:9 where Mass was celebrated on the tombs of martyrs" "To indicate the four cardinal directions plus Rome" "As architectural measurement markers for the stone mason" "To mark where the four Gospels and the Acts of the Apostles sit")
      :answer 0
      :explanation "The five crosses cut into the altar stone represent the Five Sacred Wounds of Jesus (hands, feet, side). In the catacombs, early Christians celebrated Mass on the tombs of martyrs, fulfilled in Revelation 6:9.")
  ))
  (:bindings (
    (:target "#altar-candle-glow-1" :attr "opacity" :expr "(0.80 + Math.sin(t * Math.PI * 12) * 0.20) * (vars.candleGlow || 1.0)")
    (:target "#altar-candle-glow-2" :attr "opacity" :expr "(0.80 + Math.cos(t * Math.PI * 10) * 0.20) * (vars.candleGlow || 1.0)")
    (:target "#altar-relic-glow" :attr "opacity" :expr "vars.xrayRelics > 0.5 ? 0.95 : (t >= 0.16 && t < 0.32 ? 0.85 : 0.0)")
    (:target "#altar-probe" :attr "cx" :expr "t < 0.16 ? 400 : (t < 0.32 ? 400 : (t < 0.48 ? 320 + ((t - 0.32)/0.16)*160 : (t < 0.64 ? 400 : (t < 0.80 ? 418 : 340))))")
    (:target "#altar-probe" :attr "cy" :expr "t < 0.16 ? 230 : (t < 0.32 ? 222 : (t < 0.48 ? 260 : (t < 0.64 ? 118 : (t < 0.80 ? 212 : 210))))")
    (:target "#altar-step-title" :attr "textContent" :expr "t < 0.16 ? '1. THE CONSECRATED MENSA (CHRIST THE CORNERSTONE)' : (t < 0.32 ? '2. ALTAR STONE & MARTYRS RELICS (FIVE SACRED WOUNDS)' : (t < 0.48 ? '3. WHITE ALTAR LINEN & SEASONAL ANTEPENDIUM' : (t < 0.64 ? '4. THE CENTRAL CRUCIFIX & PURE BEESWAX CANDLES' : (t < 0.80 ? '5. THE CORPORAL, CHALICE, PATEN & SACRED PALL' : '6. THE ROMAN MISSAL & CREDENCE TABLE APPOINTMENTS'))))")
    (:target "#altar-step-desc" :expr "t < 0.16 ? 'Mensa Altaris • Anointed with Holy Chrism representing Christ Himself...' : (t < 0.32 ? 'Ara & Sepulchrum • Five crosses for the wounds of Jesus and sealed relics of martyrs...' : (t < 0.48 ? 'Linteum & Antependium • Pure white burial shroud and royal seasonal frontal...' : (t < 0.64 ? 'Crux & Candelae • Proclaiming the one sacrifice of Calvary and Christ the Light...' : (t < 0.80 ? 'Corporale & Calix • Safeguarding every sacred particle of the Holy Eucharist...' : 'Missale & Abacus • Apostolic liturgy, water and wine cruets, and sanctus bells...'))))" :attr "textContent")
  ))
)
