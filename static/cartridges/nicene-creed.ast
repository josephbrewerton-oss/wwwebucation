(:scene :id "nicene-creed" :type "Slide" :oak-id "OAK-KS3-RE-014" :oak-unit "ks3-re-catholic-creed-profession-faith" :title "The Nicene & Apostles' Creed: Credo in Unum Deum" :stage "CATHOLIC LIFE" :duration 28.0
  (:vars (
    (:var :name "creedGlow" :val 1.0 :min 0.2 :max 2.0 :step 0.1 :label "Divine Light of Faith")
  ))

  (:inputs (
    (:slider :var "creedGlow" :label "Light of Faith" :min 0.2 :max 2.0 :step 0.1)
  ))

  (:gestures (
    (:draggable :target "#creed-trinity-slider" :axis "x" :min 160 :max 640)
  ))

  (:subtitles (
    (:start 0.00 :end 0.20 :en "The Creed (from Latin 'Credo' — 'I believe') is the foundational summary of Catholic apostolic faith." :es "El Credo (del latín 'Credo' — 'Creo') es el resumen fundamental de la fe apostólica católica." :la "Symbolum Fidei seu Credo est compendium fundamentale fidei apostolicae catholicae.")
    (:start 0.20 :end 0.45 :en "First: We profess God the Father Almighty, Creator of heaven and earth, of all things visible and invisible." :es "Primero: Profesamos a Dios Padre Todopoderoso, Creador del cielo y de la tierra, de lo visible e invisible." :la "Credo in unum Deum, Patrem omnipotentem, factorem caeli et terrae, visibilium omnium et invisibilium.")
    (:start 0.45 :end 0.70 :en "Second: We profess Jesus Christ, Only-Begotten Son of God, Light from Light, True God from True God, consubstantial with the Father." :es "Segundo: Profesamos a Jesucristo, Hijo único de Dios, Dios de Dios, Luz de Luz, consustancial al Padre." :la "Et in unum Dominum Iesum Christum, Filium Dei unigenitum, Deum de Deo, Lumen de Lumine, consubstantialem Patri.")
    (:start 0.70 :end 0.88 :en "For us and for our salvation He came down from heaven, was incarnate of the Virgin Mary, and rose on the third day." :es "Por nosotros y por nuestra salvación bajó del cielo, se encarnó de María la Virgen y resucitó al tercer día." :la "Qui propter nos homines et propter nostram salutem descendit de caelis et incarnatus est de Spiritu Sancto.")
    (:start 0.88 :end 1.00 :en "Third: We profess the Holy Spirit, the Lord, the Giver of Life, and One Holy Catholic and Apostolic Church." :es "Tercero: Profesamos al Espíritu Santo, Señor y dador de vida, y una sola Iglesia Católica y Apostólica." :la "Et in Spiritum Sanctum, Dominum et vivificantem, et unam, sanctam, catholicam et apostolicam Ecclesiam.")
  ))

  (:keyframes (
    (:t 0.00 :title "1. Credo in Unum Deum (I Believe)" :rule "Credo: The solemn baptismal profession of faith handed down from the Apostles.")
    (:t 0.20 :title "2. First Article: God the Father Almighty" :rule "Deus Pater: Creator of all things visible and invisible in heaven and earth.")
    (:t 0.45 :title "3. Second Article: Jesus Christ Consubstantial" :rule "Homoousios: True God from True God, begotten not made, incarnate for our redemption.")
    (:t 0.70 :title "4. The Paschal Mystery & Resurrection" :rule "Crucifixus & Resurrexit: Suffering under Pontius Pilate, rising in glory to judge living and dead.")
    (:t 0.88 :title "5. Third Article: Holy Spirit & One Holy Catholic Church" :rule "Spiritus Sanctus: The Lord and Giver of Life, speaking through prophets, sanctifying the Church.")
  ))

  (:interactive (
    (:checkpoint :t 0.35
      :prompt "What does the Latin word 'Credo' mean when we stand to profess our Catholic faith at Mass?"
      :options ("I believe / I entrust my whole heart and intellect to God" "I hope for good fortune in earthly life" "A historical narrative of ancient Roman law" "A suggestion of personal opinions")
      :answer 0
      :explanation "'Credo' means 'I believe' — expressing not mere intellectual agreement, but the total surrender of heart, mind, and will in covenant with the Living God.")
    (:checkpoint :t 0.75
      :prompt "What Greek term did the Council of Nicaea (AD 325) proclaim to define that Jesus is of the exact same divine substance as the Father?"
      :options ("Homoousios (Consubstantial / Of one Being with the Father)" "Homoiousios (Of similar substance)" "Anomoios (Different substance)" "Ktistos (Created being)")
      :answer 0
      :explanation "The Council of Nicaea defended the full divinity of Christ using 'Homoousios' (Consubstantial), translated in the Creed as 'consubstantial with the Father' against the Arian heresy.")
  ))

  (:bindings (
    (:target "#creed-glow-effect" :attr "opacity" :expr "0.4 + 0.4 * (vars.creedGlow || 1.0)")
    (:target "#trinity-article-display" :attr "opacity" :expr "1.0")
  ))
)
