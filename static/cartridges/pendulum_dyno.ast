(cartridge
  (meta
    (id "inverted-pendulum-dyno")
    (version "1.0.0")
    (fps 60)
    (budget-kb 32))

  ;; State Vector Definition: (x, v_x, theta, omega, t)
  ;; x: [-300.0 .. 300.0] track offset from centre (px)
  ;; v_x: cart velocity
  ;; theta: [-3.1415 .. 3.1415] angle from upright vertical (rad)
  ;; omega: angular velocity
  ;; t: normalized cycle time [0.0 .. 1.0]
  (state
    (cart-x 0.0)
    (cart-vx 0.0)
    (pole-rad 0.05)
    (pole-omega 0.0)
    (mode :tuple))

  ;; Hardware Binding: Directly drives the SVG nodes without DOM diffing
  (bind
    (target "#cart"
      (attr "transform" (format "translate({0}, 250)" (+ 400 (get state cart-x)))))
    
    ;; Polar Needle Law: rotation strictly around the pivot (0, 0)
    (target "#pole"
      (attr "transform" (format "rotate({0}, 0, 0)" (rad->deg (get state pole-rad))))))

  ;; Inference Interface: Defines how state feeds into Nano
  (inference-profile
    (:tuple
      (format "({0},{1},{2},{3})")
      (parse :flat-numeric-array)
      (expected-bytes 16))
    
    (:json
      (format "{\"cart\":{\"x\":{0},\"vx\":{1}},\"pole\":{\"theta\":{2},\"omega\":{3}}}")
      (parse :json-object)
      (expected-bytes 148))))
