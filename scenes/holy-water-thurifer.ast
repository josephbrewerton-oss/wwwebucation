(:scene :id "holy-water-thurifer" :type "Sim" :oak-id "OAK-KS2-RE-004" :oak-unit "ks2-re-catholic-asperges-incensations" :title "Holy Water & The Thurible: Asperges, Incense & Sacramental Purification" :stage "CATHOLIC LIFE" :duration 24.0
  (:vars (
    (:var :name "swingArc" :val 25.0 :min 5.0 :max 50.0 :step 5.0 :label "Thurible Chain Swing Arc")
    (:var :name "smokeDensity" :val 1.0 :min 0.2 :max 2.0 :step 0.2 :label "Incense Smoke Density")
    (:var :name "holyWaterSprinkled" :val 1.0 :min 0.0 :max 1.0 :step 1.0 :label "Asperges Sprinkling")
  ))
  (:inputs (
    (:slider :var "swingArc" :label "Thurible Swing Amplitude" :min 5.0 :max 50.0 :step 5.0)
    (:slider :var "smokeDensity" :label "Sweet Frankincense Smoke" :min 0.2 :max 2.0 :step 0.2)
    (:slider :var "holyWaterSprinkled" :label "Asperges Sprinkling" :min 0.0 :max 1.0 :step 1.0)
  ))
  (:gestures (
    (:draggable :target "#thurible-censer-handle" :axis "xy" :min 100 :max 700)
  ))
  (:subtitles (
    (:start 0.00 :end 0.28 :en "Holy Water (Aqua Benedicta) is a sacramental of the Church, blessed by the priest with salt. Entering the church, we dip our fingers and make the Sign of the Cross to recall our baptismal rebirth and cleanse venial faults." :es "El Agua Bendita es un sacramental de la Iglesia bendecido con sal. Al entrar, mojamos los dedos y nos persignamos recordando nuestro bautismo y purificando las faltas veniales." :la "Aqua Benedicta: In nomine Patris, et Filii, et Spiritus Sancti. Per hanc aquam benedictam et per tuam misericordiam indulge mihi, Domine, delicta mea.")
    (:start 0.28 :end 0.55 :en "The Asperges Me rite: On Sundays, especially before high Mass, the priest sprinkles the altar, ministers, and entire congregation using the Aspergillum (sprinkler) and Situla (holy water bucket), singing Psalm 51." :es "El rito del Asperges: Los domingos, el sacerdote asperja el altar, los ministros y la asamblea con el hisopo y la acetre, cantando el Salmo 50." :la "Asperges me, Domine, hyssopo, et mundabor: lavabis me, et super nivem dealbabor. Miserere mei, Deus, secundum magnam misericordiam tuam.")
    (:start 0.55 :end 0.78 :en "The Thurible (Thuribulum) & Boat (Navicula): The boat bearer presents fragrant frankincense; the priest spoons 3 measures upon the red-hot glowing charcoal, making the sign of the cross to bless the rising offering." :es "El Incensario y la Naveta: El navetero presenta el incienso; el sacerdote vierte 3 cucharadas sobre las brasas ardientes y bendice la ofrenda que asciende." :la "Incensum istud a te benedictum ascendat ad te, Domine: et descendat super nos misericordia tua. Dirigatur, Domine, oratio mea sicut incensum in conspectu tuo.")
    (:start 0.78 :end 1.00 :en "The Seven Mass Incensations: The thurifer swings the censer with precision—incensing the Altar, Crucifix, Gospel book, bread and wine, the Priest, and the congregation (representing Christ's royal priesthood, Rev 8:3-4)." :es "Las 7 incensaciones de la Misa: El turiferario inciensa el altar, la cruz, el Evangelio, los dones, el sacerdote y al pueblo (sacerdocio real, Apoc 8:3-4)." :la "Thurificatio: Stetit Angelus iuxta aram templi, habens thuribulum aureum in manu sua: et data sunt ei incensa multa. Amen.")
  ))
  (:keyframes (
    (:t 0.00 :title "1. Holy Water Stoup & Baptismal Rebirth" :rule "Aqua Benedicta • Salt and water sacramental; threshold cleansing upon entering the house of God.")
    (:t 0.28 :title "2. The Sunday Asperges Rite & Vidi Aquam" :rule "Aspergillum & Situla • Sprinkling of the congregation; 'Cleanse me with hyssop and I shall be whiter than snow.'")
    (:t 0.55 :title "3. The Thurible Anatomy, Charcoal & Boat" :rule "Thuribulum & Navicula • 3 chains, glowing briquette, spoons of frankincense and myrrh.")
    (:t 0.78 :title "4. The Liturgical Incensations (Gospel & People)" :rule "Thurificatio • Double swings; prayers rising like incense before the throne of the Lamb.")
  ))
  (:interactive (
    (:checkpoint :t 0.25
      :prompt "What theological category does Holy Water belong to in Catholic teaching?"
      :options ("A Sacramental instituted by the Church to remit venial sins and dispose souls for divine grace" "A mandatory eighth Sacrament instituted by Christ at the Jordan" "Simply symbolic tap water with no spiritual blessing" "A relic of the Old Testament temple sacrifices")
      :answer 0
      :explanation "Under CCC 1667, holy water is a Sacramental. Unlike the seven Sacraments which were instituted directly by Christ, sacramentals are instituted by the Church to prepare us to receive grace and dispose us to cooperate with it.")
    (:checkpoint :t 0.50
      :prompt "During Eastertide, what triumphant chant replaces the penitential 'Asperges Me' during the Sunday sprinkling rite?"
      :options ("Vidi Aquam ('I saw water flowing from the right side of the temple, alleluia!')" "Dies Irae" "Stabat Mater Dolorosa" "Tantum Ergo")
      :answer 0
      :explanation "During the 50 days of Easter, the Church sings 'Vidi Aquam' based on Ezekiel 47:1-9, celebrating the living water pouring from the pierced side of the Risen Christ on Calvary.")
    (:checkpoint :t 0.85
      :prompt "What do the rising clouds of sweet-smelling incense symbolize during holy Mass and Eucharistic Adoration?"
      :options ("The prayers and adoration of the saints rising directly to the throne of God (Psalm 141:2; Rev 8:3)" "A chemical disinfectant to preserve ancient cathedral stones" "A signal to the choir master to stop singing" "A decorative mist intended to hide the altar servers")
      :answer 0
      :explanation "Psalm 141:2 proclaims: 'Let my prayer rise before you like incense, the lifting up of my hands like an evening sacrifice.' In Revelation 8:3-4, the angel offers the incense with the prayers of all God's people on the golden altar before the throne.")
  ))
 (:bindings (
    ;; 1. Solemn, stately thurible swing (clamped and phased)
    (:target "#thurible-swing-group" :attr "transform" 
      :expr "'rotate(' + (t >= 0.55 ? Math.sin((t - 0.55) * Math.PI * 3) * (vars.swingArc || 25) : 0) + ' 400 60)'")

    ;; 2. Smoke Vertical Rise & Drift: Sways in harmonic cadence with the thurible (PI * 8)
    (:target "#incense-smoke-cloud" :attr "transform" 
      :expr "t >= 0.55 ? 'translate(' + (Math.sin((t - 0.55) * Math.PI * 3) * 16) + ',' + (-((t - 0.55) * 200) % 180) + ') scale(' + (1.0 + (((t - 0.55) * 1.5) % 1.1)) + ')' : 'translate(0,0) scale(0)'")

    ;; 3. Smoke Opacity: Fades in at the thurible, remains dense, fades toward top
    (:target "#incense-smoke-cloud" :attr "opacity" 
      :expr "t >= 0.55 ? Math.max(0, (0.75 - (((t - 0.55) * 1.5) % 0.8)) * (vars.smokeDensity || 1.0)) : 0.0")

    ;; 4. Asperges Droplets: Active only during Step 2 (0.28 to 0.55), pulsating outward
    (:target "#water-droplet-burst" :attr "opacity" 
      :expr "t >= 0.28 && t < 0.55 && (vars.holyWaterSprinkled !== 0) ? (0.85 + Math.sin(t * 18) * 0.15) : 0.0")
    (:target "#water-droplet-burst" :attr "transform" 
      :expr "t >= 0.28 && t < 0.55 ? 'translate(0,' + ((t * 80) % 25) + ') scale(' + (1.0 + ((t * 3) % 0.4)) + ')' : 'scale(1)'")
 ))
)
