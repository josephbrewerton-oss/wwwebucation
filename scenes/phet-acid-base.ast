(:scene :id "phet-acid-base" :type "Sim" :type "InteractiveLab" :oak-id "OAK-KS4-SCI-PHETACID" :oak-unit "ks4-science-phet-acid-base" :title "Acid-Base Titration Lab" :stage "KS3/KS4 CHEMISTRY"
  (:state (
    ;; Titrant volume in mL: negative = acid added, positive = alkali added, 0 = neutral water
    (:var :name "v_added" :init 0.0 :min -50.0 :max 50.0)
  ))

  (:static (
    (:element :target "#beaker-outline" :cache true)
    (:element :target "#dropper-track" :cache true)
    (:element :target "#ph-scale-legend" :cache true)
  ))

  (:actors (
    (:actor :target "#dropper-handle" :draggable true :axis "x")
    (:actor :target "#ph-probe" :draggable true :axis "xy")
    (:actor :target "#ph-val" :kinematic true)
    (:actor :target "#beaker-fluid" :kinematic true :will-change true)
  ))

  (:constraints (
    ;; Lock dropper handle travel along the horizontal dosage track (e.g. x: 100 to 300)
    (:drag-bounds :target "#dropper-handle" :min-x 100 :max-x 300 :min-y 60 :max-y 60)
    ;; Map handle x coordinate (100-300) to v_added (-50.0 mL to +50.0 mL)
    (:bind-var :target "#dropper-handle" :axis "x" :var "v_added" 
               :transform "((x - 200) / 100) * 50.0")
  ))

  ;; State equations: Derive pH from v_added
  (:bindings (
    ;; Sigmoidal titration curve: pH 7 at 0 mL, sharp drop with acid, sharp rise with alkali
    (:target "#ph-val" :attr "textContent" 
             :expr "'pH ' + (7.0 + (v_added < 0 ? -Math.min(5.8, Math.log10(1 + Math.abs(v_added) * 20)) : Math.min(6.8, Math.log10(1 + v_added * 20)))).toFixed(1)")

    ;; Universal indicator chromatic shift based on computed pH
    (:target "#beaker-fluid" :attr "fill" 
             :expr "let ph = 7.0 + (v_added < 0 ? -Math.min(5.8, Math.log10(1 + Math.abs(v_added) * 20)) : Math.min(6.8, Math.log10(1 + v_added * 20)));
                    ph < 3 ? '#ef4444' : (ph < 6 ? '#f97316' : (ph < 8 ? '#22c55e' : (ph < 11 ? '#3b82f6' : '#7c3aed')))")

    ;; Dynamic fluid level displacement in beaker as liquid is added
    (:target "#beaker-fluid" :attr "height" 
             :expr "120 + Math.abs(v_added) * 0.6")
  ))

  ;; Socratic verification for deterministic evaluation (Tier 3 fallback)
  (:checkpoints (
    (:checkpoint :id "reach-strong-acid" 
                 :condition "v_added <= -35.0" 
                 :prompt "Notice the color change. What ion dominates at this low pH?")
    (:checkpoint :id "reach-neutral" 
                 :condition "Math.abs(v_added) < 2.0" 
                 :prompt "The solution is balanced. What is the ratio of [H3O+] to [OH-]?")
  ))
)
