(:scene :id "dna-helix" :type "Sim" :oak-id "OAK-KS3-SCI-005" :oak-unit "ks3-biology-genetics-dna-transcription" :title "Genetics: DNA Base Pairing & Transcription" :stage "KS3 GENETICS" :duration 12.0
  (:camera :distance 440 :pitch 18 :yaw "((vars.rotSpeed != null ? vars.rotSpeed : 1.0) * (clock != null ? clock : (t * 12.0)) * 25.0)" :fov 60)
  (:vars (
    (:var :name "rotSpeed" :val 1.0 :min 0.2 :max 3.0 :step 0.2 :label "Helix Spin Rate")
    (:var :name "unzipProgress" :val 0.0 :min 0.0 :max 1.0 :step 0.05 :label "Helicase Unzip Progress")
    (:var :name "baseFilter" :val "all" :label "Base Pair Filter")
    (:var :name "inspectedRung" :val 0 :min 0 :max 18 :step 1 :label "Inspected Rung Index")
  ))
  (:inputs (
    (:slider :var "rotSpeed" :label "Rotation Velocity" :min 0.2 :max 3.0 :step 0.2)
    (:slider :var "unzipProgress" :label "Transcription Unzip" :min 0.0 :max 1.0 :step 0.05)
  ))
  (:computed (
    (:name "hydrogenBonds" :expr "(round (* (- 1.0 unzipProgress) 45))")
  ))
  (:gestures (
    (:trackball :target "#stage-svg")
    (:clickable :target "#btn-dna-unzip-0" :set-var "unzipProgress" :val 0.0 :tone "440")
    (:clickable :target "#btn-dna-unzip-0" :set-var "inspectedRung" :val 0)
    (:clickable :target "#btn-dna-unzip-50" :set-var "unzipProgress" :val 0.5 :tone "554.37")
    (:clickable :target "#btn-dna-unzip-50" :set-var "inspectedRung" :val 0)
    (:clickable :target "#btn-dna-unzip-100" :set-var "unzipProgress" :val 1.0 :tone "659.25")
    (:clickable :target "#btn-dna-unzip-100" :set-var "inspectedRung" :val 0)
    (:clickable :target "#btn-dna-filter-all" :set-var "baseFilter" :val "all" :tone "523.25")
    (:clickable :target "#btn-dna-filter-at" :set-var "baseFilter" :val "at" :tone "659.25")
    (:clickable :target "#btn-dna-filter-cg" :set-var "baseFilter" :val "cg" :tone "783.99")
    (:clickable :target "#btn-dna-speed-1" :set-var "rotSpeed" :val 1.0 :tone "480")
    (:clickable :target "#btn-dna-speed-2" :set-var "rotSpeed" :val 2.0 :tone "600")
    (:clickable :target ".dna-rung-at" :set-var "inspectedRung" :attr "data-rung" :tone "523.25,659.25")
    (:clickable :target ".dna-rung-cg" :set-var "inspectedRung" :attr "data-rung" :tone "440,554.37,659.25")
    (:key :code "ArrowUp" :step-var "unzipProgress" :delta 0.05 :min 0.0 :max 1.0)
    (:key :code "ArrowDown" :step-var "unzipProgress" :delta -0.05 :min 0.0 :max 1.0)
    (:key :code "ArrowRight" :step-var "rotSpeed" :delta 0.2 :min 0.2 :max 3.0)
    (:key :code "ArrowLeft" :step-var "rotSpeed" :delta -0.2 :min 0.2 :max 3.0)
  ))
  (:subtitles (
    (:start 0.00 :end 0.35 :en "DNA contains hereditary code structured as an anti-parallel double helix spiraling in 3D." :es "El ADN contiene el código genético estructurado como una doble hélice en 3D.")
    (:start 0.35 :end 0.70 :en "Complementary base rule: Adenine (Red) pairs with Thymine (Green); Cytosine (Blue) with Guanine (Gold)." :es "Regla complementaria: Adenina se une a Timina; Citosina se une a Guanina.")
    (:start 0.70 :end 1.00 :en "Hydrogen bonds hold the rungs together. Drag anywhere on stage to orbit this DNA helix in 3D!" :es "Los puentes de hidrógeno unen las bases. ¡Arrastra para rotar la hélice en 3D!")
  ))
  (:keyframes (
    (:t 0.00 :title "Double Helix Geometry" :rule "Anti-parallel sugar-phosphate backbones spiraling in 3D.")
    (:t 0.35 :title "Watson-Crick Base Pairs" :rule "Adenine (A) always pairs with Thymine (T) via 2 hydrogen bonds.")
    (:t 0.70 :title "Cytosine-Guanine Pairs" :rule "Cytosine (C) pairs with Guanine (G) via 3 hydrogen bonds.")
    (:t 1.00 :title "Replication Fork Unzip" :rule "Helicase enzyme unzips hydrogen bonds for semi-conservative replication.")
  ))
  (:interactive (
    (:checkpoint :t 0.50
      :prompt "According to Watson-Crick base-pairing rules, which nitrogenous base pairs with Adenine (A) in DNA?"
      :options ("Thymine (T) via 2 hydrogen bonds" "Cytosine (C)" "Guanine (G)" "Uracil (only in RNA)")
      :answer 0
      :explanation "In double-stranded DNA, Adenine (A) always pairs specifically with Thymine (T) via 2 hydrogen bonds, while Guanine (G) pairs with Cytosine (C) via 3 hydrogen bonds.")
    (:checkpoint :t 0.85
      :prompt "Which enzyme unzips the hydrogen bonds between DNA strands at the replication fork?"
      :options ("DNA Helicase" "Amylase" "Lipase" "Hemoglobin")
      :answer 0
      :explanation "DNA Helicase unwinds the double helix and breaks weak hydrogen bonds between complementary bases so each strand can serve as a template.")
  ))
  (:bindings (
    ; Status HUD & Active Pill Highlights
    (:target "#dna-status-text"
      (:text "(if (> inspectedRung 0) (str \"Inspected Rung #\" inspectedRung \": \" (if (= (% inspectedRung 2) 1) \"Adenine = Thymine (2 Hydrogen Bonds)\" \"Cytosine ≡ Guanine (3 Hydrogen Bonds)\")) (if (> unzipProgress 0) (str \"Replication Fork: Helicase Active! \" hydrogenBonds \" / 45 H-Bonds Intact (\" (round (* (- 1 unzipProgress) 100)) \"%)\") \"Strand A 5'→3' • Strand B 3'→5' • 45 Hydrogen Bonds (100% Intact)\"))")
      (:attr "fill" "(if (> inspectedRung 0) (if (= (% inspectedRung 2) 1) \"#f87171\" \"#60a5fa\") \"#94a3b8\")"))
    (:target "#btn-dna-unzip-0-bg" :attr "fill" :expr "(if (= (or unzipProgress 0) 0) \"#0284c7\" \"#1e293b\")")
    (:target "#btn-dna-unzip-50-bg" :attr "fill" :expr "(if (< (abs (- (or unzipProgress 0) 0.5)) 0.1) \"#0284c7\" \"#1e293b\")")
    (:target "#btn-dna-unzip-100-bg" :attr "fill" :expr "(if (= unzipProgress 1.0) \"#0284c7\" \"#1e293b\")")
    (:target "#btn-dna-filter-all-bg" :attr "fill" :expr "(if (= (or baseFilter \"all\") \"all\") \"#0284c7\" \"#1e293b\")")
    (:target "#btn-dna-filter-at-bg" :attr "fill" :expr "(if (= baseFilter \"at\") \"#0284c7\" \"#1e293b\")")
    (:target "#btn-dna-filter-cg-bg" :attr "fill" :expr "(if (= baseFilter \"cg\") \"#0284c7\" \"#1e293b\")")
    (:target "#btn-dna-speed-1-bg" :attr "fill" :expr "(if (<= (or rotSpeed 1.0) 1.2) \"#0284c7\" \"#1e293b\")")
    (:target "#btn-dna-speed-2-bg" :attr "fill" :expr "(if (> (or rotSpeed 1.0) 1.2) \"#0284c7\" \"#1e293b\")")

    ; Base-Pair Filter Opacity (Even Rungs = A-T, Odd Rungs = C-G)
    (:for i (0 16 2)
      (:target "#dna-line-{{i}}" :attr "stroke-opacity" :expr "vars.baseFilter === 'cg' ? '0.12' : '1.0'")
      (:target "#dna-ca-{{i}}"
        (:attr "fill-opacity" "vars.baseFilter === 'cg' ? '0.12' : '1.0'")
        (:attr "stroke-opacity" "vars.baseFilter === 'cg' ? '0.12' : '1.0'"))
      (:target "#dna-cb-{{i}}"
        (:attr "fill-opacity" "vars.baseFilter === 'cg' ? '0.12' : '1.0'")
        (:attr "stroke-opacity" "vars.baseFilter === 'cg' ? '0.12' : '1.0'"))
    )
    (:for i (1 17 2)
      (:target "#dna-line-{{i}}" :attr "stroke-opacity" :expr "vars.baseFilter === 'at' ? '0.12' : '1.0'")
      (:target "#dna-ca-{{i}}"
        (:attr "fill-opacity" "vars.baseFilter === 'at' ? '0.12' : '1.0'")
        (:attr "stroke-opacity" "vars.baseFilter === 'at' ? '0.12' : '1.0'"))
      (:target "#dna-cb-{{i}}"
        (:attr "fill-opacity" "vars.baseFilter === 'at' ? '0.12' : '1.0'")
        (:attr "stroke-opacity" "vars.baseFilter === 'at' ? '0.12' : '1.0'"))
    )

    ; 18 Anti-Parallel 3D Helical Base-Pair Rungs & Catmull-Rom Backbones
    (:for i (0 17)
      (:target "#dna-line-{{i}}" :type "3d-line"
        :x1 "(* -110 (cos (* (/ {{i}} 18) PI 3)))" :y1 "(- (* (/ {{i}} 18) 360) 180)" :z1 "(* -110 (sin (* (/ {{i}} 18) PI 3)))"
        :x2 "(* 110 (cos (* (/ {{i}} 18) PI 3)))" :y2 "(- (* (/ {{i}} 18) 360) 180)" :z2 "(* 110 (sin (* (/ {{i}} 18) PI 3)))"
        :cap1 "#dna-ca-{{i}}" :cap2 "#dna-cb-{{i}}" :base-r 8
        :split-expr "(if (and (> unzipProgress 0) (<= (/ {{i}} 18) unzipProgress)) (* (+ (- unzipProgress (/ {{i}} 18)) 0.1) 35) 0)"
        :spline-a "#dna-backbone-a" :spline-b "#dna-backbone-b" :spline-index {{i}})
    )
  ))
)
