(:scene :id "bsl-fingerspelling" :type "Sim" :oak-id "OAK-KS2-INC-001" :title "BSL: 3D British Sign Language Two-Handed Fingerspelling" :stage "ACCESSIBILITY & LANGUAGES" :duration 16.0
  (:camera :distance 420 :pitch 18 :yaw "cameraYaw" :fov 60)
  (:vars (
    (:var :name "cameraYaw" :val 0 :min -180 :max 180 :step 5 :label "360° Hand Orbit (°)")
    (:var :name "speed" :val 1.0 :min 0.2 :max 2.0 :step 0.1 :unit "x" :label "Signing Speed")
    (:var :name "letterIndex" :val 0 :min 0 :max 5 :step 1 :label "Vowel Selector (A-E-I-O-U)")
  ))
  (:inputs (
    (:slider :var "cameraYaw" :label "360° Free Hand Orbit (°)" :min -180 :max 180 :step 5)
    (:slider :var "speed" :label "Signing Speed (x)" :min 0.2 :max 2.0 :step 0.1)
  ))
  (:gestures (
    (:draggable :target "#pointer-hand" :axis "xy" :min -120 :max 120)
    (:draggable :target "#orbit-control-dot" :axis "x" :min -180 :max 180 :var "cameraYaw")
  ))
  (:subtitles (
    (:start 0.00 :end 0.25 :en "British Sign Language (BSL) uses a two-handed manual alphabet: the non-dominant hand is the base paper, and the dominant hand is the pen." :es "El lenguaje de señas británico (BSL) utiliza un alfabeto bimanual: la mano no dominante actúa como papel base y la dominante como pluma.")
    (:start 0.25 :end 0.50 :en "Vowels are located sequentially on the 5 fingertips of the non-dominant hand: Thumb is A, Index is E, Middle is I, Ring is O, and Pinky is U." :es "Las vocales se ubican en la punta de los 5 dedos: el pulgar es A, índice es E, medio es I, anular es O y meñique es U.")
    (:start 0.50 :end 0.75 :en "To sign 'A', touch the dominant index tip cleanly to the non-dominant thumb. Rotate in 3D to inspect the exact finger contact angle." :es "Para hacer 'A', toque la punta del índice dominante en el pulgar no dominante. Gire en 3D para ver el ángulo de contacto.")
    (:start 0.75 :end 1.00 :en "Consonants combine hand shapes against palms: 'C' forms an open arc, 'D' pairs index with thumb circle, and 'M' rests 3 fingers on the open palm." :es "Las consonantes combinan formas manuales: 'C' forma un arco abierto, 'D' une índice con círculo de pulgar, y 'M' coloca 3 dedos en la palma.")
  ))
  (:keyframes (
    (:t 0.00 :title "1. The Two-Handed Substrate: Base & Pen" :rule "Non-dominant hand opens palm forward (chest level). Dominant hand points index forward.")
    (:t 0.25 :title "2. The 5 Vowel Fingertips (A - E - I - O - U)" :rule "A = Thumb, E = Index, I = Middle, O = Ring, U = Little finger.")
    (:t 0.50 :title "3. Continuous Touch Contact" :rule "Point of contact must be firm and clearly oriented toward the conversation partner.")
    (:t 0.75 :title "4. Spatial Fluency & 360° Orientation" :rule "Keep hands at chest height. Never block facial expressions or mouth lip patterns.")
  ))
  (:interactive false)
  (:questions false)
  (:bindings (
    <!-- 3D Base Hand (Non-Dominant Open Palm) -->
    (:target "#base-wrist" :type "3d-node" :x "-60" :y "80" :z "0" :base-r 18 :depth-fog true)
    (:target "#base-palm" :type "3d-node" :x "-50" :y "30" :z "10" :base-r 28 :depth-fog true)
    (:target "#base-thumb-tip" :type "3d-node" :x "-95" :y "10" :z "15" :base-r 12 :depth-fog true)
    (:target "#base-index-tip" :type "3d-node" :x "-75" :y "-40" :z "18" :base-r 11 :depth-fog true)
    (:target "#base-middle-tip" :type "3d-node" :x "-50" :y "-50" :z "20" :base-r 11 :depth-fog true)
    (:target "#base-ring-tip" :type "3d-node" :x "-28" :y "-42" :z "16" :base-r 11 :depth-fog true)
    (:target "#base-pinky-tip" :type "3d-node" :x "-10" :y "-25" :z "12" :base-r 10 :depth-fog true)

    <!-- 3D Finger Bones connecting Palm to Vowel Tips -->
    (:target "#bone-thumb" :type "3d-line" :x1 "-50" :y1 "30" :z1 "10" :x2 "-95" :y2 "10" :z2 "15" :depth-fog true)
    (:target "#bone-index" :type "3d-line" :x1 "-50" :y1 "30" :z1 "10" :x2 "-75" :y2 "-40" :z2 "18" :depth-fog true)
    (:target "#bone-middle" :type "3d-line" :x1 "-50" :y1 "30" :z1 "10" :x2 "-50" :y2 "-50" :z2 "20" :depth-fog true)
    (:target "#bone-ring" :type "3d-line" :x1 "-50" :y1 "30" :z1 "10" :x2 "-28" :y2 "-42" :z2 "16" :depth-fog true)
    (:target "#bone-pinky" :type "3d-line" :x1 "-50" :y1 "30" :z1 "10" :x2 "-10" :y2 "-25" :z2 "12" :depth-fog true)

    <!-- 3D Dominant Pointer Hand ("The Pen") -->
    (:target "#dom-wrist" :type "3d-node" :x "110" :y "80" :z "-20" :base-r 18 :depth-fog true)
    (:target "#dom-knuckle" :type "3d-node" :x "60" :y "25" :z "0" :base-r 24 :depth-fog true)
    (:target "#dom-pointer-tip" :type "3d-node" :x "t < 0.25 ? -95 : (t < 0.5 ? -75 : (t < 0.75 ? -50 : -28))" :y "t < 0.25 ? 10 : (t < 0.5 ? -40 : (t < 0.75 ? -50 : -42))" :z "25" :base-r 13 :depth-fog true)
    (:target "#dom-pointer-bone" :type "3d-line" :x1 "60" :y1 "25" :z1 "0" :x2 "t < 0.25 ? -95 : (t < 0.5 ? -75 : (t < 0.75 ? -50 : -28))" :y2 "t < 0.25 ? 10 : (t < 0.5 ? -40 : (t < 0.75 ? -50 : -42))" :z2 "25" :depth-fog true)

    <!-- Active Vowel Target Beacon Pulse -->
    (:target "#vowel-indicator-label" :attr "textContent" :expr "t < 0.25 ? 'ACTIVE SIGN: Vowel A (Thumb Tap)' : (t < 0.50 ? 'ACTIVE SIGN: Vowel E (Index Tap)' : (t < 0.75 ? 'ACTIVE SIGN: Vowel I (Middle Tap)' : 'ACTIVE SIGN: Vowel O (Ring Tap)'))")
    (:target "#active-vowel-glow" :attr "cx" :expr "t < 0.25 ? '305' : (t < 0.5 ? '325' : (t < 0.75 ? '350' : '372'))")
    (:target "#active-vowel-glow" :attr "cy" :expr "t < 0.25 ? '250' : (t < 0.5 ? '200' : (t < 0.75 ? '190' : '198'))")
    (:target "#active-vowel-glow" :attr "opacity" :expr "0.5 + Math.sin(t * Math.PI * 8) * 0.4")
  ))
)
