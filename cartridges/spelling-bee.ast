    (:target "#bee-slot-rect-12" :attr "fill" :expr "computed.typedLen > 12 ? '#1e293b' : (computed.typedLen === 12 ? '#0f172a' : '#090d16')")
    (:target "#bee-slot-rect-12" :attr "stroke" :expr "computed.typedLen > 12 ? '#eab308' : (computed.typedLen === 12 ? '#38bdf8' : '#334155')")
    (:target "#bee-slot-rect-12" :attr "stroke-width" :expr "computed.typedLen >= 12 ? '1.8' : '1'")
    (:target "#bee-slot-rect-12" :attr "stroke-dasharray" :expr "computed.typedLen === 12 ? '3 2' : 'none'")
    (:target "#bee-slot-txt-12" :attr "x" :expr "String(computed.slotW / 2)")
    (:target "#bee-slot-txt-12" :attr "font-size" :expr "computed.slotW > 36 ? '20' : '16'")
    (:target "#bee-slot-txt-12" :attr "fill" :expr "computed.typedLen > 12 ? '#ffffff' : '#475569'")
    (:target "#bee-slot-txt-12" :attr "textContent" :expr "String(vars.typedWord || '').charAt(12)")

    (:target "#bee-slot-13" :attr "display" :expr "computed.wordLen > 13 ? 'block' : 'none'")
    (:target "#bee-slot-13" :attr "transform" :expr "'translate(' + (computed.slotStartX + 13 * (computed.slotW + 6)) + ', 6)'")
    (:target "#bee-slot-rect-13" :attr "width" :expr "String(computed.slotW)")
    (:target "#bee-slot-rect-13" :attr "fill" :expr "computed.typedLen > 13 ? '#1e293b' : (computed.typedLen === 13 ? '#0f172a' : '#090d16')")
    (:target "#bee-slot-rect-13" :attr "stroke" :expr "computed.typedLen > 13 ? '#eab308' : (computed.typedLen === 13 ? '#38bdf8' : '#334155')")
    (:target "#bee-slot-rect-13" :attr "stroke-width" :expr "computed.typedLen >= 13 ? '1.8' : '1'")
    (:target "#bee-slot-rect-13" :attr "stroke-dasharray" :expr "computed.typedLen === 13 ? '3 2' : 'none'")
    (:target "#bee-slot-txt-13" :attr "x" :expr "String(computed.slotW / 2)")
    (:target "#bee-slot-txt-13" :attr "font-size" :expr "computed.slotW > 36 ? '20' : '16'")
    (:target "#bee-slot-txt-13" :attr "fill" :expr "computed.typedLen > 13 ? '#ffffff' : '#475569'")
    (:target "#bee-slot-txt-13" :attr "textContent" :expr "String(vars.typedWord || '').charAt(13)")
  ))
)
