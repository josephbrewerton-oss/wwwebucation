(:scene :id "spelling-bee" :type "App" :oak-id "OAK-KS2-ENG-003" :oak-unit "ks2-english-writing-orthography-spelling" :title "Spelling Bee Championship: KS1 to KS3 Orthography" :stage "KS1/KS2/KS3 ENGLISH" :duration 14.0
  (:vars (
    (:var :name "keyStage" :val "KS2U" :label "Key Stage (KS1, KS2L, KS2U, KS3)")
    (:var :name "ksIdx" :val 2 :min 0 :max 3 :step 1 :label "Key Stage Index (0=KS1, 1=KS2L, 2=KS2U, 3=KS3)")
    (:var :name "wordIdx" :val 0 :min 0 :max 7 :step 1 :label "Word Index")
    (:var :name "typedWord" :val "" :label "Typed Letters")
    (:var :name "score" :val 0 :min 0 :max 10000 :step 10 :label "Championship Score")
    (:var :name "streak" :val 0 :min 0 :max 500 :step 1 :label "Honey Streak")
    (:var :name "speechRate" :val 0.95 :min 0.5 :max 1.5 :step 0.05 :label "Speech Speed")
    (:var :name "feedbackMode" :val 0 :min 0 :max 3 :step 1)
    (:var :name "checkResult" :val 0 :min 0 :max 2 :step 1)
    (:var :name "lastEarned" :val 20 :min 0 :max 5000 :step 5)
    (:var :name "lastSolvedWord" :val "")
  ))
  (:inputs (
    (:slider :var "speechRate" :label "Pronunciation Speed" :min 0.5 :max 1.5 :step 0.05)
  ))
  (:computed (
    (:name "ksCount" :expr "vars.ksIdx === 3 ? 6 : 8")
    (:name "ksBase" :expr "[0, 8, 16, 24][vars.ksIdx === 0 || vars.ksIdx === 1 || vars.ksIdx === 2 || vars.ksIdx === 3 ? vars.ksIdx : 2]")
    (:name "gIdx" :expr "computed.ksBase + ((vars.wordIdx || 0) % computed.ksCount)")
    (:name "targetWord" :expr "['FRIEND','BECAUSE','BEAUTIFUL','CLIMB','COULD','SCHOOL','THOUGHT','WATER','ACCIDENT','BELIEVE','CALENDAR','DECIDE','FAMOUS','GRAMMAR','ISLAND','NOTICE','ACCOMMODATE','EMBARRASS','HIERARCHY','MISCHIEVOUS','NECESSARY','RHYTHM','PRIVILEGE','CONSCIOUS','PHOTOSYNTHESIS','PARLIAMENTARY','CONSCIENTIOUS','QUESTIONNAIRE','METAMORPHOSIS','UBIQUITOUS'][computed.gIdx]")
    (:name "targetWordLower" :expr "['friend','because','beautiful','climb','could','school','thought','water','accident','believe','calendar','decide','famous','grammar','island','notice','accommodate','embarrass','hierarchy','mischievous','necessary','rhythm','privilege','conscious','photosynthesis','parliamentary','conscientious','questionnaire','metamorphosis','ubiquitous'][computed.gIdx]")
    (:name "wordType" :expr "['Noun • Common Exception Word','Conjunction • Phonics Rule','Adjective • Suffix Rule','Verb • Silent Letter','Modal Verb • National Curriculum','Noun • Greek Root','Noun/Verb • Trigraph Pattern','Noun • Common Exception','Noun • Statutory Year 3/4','Verb • Statutory Year 3/4','Noun • Statutory Year 3/4','Verb • Statutory Year 3/4','Adjective • Statutory Year 3/4','Noun • Statutory Year 3/4','Noun • Statutory Year 3/4','Verb/Noun • Statutory Year 3/4','Verb • Statutory Year 5/6','Verb • Statutory Year 5/6','Noun • Statutory Year 5/6','Adjective • Statutory Year 5/6','Adjective • Statutory Year 5/6','Noun • Statutory Year 5/6','Noun • Statutory Year 5/6','Adjective • Statutory Year 5/6','Noun • KS3 Science Academic','Adjective • KS3 Humanities','Adjective • KS3 English/Etymology','Noun • KS3 English/French Root','Noun • KS3 Biology/Literature','Adjective • KS3 Advanced Vocabulary'][computed.gIdx]")
    (:name "wordDef" :expr "['A person you know well and regard with affection and trust.','For the reason that; since.','Pleasing the senses or mind aesthetically.','Go or come up a slope or height.','Used to express possibility or past ability.','An institution for educating children and pupils.','An idea or opinion produced by thinking.','Clear liquid essential for all plant and animal life.','An unfortunate incident that happens unexpectedly and unintentionally.','Accept that something is true, especially without proof.','A chart or series of pages showing days, weeks, and months.','Come or bring to a resolution in the mind as a result of consideration.','Known about by many people across nations.','The whole system and structure of a language.','A piece of land entirely surrounded by water.','Become aware of or give attention to.','Provide lodging or sufficient space for; adapt or fit.','Cause someone to feel awkward, self-conscious, or ashamed.','A system in which members of an organization are ranked by status.','Causing or showing a fondness for causing trouble in a playful way.','Required to be done, achieved, or present; needed; essential.','A strong, regular repeated pattern of movement or sound.','A special right, advantage, or immunity granted to a person or group.','Aware of and responding to ones surroundings; deliberate.','The biochemical process by which green plants synthesize glucose using sunlight.','Relating to, enacted by, or suitable for a parliament.','Wishing to do ones work or duty thoroughly and diligently.','A set of printed or written questions devised for a survey or study.','A change of the form or nature of a thing or person into a completely different one.','Present, appearing, or found everywhere simultaneously.'][computed.gIdx]")
    (:name "sentPreview" :expr "['He walked to school with his best ________ every morning.','She stayed inside ________ it was raining heavily.','The garden was filled with ________ blooming roses.','The children love to ________ the tall oak tree in the park.','They ________ hear the cathedral bells ringing across the town.','St Josephs is a welcoming and vibrant primary ________.','She ________ carefully before writing her final answer.','Remember to drink plenty of fresh ________ during sports day.','He spilled his paint entirely by ________.','We ________ kindness makes our whole classroom community thrive.','Mark the upcoming Christmas feast on your school ________.','Take a quiet moment to ________ which library book to read.','The ________ astronomer studied the moons of Jupiter.','Accurate ________ helps you communicate your ideas persuasively.','The historic Celtic abbey stood proudly on a tidal ________.','Did you ________ the intricate geometric mosaic on the wall?','The hotel could ________ up to two hundred wedding guests.','Good leaders never ________ others when they make a slip.','The feudal ________ placed the monarch at the very summit.','The ________ kitten untangled the ball of knitting wool.','Consistent practice is ________ to master long division.','The orchestra kept a triumphant ________ throughout the movement.','It was a distinct ________ to represent our school in the finals.','She made a ________ effort to include the new student at break.','Chloroplasts absorb photons to drive the reactions of ________.','The constitutional reform was passed after intense ________ debate.','A ________ student checks every science calculation twice.','Each pupil completed the anonymous pastoral ________.','The tadpole undergoes a remarkable ________ into an adult frog.','In the modern era, digital learning tools have become ________.'][computed.gIdx]")
    (:name "sentSpoken" :expr "['He walked to school with his best friend every morning.','She stayed inside because it was raining heavily.','The garden was filled with beautiful blooming roses.','The children love to climb the tall oak tree in the park.','They could hear the cathedral bells ringing across the town.','St Josephs is a welcoming and vibrant primary school.','She thought carefully before writing her final answer.','Remember to drink plenty of fresh water during sports day.','He spilled his paint entirely by accident.','We believe kindness makes our whole classroom community thrive.','Mark the upcoming Christmas feast on your school calendar.','Take a quiet moment to decide which library book to read.','The famous astronomer studied the moons of Jupiter.','Accurate grammar helps you communicate your ideas persuasively.','The historic Celtic abbey stood proudly on a tidal island.','Did you notice the intricate geometric mosaic on the wall?','The hotel could accommodate up to two hundred wedding guests.','Good leaders never embarrass others when they make a slip.','The feudal hierarchy placed the monarch at the very summit.','The mischievous kitten untangled the ball of knitting wool.','Consistent practice is necessary to master long division.','The orchestra kept a triumphant rhythm throughout the movement.','It was a distinct privilege to represent our school in the finals.','She made a conscious effort to include the new student at break.','Chloroplasts absorb photons to drive the reactions of photosynthesis.','The constitutional reform was passed after intense parliamentary debate.','A conscientious student checks every science calculation twice.','Each pupil completed the anonymous pastoral questionnaire.','The tadpole undergoes a remarkable metamorphosis into an adult frog.','In the modern era, digital learning tools have become ubiquitous.'][computed.gIdx]")
    (:name "wordPhonics" :expr "['f · r · i · e · n · d','be · cause','beau · ti · ful','c · l · i · m · b','c · o · u · l · d','s · ch · oo · l','th · ough · t','wa · ter','ac · ci · dent','be · lieve','cal · en · dar','de · cide','fa · mous','gram · mar','is · land','no · tice','ac · com · mo · date','em · bar · rass','hier · ar · chy','mis · chie · vous','nec · es · sary','rhy · thm','priv · i · lege','con · scious','pho · to · syn · the · sis','par · lia · men · ta · ry','con · sci · en · tious','ques · tion · naire','met · a · mor · pho · sis','u · biq · ui · tous'][computed.gIdx]")
    (:name "wordSyls" :expr "[6, 2, 3, 5, 5, 4, 3, 2, 3, 2, 3, 2, 2, 2, 2, 2, 4, 3, 3, 3, 3, 2, 3, 2, 5, 5, 4, 3, 5, 4][computed.gIdx]")
    (:name "wordHint" :expr "['Mnemonic: A fri-end is with you to the end!','Big Elephants Can Always Understand Small Elephants.','French root beau with suffix -ful (only one l).','Silent b at the end of the word!','O-U-L-D group (Oh U Lucky Duck) matches would and should.','Spelled with ch for the hard /k/ sound.','Contains the ought trigraph, like brought and bought.','a makes an /aw/ sound following the w.','Double c: hard /k/ followed by soft /s/ before i.','i before e except after c rule applies here!','Watch out for the ending: it ends in -ar, not -er!','Soft c followed by split vowel digraph i-e.','Root fame drops the e before adding suffix -ous.','Double m and ends in -ar (like calendar)!','Silent s! From Old English igland, influenced by Latin insula.','Ends with -ice, like practice and service.','Double c AND double m (two cots, two mattresses)!','Double r AND double s (two red roses, two sweet smiles)!','From Greek hieros (sacred) + arche (rule). Starts with hier-!','Strictly 3 syllables: mis-chuh-vus (never say mischievious)!','One Collar, two Sleeves (one c, double s)!','No conventional vowels except y! (Rhythm Helps Your Two Mice).','Ends in -lege (not -ledge) with two i vowels!','Latin scire (to know) provides the sc in conscious.','Greek photo (light) + syn (together) + thesis (placing).','From French parler (to speak); remember the ia in parliament!','Contains sc in consci followed by -entious!','Double n before the French suffix -aire!','Greek meta (change) + morphe (form) + -osis.','From Latin ubique (everywhere) -> ubiquit- + -ous.'][computed.gIdx]")
    (:name "wordLen" :expr "computed.targetWord.length")
    (:name "typedLen" :expr "String(vars.typedWord || '').length")
    (:name "slotW" :expr "Math.max(28, Math.min(46, Math.floor((740 - (computed.wordLen - 1) * 6) / computed.wordLen)))")
    (:name "slotStartX" :expr "Math.max(0, Math.floor((740 - (computed.wordLen * computed.slotW + (computed.wordLen - 1) * 6)) / 2))")
    (:name "scoreDisplay" :expr "'Score: ' + (vars.score || 0)")
    (:name "streakDisplay" :expr "'🍯 Streak: ' + (vars.streak || 0)")
    (:name "speedLabel" :expr "'Speed: ' + Number(vars.speechRate || 0.95).toFixed(2) + '× ' + ((vars.speechRate || 0.95) < 1 ? 'Slow' : 'Normal')")
    (:name "bannerDisplay" :expr "(vars.feedbackMode || 0) > 0 ? 'block' : 'none'")
    (:name "bannerColor" :expr "vars.feedbackMode === 1 ? '#34d399' : (vars.feedbackMode === 2 ? '#f87171' : '#c084fc')")
    (:name "bannerText" :expr "vars.feedbackMode === 1 ? ('🌟 Brilliant! ' + (vars.lastSolvedWord || '') + ' is spelled correctly! +' + (vars.lastEarned || 20) + ' Points!') : (vars.feedbackMode === 2 ? ('Almost! Target spelling: ' + computed.targetWordLower + ' (' + computed.wordPhonics + '). Try again!') : ('💡 Hint: ' + computed.wordHint))")
  ))
  (:gestures (
    (:key :code "ArrowUp" :step-var "speechRate" :delta 0.05 :min 0.5 :max 1.5)
    (:key :code "ArrowDown" :step-var "speechRate" :delta -0.05 :min 0.5 :max 1.5)
    (:clickable :target "[data-action='bee-set-ks']" :attr "data-ks" :set-var "keyStage" :tone "440")
    (:clickable :target "[data-action='bee-set-ks']" :set-var "ksIdx" :val-expr "vars.keyStage === 'KS1' ? 0 : (vars.keyStage === 'KS2L' ? 1 : (vars.keyStage === 'KS3' ? 3 : 2))")
    (:clickable :target "[data-action='bee-set-ks']" :set-var "wordIdx" :val 0)
    (:clickable :target "[data-action='bee-set-ks']" :set-var "typedWord" :val "")
    (:clickable :target "[data-action='bee-set-ks']" :set-var "feedbackMode" :val 0 :speak-expr "computed.targetWord" :speak-rate-var "speechRate" :speak-pitch 1.05)

    (:clickable :target "[data-action='bee-speak-word']" :tone "523.25" :speak-expr "computed.targetWordLower" :speak-rate-var "speechRate" :speak-pitch 1.05)
    (:clickable :target "[data-action='bee-speak-sentence']" :tone "440" :speak-expr "computed.sentSpoken" :speak-rate-var "speechRate" :speak-pitch 1.05)
    (:clickable :target "[data-action='bee-speak-phonics']" :tone "440" :speak-expr "computed.wordPhonics.split('·').join(', ')" :speak-rate-var "speechRate" :speak-pitch 1.05)
    (:clickable :target "[data-action='bee-hint']" :set-var "feedbackMode" :val 3 :tone "440" :speak-expr "computed.wordHint" :speak-rate-var "speechRate" :speak-pitch 1.05)
    (:clickable :target "[data-action='bee-skip']" :set-var "streak" :val 0)
    (:clickable :target "[data-action='bee-skip']" :set-var "typedWord" :val "")
    (:clickable :target "[data-action='bee-skip']" :set-var "feedbackMode" :val 0)
    (:clickable :target "[data-action='bee-skip']" :set-var "wordIdx" :val-expr "((vars.wordIdx || 0) + 1) % computed.ksCount" :tone "330" :speak-expr "computed.targetWordLower" :speak-rate-var "speechRate" :speak-pitch 1.05)
    (:clickable :target "[data-action='bee-toggle-speed']" :set-var "speechRate" :val-expr "(vars.speechRate || 0.95) >= 1.0 ? 0.75 : 1.0" :tone "520" :speak-expr "computed.targetWordLower" :speak-rate-var "speechRate" :speak-pitch 1.05)

    (:clickable :target "[data-action='bee-press-key']" :attr "data-key" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + String(_attr || '').toUpperCase()" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:clickable :target "[data-action='bee-press-key']" :set-var "feedbackMode" :val 0)

    (:clickable :target "[data-action='bee-backspace']" :if "String(vars.typedWord || '').length > 0" :set-var "typedWord" :val-expr "String(vars.typedWord || '').slice(0, -1)" :tone "280")
    (:clickable :target "[data-action='bee-backspace']" :set-var "feedbackMode" :val 0)
    (:clickable :target "[data-action='bee-clear']" :set-var "typedWord" :val "" :tone "240")
    (:clickable :target "[data-action='bee-clear']" :set-var "feedbackMode" :val 0)

    (:clickable :target "[data-action='bee-submit']" :set-var "checkResult" :val-expr "String(vars.typedWord || '').toUpperCase() === computed.targetWord ? 1 : 2")
    (:clickable :target "[data-action='bee-submit']" :if "vars.checkResult === 1" :set-var "lastEarned" :val-expr "20 + (vars.streak || 0) * 5")
    (:clickable :target "[data-action='bee-submit']" :if "vars.checkResult === 1" :set-var "lastSolvedWord" :val-expr "computed.targetWordLower")
    (:clickable :target "[data-action='bee-submit']" :if "vars.checkResult === 1" :set-var "score" :val-expr "(vars.score || 0) + (vars.lastEarned || 20)")
    (:clickable :target "[data-action='bee-submit']" :if "vars.checkResult === 1" :set-var "streak" :val-expr "(vars.streak || 0) + 1")
    (:clickable :target "[data-action='bee-submit']" :if "vars.checkResult === 1" :set-var "feedbackMode" :val 1 :tone "523.25,659.25,783.99,1046.50" :speak-expr "'Brilliant! ' + vars.lastSolvedWord" :speak-rate-var "speechRate" :speak-pitch 1.05)
    (:clickable :target "[data-action='bee-submit']" :if "vars.checkResult === 1" :set-var "typedWord" :val "")
    (:clickable :target "[data-action='bee-submit']" :if "vars.checkResult === 1" :set-var "wordIdx" :val-expr "((vars.wordIdx || 0) + 1) % computed.ksCount")
    (:clickable :target "[data-action='bee-submit']" :if "vars.checkResult === 2" :set-var "streak" :val 0)
    (:clickable :target "[data-action='bee-submit']" :if "vars.checkResult === 2" :set-var "feedbackMode" :val 2 :tone "220")

    (:key :code "KeyA" :key "A" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'A'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyB" :key "B" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'B'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyC" :key "C" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'C'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyD" :key "D" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'D'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyE" :key "E" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'E'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyF" :key "F" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'F'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyG" :key "G" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'G'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyH" :key "H" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'H'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyI" :key "I" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'I'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyJ" :key "J" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'J'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyK" :key "K" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'K'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyL" :key "L" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'L'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyM" :key "M" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'M'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyN" :key "N" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'N'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyO" :key "O" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'O'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyP" :key "P" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'P'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyQ" :key "Q" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'Q'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyR" :key "R" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'R'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyS" :key "S" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'S'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyT" :key "T" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'T'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyU" :key "U" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'U'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyV" :key "V" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'V'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyW" :key "W" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'W'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyX" :key "X" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'X'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyY" :key "Y" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'Y'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")
    (:key :code "KeyZ" :key "Z" :if "String(vars.typedWord || '').length < computed.wordLen" :set-var "typedWord" :val-expr "String(vars.typedWord || '') + 'Z'" :tone-expr "380 + (String(vars.typedWord || '').length + 1) * 28")

    (:key :code "Backspace" :key "Backspace" :if "String(vars.typedWord || '').length > 0" :set-var "typedWord" :val-expr "String(vars.typedWord || '').slice(0, -1)" :tone "280")
    (:key :code "Backspace" :key "Backspace" :set-var "feedbackMode" :val 0)
    (:key :code "Escape" :key "Escape" :set-var "typedWord" :val "" :tone "240")
    (:key :code "Escape" :key "Escape" :set-var "feedbackMode" :val 0)

    (:key :code "Enter" :key "Enter" :set-var "checkResult" :val-expr "String(vars.typedWord || '').toUpperCase() === computed.targetWord ? 1 : 2")
    (:key :code "Enter" :key "Enter" :if "vars.checkResult === 1" :set-var "lastEarned" :val-expr "20 + (vars.streak || 0) * 5")
    (:key :code "Enter" :key "Enter" :if "vars.checkResult === 1" :set-var "lastSolvedWord" :val-expr "computed.targetWordLower")
    (:key :code "Enter" :key "Enter" :if "vars.checkResult === 1" :set-var "score" :val-expr "(vars.score || 0) + (vars.lastEarned || 20)")
    (:key :code "Enter" :key "Enter" :if "vars.checkResult === 1" :set-var "streak" :val-expr "(vars.streak || 0) + 1")
    (:key :code "Enter" :key "Enter" :if "vars.checkResult === 1" :set-var "feedbackMode" :val 1 :tone "523.25,659.25,783.99,1046.50" :speak-expr "'Brilliant! ' + vars.lastSolvedWord" :speak-rate-var "speechRate" :speak-pitch 1.05)
    (:key :code "Enter" :key "Enter" :if "vars.checkResult === 1" :set-var "typedWord" :val "")
    (:key :code "Enter" :key "Enter" :if "vars.checkResult === 1" :set-var "wordIdx" :val-expr "((vars.wordIdx || 0) + 1) % computed.ksCount")
    (:key :code "Enter" :key "Enter" :if "vars.checkResult === 2" :set-var "streak" :val 0)
    (:key :code "Enter" :key "Enter" :if "vars.checkResult === 2" :set-var "feedbackMode" :val 2 :tone "220")
  ))
  (:subtitles (
    (:start 0.00 :end 0.33 :en "Welcome to the Spelling Bee! Listen closely to the spoken word and National Curriculum definition." :es "¡Bienvenido al concurso de ortografía! Escucha la palabra y su definición.")
    (:start 0.33 :end 0.66 :en "Type letters using your keyboard or click the interactive letter tiles to construct the spelling." :es "Escribe letras con tu teclado o pulsa las fichas de letras para deletrear la palabra.")
    (:start 0.66 :end 1.00 :en "Collect golden honey drops by maintaining a winning streak across Key Stages 1, 2, and 3!" :es "¡Acumula gotas de miel dorada manteniendo una racha en las diferentes etapas!")
  ))
  (:keyframes (
    (:t 0.00 :title "Key Stage Selection" :rule "Select KS1 (Phonics), KS2 Lower (Y3/4), KS2 Upper (Y5/6), or KS3 (Academic).")
    (:t 0.33 :title "Auditory Memory" :rule "Listen to word pronunciation, in-context usage, and phonetic etymology breakdown.")
    (:t 0.66 :title "Orthographic Recall" :rule "Construct the target word using on-screen letter tiles or physical keyboard entry.")
    (:t 1.00 :title "Mastery Validation" :rule "Submit spelling to earn honey drops, streak multipliers, and instant formative feedback.")
  ))
  (:interactive false)
  (:questions false)
  (:bindings (
    (:target "#bee-ks-rect-KS1" :attr "fill" :expr "vars.ksIdx === 0 ? '#eab308' : '#1e293b'")
