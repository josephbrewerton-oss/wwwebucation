(:scene :id "pythagoras" :type "Sim" :oak-id "OAK-KS3-MAT-001" :title "Pythagoras' Theorem (a² + b² = c²)" :stage "KS3 GEOMETRY" :duration 11.0
  (:vars (
    (:var :name "sideA" :val 3 :min 1 :max 15 :step 1 :unit "units" :label "Leg a")
    (:var :name "sideB" :val 4 :min 1 :max 15 :step 1 :unit "units" :label "Leg b")
    (:var :name "showGrid" :val true :label "Unit Tile Grid")
  ))
  (ui:controls
    (control:button :id "reset" :label "↺ Reset Triangle" :action (sim:reset))
    (control:toggle :id "bsl" :label "🖐️ BSL Signing" :bind *bsl-active* :action (player:toggle-bsl))
    (control:slider :id "sideA" :label "Triangle Leg a" :min 1 :max 15 :default 3 :step 1 :bind *sideA*)
    (control:slider :id "sideB" :label "Triangle Leg b" :min 1 :max 15 :default 4 :step 1 :bind *sideB*)
  )
  (:computed (
    (:name "pythA" :expr "Math.max(1, Math.min(20, Math.round(Number(vars.sideA) || 3)))")
    (:name "pythB" :expr "Math.max(1, Math.min(20, Math.round(Number(vars.sideB) || 4)))")
    (:name "areaA" :expr "vars.pythA * vars.pythA")
    (:name "areaB" :expr "vars.pythB * vars.pythB")
    (:name "areaC" :expr "vars.areaA + vars.areaB")
    (:name "pythC" :expr "Math.sqrt(vars.areaC)")
    (:name "pythIsIntC" :expr "Math.abs(vars.pythC - Math.round(vars.pythC)) < 0.00001")
    (:name "pythCInt" :expr "Math.round(vars.pythC)")
    (:name "hypotenuse" :expr "vars.pythIsIntC ? vars.pythCInt : Number(vars.pythC.toFixed(2))")
    (:name "pythS" :expr "(vars.pythA === 3 && vars.pythB === 4) ? 28 : Math.min(28, 560 / (2 * vars.pythA + vars.pythB), 340 / (vars.pythA + 2 * vars.pythB))")
    (:name "pythOx" :expr "(vars.pythA === 3 && vars.pythB === 4) ? 360 : Math.round(400 - (vars.pythB / 2) * vars.pythS)")
    (:name "pythOy" :expr "(vars.pythA === 3 && vars.pythB === 4) ? 280 : Math.round(260 + (vars.pythA / 2) * vars.pythS)")
    (:name "pythLenA" :expr "vars.pythA * vars.pythS")
    (:name "pythLenB" :expr "vars.pythB * vars.pythS")
    (:name "pythLenC" :expr "vars.pythC * vars.pythS")
    (:name "pythVertAx" :expr "vars.pythOx")
    (:name "pythVertAy" :expr "vars.pythOy - vars.pythLenA")
    (:name "pythVertBx" :expr "vars.pythOx + vars.pythLenB")
    (:name "pythVertBy" :expr "vars.pythOy")
    (:name "pythAngleDeg" :expr "Math.atan2(vars.pythA, vars.pythB) * 180 / Math.PI")
    (:name "pythRaSize" :expr "Math.max(10, Math.min(18, Math.round(vars.pythS * 0.6)))")
    (:name "pythMidHypX" :expr "(vars.pythVertAx + vars.pythVertBx) / 2")
    (:name "pythMidHypY" :expr "(vars.pythVertAy + vars.pythVertBy) / 2")
    (:name "pythMidCx" :expr "vars.pythMidHypX + 0.22 * (vars.pythOx - vars.pythMidHypX)")
    (:name "pythMidCy" :expr "vars.pythMidHypY + 0.22 * (vars.pythOy - vars.pythMidHypY)")
  ))
  (:gestures (
    (:draggable :target "#pyth-handle-a" :axis "y" :min 80 :max 360 :var "sideA" :step 1 :invert true :relative true :tone 440)
    (:draggable :target "#pyth-handle-b" :axis "x" :min 360 :max 640 :var "sideB" :step 1 :relative true :tone 554.37)
    (:draggable :target "#pyth-rect-a" :axis "y" :min 80 :max 360 :var "sideA" :step 1 :invert true :relative true :tone 440)
    (:draggable :target "#pyth-rect-b" :axis "x" :min 360 :max 640 :var "sideB" :step 1 :relative true :tone 554.37)
    (:clickable :target "#pyth-chip-345" :expr "if(engine.setVar){engine.setVar('sideA',3);engine.setVar('sideB',4);}else{vars.sideA=3;vars.sideB=4;}" :tone "660")
    (:clickable :target "#pyth-chip-6810" :expr "if(engine.setVar){engine.setVar('sideA',6);engine.setVar('sideB',8);}else{vars.sideA=6;vars.sideB=8;}" :tone "740")
    (:clickable :target "#pyth-chip-51213" :expr "if(engine.setVar){engine.setVar('sideA',5);engine.setVar('sideB',12);}else{vars.sideA=5;vars.sideB=12;}" :tone "880")
    (:clickable :target "#pyth-chip-81517" :expr "if(engine.setVar){engine.setVar('sideA',8);engine.setVar('sideB',15);}else{vars.sideA=8;vars.sideB=15;}" :tone "988")
    (:clickable :target "#pyth-chip-91215" :expr "if(engine.setVar){engine.setVar('sideA',9);engine.setVar('sideB',12);}else{vars.sideA=9;vars.sideB=12;}" :tone "784")
    (:clickable :target "#pyth-chip-112" :expr "if(engine.setVar){engine.setVar('sideA',1);engine.setVar('sideB',1);}else{vars.sideA=1;vars.sideB=1;}" :tone "523.25")
    (:clickable :target "#pyth-chip-grid" :toggle-var "showGrid" :tone "600")
    (:key :code "ArrowUp" :step-var "sideA" :delta 1 :min 1 :max 15)
    (:key :code "ArrowDown" :step-var "sideA" :delta -1 :min 1 :max 15)
    (:key :code "ArrowRight" :step-var "sideB" :delta 1 :min 1 :max 15)
    (:key :code "ArrowLeft" :step-var "sideB" :delta -1 :min 1 :max 15)
  ))
  (:subtitles (
    (:start 0.00 :end 0.35 :en "Drag the handles or select Pythagorean triples to test right triangles." :es "Arrastra los controles o selecciona ternas pitagóricas para probar triángulos rectángulos.")
    (:start 0.35 :end 0.70 :en "Observe area conservation: square a² (emerald) plus square b² (sapphire) always equals square c² (amber)." :es "Observa la conservación de área: el cuadrado a² más el cuadrado b² siempre es igual a c².")
    (:start 0.70 :end 1.00 :en "a² + b² = c². The total number of unit square tiles is strictly conserved for all right triangles." :es "a² + b² = c². El número total de baldosas unitarias se conserva estrictamente.")
  ))
  (:keyframes (
    (:t 0.00 :title "Interactive Manipulative" :rule "Drag handles or enter custom figures to test Pythagorean triples")
    (:t 0.35 :title "Area Conservation" :rule "Square of side a has area a²; square of side b has area b²")
    (:t 0.70 :title "Vector Area Sum" :rule "Total square units: a² + b² = c²")
    (:t 1.00 :title "Hypotenuse Square c²" :rule "c = √(a² + b²) preserved across continuous geometry")
  ))
  (:interactive (
    (:checkpoint :t 0.38
      :prompt "In a right-angled triangle with perpendicular legs a = 3 units and b = 4 units, what is the exact length of hypotenuse c?"
      :options ("5 units (since 3² + 4² = 9 + 16 = 25, and √25 = 5)" "7 units (3 + 4)" "12 units (3 × 4)" "25 units")
      :answer 0
      :explanation "3-4-5 is the classic Pythagorean triple: a² + b² = 9 + 16 = 25, so hypotenuse c = √25 = 5 units.")
    (:checkpoint :t 0.78
      :prompt "Does Pythagoras' Theorem (a² + b² = c²) hold true for ALL triangles, or only right-angled (90°) triangles?"
      :options ("Strictly right-angled triangles where legs a and b meet at 90°" "Every acute and obtuse triangle equally" "Only equilateral triangles" "Only triangles with integer side lengths")
      :answer 0
      :explanation "Exact area conservation a² + b² = c² applies exclusively when legs a and b are perpendicular (90°); non-right triangles require the Law of Cosines.")
  ))
  (:bindings (
    ;; Central Right Triangle & Drafting Right-Angle Symbol
    (:target "#pyth-triangle" :attr "points" :expr "vars.pythOx + ',' + vars.pythOy + ' ' + vars.pythVertBx.toFixed(1) + ',' + vars.pythVertBy.toFixed(1) + ' ' + vars.pythVertAx.toFixed(1) + ',' + vars.pythVertAy.toFixed(1)")
    (:target "#pyth-right-angle" :attr "x" :expr "vars.pythOx")
    (:target "#pyth-right-angle" :attr "y" :expr "vars.pythOy - vars.pythRaSize")
    (:target "#pyth-right-angle" :attr "width" :expr "vars.pythRaSize")
    (:target "#pyth-right-angle" :attr "height" :expr "vars.pythRaSize")
    (:target "#pyth-right-angle-dot" :attr "cx" :expr "vars.pythOx + vars.pythRaSize / 2")
    (:target "#pyth-right-angle-dot" :attr "cy" :expr "vars.pythOy - vars.pythRaSize / 2")

    ;; Square A + Adaptive Tile Pattern + Label
    (:target "#pyth-rect-a" :attr "x" :expr "(vars.pythOx - vars.pythLenA).toFixed(1)")
    (:target "#pyth-rect-a" :attr "y" :expr "vars.pythVertAy.toFixed(1)")
    (:target "#pyth-rect-a" :attr "width" :expr "vars.pythLenA.toFixed(1)")
    (:target "#pyth-rect-a" :attr "height" :expr "vars.pythLenA.toFixed(1)")
    (:target "#pyth-pat-a" :attr "x" :expr "(vars.pythOx - vars.pythLenA).toFixed(1)")
    (:target "#pyth-pat-a" :attr "y" :expr "vars.pythVertAy.toFixed(1)")
    (:target "#pyth-pat-a" :attr "width" :expr "vars.pythS.toFixed(2)")
    (:target "#pyth-pat-a" :attr "height" :expr "vars.pythS.toFixed(2)")
    (:target "#pyth-pat-a-path" :attr "d" :expr "'M ' + vars.pythS.toFixed(2) + ' 0 V ' + vars.pythS.toFixed(2) + ' M 0 ' + vars.pythS.toFixed(2) + ' H ' + vars.pythS.toFixed(2)")
    (:target "#pyth-grid-a" :attr "x" :expr "(vars.pythOx - vars.pythLenA).toFixed(1)")
    (:target "#pyth-grid-a" :attr "y" :expr "vars.pythVertAy.toFixed(1)")
    (:target "#pyth-grid-a" :attr "width" :expr "vars.pythLenA.toFixed(1)")
    (:target "#pyth-grid-a" :attr "height" :expr "vars.pythLenA.toFixed(1)")
    (:target "#pyth-grid-a" :attr "opacity" :expr "(vars.showGrid !== false && vars.pythA <= 15) ? 0.5 : 0")
    (:target "#pyth-badge-a" :attr "width" :expr "vars.areaA >= 100 ? 76 : 64")
    (:target "#pyth-badge-a" :attr "x" :expr "(vars.pythOx - vars.pythLenA / 2 - (vars.areaA >= 100 ? 38 : 32)).toFixed(1)")
    (:target "#pyth-badge-a" :attr "y" :expr "(vars.pythOy - vars.pythLenA / 2 - 13).toFixed(1)")
    (:target "#pyth-txt-a" :attr "x" :expr "(vars.pythOx - vars.pythLenA / 2).toFixed(1)")
    (:target "#pyth-txt-a" :attr "y" :expr "(vars.pythOy - vars.pythLenA / 2 + 5).toFixed(1)")
    (:target "#pyth-txt-a" :attr "textContent" :expr "'a² = ' + vars.areaA")

    ;; Square B + Adaptive Tile Pattern + Label
    (:target "#pyth-rect-b" :attr "x" :expr "vars.pythOx")
    (:target "#pyth-rect-b" :attr "y" :expr "vars.pythOy")
    (:target "#pyth-rect-b" :attr "width" :expr "vars.pythLenB.toFixed(1)")
    (:target "#pyth-rect-b" :attr "height" :expr "vars.pythLenB.toFixed(1)")
    (:target "#pyth-pat-b" :attr "x" :expr "vars.pythOx")
    (:target "#pyth-pat-b" :attr "y" :expr "vars.pythOy")
    (:target "#pyth-pat-b" :attr "width" :expr "vars.pythS.toFixed(2)")
    (:target "#pyth-pat-b" :attr "height" :expr "vars.pythS.toFixed(2)")
    (:target "#pyth-pat-b-path" :attr "d" :expr "'M ' + vars.pythS.toFixed(2) + ' 0 V ' + vars.pythS.toFixed(2) + ' M 0 ' + vars.pythS.toFixed(2) + ' H ' + vars.pythS.toFixed(2)")
    (:target "#pyth-grid-b" :attr "x" :expr "vars.pythOx")
    (:target "#pyth-grid-b" :attr "y" :expr "vars.pythOy")
    (:target "#pyth-grid-b" :attr "width" :expr "vars.pythLenB.toFixed(1)")
    (:target "#pyth-grid-b" :attr "height" :expr "vars.pythLenB.toFixed(1)")
    (:target "#pyth-grid-b" :attr "opacity" :expr "(vars.showGrid !== false && vars.pythB <= 15) ? 0.5 : 0")
    (:target "#pyth-badge-b" :attr "width" :expr "vars.areaB >= 100 ? 76 : 68")
    (:target "#pyth-badge-b" :attr "x" :expr "(vars.pythOx + vars.pythLenB / 2 - (vars.areaB >= 100 ? 38 : 34)).toFixed(1)")
    (:target "#pyth-badge-b" :attr "y" :expr "(vars.pythOy + vars.pythLenB / 2 - 13).toFixed(1)")
    (:target "#pyth-txt-b" :attr "x" :expr "(vars.pythOx + vars.pythLenB / 2).toFixed(1)")
    (:target "#pyth-txt-b" :attr "y" :expr "(vars.pythOy + vars.pythLenB / 2 + 5).toFixed(1)")
    (:target "#pyth-txt-b" :attr "textContent" :expr "'b² = ' + vars.areaB")

    ;; Square C on Hypotenuse (Exact positive angle + adaptive unit grid for integer triples)
    (:target "#pyth-group-c" :attr "transform" :expr "'translate(' + vars.pythVertAx.toFixed(1) + ', ' + vars.pythVertAy.toFixed(1) + ') rotate(' + vars.pythAngleDeg.toFixed(2) + ')'")
    (:target "#pyth-rect-c" :attr "y" :expr "(-vars.pythLenC).toFixed(1)")
    (:target "#pyth-rect-c" :attr "width" :expr "vars.pythLenC.toFixed(1)")
    (:target "#pyth-rect-c" :attr "height" :expr "vars.pythLenC.toFixed(1)")
    (:target "#pyth-pat-c" :attr "y" :expr "(-vars.pythLenC).toFixed(1)")
    (:target "#pyth-pat-c" :attr "width" :expr "vars.pythS.toFixed(2)")
    (:target "#pyth-pat-c" :attr "height" :expr "vars.pythS.toFixed(2)")
    (:target "#pyth-pat-c-path" :attr "d" :expr "'M ' + vars.pythS.toFixed(2) + ' 0 V ' + vars.pythS.toFixed(2) + ' M 0 ' + vars.pythS.toFixed(2) + ' H ' + vars.pythS.toFixed(2)")
    (:target "#pyth-grid-c" :attr "y" :expr "(-vars.pythLenC).toFixed(1)")
    (:target "#pyth-grid-c" :attr "width" :expr "vars.pythLenC.toFixed(1)")
    (:target "#pyth-grid-c" :attr "height" :expr "vars.pythLenC.toFixed(1)")
    (:target "#pyth-grid-c" :attr "opacity" :expr "(vars.showGrid !== false && vars.pythIsIntC && vars.pythCInt <= 17) ? 0.5 : 0")
    (:target "#pyth-badge-c" :attr "width" :expr "vars.pythIsIntC ? 120 : 156")
    (:target "#pyth-badge-c" :attr "x" :expr "(vars.pythLenC / 2 - (vars.pythIsIntC ? 60 : 78)).toFixed(1)")
    (:target "#pyth-badge-c" :attr "y" :expr "(-vars.pythLenC / 2 - 14).toFixed(1)")
    (:target "#pyth-txt-c" :attr "x" :expr "(vars.pythLenC / 2).toFixed(1)")
    (:target "#pyth-txt-c" :attr "y" :expr "(-vars.pythLenC / 2 + 5).toFixed(1)")
    (:target "#pyth-txt-c" :attr "textContent" :expr "vars.pythIsIntC ? ('c² = ' + vars.areaC + ' (c = ' + vars.pythCInt + ')') : ('c² = ' + vars.areaC + ' (c = √' + vars.areaC + ' ≈ ' + vars.pythC.toFixed(2) + ')')")

    ;; Manipulator Handles A & B
    (:target "#pyth-handle-a" :attr "transform" :expr "'translate(' + vars.pythVertAx.toFixed(1) + ', ' + vars.pythVertAy.toFixed(1) + ')'")
    (:target "#pyth-handle-b" :attr "transform" :expr "'translate(' + vars.pythVertBx.toFixed(1) + ', ' + vars.pythVertBy.toFixed(1) + ')'")

    ;; Side Dimension Badges
    (:target "#pyth-label-a-bg" :attr "x" :expr "vars.pythOx + 4")
    (:target "#pyth-label-a-bg" :attr "y" :expr "(vars.pythOy - vars.pythLenA / 2 - 11).toFixed(1)")
    (:target "#pyth-label-a" :attr "x" :expr "vars.pythOx + 16")
    (:target "#pyth-label-a" :attr "y" :expr "(vars.pythOy - vars.pythLenA / 2 + 5).toFixed(1)")
    (:target "#pyth-label-a" :attr "textContent" :expr "'a = ' + vars.pythA")

    (:target "#pyth-label-b-bg" :attr "x" :expr "(vars.pythOx + vars.pythLenB / 2 - 23).toFixed(1)")
    (:target "#pyth-label-b-bg" :attr "y" :expr "vars.pythOy - 26")
    (:target "#pyth-label-b" :attr "x" :expr "(vars.pythOx + vars.pythLenB / 2).toFixed(1)")
    (:target "#pyth-label-b" :attr "y" :expr "vars.pythOy - 12")
    (:target "#pyth-label-b" :attr "textContent" :expr "'b = ' + vars.pythB")

    (:target "#pyth-label-c-bg" :attr "width" :expr "vars.pythIsIntC ? 56 : 94")
    (:target "#pyth-label-c-bg" :attr "x" :expr "(vars.pythMidCx - (vars.pythIsIntC ? 28 : 47)).toFixed(1)")
    (:target "#pyth-label-c-bg" :attr "y" :expr "(vars.pythMidCy - 11).toFixed(1)")
    (:target "#pyth-label-c" :attr "x" :expr "vars.pythMidCx.toFixed(1)")
    (:target "#pyth-label-c" :attr "y" :expr "(vars.pythMidCy + 5).toFixed(1)")
    (:target "#pyth-label-c" :attr "textContent" :expr "vars.pythIsIntC ? ('c = ' + vars.pythCInt) : ('c = √' + vars.areaC + ' ≈ ' + vars.pythC.toFixed(2))")

    ;; Top HUD Algebraic Banner
    (:target "#pyth-banner-tspan-a" :attr "textContent" :expr "'a² (' + vars.areaA + ')'")
    (:target "#pyth-banner-tspan-b" :attr "textContent" :expr "'b² (' + vars.areaB + ')'")
    (:target "#pyth-banner-tspan-c" :attr "textContent" :expr "'c² (' + vars.areaC + ')'")
    (:target "#pyth-banner-tail" :attr "textContent" :expr "vars.pythIsIntC ? (' ➔ ' + vars.pythA + '² + ' + vars.pythB + '² = ' + vars.pythCInt + '² (c = ' + vars.pythCInt + ')') : (' ➔ ' + vars.pythA + '² + ' + vars.pythB + '² = (√' + vars.areaC + ')² ➔ c = √' + vars.areaC + ' ≈ ' + vars.pythC.toFixed(2))")
    (:target "#pyth-chip-grid-bg" :attr "fill" :expr "vars.showGrid !== false ? '#064e3b' : '#1e293b'")
  ))
)
