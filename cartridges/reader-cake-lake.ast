(:scene :id "reader-cake-lake" :type "Slide" :oak-id "OAK-KS1-ENG-R05" :oak-unit "ks1-english-decodable-book-5-cake-lake" :title "Decodable Book 5: The Cake by the Lake (Level 5 · Split Digraphs & Alternatives)" :stage "EYFS/KS1 PHONICS" :duration 20.0
  (:use-skill "storybook-reader" :pages 5)
  (:vars (
    (:var :name "page" :val 0 :min 0 :max 4 :step 1 :label "Story Page")
    (:var :name "showButtons" :val true :label "Show Sound Buttons")
    (:var :name "activeWord" :val "Tap any word above to see & hear its sounds" :label "Selected Word Helper")
    (:var :name "activePhonemes" :val "" :label "Selected Word Phonemes")
  ))
  (:inputs (
    (:switch :var "showButtons" :label "Show DfE Sound Buttons (• / ━━ / ♥)")
  ))
  (:computed (
    (:name "activePage" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5)))")
    (:name "pageText" :expr "['Jake rode his bike to the wide blue lake.', 'He had a bright kite up by a white cloud.', 'Come and eat some sweet cake, said Kate.', 'We like to play and eat cake by the lake.', 'It was time to ride home with a big smile.'][Math.max(0, Math.min(4, Math.floor((t || 0) * 5)))] || ''")
  ))
  (:subtitles (
    (:start 0.00 :end 0.20 :en "Jake rode his bike to the wide blue lake.")
    (:start 0.20 :end 0.40 :en "He had a bright kite up by a white cloud.")
    (:start 0.40 :end 0.60 :en "Come and eat some sweet cake, said Kate.")
    (:start 0.60 :end 0.80 :en "We like to play and eat cake by the lake.")
    (:start 0.80 :end 1.00 :en "It was time to ride home with a big smile.")
  ))
  (:keyframes (
    (:t 0.00 :title "Page 1: The Cake by the Lake" :rule "Jake rode his bike to the wide blue lake.")
    (:t 0.25 :title "Page 2: The Cake by the Lake" :rule "He had a bright kite up by a white cloud.")
    (:t 0.50 :title "Page 3: The Cake by the Lake" :rule "Come and eat some sweet cake, said Kate.")
    (:t 0.75 :title "Page 4: The Cake by the Lake" :rule "We like to play and eat cake by the lake.")
    (:t 1.00 :title "Page 5: The Cake by the Lake" :rule "It was time to ride home with a big smile.")
  ))
  (:interactive (
    (:checkpoint :t 0.50
      :prompt "How did Jake get to the lake?"
      :options ("🚲 On a bike" "🚢 On a ship" "🚐 In a van")
      :answer 0
      :explanation "Great reading! In 'The Cake by the Lake', the answer is On a bike.")
    (:checkpoint :t 1.00
      :prompt "What treat did Kate bring?"
      :options ("🦴 A bone" "🎂 A cake" "🐟 A fish")
      :answer 1
      :explanation "Great reading! In 'The Cake by the Lake', the answer is A cake.")
  ))
  (:bindings (
    (:target "#book-page-0" :attr "display" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 0 ? 'inline' : 'none'")
    (:target "#sb-page-0" :attr "opacity" :expr "vars.showButtons ? '1' : '0'")
    (:target "#page-dot-0" :attr "fill" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 0 ? '#7c3aed' : '#cbd5e1'")
    (:target "#book-page-1" :attr "display" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 1 ? 'inline' : 'none'")
    (:target "#sb-page-1" :attr "opacity" :expr "vars.showButtons ? '1' : '0'")
    (:target "#page-dot-1" :attr "fill" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 1 ? '#7c3aed' : '#cbd5e1'")
    (:target "#book-page-2" :attr "display" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 2 ? 'inline' : 'none'")
    (:target "#sb-page-2" :attr "opacity" :expr "vars.showButtons ? '1' : '0'")
    (:target "#page-dot-2" :attr "fill" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 2 ? '#7c3aed' : '#cbd5e1'")
    (:target "#book-page-3" :attr "display" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 3 ? 'inline' : 'none'")
    (:target "#sb-page-3" :attr "opacity" :expr "vars.showButtons ? '1' : '0'")
    (:target "#page-dot-3" :attr "fill" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 3 ? '#7c3aed' : '#cbd5e1'")
    (:target "#book-page-4" :attr "display" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 4 ? 'inline' : 'none'")
    (:target "#sb-page-4" :attr "opacity" :expr "vars.showButtons ? '1' : '0'")
    (:target "#page-dot-4" :attr "fill" :expr "Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) === 4 ? '#7c3aed' : '#cbd5e1'")
    (:target "#book-page-num" :attr "textContent" :expr "'Page ' + (Math.max(0, Math.min(4, Math.floor((t || 0) * 5))) + 1) + ' of 5'")
    (:target "#decoder-hint-txt" :attr "textContent" :expr "vars.activeWord || 'Tap any word above to see & hear its sounds'")
    (:target "#btn-toggle-sb-txt" :attr "textContent" :expr "vars.showButtons ? '● Sound Buttons: ON' : '○ Sound Buttons: OFF'")
    (:target "#btn-toggle-sb-rect" :attr "fill" :expr "vars.showButtons ? '#ede9fe' : '#f1f5f9'")
  ))
)
