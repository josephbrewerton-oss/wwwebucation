(:scene :id "ten-commandments" :type "Sim" :oak-id "OAK-KS2-RE-015" :oak-unit "ks2-re-catholic-decalogue-moral-law" :title "The Ten Commandments & Moral Law: The Two Tablets of Sinai" :stage "CATHOLIC LIFE" :duration 28.0
  (:vars (
    (:var :name "selectedTablet" :val 1.0 :min 1.0 :max 2.0 :step 1.0 :label "Selected Tablet (1: Love of God 1-3, 2: Love of Neighbour 4-10)")
    (:var :name "sinaiGlory" :val 1.0 :min 0.2 :max 2.0 :step 0.1 :label "Mount Sinai Cloud of Glory Fire & Light")
    (:var :name "commandmentHighlight" :val 1.0 :min 1.0 :max 10.0 :step 1.0 :label "Active Commandment Roman Numeral (I-X)")
  ))

  (:camera :mode "2d" :viewBox "0 0 800 480")

  (:gestures (
    (:draggable :target "#tablet-toggle-knob" :axis "x" :min 260 :max 540
      (:bind-var "selectedTablet" :map "linear" :from-min 260 :from-max 540 :to-min 1.0 :to-max 2.0)
    )
    (:draggable :target "#sinai-glory-node" :axis "y" :min 60 :max 180
      (:bind-var "sinaiGlory" :map "linear" :from-min 180 :from-max 60 :to-min 0.2 :to-max 2.0)
    )
  ))

  (:subtitles (
    (:start 0.0 :end 4.5 :text "God gave Moses the Ten Commandments (the Decalogue) on Mount Sinai as a loving covenant of life and freedom.")
    (:start 4.5 :end 9.0 :text "The First Tablet contains Commandments I to III: Teaching us how to love, worship, and put God first in our lives.")
    (:start 9.0 :end 14.0 :text "We honor God's holy Name, keep Sunday holy at Mass, and never allow idols or toys to take God's place.")
    (:start 14.0 :end 19.5 :text "The Second Tablet contains Commandments IV to X: Guiding our love for our family, friends, classmates, and neighbours.")
    (:start 19.5 :end 24.5 :text "We honor parents, protect human life, speak truth with kindness, and live with pure, peaceful, and generous hearts.")
    (:start 24.5 :end 28.0 :text "Jesus summarized the Ten Commandments in the Two Great Commandments of Love: Love God, and love your neighbour as yourself.")
  ))

  (:interactive (
    (:checkpoint :at 0.35
      (:prompt "How did Jesus summarize all Ten Commandments into the Two Great Commandments of Love?")
      (:options
        ("Love the Lord your God with all your heart, and love your neighbour as yourself" :correct true)
        ("Only follow rules when an adult is watching" :correct false)
        ("Collect as many possessions as possible" :correct false)
        ("Ignore others as long as you do your own work" :correct false)
      )
      (:explanation "In Matthew 22:37-40, Jesus reveals that all the Law and the Prophets depend on loving God wholeheartedly and loving our neighbour.")
    )
    (:checkpoint :at 0.72
      (:prompt "Which Commandments belong to the First Tablet regarding our love and worship of God?")
      (:options
        ("Commandments 1, 2, and 3" :correct true)
        ("Commandments 4, 5, and 6" :correct false)
        ("Only Commandment 10" :correct false)
        ("All 10 belong on the first tablet" :correct false)
      )
      (:explanation "St. Augustine taught that the Ten Commandments are divided into two tablets: the first 3 direct our love toward God, and the remaining 7 toward our neighbour.")
    )
  ))

  (:bindings (
    (:target "#sinai-cloud-glow" :attr "opacity" :expr "0.35 + 0.4 * sinaiGlory")
    (:target "#sinai-cloud-glow" :attr "r" :expr "50 + 25 * sinaiGlory")
    (:target "#sinai-lightning" :attr "opacity" :expr "0.2 + 0.6 * abs(sin(t * 3.5))")
    (:target "#tablet-one-glow" :attr "stroke-width" :expr "selectedTablet < 1.5 ? 3 : 1")
    (:target "#tablet-two-glow" :attr "stroke-width" :expr "selectedTablet >= 1.5 ? 3 : 1")
  ))
)
