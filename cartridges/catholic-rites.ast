(:scene :id "catholic-rites" :type "Sim" :oak-id "OAK-KS3-RE-011" :oak-unit "ks3-re-catholic-sacramental-rites" :title "The 24 Catholic Rites & Churches: Unity in Diversity Across East & West" :stage "CATHOLIC LIFE" :duration 28.0
  (:vars (
    (:var :name "selectedRite" :val 1.0 :min 1.0 :max 6.0 :step 1.0 :label "Liturgical Tradition (1: Latin, 2: Byzantine, 3: Alexandrian, 4: Antiochene, 5: Chaldean, 6: Armenian)")
    (:var :name "communionGlow" :val 1.0 :min 0.2 :max 2.0 :step 0.1 :label "Communion with the Holy See Beacon Intensity")
    (:var :name "iconShimmer" :val 0.8 :min 0.0 :max 1.5 :step 0.1 :label "Iconostasis & Mosaic Shimmer")
  ))

  (:camera :mode "2d" :viewBox "0 0 800 480")

  (:gestures (
    (:draggable :target "#rite-selector-knob" :axis "x" :min 120 :max 680
      (:bind-var "selectedRite" :map "linear" :from-min 120 :from-max 680 :to-min 1.0 :to-max 6.0))
    (:draggable :target "#communion-beacon-core" :axis "y" :min 80 :max 220
      (:bind-var "communionGlow" :map "linear" :from-min 220 :from-max 80 :to-min 0.2 :to-max 2.0))
  ))

  (:subtitles (
    (:start 0.0 :end 4.5 :en "The Catholic Church is a global communion of 24 autonomous (sui iuris) Churches united under the Bishop of Rome.")
    (:start 4.5 :end 9.0 :en "The Latin (Western) Church shares full communion with 23 ancient Eastern Catholic Churches spanning 6 Liturgical Traditions.")
    (:start 9.0 :end 14.0 :en "From the Byzantine Divine Liturgy with icons, to the Alexandrian Ge'ez chant, Christ's Church breathes with two lungs: East and West.")
    (:start 14.0 :end 19.5 :en "Ancient Eastern traditions use leavened prosphora bread symbolizing the Resurrection, alongside holy icons and incense.")
    (:start 19.5 :end 24.5 :en "Churches like the Maronites of Lebanon have maintained unbroken communion with the Holy See across two millennia.")
    (:start 24.5 :end 28.0 :en "In all 24 Churches, the same true Sacraments, apostolic faith, and communion with the Successor of Peter are fully preserved.")
  ))

  (:interactive (
    (:checkpoint :t 0.35
      :prompt "How many autonomous (sui iuris) Churches make up the one Universal Catholic Church in full communion with the Pope?"
      :options ("Only 1 (The Roman Church)" "6 regional dioceses" "24 autonomous Churches across 6 Liturgical Traditions" "Over 500 divided denominations")
      :answer 2
      :explanation "The Catholic Church is a communion of 24 autonomous Churches (1 Western Latin + 23 Eastern Catholic Churches) all united in one faith under the Pope.")
    (:checkpoint :t 0.75
      :prompt "Why do Byzantine and Eastern Catholic Churches use leavened bread (Prosphora) for the Holy Eucharist?"
      :options ("Because yeast represents the Risen Life of Christ and the breath of the Holy Spirit" "Because unleavened bread had not yet been introduced" "Because flat wafers were invented only recently" "Only to make the bread softer for the priest")
      :answer 0
      :explanation "Leaven symbolizes Christ rising from the dead and the Holy Spirit breathing life into the bread. Both leavened and unleavened traditions are holy, ancient, and fully valid.")
  ))

  (:bindings (
    ;; Beacon pulse linked to variable
    (:target "#beacon-pulse" :attr "opacity" :expr "0.3 + 0.4 * (vars.communionGlow || 1.0)")
    (:target "#beacon-halo" :attr "r" :expr "30 + 20 * (vars.communionGlow || 1.0)")
    (:target "#icon-gold-glow" :attr "opacity" :expr "0.4 + 0.5 * (vars.iconShimmer || 0.8)")
    
    ;; Cross sway on dome (namespaced Math.sin)
    (:target "#dome-cross" :attr "transform" :expr "'rotate(' + (Math.sin(t * 1.5) * 2) + ', 400, 110)'")

    ;; Active rite display driven by the slider knob
    (:target "#tradition-label" :attr "textContent" :expr "
      let r = Math.round(vars.selectedRite || 1);
      r === 1 ? '1. Latin (Western) Tradition' :
      r === 2 ? '2. Byzantine Tradition (e.g. Ukrainian, Melkite)' :
      r === 3 ? '3. Alexandrian Tradition (e.g. Coptic, Ethiopian)' :
      r === 4 ? '4. Antiochene Tradition (e.g. Maronite, Syro-Malankara)' :
      r === 5 ? '5. Chaldean Tradition (e.g. Chaldean, Syro-Malabar)' :
                '6. Armenian Tradition (Armenian Catholic Church)'")
  ))
)
