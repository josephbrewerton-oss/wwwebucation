    (:target "#tt-hct-11" :attr "fill" :expr "vars.multiplier === 11 ? '#ffffff' : '#facc15'")
    (:target "#tt-hcr-12" :attr "fill" :expr "vars.multiplier === 12 ? '#d97706' : '#1e293b'")
    (:target "#tt-hcr-12" :attr "stroke" :expr "vars.multiplier === 12 ? '#f59e0b' : '#334155'")
    (:target "#tt-hcr-12" :attr "stroke-width" :expr "vars.multiplier === 12 ? '1.5' : '0.8'")
    (:target "#tt-hct-12" :attr "fill" :expr "vars.multiplier === 12 ? '#ffffff' : '#facc15'")

    (:target "#tt-hrr-1" :attr "fill" :expr "vars.table === 1 ? '#059669' : '#1e293b'")
    (:target "#tt-hrr-1" :attr "stroke" :expr "vars.table === 1 ? '#10b981' : '#334155'")
    (:target "#tt-hrr-1" :attr "stroke-width" :expr "vars.table === 1 ? '1.5' : '0.8'")
    (:target "#tt-hrt-1" :attr "fill" :expr "vars.table === 1 ? '#ffffff' : '#34d399'")
    (:target "#tt-hrr-2" :attr "fill" :expr "vars.table === 2 ? '#059669' : '#1e293b'")
    (:target "#tt-hrr-2" :attr "stroke" :expr "vars.table === 2 ? '#10b981' : '#334155'")
