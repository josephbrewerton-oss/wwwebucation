    (:target "#tt-hrr-4" :attr "stroke-width" :expr "vars.table === 4 ? '1.5' : '0.8'")
    (:target "#tt-hrt-4" :attr "fill" :expr "vars.table === 4 ? '#ffffff' : '#34d399'")
    (:target "#tt-hrr-5" :attr "fill" :expr "vars.table === 5 ? '#059669' : '#1e293b'")
    (:target "#tt-hrr-5" :attr "stroke" :expr "vars.table === 5 ? '#10b981' : '#334155'")
    (:target "#tt-hrr-5" :attr "stroke-width" :expr "vars.table === 5 ? '1.5' : '0.8'")
    (:target "#tt-hrt-5" :attr "fill" :expr "vars.table === 5 ? '#ffffff' : '#34d399'")
    (:target "#tt-hrr-6" :attr "fill" :expr "vars.table === 6 ? '#059669' : '#1e293b'")
    (:target "#tt-hrr-6" :attr "stroke" :expr "vars.table === 6 ? '#10b981' : '#334155'")
