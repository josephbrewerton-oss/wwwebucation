    (:target "#tt-hrr-10" :attr "stroke" :expr "vars.table === 10 ? '#10b981' : '#334155'")
    (:target "#tt-hrr-10" :attr "stroke-width" :expr "vars.table === 10 ? '1.5' : '0.8'")
    (:target "#tt-hrt-10" :attr "fill" :expr "vars.table === 10 ? '#ffffff' : '#34d399'")
