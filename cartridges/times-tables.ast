    (:target "#tt-vis-txt-12" :attr "textContent" :expr "String(vars.table || 7)")
    (:target "#tt-card-family-comm" :attr "textContent" :expr "(vars.multiplier || 8) + ' × ' + (vars.table || 7) + ' = ' + computed.totalProduct + ' (Commutative Property)'")
    (:target "#tt-card-family-div" :attr "textContent" :expr "computed.totalProduct + ' ÷ ' + (vars.table || 7) + ' = ' + (vars.multiplier || 8) + ' • ' + computed.totalProduct + ' ÷ ' + (vars.multiplier || 8) + ' = ' + (vars.table || 7) + ' (Division Inverses)'")
    (:target "#tt-card-repeated-add" :attr "textContent" :expr "computed.repeatedAdd")
    (:target "#tt-card-strategy" :attr "textContent" :expr "computed.strategyEq")

    (:target "#tt-hcr-1" :attr "fill" :expr "vars.multiplier === 1 ? '#d97706' : '#1e293b'")
    (:target "#tt-hcr-1" :attr "stroke" :expr "vars.multiplier === 1 ? '#f59e0b' : '#334155'")
    (:target "#tt-hcr-1" :attr "stroke-width" :expr "vars.multiplier === 1 ? '1.5' : '0.8'")
    (:target "#tt-hct-1" :attr "fill" :expr "vars.multiplier === 1 ? '#ffffff' : '#facc15'")
