    (:target "#tt-hcr-10" :attr "fill" :expr "vars.multiplier === 10 ? '#d97706' : '#1e293b'")
    (:target "#tt-hcr-10" :attr "stroke" :expr "vars.multiplier === 10 ? '#f59e0b' : '#334155'")
