    (:target "#tt-hrr-11" :attr "stroke-width" :expr "vars.table === 11 ? '1.5' : '0.8'")
    (:target "#tt-hrt-11" :attr "fill" :expr "vars.table === 11 ? '#ffffff' : '#34d399'")
