(:scene :id "times-tables" :type "Sim" :oak-id "OAK-KS1-MAT-006" :oak-unit "ks1-maths-arithmetic-multiplication-arrays" :title "Times Tables: 1× to 12× Standard School Multiplication Chart & Grid" :stage "KS1/KS2 MATHS" :duration 14.0
  (:vars (
    (:var :name "table" :val 7 :min 1 :max 12 :step 1 :label "Times Table (1 to 12)")
    (:var :name "multiplier" :val 8 :min 1 :max 12 :step 1 :label "Multiplier (1 to 12)")
    (:var :name "mode" :val 0 :min 0 :max 2 :step 1 :label "View Mode (0=List, 1=Grid, 2=Quiz)")
    (:var :name "hideAnswers" :val false :label "Test Yourself (Hide Answers)")
    (:var :name "revealedMask" :val 0 :min 0 :max 4095 :step 1 :label "Revealed Answer Bitmask")
    (:var :name "tmpSwap" :val 7 :min 1 :max 12 :step 1)
    (:var :name "quizIdx" :val 0 :min 0 :max 23 :step 1 :label "Quiz Question Index")
    (:var :name "quizStreak" :val 0 :min 0 :max 999 :step 1 :label "MTC Fluency Streak")
    (:var :name "quizWrongIdx" :val -1 :min -1 :max 3 :step 1)
    (:var :name "quizResult" :val 0 :min 0 :max 2 :step 1)
    (:var :name "quizState" :val 0 :min 0 :max 2 :step 1)
  ))
  (:inputs (
    (:slider :var "table" :label "Times Table" :min 1 :max 12 :step 1)
    (:slider :var "multiplier" :label "Multiplier" :min 1 :max 12 :step 1)
  ))
  (:computed (
    (:name "totalProduct" :expr "(vars.table || 7) * (vars.multiplier || 8)")
    (:name "wordForm" :expr "(['zero','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve'][vars.table || 7] || 'Seven') + ' multiplied by ' + (['zero','one','two','three','four','five','six','seven','eight','nine','ten','eleven','twelve'][vars.multiplier || 8] || 'eight') + ' equals ' + computed.totalProduct")
    (:name "repeatedAdd" :expr "(vars.multiplier || 8) === 1 ? (String(vars.table || 7) + ' = ' + (vars.table || 7)) : ((vars.multiplier || 8) <= 10 ? [vars.table||7,vars.table||7,vars.table||7,vars.table||7,vars.table||7,vars.table||7,vars.table||7,vars.table||7,vars.table||7,vars.table||7].slice(0, vars.multiplier || 8).join(' + ') + ' = ' + computed.totalProduct : (vars.table||7) + ' + ' + (vars.table||7) + ' + ' + (vars.table||7) + ' + ' + (vars.table||7) + ' ... (' + (vars.multiplier||8) + ' times) = ' + computed.totalProduct)")
    (:name "strategyEq" :expr "(vars.multiplier || 8) > 5 ? ((vars.table||7) + ' × ' + (vars.multiplier||8) + ' = (' + (vars.table||7) + ' × 5) + (' + (vars.table||7) + ' × ' + ((vars.multiplier||8) - 5) + ') = ' + ((vars.table||7) * 5) + ' + ' + ((vars.table||7) * ((vars.multiplier||8) - 5)) + ' = ' + computed.totalProduct) : ((vars.multiplier || 8) > 1 ? ((vars.table||7) + ' × ' + (vars.multiplier||8) + ' = (' + (vars.table||7) + ' × ' + Math.floor((vars.multiplier||8)/2) + ') + (' + (vars.table||7) + ' × ' + ((vars.multiplier||8) - Math.floor((vars.multiplier||8)/2)) + ') = ' + ((vars.table||7) * Math.floor((vars.multiplier||8)/2)) + ' + ' + ((vars.table||7) * ((vars.multiplier||8) - Math.floor((vars.multiplier||8)/2))) + ' = ' + computed.totalProduct) : ((vars.table||7) + ' × 1 = ' + (vars.table||7) + ' (Identity Property of Multiplication)'))")
    (:name "factorsStr" :expr "'Factors: 1' + (computed.totalProduct > 2 && computed.totalProduct % 2 === 0 ? ', 2' : '') + (computed.totalProduct > 3 && computed.totalProduct % 3 === 0 ? ', 3' : '') + (computed.totalProduct > 4 && computed.totalProduct % 4 === 0 ? ', 4' : '') + (computed.totalProduct > 5 && computed.totalProduct % 5 === 0 ? ', 5' : '') + (computed.totalProduct > 6 && computed.totalProduct % 6 === 0 ? ', 6' : '') + (computed.totalProduct > 7 && computed.totalProduct % 7 === 0 ? ', 7' : '') + (computed.totalProduct > 8 && computed.totalProduct % 8 === 0 ? ', 8' : '') + (computed.totalProduct > 9 && computed.totalProduct % 9 === 0 ? ', 9' : '') + (computed.totalProduct > 10 && computed.totalProduct % 10 === 0 ? ', 10' : '') + (computed.totalProduct > 11 && computed.totalProduct % 11 === 0 ? ', 11' : '') + (computed.totalProduct > 12 && computed.totalProduct % 12 === 0 ? ', 12' : '') + (computed.totalProduct > 14 && computed.totalProduct % 14 === 0 ? ', 14' : '') + (computed.totalProduct > 15 && computed.totalProduct % 15 === 0 ? ', 15' : '') + (computed.totalProduct > 16 && computed.totalProduct % 16 === 0 ? ', 16' : '') + (computed.totalProduct > 18 && computed.totalProduct % 18 === 0 ? ', 18' : '') + (computed.totalProduct > 20 && computed.totalProduct % 20 === 0 ? ', 20' : '') + (computed.totalProduct > 21 && computed.totalProduct % 21 === 0 ? ', 21' : '') + (computed.totalProduct > 22 && computed.totalProduct % 22 === 0 ? ', 22' : '') + (computed.totalProduct > 24 && computed.totalProduct % 24 === 0 ? ', 24' : '') + (computed.totalProduct > 25 && computed.totalProduct % 25 === 0 ? ', 25' : '') + (computed.totalProduct > 27 && computed.totalProduct % 27 === 0 ? ', 27' : '') + (computed.totalProduct > 28 && computed.totalProduct % 28 === 0 ? ', 28' : '') + (computed.totalProduct > 30 && computed.totalProduct % 30 === 0 ? ', 30' : '') + (computed.totalProduct > 32 && computed.totalProduct % 32 === 0 ? ', 32' : '') + (computed.totalProduct > 33 && computed.totalProduct % 33 === 0 ? ', 33' : '') + (computed.totalProduct > 35 && computed.totalProduct % 35 === 0 ? ', 35' : '') + (computed.totalProduct > 36 && computed.totalProduct % 36 === 0 ? ', 36' : '') + (computed.totalProduct > 40 && computed.totalProduct % 40 === 0 ? ', 40' : '') + (computed.totalProduct > 42 && computed.totalProduct % 42 === 0 ? ', 42' : '') + (computed.totalProduct > 44 && computed.totalProduct % 44 === 0 ? ', 44' : '') + (computed.totalProduct > 45 && computed.totalProduct % 45 === 0 ? ', 45' : '') + (computed.totalProduct > 48 && computed.totalProduct % 48 === 0 ? ', 48' : '') + (computed.totalProduct > 49 && computed.totalProduct % 49 === 0 ? ', 49' : '') + (computed.totalProduct > 50 && computed.totalProduct % 50 === 0 ? ', 50' : '') + (computed.totalProduct > 54 && computed.totalProduct % 54 === 0 ? ', 54' : '') + (computed.totalProduct > 55 && computed.totalProduct % 55 === 0 ? ', 55' : '') + (computed.totalProduct > 56 && computed.totalProduct % 56 === 0 ? ', 56' : '') + (computed.totalProduct > 60 && computed.totalProduct % 60 === 0 ? ', 60' : '') + (computed.totalProduct > 63 && computed.totalProduct % 63 === 0 ? ', 63' : '') + (computed.totalProduct > 64 && computed.totalProduct % 64 === 0 ? ', 64' : '') + (computed.totalProduct > 66 && computed.totalProduct % 66 === 0 ? ', 66' : '') + (computed.totalProduct > 70 && computed.totalProduct % 70 === 0 ? ', 70' : '') + (computed.totalProduct > 72 && computed.totalProduct % 72 === 0 ? ', 72' : '') + (computed.totalProduct > 1 ? ', ' + computed.totalProduct : '')")
    (:name "quizMult" :expr "[8, 7, 12, 6, 9, 4, 11, 8, 3, 7, 12, 5, 9, 6, 8, 11, 7, 4, 12, 9, 6, 8, 10, 12][(vars.quizIdx || 0) % 24]")
    (:name "quizAns" :expr "(vars.table || 7) * computed.quizMult")
    (:name "qD1" :expr "computed.quizAns + (vars.table || 7)")
    (:name "qD2" :expr "computed.quizAns > (vars.table || 7) ? computed.quizAns - (vars.table || 7) : computed.quizAns + (vars.table || 7) + 2")
    (:name "qD3" :expr "(computed.quizAns + 2) !== computed.qD1 && (computed.quizAns + 2) !== computed.qD2 ? (computed.quizAns + 2) : ((computed.quizAns + 3) !== computed.qD1 && (computed.quizAns + 3) !== computed.qD2 ? (computed.quizAns + 3) : computed.quizAns + (vars.table || 7) + 5)")
    (:name "correctPos" :expr "((vars.quizIdx || 0) * 3 + (vars.table || 7)) % 4")
    (:name "qOpt0" :expr "[computed.quizAns, computed.qD1, computed.qD2, computed.qD3][(0 - computed.correctPos + 4) % 4]")
    (:name "qOpt1" :expr "[computed.quizAns, computed.qD1, computed.qD2, computed.qD3][(1 - computed.correctPos + 4) % 4]")
    (:name "qOpt2" :expr "[computed.quizAns, computed.qD1, computed.qD2, computed.qD3][(2 - computed.correctPos + 4) % 4]")
    (:name "qOpt3" :expr "[computed.quizAns, computed.qD1, computed.qD2, computed.qD3][(3 - computed.correctPos + 4) % 4]")
  ))
  (:gestures (
    (:key :code "ArrowUp" :step-var "table" :delta 1 :min 1 :max 12)
    (:key :code "ArrowDown" :step-var "table" :delta -1 :min 1 :max 12)
    (:key :code "ArrowRight" :step-var "multiplier" :delta 1 :min 1 :max 12)
    (:key :code "ArrowLeft" :step-var "multiplier" :delta -1 :min 1 :max 12)
    (:clickable :target "[data-action='tt-mode-list']" :set-var "mode" :val 0 :tone "440")
    (:clickable :target "[data-action='tt-mode-grid']" :set-var "mode" :val 1 :tone "440")
    (:clickable :target "[data-action='tt-mode-quiz']" :set-var "mode" :val 2 :tone "440")
    (:clickable :target "[data-action='tt-mode-quiz']" :set-var "quizWrongIdx" :val -1)
    (:clickable :target "[data-action='tt-mode-quiz']" :set-var "quizState" :val 0)
    (:clickable :target ".table-chip" :attr "data-table" :set-var "table" :tone-expr "260 + vars.table * 30")
    (:clickable :target ".table-chip" :set-var "revealedMask" :val 0)
    (:clickable :target ".table-chip" :set-var "quizWrongIdx" :val -1)
    (:clickable :target ".table-chip" :set-var "quizState" :val 0)
    (:clickable :target "[data-action='tt-dec-mult']" :step-var "multiplier" :delta -1 :min 1 :max 12 :tone-expr "300 + (vars.multiplier || 8) * 35")
    (:clickable :target "[data-action='tt-inc-mult']" :step-var "multiplier" :delta 1 :min 1 :max 12 :tone-expr "300 + (vars.multiplier || 8) * 35")
    (:clickable :target "[data-action='tt-set-mult']" :attr "data-mult" :set-var "multiplier" :tone-expr "300 + (vars.multiplier || 8) * 35")
    (:clickable :target ".tt-ans-box" :attr "data-row" :if "vars.hideAnswers && Math.floor((vars.revealedMask || 0) / (2 ** (_attr - 1))) % 2 === 0" :set-var "revealedMask" :val-expr "(vars.revealedMask || 0) + (2 ** (_attr - 1))" :tone "659.25")
    (:clickable :target "[data-action='tt-flip']" :set-var "tmpSwap" :val-expr "vars.table || 7" :tone "523.25")
    (:clickable :target "[data-action='tt-flip']" :set-var "table" :val-expr "vars.multiplier || 8")
    (:clickable :target "[data-action='tt-flip']" :set-var "multiplier" :val-expr "vars.tmpSwap || 7")
    (:clickable :target "[data-action='tt-toggle-hide']" :toggle-var "hideAnswers" :tone "440")
    (:clickable :target "[data-action='tt-toggle-hide']" :set-var "revealedMask" :val 0)
    (:clickable :target "[data-action='tt-recite']" :tone "523.25,587.33,659.25,783.99,880" :speak-expr "(vars.table || 7) + ' times ' + (vars.multiplier || 8) + ' equals ' + computed.totalProduct")
    (:clickable :target ".tt-hdr-col" :attr "data-c" :set-var "multiplier" :tone-expr "260 + (vars.table || 7) * 20 + _c * 15")
    (:clickable :target ".tt-hdr-row" :attr "data-r" :set-var "table" :tone-expr "260 + _r * 25")
    (:clickable :target ".tt-grid-cell" :set-var "table" :val-expr "_r" :tone-expr "260 + (_r * _c) * 4")
    (:clickable :target ".tt-grid-cell" :set-var "multiplier" :val-expr "_c")
    (:clickable :target ".quiz-opt-btn" :attr "data-idx" :set-var "quizResult" :val-expr "_attr === computed.correctPos ? 1 : 2")
    (:clickable :target ".quiz-opt-btn" :if "vars.quizResult === 1" :set-var "quizStreak" :val-expr "(vars.quizStreak || 0) + 1" :tone "523.25,659.25,783.99")
    (:clickable :target ".quiz-opt-btn" :if "vars.quizResult === 1" :set-var "quizWrongIdx" :val -1)
    (:clickable :target ".quiz-opt-btn" :if "vars.quizResult === 1" :set-var "quizState" :val 1)
    (:clickable :target ".quiz-opt-btn" :if "vars.quizResult === 1" :set-var "quizIdx" :val-expr "((vars.quizIdx || 0) + 1) % 24")
    (:clickable :target ".quiz-opt-btn" :attr "data-idx" :if "vars.quizResult === 2" :set-var "quizStreak" :val 0 :tone "220")
    (:clickable :target ".quiz-opt-btn" :attr "data-idx" :if "vars.quizResult === 2" :set-var "quizWrongIdx" :val-expr "_attr")
    (:clickable :target ".quiz-opt-btn" :if "vars.quizResult === 2" :set-var "quizState" :val 2)
  ))
  (:subtitles (
    (:start 0.00 :end 0.35 :en "Master the 1 to 12 times tables in standard UK school format! Select any times table from 1× to 12×." :es "¡Domina las tablas de multiplicar del 1 al 12 en el formato escolar estándar!")
    (:start 0.35 :end 0.70 :en "Each table shows all 12 multiplication facts, repeated addition, and inverse division facts." :es "Cada tabla muestra las 12 multiplicaciones, suma repetida y divisiones inversas.")
    (:start 0.70 :end 1.00 :en "Explore the 12×12 Multiplication Grid or test your fluency with the MTC challenge quiz!" :es "¡Explora la cuadrícula de 12×12 o pon a prueba tu cálculo mental con el reto MTC!")
  ))
  (:keyframes (
    (:t 0.00 :title "Step 1: Choose Table" :rule "Select any table from 1× to 12× to view the complete school multiplication chart.")
    (:t 0.35 :title "Step 2: 1 to 12 Equations" :rule "Read and recite the 12 multiplication facts from 1×N through 12×N.")
    (:t 0.70 :title "Step 3: Inverses & Commutativity" :rule "Understand fact families: a × b = c implies b × a = c and c ÷ a = b.")
    (:t 1.00 :title "Step 4: 12×12 Grid Mastery" :rule "Explore the 12×12 matrix to discover number patterns and square numbers.")
  ))
  (:interactive (
    (:checkpoint :t 0.40
      :prompt "What is the product of 7 × 8 in the UK Multiplication Tables Check (MTC)?"
      :options ("56" "54" "48" "64")
      :answer 0
      :explanation "7 groups of 8 (or 8 groups of 7) equal 56 — easily remembered by the sequence 5, 6, 7, 8 (56 = 7 × 8)!")
    (:checkpoint :t 0.80
      :prompt "If 9 × 6 = 54, which inverse division fact belongs to the exact same multiplication fact family?"
      :options ("54 ÷ 9 = 6 (and 54 ÷ 6 = 9)" "54 ÷ 4 = 9" "54 + 6 = 60" "9 ÷ 54 = 6")
      :answer 0
      :explanation "Multiplication and division are inverse operations: knowing a × b = c immediately gives c ÷ a = b and c ÷ b = a.")
  ))
  (:bindings (
    (:target "#tt-stage-list" :attr "display" :expr "vars.mode === 0 ? 'block' : 'none'")
    (:target "#tt-stage-grid" :attr "display" :expr "vars.mode === 1 ? 'block' : 'none'")
    (:target "#tt-stage-quiz" :attr "display" :expr "vars.mode === 2 ? 'block' : 'none'")
    (:target "#tab-mode-list-rect" :attr "fill" :expr "vars.mode === 0 ? '#0284c7' : '#1e293b'")
    (:target "#tab-mode-list-rect" :attr "stroke" :expr "vars.mode === 0 ? '#38bdf8' : '#334155'")
    (:target "#tab-mode-list-txt" :attr "fill" :expr "vars.mode === 0 ? '#ffffff' : '#94a3b8'")
    (:target "#tab-mode-grid-rect" :attr "fill" :expr "vars.mode === 1 ? '#0284c7' : '#1e293b'")
    (:target "#tab-mode-grid-rect" :attr "stroke" :expr "vars.mode === 1 ? '#38bdf8' : '#334155'")
    (:target "#tab-mode-grid-txt" :attr "fill" :expr "vars.mode === 1 ? '#ffffff' : '#94a3b8'")
    (:target "#tab-mode-quiz-rect" :attr "fill" :expr "vars.mode === 2 ? '#0284c7' : '#1e293b'")
    (:target "#tab-mode-quiz-rect" :attr "stroke" :expr "vars.mode === 2 ? '#38bdf8' : '#334155'")
    (:target "#tab-mode-quiz-txt" :attr "fill" :expr "vars.mode === 2 ? '#ffffff' : '#94a3b8'")

    (:target "#tt-chip-rect-1" :attr "fill" :expr "vars.table === 1 ? '#059669' : '#1e293b'")
    (:target "#tt-chip-rect-1" :attr "stroke" :expr "vars.table === 1 ? '#10b981' : '#334155'")
    (:target "#tt-chip-rect-1" :attr "stroke-width" :expr "vars.table === 1 ? '1.5' : '1'")
    (:target "#tt-chip-txt-1" :attr "fill" :expr "vars.table === 1 ? '#ffffff' : '#cbd5e1'")
    (:target "#tt-chip-rect-2" :attr "fill" :expr "vars.table === 2 ? '#059669' : '#1e293b'")
    (:target "#tt-chip-rect-2" :attr "stroke" :expr "vars.table === 2 ? '#10b981' : '#334155'")
    (:target "#tt-chip-rect-2" :attr "stroke-width" :expr "vars.table === 2 ? '1.5' : '1'")
    (:target "#tt-chip-txt-2" :attr "fill" :expr "vars.table === 2 ? '#ffffff' : '#cbd5e1'")
    (:target "#tt-chip-rect-3" :attr "fill" :expr "vars.table === 3 ? '#059669' : '#1e293b'")
    (:target "#tt-chip-rect-3" :attr "stroke" :expr "vars.table === 3 ? '#10b981' : '#334155'")
    (:target "#tt-chip-rect-3" :attr "stroke-width" :expr "vars.table === 3 ? '1.5' : '1'")
    (:target "#tt-chip-txt-3" :attr "fill" :expr "vars.table === 3 ? '#ffffff' : '#cbd5e1'")
    (:target "#tt-chip-rect-4" :attr "fill" :expr "vars.table === 4 ? '#059669' : '#1e293b'")
    (:target "#tt-chip-rect-4" :attr "stroke" :expr "vars.table === 4 ? '#10b981' : '#334155'")
    (:target "#tt-chip-rect-4" :attr "stroke-width" :expr "vars.table === 4 ? '1.5' : '1'")
    (:target "#tt-chip-txt-4" :attr "fill" :expr "vars.table === 4 ? '#ffffff' : '#cbd5e1'")
    (:target "#tt-chip-rect-5" :attr "fill" :expr "vars.table === 5 ? '#059669' : '#1e293b'")
    (:target "#tt-chip-rect-5" :attr "stroke" :expr "vars.table === 5 ? '#10b981' : '#334155'")
    (:target "#tt-chip-rect-5" :attr "stroke-width" :expr "vars.table === 5 ? '1.5' : '1'")
    (:target "#tt-chip-txt-5" :attr "fill" :expr "vars.table === 5 ? '#ffffff' : '#cbd5e1'")
    (:target "#tt-chip-rect-6" :attr "fill" :expr "vars.table === 6 ? '#059669' : '#1e293b'")
    (:target "#tt-chip-rect-6" :attr "stroke" :expr "vars.table === 6 ? '#10b981' : '#334155'")
    (:target "#tt-chip-rect-6" :attr "stroke-width" :expr "vars.table === 6 ? '1.5' : '1'")
    (:target "#tt-chip-txt-6" :attr "fill" :expr "vars.table === 6 ? '#ffffff' : '#cbd5e1'")
    (:target "#tt-chip-rect-7" :attr "fill" :expr "vars.table === 7 ? '#059669' : '#1e293b'")
    (:target "#tt-chip-rect-7" :attr "stroke" :expr "vars.table === 7 ? '#10b981' : '#334155'")
    (:target "#tt-chip-rect-7" :attr "stroke-width" :expr "vars.table === 7 ? '1.5' : '1'")
    (:target "#tt-chip-txt-7" :attr "fill" :expr "vars.table === 7 ? '#ffffff' : '#cbd5e1'")
    (:target "#tt-chip-rect-8" :attr "fill" :expr "vars.table === 8 ? '#059669' : '#1e293b'")
    (:target "#tt-chip-rect-8" :attr "stroke" :expr "vars.table === 8 ? '#10b981' : '#334155'")
    (:target "#tt-chip-rect-8" :attr "stroke-width" :expr "vars.table === 8 ? '1.5' : '1'")
    (:target "#tt-chip-txt-8" :attr "fill" :expr "vars.table === 8 ? '#ffffff' : '#cbd5e1'")
    (:target "#tt-chip-rect-9" :attr "fill" :expr "vars.table === 9 ? '#059669' : '#1e293b'")
    (:target "#tt-chip-rect-9" :attr "stroke" :expr "vars.table === 9 ? '#10b981' : '#334155'")
    (:target "#tt-chip-rect-9" :attr "stroke-width" :expr "vars.table === 9 ? '1.5' : '1'")
    (:target "#tt-chip-txt-9" :attr "fill" :expr "vars.table === 9 ? '#ffffff' : '#cbd5e1'")
    (:target "#tt-chip-rect-10" :attr "fill" :expr "vars.table === 10 ? '#059669' : '#1e293b'")
    (:target "#tt-chip-rect-10" :attr "stroke" :expr "vars.table === 10 ? '#10b981' : '#334155'")
    (:target "#tt-chip-rect-10" :attr "stroke-width" :expr "vars.table === 10 ? '1.5' : '1'")
    (:target "#tt-chip-txt-10" :attr "fill" :expr "vars.table === 10 ? '#ffffff' : '#cbd5e1'")
    (:target "#tt-chip-rect-11" :attr "fill" :expr "vars.table === 11 ? '#059669' : '#1e293b'")
    (:target "#tt-chip-rect-11" :attr "stroke" :expr "vars.table === 11 ? '#10b981' : '#334155'")
    (:target "#tt-chip-rect-11" :attr "stroke-width" :expr "vars.table === 11 ? '1.5' : '1'")
    (:target "#tt-chip-txt-11" :attr "fill" :expr "vars.table === 11 ? '#ffffff' : '#cbd5e1'")
    (:target "#tt-chip-rect-12" :attr "fill" :expr "vars.table === 12 ? '#059669' : '#1e293b'")
    (:target "#tt-chip-rect-12" :attr "stroke" :expr "vars.table === 12 ? '#10b981' : '#334155'")
    (:target "#tt-chip-rect-12" :attr "stroke-width" :expr "vars.table === 12 ? '1.5' : '1'")
    (:target "#tt-chip-txt-12" :attr "fill" :expr "vars.table === 12 ? '#ffffff' : '#cbd5e1'")

    (:target "#tt-multiplier-display" :attr "textContent" :expr "'× ' + (vars.multiplier || 8) + ' Multiplier'")
    (:target "#tt-flip-label" :attr "textContent" :expr "'🔄 Flip: ' + (vars.table || 7) + '×' + (vars.multiplier || 8) + ' ⇄ ' + (vars.multiplier || 8) + '×' + (vars.table || 7)")
    (:target "#tt-hide-toggle-text" :attr "textContent" :expr "vars.hideAnswers ? '🔓 Show All Answers' : '👁️ Hide Answers (Test)'")
    (:target "#tt-list-header" :attr "textContent" :expr "(vars.table || 7) + ' TIMES TABLE (1× TO 12×)'")

    (:target "#tt-row-rect-1" :attr "fill" :expr "vars.multiplier === 1 ? 'url(#tt-grad-row-active)' : '#0f172a'")
    (:target "#tt-row-rect-1" :attr "stroke" :expr "vars.multiplier === 1 ? '#38bdf8' : '#1e293b'")
    (:target "#tt-row-rect-1" :attr "stroke-width" :expr "vars.multiplier === 1 ? '1.5' : '1'")
    (:target "#tt-row-arrow-1" :attr "display" :expr "vars.multiplier === 1 ? 'block' : 'none'")
    (:target "#tt-row-eq-1" :attr "x" :expr "vars.multiplier === 1 ? '24' : '14'")
    (:target "#tt-row-eq-1" :attr "fill" :expr "vars.multiplier === 1 ? '#f8fafc' : '#cbd5e1'")
    (:target "#tt-row-eq-1" :attr "font-weight" :expr "vars.multiplier === 1 ? '900' : '700'")
    (:target "#tt-row-eq-1" :attr "textContent" :expr "' 1 × ' + (vars.table || 7) + ' ='")
