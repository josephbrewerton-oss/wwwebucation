    (:target "#tt-hrr-12" :attr "stroke-width" :expr "vars.table === 12 ? '1.5' : '0.8'")
    (:target "#tt-hrt-12" :attr "fill" :expr "vars.table === 12 ? '#ffffff' : '#34d399'")

    (:target "#tt-grid-cell-eq" :attr "textContent" :expr "(vars.table || 7) + ' × ' + (vars.multiplier || 8) + ' = ' + computed.totalProduct")
    (:target "#tt-grid-square-badge" :attr "textContent" :expr "vars.table === vars.multiplier ? '⭐ PERFECT SQUARE: ' + (vars.table || 7) + '² = ' + computed.totalProduct : 'Row ' + (vars.table || 7) + ' × Col ' + (vars.multiplier || 8)")
    (:target "#tt-grid-factors" :attr "textContent" :expr "computed.factorsStr")
    (:target "#tt-grid-even" :attr "textContent" :expr "(computed.totalProduct % 2 === 0 ? 'Even' : 'Odd') + ' Number • Multiple of ' + (vars.table || 7) + ' and ' + (vars.multiplier || 8)")

    (:target "#tt-quiz-streak" :attr "textContent" :expr "'🔥 Streak: ' + (vars.quizStreak || 0)")
    (:target "#tt-quiz-prompt" :attr "textContent" :expr "(vars.table || 7) + ' × ' + computed.quizMult + ' = ?'")
    (:target "#tt-quiz-val-0" :attr "textContent" :expr "String(computed.qOpt0)")
    (:target "#tt-quiz-val-1" :attr "textContent" :expr "String(computed.qOpt1)")
    (:target "#tt-quiz-val-2" :attr "textContent" :expr "String(computed.qOpt2)")
    (:target "#tt-quiz-val-3" :attr "textContent" :expr "String(computed.qOpt3)")
    (:target "#tt-quiz-rect-0" :attr "fill" :expr "vars.quizWrongIdx === 0 ? '#7f1d1d' : '#1e293b'")
    (:target "#tt-quiz-rect-0" :attr "stroke" :expr "vars.quizWrongIdx === 0 ? '#f87171' : '#475569'")
    (:target "#tt-quiz-rect-1" :attr "fill" :expr "vars.quizWrongIdx === 1 ? '#7f1d1d' : '#1e293b'")
    (:target "#tt-quiz-rect-1" :attr "stroke" :expr "vars.quizWrongIdx === 1 ? '#f87171' : '#475569'")
    (:target "#tt-quiz-rect-2" :attr "fill" :expr "vars.quizWrongIdx === 2 ? '#7f1d1d' : '#1e293b'")
    (:target "#tt-quiz-rect-2" :attr "stroke" :expr "vars.quizWrongIdx === 2 ? '#f87171' : '#475569'")
    (:target "#tt-quiz-rect-3" :attr "fill" :expr "vars.quizWrongIdx === 3 ? '#7f1d1d' : '#1e293b'")
    (:target "#tt-quiz-rect-3" :attr "stroke" :expr "vars.quizWrongIdx === 3 ? '#f87171' : '#475569'")
    (:target "#tt-quiz-msg" :attr "textContent" :expr "vars.quizState === 1 ? '🌟 Correct! Streak increased! Keep going!' : (vars.quizState === 2 ? 'Almost! Try another option — check repeated addition or nearby multiples.' : 'Select the correct product to score!')")
    (:target "#tt-quiz-msg" :attr "fill" :expr "vars.quizState === 1 ? '#34d399' : (vars.quizState === 2 ? '#f87171' : '#38bdf8')")

    (:target "#tt-banner-txt" :attr "textContent" :expr "'Standard School Times Table: ' + (vars.table || 7) + ' × ' + (vars.multiplier || 8) + ' = ' + computed.totalProduct + ' • ' + (vars.multiplier || 8) + ' groups of ' + (vars.table || 7) + ' • Inverse: ' + computed.totalProduct + ' ÷ ' + (vars.table || 7) + ' = ' + (vars.multiplier || 8) + '.'")
  ))
)
