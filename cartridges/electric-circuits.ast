(:scene 
  :id "electric-circuits" 
  :type "Sim" 
  :oak-id "OAK-KS2-SCI-ELECTRICC" 
  :title "Electrical Circuits & Ohm's Law (V = I × R)" 
  :stage "KS2/KS3 PHYSICS" 
  :duration 12.0

  (:vars (
    (:var :name "voltage" :val 12.0 :min 1.5 :max 24.0 :step 0.5 :unit "V" :label "Battery Voltage (V)")
    (:var :name "resistance" :val 4.0 :min 1.0 :max 12.0 :step 0.5 :unit "Ω" :label "Circuit Resistance (Ω)")
    (:var :name "switchClosed" :val true :label "Knife Switch Position")
  ))

  (ui:controls
    (control:button :id "reset" :label "↺ Reset Circuit" :action (sim:reset))
    (control:toggle :id "switch" :label "⚡ Knife Switch" :bind *switchClosed* :action (toggle-var *switchClosed*))
    (control:toggle :id "bsl" :label "🖐️ BSL Signing" :bind *bsl-active* :action (player:toggle-bsl))
    (control:slider :id "voltage" :label "EMF Voltage (V)" :min 1.5 :max 24.0 :default 12.0 :step 0.5 :bind *voltage*)
    (control:slider :id "resistance" :label "Resistance (Ω)" :min 1.0 :max 12.0 :default 4.0 :step 0.5 :bind *resistance*)
  )

  (:computed (
    (:name "current" :expr "vars.switchClosed ? (vars.voltage / (vars.resistance || 1.0)) : 0")
    (:name "power" :expr "vars.switchClosed ? ((vars.voltage * vars.voltage) / (vars.resistance || 1.0)) : 0")
  ))

  (:gestures (
    (:clickable :target "#circuit-switch" :toggle-var "switchClosed")
    (:key :code "Space" :toggle-var "switchClosed")
    (:key :code "ArrowUp" :step-var "voltage" :delta 0.5 :min 1.5 :max 24.0)
    (:key :code "ArrowDown" :step-var "voltage" :delta -0.5 :min 1.5 :max 24.0)
    (:key :code "ArrowRight" :step-var "resistance" :delta 0.5 :min 1.0 :max 12.0)
    (:key :code "ArrowLeft" :step-var "resistance" :delta -0.5 :min 1.0 :max 12.0)
  ))

  (:keyframes (
    (:t 0.00 :title "1. Closed Loop Circuit" :rule "Current (I) only flows through an unbroken conductive loop from positive to negative terminal")
    (:t 0.35 :title "2. Voltage Drives Potential" :rule "Voltage (V) is electrical pressure. Higher voltage pushes more coulombs per second")
    (:t 0.70 :title "3. Resistance Opposes Flow" :rule "Resistance (R) in ohms restricts electron velocity: Ohm's Law I = V / R")
    (:t 1.00 :title "4. Energy Dissipation" :rule "Electrons collide with tungsten atoms, converting electrical energy into radiant photon light (P = I²R)")
  ))

  (:subtitles (
    (:start 0.00 :end 0.29 :en "An electrical circuit is a closed loop! The battery voltage pushes electrons through the copper wires." :es "¡Un circuito eléctrico es un lazo cerrado! El voltaje de la batería empuja electrones por los cables.")
    (:start 0.29 :end 0.63 :en "Watch the yellow electrons move! Current is the rate of charge flow: I = Voltage divided by Resistance." :es "¡Mira cómo se mueven los electrones! La corriente es la tasa de flujo: I = Voltaje dividido entre Resistencia.")
    (:start 0.63 :end 1.00 :en "Inside the lightbulb, resistance forces electrons to collide, heating the filament into brilliant glowing light!" :es "Dentro de la bombilla, la resistencia hace chocar los electrones, ¡calentando el filamento y emitiendo luz!")
  ))

  (:interactive (
    (:checkpoint :t 0.34
      :prompt "According to Ohm's Law (I = V / R), what happens if we double the battery voltage while keeping resistance the same?"
      :options ("The electrical current (I) doubles and the lightbulb shines brighter" "The electrical current is cut in half" "The resistance increases automatically")
      :answer 0
      :explanation "Current is directly proportional to voltage. Doubling the voltage doubles the rate of electron flow (amperage).")
    (:checkpoint :t 0.85
      :prompt "What form of energy is electrical energy converted into inside the incandescent lightbulb?"
      :options ("Thermal (heat) and Radiant (light) energy" "Nuclear potential energy" "Chemical bonding energy")
      :answer 0
      :explanation "High resistance in the filament causes electrons to collide with tungsten ions, releasing intense thermal heat and visible light photons.")
  ))

  (:bindings (
    ;; Telemetry & Formula Overlays
    (:target "#telemetry-display" :attr "textContent" :expr "'Voltage: ' + (vars.voltage || 0) + 'V | Resistance: ' + (vars.resistance || 1) + 'Ω | Current: ' + Number(computed.current || 0).toFixed(2) + 'A | Power: ' + Number(computed.power || 0).toFixed(1) + 'W'")
    (:target "#battery-voltage-text" :attr "textContent" :expr "(vars.voltage || 12) + 'V'")
    (:target "#resistor-ohms-text" :attr "textContent" :expr "(vars.resistance || 4) + ' Ω'")
    (:target "#formula-legend-text" :attr "textContent" :expr "'Formula: Current I = ' + (vars.voltage || 12) + 'V ÷ ' + (vars.resistance || 4) + 'Ω = ' + Number(computed.current || 0).toFixed(2) + ' Amperes • Power P = ' + (vars.voltage || 12) + 'V × ' + Number(computed.current || 0).toFixed(2) + 'A = ' + Number(computed.power || 0).toFixed(1) + ' Watts'")

    ;; Physical Knife Switch Arm & Label Visuals (Local hinge at x=0, y=20 inside #circuit-switch)
    (:target "#circuit-switch" :attr "data-state" :expr "vars.switchClosed ? 'closed' : 'open'")
    (:target "#switch-blade" :attr "transform" :expr "vars.switchClosed ? 'rotate(0 0 20)' : 'rotate(-32 0 20)'")
    (:target "#switch-blade" :attr "stroke" :expr "vars.switchClosed ? '#22c55e' : '#ef4444'")
    (:target "#switch-text" :attr "fill" :expr "vars.switchClosed ? '#4ade80' : '#f87171'")
    (:target "#switch-text" :attr "textContent" :expr "vars.switchClosed ? 'SWITCH: CLOSED (Click or Space)' : 'SWITCH: OPEN (Click or Space)'")

    ;; Bulb Glow & Filament
    (:target "#bulb-halo" :attr "opacity" :expr "vars.switchClosed ? Math.min(1.0, 0.15 + (Number(computed.power || 0) / 120)) : 0.05")
    (:target "#bulb-halo" :attr "r" :expr "vars.switchClosed ? (25 + Math.min(65, Number(computed.power || 0) * 0.5)) : 15")
    (:target "#bulb-filament" :attr "stroke" :expr "vars.switchClosed && Number(computed.power || 0) > 2 ? '#fff5a0' : '#444'")

    ;; Dynamic Current Flow & Electron Drift
    (:target "#wire-flow" :attr "stroke-dashoffset" :expr "vars.switchClosed ? -(t * 60 * Number(computed.current || 1)) : 0")
    (:target "#wire-flow" :attr "stroke" :expr "vars.switchClosed ? '#facc15' : '#475569'")
    (:target "#electron-charges" :attr "opacity" :expr "vars.switchClosed ? 1.0 : 0.2")
  ))
)
