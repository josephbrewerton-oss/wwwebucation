# Map AST cartridges to Common Lisp (hyphen required by Linguist for spaces)
*.ast linguist-language=Common-Lisp
*.ast linguist-detectable=true
*.ast linguist-vendored=false

# Lisp views in sys/views/
*.lisp linguist-language=Common-Lisp
*.lisp linguist-detectable=true

# Keep SVG detection active for vector stages
static/player/scenes/*.svg linguist-language=SVG
static/player/scenes/*.svg linguist-detectable=true
static/cartridges/*.svg linguist-language=SVG
static/cartridges/*.svg linguist-detectable=true
