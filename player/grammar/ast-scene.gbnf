# ast-scene.gbnf
# GGML BNF Grammar for Constraining Local LLMs to Valid AST Vector Scenes
# Compatible with llama.cpp, Ollama, llama-cpp-python, and vLLM.

root ::= "{" ws "\"id\":" ws string "," ws ("\"type\":" ws ("\"Sim\"" | "\"Slide\"" | "\"App\"" | "\"Film\"") "," ws)? ("\"video\":" ws string "," ws)? ("\"videoFit\":" ws ("\"contain\"" | "\"cover\"" | "\"fill\"") "," ws)? "\"stage\":" ws string "," ws "\"title\":" ws string "," ws "\"duration\":" ws number "," ws ("\"easing\":" ws easing "," ws)? "\"keyframes\":" ws keyframe-array ("," ws "\"subtitles\":" ws subtitle-array)? ("," ws "\"stateMachines\":" ws state-machine-array)? ("," ws "\"emitters\":" ws emitter-array)? ("," ws "\"bindInputs\":" ws bind-input-array)? ("," ws "\"elements\":" ws element-array)? ws "}"

# State Machines Array
state-machine-array ::= "[" ws (state-machine ("," ws state-machine)*)? ws "]"
state-machine ::= "{" ws "\"id\":" ws string "," ws "\"initial\":" ws string ("," ws "\"dwell\":" ws number)? "," ws "\"states\":" ws state-array "," ws "\"transitions\":" ws transition-array ws "}"
state-array ::= "[" ws (state-obj ("," ws state-obj)*)? ws "]"
state-obj ::= "{" ws "\"name\":" ws string ("," ws "\"attrs\":" ws "{" ws "}")? ("," ws "\"emitterSets\":" ws "[" ws (emitter-set ("," ws emitter-set)*)? ws "]")? ws "}"
emitter-set ::= "{" ws "\"target\":" ws string ("," ws "\"speed\":" ws number)? ("," ws "\"count\":" ws integer)? ("," ws "\"gravity\":" ws number)? ("," ws "\"fill\":" ws string)? ("," ws "\"boundsElement\":" ws string)? ws "}"
transition-array ::= "[" ws (transition-obj ("," ws transition-obj)*)? ws "]"
transition-obj ::= "{" ws "\"from\":" ws string "," ws "\"to\":" ws string "," ws "\"trigger\":" ws string ("," ws "\"duration\":" ws number)? ("," ws "\"dwell\":" ws number)? ("," ws "\"easing\":" ws easing)? ws "}"

# Emitters Array
emitter-array ::= "[" ws (emitter-obj ("," ws emitter-obj)*)? ws "]"
emitter-obj ::= "{" ws "\"id\":" ws string ("," ws "\"count\":" ws integer)? ("," ws "\"speed\":" ws number)? ("," ws "\"radius\":" ws number)? ("," ws "\"fill\":" ws string)? ("," ws "\"gravity\":" ws number)? ("," ws "\"wrapMode\":" ws ("\"bounce\"" | "\"wrap\""))? ("," ws "\"boundsElement\":" ws string)? ws "}"

# Bind Inputs Array
bind-input-array ::= "[" ws (bind-input-obj ("," ws bind-input-obj)*)? ws "]"
bind-input-obj ::= "{" ws "\"target\":" ws string "," ws "\"var\":" ws string "," ws "\"min\":" ws number "," ws "\"max\":" ws number ("," ws "\"axis\":" ws ("\"x\"" | "\"y\"" | "\"rotary\""))? ("," ws "\"trackMin\":" ws number)? ("," ws "\"trackMax\":" ws number)? ws "}"

# Keyframes Array
keyframe-array ::= "[" ws (keyframe ("," ws keyframe)*)? ws "]"
keyframe ::= "{" ws "\"t\":" ws fraction "," ws "\"title\":" ws string "," ws "\"rule\":" ws string ("," ws "\"mathNotation\":" ws string)? ws "}"

# Subtitles Array
subtitle-array ::= "[" ws (subtitle ("," ws subtitle)*)? ws "]"
subtitle ::= "{" ws "\"start\":" ws fraction "," ws "\"end\":" ws fraction "," ws "\"en\":" ws string ("," ws "\"es\":" ws string)? ws "}"

# Elements Array
element-array ::= "[" ws (element ("," ws element)*)? ws "]"
element ::= circle-el | orbit-el | particle-el

circle-el ::= "{" ws "\"type\":" ws "\"circle\"" "," ws "\"cx\":" ws integer "," ws "\"cy\":" ws integer "," ws "\"r\":" ws integer "," ws "\"fill\":" ws hex-color ws "}"

orbit-el ::= "{" ws "\"type\":" ws "\"orbit-path\"" "," ws "\"cx\":" ws integer "," ws "\"cy\":" ws integer "," ws "\"rx\":" ws integer "," ws "\"ry\":" ws integer "," ws "\"stroke\":" ws hex-color ws "}"

particle-el ::= "{" ws "\"type\":" ws "\"particle\"" "," ws "\"orbit\":" ws "{" ws "\"cx\":" ws integer "," ws "\"cy\":" ws integer "," ws "\"rx\":" ws integer "," ws "\"ry\":" ws integer "," ws "\"speed\":" ws number ws "}" "," ws "\"r\":" ws integer "," ws "\"fill\":" ws hex-color "," ws "\"label\":" ws string ws "}"

# Primitives
easing ::= "\"linear\"" | "\"easeInQuad\"" | "\"easeOutQuad\"" | "\"easeInOutQuad\"" | "\"cubic\""

fraction ::= "0." [0-9] [0-9]? | "1.0" | "0.0" | "1" | "0"
number ::= [0-9]+ ("." [0-9]+)?
integer ::= [0-9]+
hex-color ::= "\"#" [a-fA-F0-9] [a-fA-F0-9] [a-fA-F0-9] [a-fA-F0-9] [a-fA-F0-9] [a-fA-F0-9] "\""

string ::= "\"" ([^"\\] | "\\" (["\\/bfnrt] | "u" [a-fA-F0-9] [a-fA-F0-9] [a-fA-F0-9] [a-fA-F0-9]))* "\""
ws ::= [ \t\n\r]*
