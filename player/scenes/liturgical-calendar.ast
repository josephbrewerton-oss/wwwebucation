(:scene :id "liturgical-calendar" :type "Sim" :title "The Catholic Liturgical Year: Sacred Seasons & Colors" :stage "CATHOLIC LIFE" :duration 26.0
  (:vars (
    (:var :name "seasonAngle" :val 0.0 :min 0.0 :max 360.0 :step 15.0 :label "Liturgical Year Wheel Dial")
    (:var :name "vestmentGlow" :val 1.0 :min 0.2 :max 2.0 :step 0.2 :label "Liturgical Color Intensity")
    (:var :name "sundayCycle" :val 2.0 :min 0.0 :max 2.0 :step 1.0 :label "Lectionary Cycle (Year A, B, C)")
  ))
  (:inputs (
    (:slider :var "seasonAngle" :label "Year Wheel Angle (Advent to Ordinary Time)" :min 0.0 :max 360.0 :step 15.0)
    (:slider :var "vestmentGlow" :label "Liturgical Color Intensity" :min 0.2 :max 2.0 :step 0.2)
    (:slider :var "sundayCycle" :label "Lectionary Cycle (A=Matthew, B=Mark, C=Luke)" :min 0.0 :max 2.0 :step 1.0)
  ))
  (:gestures (
    (:draggable :target "#liturgical-dial-needle" :axis "xy" :min 100 :max 700)
  ))
  (:subtitles (
    (:start 0.00 :end 0.16 :en "Advent (Violet / Purple): Four weeks of joyful expectation, preparation, and penance awaiting the twofold coming of Christ: His birth in Bethlehem and His return in glory. Third Sunday: Rose (Gaudete)." :es "Adviento (Morado): Cuatro semanas de preparación alegre y penitencia esperando la venida de Cristo. Tercer domingo: Rosa (Gaudete)." :la "Tempus Adventus: Veni, veni Emmanuel, captivum solve Israel. Gaudete in Domino semper: iterum dico, gaudete.")
    (:start 0.16 :end 0.32 :en "Christmas Season (White & Gold): From the Nativity of the Lord on December 25th through the Epiphany of the Lord to the Baptism of the Lord. Celebrating the Incarnation—the Word made flesh." :es "Navidad (Blanco y Dorado): Del 25 de diciembre al Bautismo del Señor. Celebramos la Encarnación: el Verbo se hizo carne." :la "Tempus Nativitatis: Verbum caro factum est, et habitavit in nobis. Puer natus est nobis, et filius datus est nobis.")
    (:start 0.32 :end 0.48 :en "Ordinary Time - Part 1 (Green): 'Tempus per Annum'. Green symbolizes hope, growth, and the public ministry, parables, and miracles of Jesus Christ leading up to Lent." :es "Tiempo Ordinario (Verde): El verde simboliza la esperanza y el crecimiento de la fe siguiendo el ministerio y parábolas de Jesús." :la "Tempus per Annum: Dominus illuminatio mea et salus mea; quem timebo? Spes et vita in Christo.")
    (:start 0.48 :end 0.65 :en "Lent & Passiontide (Violet / Purple): Forty days of fasting, almsgiving, and prayer beginning on Ash Wednesday. Fourth Sunday: Rose (Laetare). Concludes with Holy Week." :es "Cuaresma (Morado): Cuarenta días de ayuno, limosna y oración desde el Miércoles de Ceniza hasta Semana Santa. Cuarto domingo: Rosa (Laetare)." :la "Tempus Quadragesimae: Memento, homo, quia pulvis es, et in pulverem reverteris. Emendemus in melius quae ignoranter peccavimus.")
    (:start 0.65 :end 0.82 :en "The Sacred Triduum & Easter Season (White & Gold, 50 Days): The culmination of the liturgical year. Fifty days of unrestrained joy from Easter Sunday to Pentecost (Red for the Holy Spirit)." :es "El Triduo Pascual y Tiempo de Pascua (Blanco y Oro, 50 días): Cincuenta días de gozo desde Pascua hasta Pentecostés (Rojo del Espíritu)." :la "Tempus Paschale: Surrexit Dominus vere, alleluia! Veni Sancte Spiritus, reple tuorum corda fidelium.")
    (:start 0.82 :end 1.00 :en "Ordinary Time - Part 2 (Green) to Christ the King: Walking with the Church through the summer and autumn until the Solemnity of Our Lord Jesus Christ, King of the Universe." :es "Tiempo Ordinario (Parte 2) hasta Cristo Rey: Caminando con la Iglesia hasta la fiesta de Jesucristo, Rey del Universo." :la "Christus Vincit, Christus Regnat, Christus Imperat! Regnum veritatis et vitae, regnum iustitiae, amoris et pacis.")
  ))
  (:keyframes (
    (:t 0.00 :title "I. Advent (Violet / Rose)" :rule "Adventus • 4 Sunday weeks; expectancy; Emmanuel; Gaudete Sunday rose.")
    (:t 0.16 :title "II. Christmas Season (White / Gold)" :rule "Nativitas • Nativity, Holy Family, Epiphany, Baptism of the Lord.")
    (:t 0.32 :title "III. Ordinary Time Part I (Green)" :rule "Tempus per Annum • Hope, parables, discipleship, Christ's healing ministry.")
    (:t 0.48 :title "IV. Lent (Violet / Purple)" :rule "Quadragesima • Ash Wednesday, 40 days, prayer, fasting, almsgiving, Laetare.")
    (:t 0.65 :title "V. Triduum & Easter Season (Gold / Red)" :rule "Pascha & Pentecoste • 50 days of resurrection; Red flames on Pentecost.")
    (:t 0.82 :title "VI. Christ the King (Apex of the Year)" :rule "Christus Rex • Final Sunday of Ordinary Time crowning the sacred year.")
  ))
  (:interactive (
    (:checkpoint :t 0.14
      :prompt "On which two specific Sundays of the liturgical year is the priest permitted to wear Rose-colored vestments?"
      :options ("Gaudete Sunday (3rd Sunday of Advent) and Laetare Sunday (4th Sunday of Lent)" "Easter Sunday and Pentecost Sunday" "Ash Wednesday and Good Friday" "Christmas Day and Epiphany")
      :answer 0
      :explanation "Under GIRM 346, Rose vestments may be worn on Gaudete Sunday in Advent and Laetare Sunday in Lent to signify an anticipation of joyful celebration amidst a penitential season.")
    (:checkpoint :t 0.46
      :prompt "What is the primary spiritual symbolism of the color Green worn during Ordinary Time?"
      :options ("Hope, spiritual life, and growth in grace following Christ's earthly teaching (GIRM 346f)" "Penance and interior mortification" "Martyrdom and the shedding of blood" "Mourning and sorrow for human sins")
      :answer 0
      :explanation "Green is the color of living vegetation, sprouts, and springtime growth. In the liturgy, green signifies hope and the continuous daily growth of the Christian soul through the Gospel teachings.")
    (:checkpoint :t 0.78
      :prompt "How many days does the Church celebrate the Easter Season from Easter Sunday to Pentecost?"
      :options ("50 Days (The Great 'Pentecost' Fifty Days of Joy)" "40 Days" "7 Days (The Octave only)" "100 Days")
      :answer 0
      :explanation "Easter is celebrated for 50 uninterrupted days ('as one feast day, indeed as one great Sunday', General Norms for the Liturgical Year §22), culminating in the descent of the Holy Spirit on Pentecost.")
  ))
  (:bindings (
    (:target "#liturgical-dial-needle" :attr "transform" :expr "'rotate(' + ((t * 360) + (vars.seasonAngle || 0)) + ' 400 220)'")
    (:target "#season-glow-halo" :attr "stroke" :expr "t < 0.16 ? '#a855f7' : (t < 0.32 ? '#facc15' : (t < 0.48 ? '#22c55e' : (t < 0.65 ? '#9333ea' : (t < 0.82 ? '#f59e0b' : '#22c55e'))))")
    (:target "#season-center-badge" :attr "fill" :expr "t < 0.16 ? '#581c87' : (t < 0.32 ? '#854d0e' : (t < 0.48 ? '#14532d' : (t < 0.65 ? '#581c87' : (t < 0.82 ? '#7f1d1d' : '#14532d'))))")
  ))
)
