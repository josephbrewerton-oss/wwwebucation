(:scene :id "cst-virtues" :type "Slide" :oak-id "OAK-KS3-RE-012" :oak-unit "ks3-re-catholic-social-teaching-virtues" :title "Catholic Social Teaching & Virtues: Gospel Love in Daily Action" :stage "CATHOLIC LIFE" :duration 28.0
  (:vars (
    (:var :name "activePillar" :val 1.0 :min 1.0 :max 7.0 :step 1.0 :label "Selected CST Pillar")
    (:var :name "solidarityGlow" :val 1.0 :min 0.2 :max 2.0 :step 0.1 :label "Solidarity Ray Intensity")
    (:var :name "creationGrowth" :val 1.0 :min 0.5 :max 1.8 :step 0.1 :label "Care for Creation Scale")
  ))

  (:camera :mode "2d" :viewBox "0 0 800 480")

  (:inputs (
    (:slider :var "activePillar" :label "CST Pillar (1-7)" :min 1.0 :max 7.0 :step 1.0)
    (:slider :var "solidarityGlow" :label "Solidarity Glow" :min 0.2 :max 2.0 :step 0.1)
    (:slider :var "creationGrowth" :label "Creation Seedling Scale" :min 0.5 :max 1.8 :step 0.1)
  ))

  (:gestures (
    (:draggable :target "#cst-compass-dial" :axis "x" :min 120 :max 680
      (:bind-var "activePillar" :map "linear" :from-min 120 :from-max 680 :to-min 1.0 :to-max 7.0)
    )
    (:draggable :target "#creation-seedling-node" :axis "y" :min 140 :max 280
      (:bind-var "creationGrowth" :map "linear" :from-min 280 :from-max 140 :to-min 0.5 :to-max 1.8)
    )
  ))

  (:subtitles (
    (:start 0.00 :end 0.16 :en "Catholic Social Teaching (CST) shows how Christ's Gospel is put into real daily action in our classrooms, towns, and global community.")
    (:start 0.16 :end 0.32 :en "The bedrock principle is the Dignity of the Human Person: every human is made in God's image and has infinite sacred worth.")
    (:start 0.32 :end 0.50 :en "The Common Good reminds us that true flourishing happens when we ensure everyone has what they need to thrive—not just a lucky few.")
    (:start 0.50 :end 0.70 :en "In Solidarity and Preferential Option for the Poor, we stand with the vulnerable, seeing Jesus in the hungry, refugee, and lonely.")
    (:start 0.70 :end 0.88 :en "Through Care for Creation (Laudato Si'), we protect God's planetary garden for generations to come.")
    (:start 0.88 :end 1.00 :en "Guided by the Theological Virtues (Faith, Hope, Love) and Cardinal Virtues, our school community brings Christ's light to all.")
  ))

  (:interactive (
    (:checkpoint :t 0.35
      :prompt "What is the foundational first principle of Catholic Social Teaching from which all human rights flow?"
      :options ("The Dignity of the Human Person made in the Image and Likeness of God" "Having the highest gross domestic product" "Winning school competitions" "Following the opinions of social media")
      :answer 0
      :explanation "Genesis 1:27 teaches that every single person is formed in the image of God (Imago Dei) with inviolable worth and dignity.")
    (:checkpoint :t 0.72
      :prompt "What does Pope Francis call the Earth in his encyclical Laudato Si' on Care for Creation?"
      :options ("Our Common Home, a sister with whom we share our life" "An endless warehouse of resources to consume" "A problem only for scientists to solve" "Something that does not relate to Christian faith")
      :answer 0
      :explanation "Pope Francis reminds us in Laudato Si' that our planet is our Common Home, entrusted to us by God as loving stewards.")
  ))

  (:bindings (
    (:target "#solidarity-halo" :attr "opacity" :expr "0.3 + 0.35 * (vars.solidarityGlow || 1.0)")
    (:target "#solidarity-halo" :attr "r" :expr "45 + 15 * (vars.solidarityGlow || 1.0)")
    ;; Scale around local plant origin (assumes seedling base is around x: 550, y: 380)
    (:target "#seedling-stem" :attr "transform" :expr "'translate(550, 380) scale(' + (vars.creationGrowth || 1.0) + ') translate(-550, -380)'")
    (:target "#justice-scales" :attr "transform" :expr "'rotate(' + (Math.sin(t * 1.2) * 5) + ' 220 240)'")
  ))
)
