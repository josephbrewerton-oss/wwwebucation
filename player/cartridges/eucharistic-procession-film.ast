(:scene :id "eucharistic-procession-film" :type "Film" :video "/media/eucharistic-procession.mp4" :video-fit "contain" :title "Solemn Eucharistic Procession: Liturgical Film & Sacred Vectors" :stage "CATHOLIC LIFE" :duration 26.0
  (:vars (
    (:var :name "incenseSwirl" :val 1.0 :min 0.2 :max 2.0 :step 0.2 :label "Censer Smoke Diffusion")
    (:var :name "monstranceGlow" :val 0.85 :min 0.2 :max 1.5 :step 0.1 :label "Eucharistic Halo Radiance")
    (:var :name "cameraSpotlight" :val 1.0 :min 0.0 :max 1.0 :step 1.0 :label "Pedagogical Vector Overlay")
  ))
  (:inputs (
    (:slider :var "incenseSwirl" :label "Thurible Incense Cloud" :min 0.2 :max 2.0 :step 0.2)
    (:slider :var "monstranceGlow" :label "Blessed Sacrament Radiance" :min 0.2 :max 1.5 :step 0.1)
    (:switch :var "cameraSpotlight" :label "Show Vector HUD Annotations")
  ))
  (:gestures (
    (:draggable :target "#film-interactive-probe" :axis "xy" :min 80 :max 720)
  ))
  (:subtitles (
    (:start 0.00 :end 0.25 :en "Solemn Eucharistic Procession: The Blessed Sacrament is borne triumphantly through the sanctuary under an embroidered silk canopy (Ombrellino / Baldachinum)." :es "Solemne Procesión Eucarística: El Santísimo Sacramento es llevado triunfalmente bajo el palio de seda bordada." :la "Processio Solemnis: Pange, lingua, gloriosi Corporis mysterium, Sanguinisque pretiosi, quem in mundi pretium effudit Rex gentium.")
    (:start 0.25 :end 0.52 :en "The Thurifer and Boat Bearer lead the procession, swinging fragrant frankincense continuously before the Lord, fulfilling Psalm 141 and Revelation 8:3." :es "El turiferario y el navetero encabezan la marcha, esparciendo incienso continuo ante el Señor, cumpliendo el Salmo 140 y Apocalipsis 8:3." :la "Thurificatio: Stetit Angelus iuxta aram templi, habens thuribulum aureum in manu sua: et data sunt ei incensa multa.")
    (:start 0.52 :end 0.78 :en "Tantum Ergo Sacramentum: As the procession reaches the high altar, all fall to their knees in adoration before the Real Presence of Christ in the Monstrance (Ostensorium)." :es "Tantum Ergo: Al llegar al altar mayor, la asamblea se arrodilla en adoración ante la Presencia Real de Cristo en la Custodia." :la "Tantum ergo Sacramentum veneremur cernui: et antiquum documentum novo cedat ritui: praestet fides supplementum sensuum defectui.")
    (:start 0.78 :end 1.00 :en "The Eucharistic Blessing: The priest, wearing the humeral veil, raises the Monstrance in the Sign of the Cross to bless the faithful in reverent silence." :es "La Bendición Eucarística: El sacerdote, con el velo humeral, eleva la Custodia en la Señal de la Cruz para bendecir a los fieles en solemne silencio." :la "Benedictio: Panem de caelo praestitisti eis. Omne delectamentum in se habentem. Oremus: Deus, qui nobis sub sacramento mirabili...")
  ))
  (:keyframes (
    (:t 0.00 :title "1. The Canopy & Processional Cross" :rule "Processio Solemnis • The processional cross leads; silk canopy shelters the Lord.")
    (:t 0.25 :title "2. Frankincense & The Royal Path" :rule "Thurifer & Navicula • Double swings of burning incense sanctifying the pilgrim nave.")
    (:t 0.52 :title "3. Tantum Ergo & Altar Genuflection" :rule "Adoratio • Deep double genuflection before the True Body and Blood of Christ.")
    (:t 0.78 :title "4. The Humeral Blessing with the Monstrance" :rule "Benedictio • Blessing of the faithful; the priest's hands covered by sacred silk.")
  ))
  (:interactive (
    (:checkpoint :t 0.35
      :prompt "Why does the priest wear the silk Humeral Veil when raising the Monstrance for Eucharistic Benediction?"
      :options ("To signify that it is Christ Himself blessing the people, not the human priest using his bare hands" "To keep his hands warm in cold stone stone churches" "As a sign of apostolic mourning" "To prevent fingerprints on the polished gold stem")
      :answer 0
      :explanation "Under Roman Rite liturgical rubrics, the priest covers his hands with the humeral veil so that the faithful look past the human minister and receive the blessing directly from Christ Jesus present in the Blessed Sacrament.")
    (:checkpoint :t 0.75
      :prompt "What classic hymn composed by St. Thomas Aquinas for Corpus Christi concludes with the famous 'Tantum Ergo' verses?"
      :options ("Pange Lingua Gloriosi" "Dies Irae" "Adeste Fideles" "Salve Regina")
      :answer 0
      :explanation "St. Thomas Aquinas composed 'Pange Lingua' at the request of Pope Urban IV in 1264 for the newly instituted Solemnity of Corpus Christi. The last two stanzas form the beloved Eucharistic hymn 'Tantum Ergo'.")
  ))
  (:bindings (
    (:target "#film-monstrance-halo" :attr "r" :expr "55 + (Math.sin(t * Math.PI * 6) * 12) * (vars.monstranceGlow || 0.85)")
    (:target "#film-monstrance-halo" :attr "opacity" :expr "(0.65 + Math.sin(t * 14) * 0.18) * (vars.monstranceGlow || 0.85)")
    (:target "#film-incense-stream-1" :attr "transform" :expr "'translate(' + (Math.sin(t * Math.PI * 8) * 20 * (vars.incenseSwirl || 1.0)) + ', ' + (-t * 30) + ')'")
    (:target "#film-incense-stream-1" :attr "opacity" :expr "(0.45 + Math.cos(t * 10) * 0.2) * (vars.incenseSwirl || 1.0)")
    (:target "#film-incense-stream-2" :attr "transform" :expr "'translate(' + (-Math.sin(t * Math.PI * 8 + 0.5) * 28 * (vars.incenseSwirl || 1.0)) + ', ' + (-t * 45) + ')'")
    (:target "#film-hud-group" :attr "opacity" :expr "vars.cameraSpotlight === 0 ? 0 : 0.95")
    (:target "#film-progress-cursor" :attr "cx" :expr "120 + t * 560")
  ))
)
