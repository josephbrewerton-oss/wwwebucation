(:scene :id "languages" :type "App" :oak-id "OAK-KS2-MFL-001" :oak-unit "ks2-languages-mfl-polyglot-studio" :title "MFL & Polyglot Studio: Spanish, French & Latin" :stage "KS2/KS3 MFL" :duration 15.0
  (:vars (
    (:var :name "personIndex" :val 0 :min 0 :max 5 :step 1 :label "Grammatical Person (1st to 3rd)")
  ))
  (:inputs (
    (:slider :var "personIndex" :label "Person / Conjugation Index" :min 0 :max 5 :step 1)
  ))
  (:gestures (
    (:draggable :target "#suffix-display" :axis "x" :min 460 :max 580)
    (:interactive :target "#pronoun-display" :action "toggle")
  ))
  (:subtitles (
    (:start 0.00 :end 4.00 :en "Welcome to the Polyglot Lab. Let's explore how Spanish, French, and Latin construct meaning through sounds and stems." :es "Bienvenidos al Laboratorio Políglota. Exploremos cómo el español, francés y latín construyen significado.")
    (:start 4.00 :end 9.00 :en "Notice how the verb stem stays stable while the ending signals WHO is doing the action." :es "Observa cómo la raíz del verbo se mantiene estable mientras la terminación indica QUIÉN realiza la acción.")
    (:start 9.00 :end 15.00 :en "Because the ending uniquely tells us the subject, Spanish and Latin drop the pronoun: 'Hablo' means 'I speak'." :es "Debido a que la terminación indica el sujeto, el español no necesita el pronombre: 'Hablo' ya significa 'Yo hablo'.")
  ))
  (:keyframes (
    (:t 0.00 :title "1. The Soundboard" :rule "Phonics first: Sound-to-spelling correspondence across European languages")
    (:t 0.35 :title "2. The Stem & Ending" :rule "Morphology: Stripping the infinitive (-ar, -er, -ir) and attaching person markers")
    (:t 0.70 :title "3. Pro-Drop Syntax" :rule "Spanish & Latin omit pronouns ('Hablo') because the ending encodes the subject")
    (:t 1.00 :title "4. Polyglot Mastery" :rule "60% of academic English connects back to Latin and Romance language cognates")
  ))
  (:interactive false)
  (:questions false)
  (:bindings (
    (:target "#pronoun-display" :attr "textContent" :expr "['Yo (I)', 'Tú (You)', 'Él (He)', 'Nosotros (We)', 'Vosotros (You all)', 'Ellos (They)'][Math.floor(t * 6) % 6]")
    (:target "#suffix-display" :attr "textContent" :expr "['-o', '-as', '-a', '-amos', '-áis', '-an'][Math.floor(t * 6) % 6]")
  ))
)
