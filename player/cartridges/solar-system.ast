(:scene :id "solar-system" :type "Sim" :title "Solar System: Heliocentric Planetary Motion" :stage "KS3 SCIENCE" :duration 14.0
  (:camera :distance 580 :pitch 24 :yaw "t * 40" :fov 60)
  (:vars (
    (:var :name "warpSpeed" :val 1.0 :min 0.2 :max 5.0 :step 0.2 :label "Time Dilation Warp")
    (:var :name "showOrbits" :val true :label "Display Orbital Rings")
  ))
  (:inputs (
    (:slider :var "warpSpeed" :label "Orbital Speed Multiplier" :min 0.2 :max 5.0 :step 0.2)
    (:switch :var "showOrbits" :label "Orbital Paths")
  ))
  (:computed (
    (:name "earthDays" :expr "Math.round(vars.warpSpeed * 365)")
  ))
  (:gestures (
    (:draggable :target "#sun-body" :axis "xy" :min -30 :max 30)
  ))
  (:subtitles (
    (:start 0.00 :end 0.33 :en "At the center sits our Sun. Watch how Mercury speeds around much faster than Earth." :es "En el centro se encuentra el Sol. Observa cómo Mercurio gira mucho más rápido que la Tierra.")
    (:start 0.33 :end 0.66 :en "Kepler's Law: The closer a planet is to the Sun, the faster it travels in its orbit." :es "Ley de Kepler: Cuanto más cerca está un planeta del Sol, más rápido orbita.")
    (:start 0.66 :end 1.00 :en "Outer gas giants Jupiter and Saturn glide on immense orbits. Drag stage to orbit in 3D!" :es "Los gigantes gaseosos Júpiter y Saturno siguen órbitas inmensas. ¡Arrastra para rotar en 3D!")
  ))
  (:keyframes (
    (:t 0.00 :title "Heliocentric Sun" :rule "The Sun sits at the focal center, providing gravitational attraction.")
    (:t 0.33 :title "Planetary Orbits" :rule "Inner planets orbit faster than outer planets (Kepler's 3rd Law).")
    (:t 0.66 :title "Earth Axial Tilt" :rule "Earth's 23.5° tilt causes seasonal changes, not distance from the Sun!")
    (:t 1.00 :title "Harmonic Alignment" :rule "Deterministic orbital resonance across the solar system.")
  ))
  (:interactive (
    (:checkpoint :t 0.40
      :prompt "According to Kepler's Third Law (T² ∝ r³), which planet takes the least time to complete one full revolution around the Sun?"
      :options ("Mercury (closest orbital radius)" "Earth" "Jupiter" "Saturn")
      :answer 0
      :explanation "Planets closest to the Sun experience the strongest gravitational pull and have the smallest orbital circumference, resulting in the shortest orbital period (Mercury orbits in just 88 Earth days).")
  ))
  (:bindings (
    (:target "#sun-body" :type "3d-node" :x "0" :y "0" :z "0" :base-r 26 :depth-fog false)
    (:target "#sun-corona" :type "3d-node" :x "0" :y "0" :z "0" :base-r 38 :depth-fog false)
    
    (:target "#orbit-mercury" :type "3d-ring" :r "55" :depth-fog true)
    (:target "#orbit-venus" :type "3d-ring" :r "90" :depth-fog true)
    (:target "#orbit-earth" :type "3d-ring" :r "135" :depth-fog true)
    (:target "#orbit-mars" :type "3d-ring" :r "175" :depth-fog true)
    (:target "#orbit-jupiter" :type "3d-ring" :r "230" :depth-fog true)
    (:target "#orbit-saturn" :type "3d-ring" :r "290" :depth-fog true)

    (:target "#planet-mercury" :type "3d-node"
      :x "Math.cos(t * Math.PI * 2 * 4.15) * 55"
      :y "Math.sin(t * Math.PI * 2 * 4.15 * 0.12) * 10"
      :z "Math.sin(t * Math.PI * 2 * 4.15) * 55"
      :base-r 5
      :label "#label-mercury"
    )
    (:target "#planet-venus" :type "3d-node"
      :x "Math.cos(t * Math.PI * 2 * 1.62) * 90"
      :y "Math.sin(t * Math.PI * 2 * 1.62 * 0.15) * 14"
      :z "Math.sin(t * Math.PI * 2 * 1.62) * 90"
      :base-r 8
      :label "#label-venus"
    )
    (:target "#planet-earth" :type "3d-node"
      :x "Math.cos(t * Math.PI * 2 * 1.00) * 135"
      :y "Math.sin(t * Math.PI * 2 * 1.00 * 0.10) * 16"
      :z "Math.sin(t * Math.PI * 2 * 1.00) * 135"
      :base-r 9
      :label "#label-earth"
    )
    (:target "#moon-earth" :type "3d-node"
      :x "(Math.cos(t * Math.PI * 2 * 1.00) * 135) + Math.cos(t * Math.PI * 2 * 12) * 18"
      :y "(Math.sin(t * Math.PI * 2 * 1.00 * 0.10) * 16) + Math.sin(t * Math.PI * 2 * 12) * 5"
      :z "(Math.sin(t * Math.PI * 2 * 1.00) * 135) + Math.sin(t * Math.PI * 2 * 12) * 18"
      :base-r 2.5
    )
    (:target "#planet-mars" :type "3d-node"
      :x "Math.cos(t * Math.PI * 2 * 0.53) * 175"
      :y "Math.sin(t * Math.PI * 2 * 0.53 * 0.18) * 18"
      :z "Math.sin(t * Math.PI * 2 * 0.53) * 175"
      :base-r 6
      :label "#label-mars"
    )
    (:target "#planet-jupiter" :type "3d-node"
      :x "Math.cos(t * Math.PI * 2 * 0.24) * 230"
      :y "Math.sin(t * Math.PI * 2 * 0.24 * 0.08) * 20"
      :z "Math.sin(t * Math.PI * 2 * 0.24) * 230"
      :base-r 14
      :label "#label-jupiter"
    )
    (:target "#planet-saturn" :type "3d-node"
      :x "Math.cos(t * Math.PI * 2 * 0.10) * 290"
      :y "Math.sin(t * Math.PI * 2 * 0.10 * 0.06) * 24"
      :z "Math.sin(t * Math.PI * 2 * 0.10) * 290"
      :base-r 11
      :label "#label-saturn"
    )
    (:target "#saturn-ring" :type "3d-ring"
      :cx "Math.cos(t * Math.PI * 2 * 0.10) * 290"
      :cy "Math.sin(t * Math.PI * 2 * 0.10 * 0.06) * 24"
      :cz "Math.sin(t * Math.PI * 2 * 0.10) * 290"
      :r "20"
      :tilt-x "25"
      :tilt-z "15"
      :depth-fog true
    )
  ))
)
