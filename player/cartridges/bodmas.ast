(:scene :id "bodmas" :type "Slide" :oak-id "OAK-KS2-MAT-004" :oak-unit "ks2-maths-arithmetic-order-operations" :title "BODMAS / BIDMAS: Forcefield Clamping & Area Physics" :stage "KS2/KS3 MATHS" :duration 14.0
  (:vars (
    (:var :name "addend" :val 5 :min 1 :max 20 :step 1 :label "Loose Addend")
    (:var :name "factorA" :val 3 :min 1 :max 10 :step 1 :label "Factor A")
    (:var :name "factorB" :val 4 :min 1 :max 10 :step 1 :label "Factor B")
  ))
  (:inputs (
    (:slider :var "addend" :label "Addend (Outside Clamping)" :min 1 :max 20 :step 1)
    (:slider :var "factorA" :label "Multiplication Factor A" :min 1 :max 10 :step 1)
    (:slider :var "factorB" :label "Multiplication Factor B" :min 1 :max 10 :step 1)
  ))
  (:computed (
    (:name "correctTotal" :expr "vars.addend + vars.factorA * vars.factorB")
    (:name "wrongTotal" :expr "(vars.addend + vars.factorA) * vars.factorB")
  ))
  (:gestures (
    (:draggable :target "#bodmas-clamp-border" :axis "x" :min 280 :max 480)
  ))
  (:subtitles (
    (:start 0.00 :end 0.35 :en "Look at 5 + 3 × 4. Many students make the classic mistake of adding 5 + 3 first. But watch what happens in physical geometry!" :es "Mira 5 + 3 × 4. Muchos cometen el error de sumar 5 + 3 primero. ¡Pero mira qué sucede en la geometría física!")
    (:start 0.35 :end 0.70 :en "Multiplication creates a solid 3 by 4 rectangular array of 12 tiles! If you add 5 + 3 to get 8, you turn 3 groups into 8 groups, inventing 20 extra tiles from nothing!" :es "¡La multiplicación crea un bloque rectangular de 3 por 4 con 12 baldosas! ¡Si sumas 5 + 3 para hacer 8, inventas 20 baldosas de la nada!")
    (:start 0.70 :end 1.00 :en "The high-voltage multiplication clamp evaluates first: 3 × 4 = 12. Then we add the 5 loose coins: 5 + 12 = 17! Solved correctly." :es "La multiplicación se calcula primero: 3 × 4 = 12. Luego sumamos las 5 monedas sueltas: 5 + 12 = 17. ¡Resuelto correctamente!")
  ))
  (:keyframes (
    (:t 0.00 :title "Step 1: The Equation" :rule "Analyze 5 + 3 × 4: Identify loose units versus grouped area multiplication.")
    (:t 0.35 :title "Step 2: Magnetic Clamping" :rule "3 × 4 binds into an unbroken 2D rectangular array of 12 tiles.")
    (:t 0.65 :title "Step 3: The Left-to-Right Trap" :rule "5 + 3 = 8 ➔ 8 × 4 = 32 is FALSE. It destroys the area model and invents 20 extra tiles.")
    (:t 0.85 :title "Step 4: Vector Addition" :rule "Evaluate clamp: 3 × 4 = 12. Combine 5 loose coins + 12 tiles = 17.")
    (:t 1.00 :title "Step 5: Verified Proof" :rule "5 + 3 × 4 = 17. Q.E.D. Order of Operations mastered.")
  ))
  (:interactive (
    (:checkpoint :t 0.70
      :prompt "Why does 5 + 3 × 4 equal 17 instead of 32?"
      :options ("Multiplication takes precedence over addition (3 × 4 = 12, then + 5 = 17)" "Math equations are always evaluated right-to-left" "Because 32 is too large" "It is a convention only for negative numbers")
      :answer 0
      :explanation "Under standard algebraic order of operations (BODMAS / BIDMAS), multiplication binds factors into an area group before loose units are added.")
  ))
  (:bindings (
    (:target "#bodmas-clamp-border" :attr "stroke-width" :expr "t < 0.35 ? 2.5 : (2.5 + Math.sin(t * 20) * 1.5)")
    (:target "#bodmas-trap-card" :attr "opacity" :expr "(t >= 0.35 && t < 0.70) ? Math.min(1, (t - 0.35) / 0.10) : 0")
    (:target "#bodmas-proof-card" :attr "opacity" :expr "t >= 0.70 ? Math.min(1, (t - 0.70) / 0.10) : 0")
    (:target "#bodmas-expr-3x4" :attr "opacity" :expr "t < 0.75 ? 1 : 0")
    (:target "#bodmas-expr-12" :attr "opacity" :expr "t >= 0.75 ? 1 : 0")
    (:target "#bodmas-result-txt" :attr "textContent" :expr "t < 0.75 ? '?' : '17'")
    (:target "#bodmas-result-txt" :attr "fill" :expr "t < 0.75 ? '#94a3b8' : '#4ade80'")
    (:target "#bodmas-banner-txt" :attr "textContent" :expr "t < 0.35 ? 'BODMAS Rule: Multiplication binds tighter than Addition.' : (t < 0.70 ? 'Trap: 5 + 3 = 8 -> 8 × 4 = 32 invents 20 extra tiles out of nowhere!' : 'Verified: 3 × 4 = 12 area units + 5 loose units = 17.')")
  ))
)
