<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%" id="lumina-manifesto-root" style="background:#090d16; font-family:system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  <!--
    (:scene
      :id "lumina-architecture-manifesto"
      :type "Slide"
      :title "Lumina: Sovereign Architectural Manifesto"
      :stage "FOUNDATIONAL SYSTEM ARCHITECTURE"
      :duration 1.0

      (:subtitles (
        (:start 0.00 :end 0.25 :en "I. The Anti-Enclosure Axiom: Zero Telemetry & Privacy Sovereignty")
        (:start 0.25 :end 0.50 :en "II. 7-Page (448 KB) WASM Linear Memory Contract")
        (:start 0.50 :end 0.75 :en "III. Declarative S-Expressions into Pure Vectors & Subtractive CSG")
        (:start 0.75 :end 1.00 :en "IV. The Sovereign Offline Covenant: Air-Gapped P2P Mesh")
      ))

      (:vars (
        (:var :name "page" :val 0 :min 0 :max 3 :step 1 :label "Chapter Index")
        (:var :name "wasmByteOffset" :val 128 :min 0 :max 448 :step 1 :label "Linear Memory Ring (KB)")
        (:var :name "csgAperture" :val 24 :min 8 :max 48 :step 1 :label "CSG Void Inset (mm)")
      ))

      (:inputs (
        (:slider :var "page" :label "Turn Chapter (1 - 4)" :min 0 :max 3 :step 1)
        (:slider :var "wasmByteOffset" :label "Inspect WASM Ring Buffer (KB)" :min 0 :max 448 :step 1)
        (:slider :var "csgAperture" :label "CSG Void Inset (mm)" :min 8 :max 48 :step 1)
      ))

      (:computed (
        (:name "spineTranslationX" :expr "-(vars.page || 0) * 800")
        (:name "memoryPointerAngle" :expr "((vars.wasmByteOffset || 0) / 448) * 360")
        (:name "csgPathD" :expr "'M 40 30 L 220 30 L 220 170 L 40 170 Z M ' + (40 + (vars.csgAperture || 24)) + ' ' + (30 + (vars.csgAperture || 24)) + ' L ' + (220 - (vars.csgAperture || 24)) + ' ' + (30 + (vars.csgAperture || 24)) + ' L ' + (220 - (vars.csgAperture || 24)) + ' ' + (170 - (vars.csgAperture || 24)) + ' L ' + (40 + (vars.csgAperture || 24)) + ' ' + (170 - (vars.csgAperture || 24)) + ' Z'")
        (:name "tab1Bg" :expr "(vars.page || 0) === 0 ? '#0284c7' : '#1e293b'")
        (:name "tab2Bg" :expr "(vars.page || 0) === 1 ? '#0284c7' : '#1e293b'")
        (:name "tab3Bg" :expr "(vars.page || 0) === 2 ? '#0284c7' : '#1e293b'")
        (:name "tab4Bg" :expr "(vars.page || 0) === 3 ? '#0284c7' : '#1e293b'")
      ))

      (:keyframes (
        (:t 0.00 :title "I. The Anti-Enclosure Axiom" :rule "Zero Telemetry, Zero Cloud Compute, Universal Destination of Goods")
        (:t 0.33 :title "II. WASM 7-Page Linear Memory" :rule "Fixed 448 KB Virtual ISA. Zero Allocation in Hot Animation Loops")
        (:t 0.66 :title "III. S-Expressions & Subtractive CSG" :rule "Negative-Space Compound Vectorization Carving Voids via fill-rule: evenodd")
        (:t 1.00 :title "IV. The Sovereign Offline Covenant" :rule "Air-Gapped P2P Mesh, Optical QR Sneakernet, AGPLv3 Dual Licensing")
      ))

      (:bindings (
        (:target "#document-spine" :attr "transform" :expr "'translate(' + computed.spineTranslationX + ', 0)'")
        (:target "#chapter-indicator" :attr "textContent" :expr "'CHAPTER ' + ((vars.page || 0) + 1) + ' OF 4'")
        (:target "#wasm-dial-pointer" :attr "transform" :expr "'rotate(' + computed.memoryPointerAngle + ' 1200 240)'")
        (:target "#wasm-addr-readout" :attr "textContent" :expr "'0x' + (Math.round((vars.wasmByteOffset || 0) * 1024)).toString(16).toUpperCase().padStart(6, '0') + ' / 0x070000'")
        (:target "#csg-compound-preview" :attr "d" :expr "computed.csgPathD")
        (:target "#csg-readout-tokens" :attr "textContent" :expr "'INSET: ' + (vars.csgAperture || 24) + 'mm | COMPOUND VOID CARVED IN 1 OPERATION'")
        (:target "#tab-1-bg" :attr "fill" :expr "computed.tab1Bg")
        (:target "#tab-2-bg" :attr "fill" :expr "computed.tab2Bg")
        (:target "#tab-3-bg" :attr "fill" :expr "computed.tab3Bg")
        (:target "#tab-4-bg" :attr "fill" :expr "computed.tab4Bg")
      ))

      (:interactive (
        (:checkpoint :t 0.25
          :prompt "Why does Lumina mandate zero network telemetry and zero cloud compute by construction?"
          :options ("To guarantee student privacy under UK GDPR Art. 25 & KCSIE while running air-gapped on school hardware" "To sell proprietary analytics software" "To increase server bills" "Because internet access is illegal")
          :answer 0
          :explanation "Zero telemetry protects vulnerable pupils by mathematical construction. The entire runtime executes client-side with zero student data egress.")
        (:checkpoint :t 0.70
          :prompt "How does Subtractive CSG (Compound Negative Space) outperform additive 3D meshes in SVG?"
          :options ("It carves voids using winding rules (fill-rule: evenodd) into a single path, cutting DOM nodes by 40-80% with zero overdraw" "It downloads gigabytes of 3D WebGL textures" "It runs heavy server-side Python raytracers" "It repeats every face 10 times")
          :answer 0
          :explanation "Negative-space subtraction carves hollow cavities in 1 hardware drawing pass. This eliminates coplanar seams, cuts GPU overdraw, and maintains 60 FPS on low-power Chromebooks.")
      ))

      (:gestures (
        (:draggable :target "#csg-aperture-scrubber" :axis "x" :var "csgAperture" :min 8 :max 48)
        (:draggable :target "#wasm-dial-pointer" :axis "x" :var "wasmByteOffset" :min 0 :max 448)
        (:clickable :target ".lumina-ch-tab" :set-var "page" :attr "data-page")
        (:clickable :target "#lumina-btn-prev" :step-var "page" :delta -1 :min 0 :max 3)
        (:clickable :target "#lumina-btn-next" :step-var "page" :delta 1 :min 0 :max 3)
      ))
    )
  -->

  <defs>
    <linearGradient id="pageCardGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>

    <linearGradient id="cyanAccent" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#818cf8" />
    </linearGradient>

    <linearGradient id="csgFillGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f43f5e" />
      <stop offset="100%" stop-color="#be123c" />
    </linearGradient>

    <pattern id="blueprintGrid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#1e293b" stroke-width="0.75" />
    </pattern>

    <filter id="shadowFilter" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#000000" flood-opacity="0.5" />
    </filter>
  </defs>

  <!-- Background Blueprint Matrix -->
  <rect width="800" height="500" fill="url(#blueprintGrid)" />

  <!-- Top Persistent Header -->
  <g id="hud-header">
    <rect x="0" y="0" width="800" height="52" fill="#090d16" fill-opacity="0.9" />
    <text x="32" y="32" fill="#38bdf8" font-size="12" font-weight="800" letter-spacing="1.5">LUMINA: SOVEREIGN ARCHITECTURAL MANIFESTO</text>
    <text id="chapter-indicator" x="768" y="32" text-anchor="end" fill="#94a3b8" font-size="11" font-weight="700" font-family="ui-monospace, monospace">CHAPTER 1 OF 4</text>
    <line x1="32" y1="46" x2="768" y2="46" stroke="#334155" stroke-width="1.2" />
  </g>

  <!-- 4-Chapter Sliding Document Spine -->
  <g id="document-spine" style="transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);">
    
    <!-- CHAPTER 1: THE ANTI-ENCLOSURE AXIOM -->
    <g id="page-1" transform="translate(0, 0)">
      <rect x="36" y="60" width="728" height="375" rx="12" fill="url(#pageCardGrad)" stroke="#334155" stroke-width="1.5" filter="url(#shadowFilter)" />
      
      <text x="64" y="100" fill="#f8fafc" font-size="19" font-weight="800">I. The Anti-Enclosure Axiom</text>
      <text x="64" y="122" fill="#94a3b8" font-size="12">An architectural refusal of surveillance-capitalist educational technology.</text>

      <g transform="translate(64, 142)">
        <rect x="0" y="0" width="450" height="66" rx="8" fill="#090d16" stroke="#1e293b" />
        <text x="16" y="24" fill="#38bdf8" font-size="11.5" font-weight="800" font-family="ui-monospace, monospace">01. ZERO NETWORK EGRESS &amp; PRIVACY SOVEREIGNTY</text>
        <text x="16" y="44" fill="#cbd5e1" font-size="11">No tracking beacons, cookies, or telemetry. Complete student safeguarding</text>
        <text x="16" y="58" fill="#94a3b8" font-size="10.5">guaranteed by construction under UK GDPR Art. 25 &amp; KCSIE standards.</text>
      </g>

      <g transform="translate(64, 222)">
        <rect x="0" y="0" width="450" height="66" rx="8" fill="#090d16" stroke="#1e293b" />
        <text x="16" y="24" fill="#38bdf8" font-size="11.5" font-weight="800" font-family="ui-monospace, monospace">02. MECHANICAL SYMPATHY OVER FRAMEWORK BLOAT</text>
        <text x="16" y="44" fill="#cbd5e1" font-size="11">Zero Virtual DOM diffing overhead. 60 FPS vector execution within low-power</text>
        <text x="16" y="58" fill="#94a3b8" font-size="10.5">school hardware budgets (&lt; 8 MB RAM, &lt; 35 KB gzipped engine footprint).</text>
      </g>

      <g transform="translate(64, 302)">
        <rect x="0" y="0" width="450" height="66" rx="8" fill="#090d16" stroke="#1e293b" />
        <text x="16" y="24" fill="#38bdf8" font-size="11.5" font-weight="800" font-family="ui-monospace, monospace">03. HUMANITARIAN COMMONS (AGPLv3 + OGL v3.0)</text>
        <text x="16" y="44" fill="#cbd5e1" font-size="11">Perpetually free for state schools, Catholic dioceses, charities, and</text>
        <text x="16" y="58" fill="#94a3b8" font-size="10.5">developing nations under the Universal Destination of Human Goods.</text>
      </g>

      <!-- Right Column: Verification Seal -->
      <g transform="translate(620, 215)">
        <circle cx="0" cy="0" r="64" fill="#090d16" stroke="#38bdf8" stroke-width="2" stroke-dasharray="8 4" />
        <circle cx="0" cy="0" r="54" fill="none" stroke="#334155" stroke-width="1.2" />
        <text x="0" y="-8" text-anchor="middle" fill="#38bdf8" font-size="11" font-weight="800" font-family="ui-monospace, monospace">AIR-GAPPED</text>
        <text x="0" y="8" text-anchor="middle" fill="#38bdf8" font-size="10" font-weight="800" font-family="ui-monospace, monospace">SOVEREIGNTY</text>
        <text x="0" y="24" text-anchor="middle" fill="#94a3b8" font-size="8.5" font-family="ui-monospace, monospace">VERIFIED SAFE</text>
      </g>
    </g>

    <!-- CHAPTER 2: 7-PAGE (448 KB) WASM LINEAR MEMORY CONTRACT -->
    <g id="page-2" transform="translate(800, 0)">
      <rect x="36" y="60" width="728" height="375" rx="12" fill="url(#pageCardGrad)" stroke="#334155" stroke-width="1.5" filter="url(#shadowFilter)" />
      
      <text x="64" y="100" fill="#f8fafc" font-size="19" font-weight="800">II. 7-Page (448 KB) WASM Memory Contract</text>
      <text x="64" y="122" fill="#94a3b8" font-size="12">Fixed linear memory virtual ISA guarantees zero dynamic heap allocations in active loops.</text>

      <g transform="translate(64, 148)">
        <text x="0" y="14" fill="#cbd5e1" font-size="12.5" font-weight="700">Structure of Arrays (SoA) Layout vs Heap Churn:</text>
        <text x="0" y="34" fill="#94a3b8" font-size="11">Hot 60 FPS animation loops completely bypass V8 garbage-collected heap allocation.</text>
        <text x="0" y="50" fill="#94a3b8" font-size="11">Kinetic particles, rigid bodies, and projected 3D vertices occupy contiguous memory.</text>
        <text x="0" y="66" fill="#94a3b8" font-size="11">This eliminates Garbage Collector (GC) micro-stutters and dropped frames on low-tier devices.</text>
      </g>

      <g transform="translate(64, 240)">
        <rect x="0" y="0" width="380" height="58" rx="8" fill="#090d16" stroke="#1e293b" />
        <text x="16" y="22" fill="#94a3b8" font-size="9.5" font-weight="800" font-family="ui-monospace, monospace">INSPECTED LINEAR ADDRESS REGISTER:</text>
        <text id="wasm-addr-readout" x="16" y="44" fill="#38bdf8" font-size="14" font-weight="800" font-family="ui-monospace, monospace">0x020000 / 0x070000</text>
      </g>

      <g transform="translate(64, 318)">
        <rect x="0" y="0" width="380" height="50" rx="8" fill="#090d16" stroke="#1e293b" />
        <text x="16" y="20" fill="#34d399" font-size="9.5" font-weight="800" font-family="ui-monospace, monospace">MEMORY PARTITIONS (7 PAGES):</text>
        <text x="16" y="38" fill="#cbd5e1" font-size="10.5" font-family="ui-monospace, monospace">0:Header | 1:StringTable | 2-4:SoA Particles | 5-6:Affine Scratch</text>
      </g>

      <!-- Right Column: Interactive WASM Memory Wheel -->
      <g id="wasm-memory-viz">
        <circle cx="1200" cy="240" r="85" fill="#090d16" stroke="#334155" stroke-width="16" />
        <circle cx="1200" cy="240" r="85" fill="none" stroke="url(#cyanAccent)" stroke-width="16" stroke-dasharray="135 400" />
        <text x="1200" y="235" text-anchor="middle" fill="#f8fafc" font-size="16" font-weight="800" font-family="ui-monospace, monospace">448 KB</text>
        <text x="1200" y="253" text-anchor="middle" fill="#94a3b8" font-size="10" font-weight="700" font-family="ui-monospace, monospace">FIXED POOL</text>
        <g id="wasm-dial-pointer" transform="rotate(102 1200 240)">
          <line x1="1200" y1="240" x2="1200" y2="162" stroke="#f43f5e" stroke-width="3.5" stroke-linecap="round" />
          <circle cx="1200" cy="240" r="7" fill="#f43f5e" />
        </g>
        <text x="1200" y="352" text-anchor="middle" fill="#64748b" font-size="9.5" font-family="ui-monospace, monospace">SCRUB VIA INPUT SLIDER</text>
      </g>
    </g>

    <!-- CHAPTER 3: S-EXPRESSIONS & SUBTRACTIVE CSG VECTORIZATION -->
    <g id="page-3" transform="translate(1600, 0)">
      <rect x="36" y="60" width="728" height="375" rx="12" fill="url(#pageCardGrad)" stroke="#334155" stroke-width="1.5" filter="url(#shadowFilter)" />
      
      <text x="64" y="100" fill="#f8fafc" font-size="19" font-weight="800">III. Declarative S-Expressions &amp; Subtractive CSG</text>
      <text x="64" y="122" fill="#94a3b8" font-size="12">Mathematical evaluation maps directly into pure SVG hardware rasterization.</text>

      <g transform="translate(64, 142)">
        <rect x="0" y="0" width="370" height="96" rx="8" fill="#090d16" stroke="#1e293b" />
        <text x="14" y="22" fill="#38bdf8" font-size="11" font-weight="800" font-family="ui-monospace, monospace">NEGATIVE SPACE CSG (BOOLEAN DIFFERENCE):</text>
        <text x="14" y="42" fill="#cbd5e1" font-size="10.5">Instead of additively stacking multiple perimeter wall quads,</text>
        <text x="14" y="58" fill="#cbd5e1" font-size="10.5">hollow voids are subtracted in 1 compound path via winding rules:</text>
        <text x="14" y="78" fill="#f43f5e" font-size="10" font-family="ui-monospace, monospace">fill-rule="evenodd" (Outer Box \ Inset Void)</text>
      </g>

      <g transform="translate(64, 252)">
        <rect x="0" y="0" width="370" height="60" rx="8" fill="#090d16" stroke="#1e293b" />
        <text x="14" y="22" fill="#34d399" font-size="10.5" font-weight="800" font-family="ui-monospace, monospace">DOM REDUCTION &amp; ZERO OVERDRAW:</text>
        <text x="14" y="42" fill="#94a3b8" font-size="10.5">Cuts DOM elements by 40–80%. The GPU stencil rasterizes</text>
        <text x="14" y="56" fill="#94a3b8" font-size="10.5">the hollow volume in a single drawing pass with zero z-fighting.</text>
      </g>

      <g transform="translate(64, 326)">
        <text id="csg-readout-tokens" x="0" y="14" fill="#38bdf8" font-size="10" font-weight="700" font-family="ui-monospace, monospace">
          INSET: 24mm | COMPOUND VOID CARVED IN 1 OPERATION
        </text>
        <text x="0" y="32" fill="#64748b" font-size="9.5" font-family="ui-monospace, monospace">
          APPLIED TO: LEGO Underside, BSL Avatar Handshapes, Flywheels, &amp; Atom Shells
        </text>
      </g>

      <!-- Right Column: Interactive Subtractive CSG Live Demo Stage -->
      <g transform="translate(480, 142)">
        <!-- Outer Stage Frame -->
        <rect x="0" y="0" width="256" height="230" rx="10" fill="#090d16" stroke="#334155" stroke-width="1.2" />
        <text x="12" y="22" fill="#94a3b8" font-size="9" font-weight="800" font-family="ui-monospace, monospace">LIVE CSG SUBTRACTION STAGE:</text>
        
        <!-- Background Grid showing transparency through negative-space void -->
        <g transform="translate(0, 10)" opacity="0.4">
          <line x1="40" y1="50" x2="220" y2="150" stroke="#38bdf8" stroke-width="0.8" stroke-dasharray="4 4" />
          <line x1="40" y1="150" x2="220" y2="50" stroke="#38bdf8" stroke-width="0.8" stroke-dasharray="4 4" />
          <circle cx="130" cy="100" r="40" fill="none" stroke="#64748b" stroke-width="1" stroke-dasharray="3 3" />
        </g>

        <!-- Reactive Compound Subtractive Path (Outer Box minus Inner Inset Void) -->
        <path id="csg-compound-preview" fill-rule="evenodd" fill="url(#csgFillGrad)" stroke="#fda4af" stroke-width="1.5" stroke-linejoin="round"
              d="M 40 30 L 220 30 L 220 170 L 40 170 Z M 64 54 L 196 54 L 196 146 L 64 146 Z" />
        
        <text x="128" y="104" text-anchor="middle" fill="#f8fafc" font-size="10" font-weight="800" font-family="ui-monospace, monospace">HOLLOW VOID</text>
        <text x="128" y="118" text-anchor="middle" fill="#94a3b8" font-size="8" font-family="ui-monospace, monospace">(0 Overdraw)</text>

        <!-- Interactive Drag Knob / Scrubber for CSG Void Inset -->
        <g id="csg-aperture-scrubber" transform="translate(40, 196)" cursor="ew-resize">
          <rect x="0" y="0" width="180" height="22" rx="5" fill="#1e293b" stroke="#38bdf8" stroke-width="1" />
          <text x="90" y="14.5" text-anchor="middle" fill="#38bdf8" font-size="9" font-weight="700" font-family="ui-monospace, monospace">
            DRAG TO RESIZE VOID
          </text>
        </g>
      </g>
    </g>

    <!-- CHAPTER 4: THE SOVEREIGN OFFLINE COVENANT -->
    <g id="page-4" transform="translate(2400, 0)">
      <rect x="36" y="60" width="728" height="375" rx="12" fill="url(#pageCardGrad)" stroke="#334155" stroke-width="1.5" filter="url(#shadowFilter)" />
      
      <text x="64" y="100" fill="#f8fafc" font-size="19" font-weight="800">IV. The Sovereign Offline Covenant: P2P Mesh</text>
      <text x="64" y="122" fill="#94a3b8" font-size="12">Air-gapped edge AI and local mesh synchronization for developing-world classrooms.</text>

      <g transform="translate(64, 142)">
        <rect x="0" y="0" width="450" height="66" rx="8" fill="#090d16" stroke="#1e293b" />
        <text x="16" y="24" fill="#38bdf8" font-size="11.5" font-weight="800" font-family="ui-monospace, monospace">01. 3-TIER EDGE AI INFERENCE HIERARCHY</text>
        <text x="16" y="44" fill="#cbd5e1" font-size="11">Tier 1: Chrome Prompt API (Gemini Nano) • Tier 2: WebLLM GPU shaders</text>
        <text x="16" y="58" fill="#94a3b8" font-size="10.5">Tier 3: Deterministic Socratic engine (&lt; 5ms, 0 GPU memory, 0 bps bandwidth).</text>
      </g>

      <g transform="translate(64, 222)">
        <rect x="0" y="0" width="450" height="66" rx="8" fill="#090d16" stroke="#1e293b" />
        <text x="16" y="24" fill="#38bdf8" font-size="11.5" font-weight="800" font-family="ui-monospace, monospace">02. P2P SNEAKERNET &amp; OPTICAL QR MESH</text>
        <text x="16" y="44" fill="#cbd5e1" font-size="11">High-density animated QR codes enable camera-to-camera optical transfer</text>
        <text x="16" y="58" fill="#94a3b8" font-size="10.5">of full AST binary cartridges without cables, Wi-Fi, or cellular connectivity.</text>
      </g>

      <g transform="translate(64, 302)">
        <rect x="0" y="0" width="450" height="66" rx="8" fill="#090d16" stroke="#1e293b" />
        <text x="16" y="24" fill="#38bdf8" font-size="11.5" font-weight="800" font-family="ui-monospace, monospace">03. FLASH WEAR GUARD (eMMC PRESERVATION)</text>
        <text x="16" y="44" fill="#cbd5e1" font-size="11">Zero disk writes during active 60 FPS simulations. Debounced milestone</text>
        <text x="16" y="58" fill="#94a3b8" font-size="10.5">commits to IndexedDB protect low-cost educational tablets from flash burnout.</text>
      </g>

      <!-- Right Column: Mesh Beacon Hologram -->
      <g transform="translate(620, 215)">
        <rect x="-65" y="-65" width="130" height="130" rx="16" fill="#090d16" stroke="#34d399" stroke-width="1.8" />
        <!-- Procedural QR-style matrix representation -->
        <rect x="-48" y="-48" width="24" height="24" fill="#34d399" />
        <rect x="-42" y="-42" width="12" height="12" fill="#090d16" />
        <rect x="24" y="-48" width="24" height="24" fill="#34d399" />
        <rect x="30" y="-42" width="12" height="12" fill="#090d16" />
        <rect x="-48" y="24" width="24" height="24" fill="#34d399" />
        <rect x="-42" y="30" width="12" height="12" fill="#090d16" />
        <circle cx="8" cy="8" r="6" fill="#38bdf8" />
        <circle cx="-10" cy="8" r="4" fill="#38bdf8" />
        <circle cx="20" cy="20" r="4" fill="#38bdf8" />
        <text x="0" y="58" text-anchor="middle" fill="#34d399" font-size="9" font-weight="800" font-family="ui-monospace, monospace">OPTICAL BEACON</text>
      </g>
    </g>

  </g>

  <!-- Persistent Bottom Chapter Navigation Bar -->
  <g id="hud-chapter-tabs" transform="translate(0, 445)">
    <!-- Prev Button -->
    <g id="lumina-btn-prev" class="lumina-nav-btn" transform="translate(36, 0)" cursor="pointer">
      <rect width="90" height="34" rx="6" fill="#1e293b" stroke="#334155" stroke-width="1" />
      <text x="45" y="21" fill="#cbd5e1" font-size="11" font-weight="700" text-anchor="middle">◀ PREV</text>
    </g>

    <!-- 4 Chapter Quick Jump Tabs -->
    <g id="tab-1" class="lumina-ch-tab" data-page="0" transform="translate(136, 0)" cursor="pointer">
      <rect id="tab-1-bg" width="124" height="34" rx="6" fill="#0284c7" stroke="#38bdf8" stroke-width="1" />
      <text x="62" y="21" fill="#ffffff" font-size="10" font-weight="800" text-anchor="middle">I. AXIOMS</text>
    </g>

    <g id="tab-2" class="lumina-ch-tab" data-page="1" transform="translate(268, 0)" cursor="pointer">
